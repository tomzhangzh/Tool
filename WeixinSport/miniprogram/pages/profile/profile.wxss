/* pages/profile/profile.wxss */
.profile-page { padding-bottom: 40rpx; }

.hero { padding: 60rpx 32rpx 40rpx; text-align: center; border-radius: 0 0 32rpx 32rpx; margin-bottom: 24rpx; }
.hero-avatar { width: 120rpx; height: 120rpx; border: 6rpx solid rgba(255,255,255,0.5); background: rgba(255,255,255,0.2); }
.avatar-placeholder { background: #ddd; color: #666; }
.avatar-btn { padding: 0; line-height: 1.5; background: transparent; display: inline-block; }
.avatar-btn::after { border: none; }
.hero-name { font-size: 36rpx; font-weight: 700; color: #fff; margin-top: 16rpx; }
.hero-role { font-size: 24rpx; color: rgba(255,255,255,0.85); margin-top: 4rpx; }

.stat-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.stat-cell { flex: 1; min-width: 40%; text-align: center; padding: 20rpx 8rpx; background: #f9f9fb; border-radius: 12rpx; }
.stat-num { font-size: 36rpx; font-weight: 700; }
.stat-label { font-size: 22rpx; color: #999; margin-top: 4rpx; }

.menu { padding: 0; }
.menu-item { display: flex; align-items: center; gap: 16rpx; padding: 28rpx 24rpx; border-bottom: 1rpx solid #f5f5f5; }
.menu-item:last-child { border-bottom: none; }
.menu-item:active { background: #f9f9fb; }
.menu-emoji { font-size: 40rpx; }
.menu-badge { background: #ff4d4f; color: #fff; font-size: 20rpx; padding: 2rpx 12rpx; border-radius: 16rpx; }
.menu-arrow { color: #ccc; font-size: 36rpx; }

.logout-btn { margin-top: 32rpx; }
