/* pages/weekly/weekly.wxss */
.week-switch {
  display: flex; align-items: center; gap: 16rpx;
  background: #fff; padding: 16rpx 24rpx; border-radius: 16rpx;
  margin-bottom: 20rpx;
}
.week-tab {
  padding: 10rpx 32rpx; border-radius: 32rpx; font-size: 26rpx;
  background: #f5f5f5; color: #666;
}
.week-tab-active { background: #4A90E2; color: #fff; }
.week-label { margin-left: auto; font-size: 24rpx; color: #999; }

.calc-bar {
  display: flex; align-items: center; justify-content: space-between;
  background: #fff8e6; padding: 20rpx 24rpx; border-radius: 16rpx;
  margin-bottom: 20rpx; font-size: 26rpx; color: #8a6500;
}
.calc-bar .btn { margin-left: 16rpx; }

.award-card { margin-bottom: 24rpx; }
.award-header { display: flex; align-items: center; gap: 16rpx; padding-bottom: 16rpx; border-bottom: 1rpx solid #f5f5f5; margin-bottom: 16rpx; }
.award-icon { font-size: 56rpx; }
.award-title { font-size: 32rpx; font-weight: 600; color: #333; }

.winner-row {
  display: flex; align-items: center; gap: 16rpx; padding: 16rpx 12rpx;
  border-radius: 12rpx; margin-bottom: 8rpx;
}
.winner-top { background: linear-gradient(90deg, #fff8e6 0%, #fff 100%); }
.rank-badge {
  width: 48rpx; height: 48rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  background: #f0f0f0; font-size: 28rpx; font-weight: 700;
}
.rank-1 { background: #FFD700; color: #fff; }
.rank-2 { background: #C0C0C0; color: #fff; }
.rank-3 { background: #CD7F32; color: #fff; }
.winner-avatar { width: 56rpx; height: 56rpx; }
.avatar-placeholder { background: #ddd; font-size: 24rpx; color: #666; }
.winner-info { flex: 1; }
.winner-name { font-size: 28rpx; color: #333; font-weight: 500; }
.winner-tag {
  background: linear-gradient(135deg, #FFD700, #FFA940);
  color: #fff; font-size: 22rpx; padding: 4rpx 16rpx; border-radius: 24rpx;
}

.mini-empty { padding: 40rpx 0; font-size: 24rpx; }

.rule-card { background: #f9f9fb; }
.rule-text { font-size: 26rpx; color: #666; line-height: 1.8; }
