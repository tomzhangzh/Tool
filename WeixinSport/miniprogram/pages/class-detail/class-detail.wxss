/* pages/class-detail/class-detail.wxss */
.info-card { color: #fff; padding: 40rpx 32rpx; }
.info-name { font-size: 40rpx; font-weight: 700; }
.info-sub { font-size: 26rpx; opacity: 0.9; margin-top: 8rpx; }
.code-row { margin-top: 24rpx; display: inline-flex; align-items: center; gap: 12rpx; background: rgba(255,255,255,0.25); padding: 12rpx 24rpx; border-radius: 24rpx; }
.code-text { color: #fff; font-size: 26rpx; }
.copy-tag { background: #fff; color: #4A90E2; font-size: 22rpx; padding: 4rpx 16rpx; border-radius: 16rpx; }

.entry-row { display: flex; gap: 16rpx; margin-bottom: 20rpx; }
.entry-cell {
  flex: 1; background: #fff; border-radius: 16rpx; padding: 32rpx 0;
  text-align: center; font-size: 26rpx; color: #555;
}
.entry-emoji { font-size: 48rpx; margin-bottom: 8rpx; }

.member-row { display: flex; align-items: center; gap: 16rpx; padding: 16rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.member-row:last-child { border-bottom: none; }
.rank-num { width: 40rpx; text-align: center; color: #999; font-size: 24rpx; }
.member-avatar { width: 56rpx; height: 56rpx; }
.avatar-placeholder { background: #ddd; font-size: 24rpx; color: #666; }
.member-name { font-size: 28rpx; color: #333; }
.member-stat { text-align: right; }
.stat-val { font-size: 30rpx; color: #FFA940; font-weight: 600; }
