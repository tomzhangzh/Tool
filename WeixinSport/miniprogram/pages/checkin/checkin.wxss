/* pages/checkin/checkin.wxss */
.type-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16rpx; }
.type-cell { background: #f9f9fb; border-radius: 12rpx; padding: 24rpx 8rpx; text-align: center; border: 2rpx solid transparent; }
.type-cell-active { border-color: #4A90E2; background: #eef4ff; }
.type-emoji { font-size: 48rpx; }
.type-name { font-size: 24rpx; color: #555; margin-top: 8rpx; }

.form-row { display: flex; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.form-row:last-of-type { border-bottom: none; }
.form-label { width: 160rpx; color: #666; font-size: 28rpx; }
.form-input { flex: 1; font-size: 30rpx; }

.duration-input { flex: 1; display: flex; align-items: center; gap: 12rpx; }
.duration-input slider { flex: 1; }
.calorie-text { font-size: 36rpx; color: #FFA940; font-weight: 700; }

.checkin-row { display: flex; align-items: center; gap: 16rpx; padding: 16rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.checkin-row:last-child { border-bottom: none; }
