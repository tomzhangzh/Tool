/* pages/monthly/monthly.wxss */
.month-switch {
  display: flex; align-items: center; gap: 16rpx;
  background: #fff; padding: 16rpx 24rpx; border-radius: 16rpx;
  margin-bottom: 20rpx;
}
.week-tab {
  padding: 10rpx 32rpx; border-radius: 32rpx; font-size: 26rpx;
  background: #f5f5f5; color: #666;
}
.week-tab-active { background: #4A90E2; color: #fff; }
.week-label { margin-left: auto; font-size: 24rpx; color: #999; }

.calc-bar {
  display: flex; align-items: center; justify-content: space-between;
  background: #fff8e6; padding: 20rpx 24rpx; border-radius: 16rpx;
  margin-bottom: 20rpx; font-size: 26rpx; color: #8a6500;
}

.podium-card { padding: 24rpx; }
.podium {
  display: flex; justify-content: center; align-items: flex-end; gap: 24rpx;
  padding: 32rpx 0 16rpx; min-height: 320rpx;
}
.podium-col {
  display: flex; flex-direction: column; align-items: center; gap: 8rpx;
  padding: 24rpx 16rpx; border-radius: 16rpx 16rpx 0 0; min-width: 180rpx;
}
.podium-1 { background: linear-gradient(180deg, #fff8e6 0%, #FFD700 100%); height: 280rpx; order: 2; }
.podium-2 { background: linear-gradient(180deg, #f5f5f5 0%, #C0C0C0 100%); height: 230rpx; order: 1; }
.podium-3 { background: linear-gradient(180deg, #fff0e6 0%, #CD7F32 100%); height: 200rpx; order: 3; }
.podium-medal { font-size: 48rpx; }
.podium-avatar { width: 88rpx; height: 88rpx; border: 4rpx solid rgba(255,255,255,0.7); }
.avatar-placeholder { background: rgba(255,255,255,0.5); color: #fff; font-size: 32rpx; }
.podium-name { font-size: 28rpx; color: #333; font-weight: 600; }
.podium-score { font-size: 32rpx; color: #FFA940; font-weight: 700; }
.podium-label { font-size: 22rpx; color: #666; background: rgba(255,255,255,0.7); padding: 2rpx 16rpx; border-radius: 16rpx; }

.special-row {
  display: flex; align-items: center; gap: 16rpx; padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.special-row:last-child { border-bottom: none; }
.special-emoji { font-size: 48rpx; }
.special-name { font-size: 28rpx; color: #333; font-weight: 600; }
.special-winner { text-align: right; }
.special-winner .winner-name { font-size: 28rpx; color: #FFA940; font-weight: 600; }

.rule-card { background: #f9f9fb; }
.rule-text { font-size: 26rpx; color: #666; line-height: 1.8; }
.empty-emoji { font-size: 80rpx; margin-bottom: 12rpx; }
