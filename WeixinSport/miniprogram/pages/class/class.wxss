/* pages/class/class.wxss */
.create-card {
  display: flex; align-items: center; gap: 16rpx; padding: 32rpx 24rpx;
  background: linear-gradient(135deg, #eef4ff 0%, #fff 100%);
}
.create-card:active { opacity: 0.8; }
.create-emoji { font-size: 56rpx; }
.create-title { font-size: 32rpx; font-weight: 600; color: #4A90E2; }

.join-card {
  display: flex; align-items: center; gap: 16rpx; padding: 28rpx 24rpx; margin-top: 16rpx;
  background: linear-gradient(135deg, #fff5e6 0%, #fff 100%);
}
.join-card:active { opacity: 0.8; }
.join-card .create-title { color: #FFA940; }

.class-card { padding: 24rpx; }
.class-card-header { display: flex; align-items: center; gap: 16rpx; }
.class-card-icon { font-size: 48rpx; }
.class-card-name { font-size: 32rpx; font-weight: 600; color: #333; }

.code-box {
  margin-top: 20rpx; padding: 20rpx; background: #f9f9fb; border-radius: 12rpx;
  display: flex; align-items: center; gap: 16rpx;
}
.code-label { font-size: 24rpx; color: #999; }
.code-value { flex: 1; font-size: 36rpx; font-weight: 700; color: #4A90E2; letter-spacing: 4rpx; }
.copy-btn {
  background: #4A90E2; color: #fff; font-size: 24rpx;
  padding: 8rpx 24rpx; border-radius: 24rpx;
}

.modal-mask {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center;
  z-index: 100;
}
.modal {
  width: 560rpx; background: #fff; border-radius: 24rpx; padding: 32rpx;
}
.modal-title { font-size: 32rpx; font-weight: 600; text-align: center; margin-bottom: 24rpx; }
.modal-input { border: 1rpx solid #eee; border-radius: 12rpx; padding: 20rpx; font-size: 30rpx; margin-bottom: 24rpx; }
.modal-actions { display: flex; gap: 16rpx; }
.modal-actions .btn { border-radius: 48rpx; }

.empty-emoji { font-size: 80rpx; margin-bottom: 12rpx; }
