/* pages/stats/stats.wxss */
.tab-bar { display: flex; background: #fff; border-radius: 16rpx; padding: 8rpx; margin-bottom: 20rpx; }
.tab { flex: 1; text-align: center; padding: 16rpx 0; font-size: 28rpx; color: #666; border-radius: 12rpx; }
.tab-active { background: #4A90E2; color: #fff; font-weight: 600; }

.stat-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.stat-cell { flex: 1; min-width: 40%; text-align: center; padding: 24rpx 8rpx; background: #f9f9fb; border-radius: 12rpx; }
.stat-num { font-size: 40rpx; font-weight: 700; }
.stat-label { font-size: 22rpx; color: #999; margin-top: 4rpx; }

.chart {
  display: flex; align-items: flex-end; justify-content: space-around;
  height: 280rpx; padding: 16rpx 0; border-bottom: 1rpx solid #f0f0f0;
}
.chart-bar-wrap { display: flex; flex-direction: column; align-items: center; flex: 1; }
.chart-bar {
  width: 40rpx; background: linear-gradient(180deg, #67B8F2 0%, #4A90E2 100%);
  border-radius: 8rpx 8rpx 0 0; min-height: 8rpx;
}
.chart-val { font-size: 20rpx; color: #666; margin-top: 6rpx; }
.chart-label { font-size: 20rpx; color: #999; margin-top: 4rpx; }

.dist-row { display: flex; align-items: center; gap: 16rpx; padding: 16rpx 0; }
.dist-emoji { font-size: 40rpx; width: 56rpx; text-align: center; }
.dist-name-row { display: flex; justify-content: space-between; font-size: 26rpx; color: #333; margin-bottom: 8rpx; }
.dist-bar { height: 12rpx; background: #f0f0f0; border-radius: 6rpx; overflow: hidden; }
.dist-bar-inner { height: 100%; border-radius: 6rpx; }

.empty-emoji { font-size: 80rpx; margin-bottom: 12rpx; }
