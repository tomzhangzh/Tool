@using Furion.ClayObject;
@model TUI.Core.Models.SummaryPageInfo<dynamic,dynamic>
@inject IDynamicService DynamicService
@{
    DynamicService.SetTableInfo("ComponentSetting", "ComponentSetting");
    Model.Filter = new { Name__Like = "" };
    (string whereClause, SugarParameter[] parameters) where = DynamicService.GenerateWhereClauseAndParameters(Model.Filter);
    ISugarQueryable<System.Dynamic.ExpandoObject> queryable = DynamicService.Queryable().Where(where.whereClause, Model.Filter);
    Model.PageInfo.Count = queryable.Count();
    var items = queryable.Skip(Model.PageInfo.Skip).Take(Model.PageInfo.Limit).ToList().Select(x => x.ToJson().DeserializeJson<ComponentSetting>());
}
<div t-init-vueinit="@(Model.ToJson())" t-init-winStyle="@(new{width="80%"}.ToJson())" class="flex flex-col p-2 w-full h-full justify-stretch overflow-auto bg-gray-100">
    <div class="layui-card" >
        <div class="layui-card-header bg-blue-500 text-white">查询</div>
        <div class="layui-card-body">
            <el-form :model="model.Filter" label-width="120px" class="grid grid-cols-3 gap-4">
                <el-form-item label="Name">
                    <el-input v-model="model.Filter.Name__Like"></el-input>
                </el-form-item>

                <el-form-item label="Description">
                    <el-input v-model="model.Filter.Description__Like"></el-input>
                </el-form-item>
            </el-form>
        </div>
        <div class="layui-card-footer">
            <div class="layui-btn-group">
                <span class="layui-btn layui-btn-normal px-2"><i class="layui-icon layui-icon-add-1"></i>添加</span>
                <span class="layui-btn layui-btn-normal px-2" t-click-postData="@(new{@event="Search"}.ToJson())"><i class="layui-icon layui-icon-search"></i>查询</span>
                <span class="layui-btn layui-btn-normal px-2" t-click-postData="@(new{@event="Clear"}.ToJson())"><i class="layui-icon layui-icon-refresh-1"></i>清除</span>
            </div>
        </div>
    </div>
    <div class="flex justify-between h-10 items-center border  bg-white px-2" t-init-updateEl="/WebControl/Pagination">
    </div>
    <table id="dt-basic-example" class="layui-table table-hover table-striped w-100 m-0">
        <thead class="bg-blue-500 text-white">
            <tr>
                <th width="150px">

                </th>
                <th sortname="Name"
                    style="width:200px">
                    Name
                </th>
                <th sortname="DbObjectType"
                    style="width:300px">
                    Db Type
                </th>
                <th sortname="DbObjectType"
                    style="width:300px">
                    Description
                </th>

                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in items)
            {
                <tr>
                    <td style="padding: 0px 5px">
                        <div class="d-flex justify-content-between content-center gap-2 place-items-center w-full">
                            <span class="hover:bg-blue-300 h-8 hover:bg-opacity-30  p-2"
                                  t-click-openWinurl="@(new{title="编辑表"+item.Name,url=$"/Tools/DBManagement/Detail?TableName={item.Name}",options=new{shade=0}}.ToJson())">
                                <i class="layui-icon layui-icon-edit" style="font-size: 20px; color: #1E9FFF;"></i>编辑
                            </span>
                            <span class="hover:bg-blue-300 h-8 hover:bg-opacity-30  p-2">
                                <i class="layui-icon layui-icon-delete" style="font-size: 20px; color: red;"></i>删除
                            </span>

                            @*     <a href="javascript: void(0); " myaction-openwindow="
                        @(new  {options=new{ title = "Edit", width="1000px",center=true},url="/Systems/EmailTemplate/Detail",refresh=true,@params=new{item.ID } }.ToJSON())
                        " class="btn btn-outline-info  btn-sm btn-icon rounded-circle waves-effect waves-themed">
                        <i class="fal fa-edit"></i>
                        </a>
                        <a href="javascript: void(0); " myaction-delete="
                        @(new  {url="/Systems/EmailTemplate/Delete",@params=new{item.ID } }.ToJSON())
                        " class="btn btn-outline-danger btn-sm btn-icon rounded-circle waves-effect waves-themed">
                        <i class="fal fa-trash"></i>
                        </a> *@
                        </div>

                    </td>
                    <td>
                        @item.Name

                    </td>
                    <td>
                        @item.Category

                    </td>
                    <td>
                        @item.Description

                    </td>

                    <td></td>
                </tr>
            }
        </tbody>
    </table>
    <div class="flex justify-between h-10 items-center border  bg-white px-2">
        <div></div>
        @await Html.PartialAsync("~/Views/Shared/Components/Pagination.cshtml",Model.PageInfo)
    </div>
</div>
