@using Furion.ClayObject;
@model TUI.Core.Models.SummaryPageInfo<ComponentSetting>
@inject IService<ComponentSetting> service
@{
    var list = service.Queryable();
    list = list.WhereIF(Model.Filter.Name.IsNullOrEmpty() == false, x => x.Name.Contains(Model.Filter.Name, StringComparison.OrdinalIgnoreCase));
    list = list.WhereIF(Model.Filter.Description.IsNullOrEmpty() == false, x => x.Name.Contains(Model.Filter.Description, StringComparison.OrdinalIgnoreCase));
    Model.PageInfo.Count = list.Count();
    var items = list.Skip(Model.PageInfo.Skip).Take(Model.PageInfo.Limit).ToList();
}
