                            " class="btn btn-outline-danger btn-sm btn-icon rounded-circle waves-effect waves-themed">
                            <i class="fal fa-trash"></i>
                            </a> *@
                            </div>

                        </td>
                        <td>
                            @item.Name

                        </td>
                        <td>
                            @item.DbObjectType

                        </td>
                        <td>
                            @item.Description

                        </td>

                        <td></td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="flex justify-between h-10 items-center border  bg-white px-2">
            <div></div>
            @await Html.PartialAsync("~/Views/Shared/Components/Pagination.cshtml",Model.PageInfo)
        </div>
      
        
