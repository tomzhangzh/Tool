                <span class="layui-btn layui-btn-normal px-2" t-click-postData="@(new{@event="Clear"}.ToJson())"><i class="layui-icon layui-icon-refresh-1"></i>清除</span>
            </div>
        </div>
        <div class="flex justify-between h-10 items-center border  bg-white px-2" t-init-updateEl="/WebControl/Pagination">
           
        </div>
        <table id="dt-basic-example" class="layui-table table-hover table-striped w-100 m-0">
            <thead class="bg-blue-500 text-white">
                <tr>
                    <th width="150px">

                    </th>
                    <th sortname="Name"
                        style="width:200px">
                        Name
                    </th>
                    <th sortname="DbObjectType"
