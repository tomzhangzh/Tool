@model TUI.Core.Models.SummaryPageInfo<DbTableInfo>
@{
    var list = this.SqlSugarClient.DbMaintenance.GetTableInfoList(false);
    list = list.WhereIF(Model.Filter.Name.IsNullOrEmpty() == false, x => x.Name.Contains(Model.Filter.Name,StringComparison.OrdinalIgnoreCase)).ToList();
    list = list.WhereIF(Model.Filter.Description.IsNullOrEmpty() == false, x => x.Name.Contains(Model.Filter.Description, StringComparison.OrdinalIgnoreCase)).ToList();
    Model.PageInfo.Count = list.Count;
    var items = list.Skip(Model.PageInfo.Skip).Take(Model.PageInfo.Limit);
}
<div t-init-vueinit="@(Model.ToJson())"
     t-init-winMax
@*t-init-winStyle="@(new{left="10px",top="10px"}.ToJson())" *@
class="flex flex-col p-2 w-full h-full justify-stretch overflow-auto bg-gray-100">
@*<t-checkbox :value="true"></t-checkbox>*@
<div class="flex ">

