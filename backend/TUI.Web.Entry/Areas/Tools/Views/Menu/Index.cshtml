@using Furion.ClayObject;
@model TUI.Core.Models.SummaryPageInfo<dynamic,dynamic>
@inject IDynamicService DynamicService
@{
    DynamicService.SetTableInfo("MenuSetting", "MenuSetting");
    Model.Filter = new { Name__Like = "菜单",Id__In=new List<int>() { 1,3,4} };
    (string whereClause, SugarParameter[] parameters) where = DynamicService.GenerateWhereClauseAndParameters(Model.Filter);
    ISugarQueryable<System.Dynamic.ExpandoObject> queryable = DynamicService.Queryable().Where(where.whereClause, Model.Filter);
   
    var items = queryable.Skip(Model.PageInfo.Skip).Take(Model.PageInfo.Limit).ToList().Select(x => Clay.Object(x));
}
<div t-init-vueinit="@(Model.ToJson())" t-init-winStyle="@(new{left="10px",top="10px"}.ToJson())" class="flex flex-col p-2 w-full h-full justify-stretch overflow-auto bg-gray-100">
    <div class="layui-card">
        <div class="layui-card-header bg-blue-500 text-white">查询</div>
        <div class="layui-card-body">
            卡片式面板面板通常用于非白色背景色的主体内<br>
            从而映衬出边框投影
           @*  <icon-park :size="20" stroke-width="2" theme="outline"  type="left-bar" /> *@
            <t-select ></t-select>
        </div>

    </div>
    <div>
        <div class="flex justify-between h-10 items-center border bg-white">
            <div class="flex-grow flex flex-row  text-stronger content-start gap-1 place-items-center px-2">
                <img src="/img/icon1/10023.png" class="h-6 w-6 ">
                <div class="text">组件设计/img/icon1/10023.png</div>
            </div>
            <div class="layui-btn-group">
                <span class="layui-btn layui-btn-normal px-2"><i class="layui-icon layui-icon-add-1"></i>添加</span>
                <span class="layui-btn layui-btn-normal px-2"><i class="layui-icon layui-icon-search"></i>查询</span>
                <span class="layui-btn layui-btn-normal px-2"><i class="layui-icon layui-icon-refresh-1"></i>清除</span>
            </div>
        </div>

        <table id="dt-basic-example" class="layui-table table-hover table-striped w-100 m-0">
            <thead class="bg-blue-500 text-white">
                <tr>
                    <th width="70px">

                    </th>
                    <th sortname="Name"
                        style="width:200px">
                        Name
                    </th>
                    <th sortname="DbObjectType"
                        style="width:300px">
                        Title
                    </th>
                    <th sortname="DbObjectType"
                        style="width:300px">
                        URL
                    </th>

                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in items)
                {
                    <tr>
                        <td>
                            <div class="d-flex justify-content-between">
                                @*     <a href="javascript: void(0); " myaction-openwindow="
                            @(new  {options=new{ title = "Edit", width="1000px",center=true},url="/Systems/EmailTemplate/Detail",refresh=true,@params=new{item.ID } }.ToJSON())
                            " class="btn btn-outline-info  btn-sm btn-icon rounded-circle waves-effect waves-themed">
                            <i class="fal fa-edit"></i>
                            </a>
                            <a href="javascript: void(0); " myaction-delete="
                            @(new  {url="/Systems/EmailTemplate/Delete",@params=new{item.ID } }.ToJSON())
                            " class="btn btn-outline-danger btn-sm btn-icon rounded-circle waves-effect waves-themed">
                            <i class="fal fa-trash"></i>
                            </a> *@
                            </div>

                        </td>
                        <td>
                            @item.Name

                        </td>
                        <td>
                            @item.Title

                        </td>
                        <td>
                            @item.URL

                        </td>

                        <td></td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="flex justify-between h-10 items-center border  bg-white px-2">
            <div></div>
            @await Html.PartialAsync("~/Views/Shared/Components/Pagination.cshtml",Model.PageInfo)
        </div>


    </div>

</div>
