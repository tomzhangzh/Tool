                              class="comitem "
                              :name="index"
                              @@click.stop="extensionInfo.setComCurrent(element)"
                              :class="[getClass(props.jsonconfig.options?.itemoptions,element.jsonconfigoptions?.itemoptions), desginSharedData?.current?.com === element ? 'com_current' : '']">
