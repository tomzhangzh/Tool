                                <i class="fa fa-remove "></i>
                            </div>
                            <div class="hover:bg-blue-400/60   bg-blue-400  text-white  space-x-1 h-5 px-1 cursor-default  "
                                 @@click.stop="desginSharedData.handleSelectParent(element)">
                                <i class="fa fa-arrow-up "></i>
                            </div>


                        </div>
                    </div>
                </div>
                
           
            </el-collapse-item>
        </el-collapse>
