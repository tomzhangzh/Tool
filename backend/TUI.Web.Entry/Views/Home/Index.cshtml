@using Microsoft.AspNetCore.Html;
@using System.Linq;
@{
    Func<(string name, string imgsrc, string url), IHtmlContent> shortcut =@<text>
            <div t-click-openWinurl="@(new{title=item.name+item.imgsrc,item.imgsrc,item.url,options=new{shade=0}}.ToJson())"
                 class="w-16 hover:bg-white hover:bg-opacity-50 rounded p-1 flex flex-col content-start gap-2 place-items-center">
                <img src="@item.imgsrc" class="h-12 w-12" />
                <div class="text-white">@item.name</div>
            </div>
    </text>
    ;
    Func<(string name, string imgsrc, string url), IHtmlContent> startmenu =@<text>
            <div t-click-openWin="@(new{title=item.name,item.imgsrc,item.url}.ToJson())"
                 class="w-full hover:bg-white hover:bg-opacity-50 rounded p-1 flex flex-row content-start gap-2 place-items-center">
                <img src="@item.imgsrc" class="h-8 w-8" />
                <div class="text-white">@item.name</div>
            </div>
    </text>
    ;
    var list = Enumerable.Range(21, 10).Select(x => ("组件设计1", $"/img/icon1/100{x}.png", "/Tools/DBManagement/Index")).ToList();
    list.Add(("组件设计", $"/img/icon1/10022.png", "/Tools/ComponentSetting/Index"));
    list.Add(("菜单设置", $"/img/icon1/10023.png", "/Tools/Menu/Index"));
}
<div id="desktop" unselectable="on" class="h-full w-full p-0 overflow-hidden">
    <div id="bg-bg" style="top: 0px;top: 0px;height: calc(100%);position:absolute;z-index:-1;width:100%; filter: brightness(106%);
background-image: url('/img/wallpaper.jpg')
"
         class="bg-center bg-cover relative overflow-hidden"
      >
       
     </div>
    <div class="bg-transparent" style="top: 0px;top: 0px;height: calc(100% - 40px);">
        <div class="flex flex-col flex-wrap h-full content-start gap-4 place-items-center p-2">
            @foreach (var item in list)
            {
                @shortcut(item)
            }
            @* @shortcut(("组件设计","/img/icon1/10021.png",null))
            @shortcut(("组件设计","/img/icon1/10022.png",null))
            @shortcut(("组件设计","/img/icon1/10023.png",null))
            @shortcut(("组件设计","/img/icon1/10023.png",null))
            @shortcut(("组件设计","/img/icon1/10024.png",null))
            @shortcut(("组件设计","/img/icon1/10025.png",null))
            @shortcut(("组件设计","/img/icon1/10026.png",null))
            @shortcut(("组件设计","/img/icon1/10027.png",null))
            @shortcut(("组件设计","/img/icon1/10028.png",null))
            @shortcut(("组件设计","/img/icon1/10029.png",null))
            @shortcut(("组件设计","/img/icon1/10023.png",null))
            @shortcut(("组件设计","/img/icon1/10024.png",null))
            @shortcut(("组件设计","/img/icon1/10025.png",null))
            @shortcut(("组件设计","/img/icon1/10026.png",null))*@
        </div>
    </div>
    <div class="w-full h-10 px-0 fixed bottom-0 flex flex-row justify-between items-center z-20 text-sm text-white bg-gray-500 bg-opacity-10 backdrop-blur-2xl shadow transition">
        <div class="flex flex-row items-center space-x-1">
            <div class="inline-flex  cursor-default flex-row space-x-1 hover:bg-white hover:bg-opacity-30 rounded p-2" id="startBtn">
                <svg stroke="currentColor" class="h-6 w-6" fill="currentColor" stroke-width="0" viewBox="0 0 24 24" height="16" width="16" xmlns="http://www.w3.org/2000/svg"><g><path fill="none" d="M0 0h24v24H0z"></path><path fill-rule="nonzero" d="M11.624 7.222c-.876 0-2.232-.996-3.66-.96-1.884.024-3.612 1.092-4.584 2.784-1.956 3.396-.504 8.412 1.404 11.172.936 1.344 2.04 2.856 3.504 2.808 1.404-.06 1.932-.912 3.636-.912 1.692 0 2.172.912 3.66.876 1.512-.024 2.472-1.368 3.396-2.724 1.068-1.56 1.512-3.072 1.536-3.156-.036-.012-2.94-1.128-2.976-4.488-.024-2.808 2.292-4.152 2.4-4.212-1.32-1.932-3.348-2.148-4.056-2.196-1.848-.144-3.396 1.008-4.26 1.008zm3.12-2.832c.78-.936 1.296-2.244 1.152-3.54-1.116.048-2.46.744-3.264 1.68-.72.828-1.344 2.16-1.176 3.432 1.236.096 2.508-.636 3.288-1.572z"></path></g></svg>
            </div>
            @* <span class="cursor-default font-semibold">TUI</span>*@
        </div>
        <div id="winManager" class="grow flex flex-row justify-start items-center pl-2 gap-2 bg-gray-900 bg-opacity-30 h-10  overflow-hidden ">
            <!------------------------------->
            <div v-for="(item, index) in model.openwin"
                 :key="index"
                 :index="index" :class="model.openwin.length>10?'w-16':'w-32'" class="border-l border-gray-500 h-8  cursor-default flex-row space-x-1 hover:bg-white hover:bg-opacity-30  p-1">
                <div class="w-full flex flex-row content-start gap-2 place-items-center"
                     @@click="setActiveWin(item)">
                    <img :src="item.args.imgsrc" class="h-6 w-6">
                    {{item.com.index}}
                    <div class="text text-ellipsis overflow-hidden whitespace-nowrap">{{item.args.title}}</div>
                </div>
            </div>
           
            <!------------------------------->
        </div>
        <div class="flex flex-row justify-end items-center space-x-2">
            <div class="inline-flex h-6 cursor-default flex-row space-x-1 hover:bg-white hover:bg-opacity-30 rounded p-1">
                <i class="layui-icon layui-icon-time"></i>
                <span>
                    {{ moment(now).format("YYYY年MM月DD日 HH时mm分ss秒") }}

                </span>
            </div>
            
        </div>
    </div>
    <div class="startMenu flex flex-row w-full h-full " >
        <div class="flex flex-col h-full bg-gray-900 bg-opacity-20 w-10 py-1  gap-2 justify-items-stretch items-center text-center">
            <div class="w-8 h-8 hover:bg-white hover:bg-opacity-30 rounded p-1">
                <i class="layui-icon layui-icon-face-smile"></i>
            </div>
            <div class="grow  w-8 h-8">
                02
            </div>
            <div class="w-8 h-8 hover:bg-white hover:bg-opacity-30 rounded p-1">
                <i class="layui-icon layui-icon-set-fill"></i>
            </div>
            <div class="w-8 h-8 hover:bg-white hover:bg-opacity-30 rounded p-1">
                <i class="layui-icon layui-icon-circle"></i>
            </div>

        </div>
        <div class="flex flex-col grow h-full bg-gray-600 bg-opacity-10  py-1 px-2  gap-2 justify-items-stretch items-center text-center">
            @foreach (var item in list)
            {
                @startmenu(item)
            }

        </div>
    </div>
</div>

<script>
    $(()=>{
        layui.use(function () {
            var dropdown = layui.dropdown;
            // 自定义内容
            dropdown.render({
                elem: '#startBtn',
                content: $(".startMenu"),
                className: 'border-0 flex flex-row justify-between items-center z-20 text-sm text-white bg-gray-500 bg-opacity-10 backdrop-blur-2xl shadow transition',
                style: 'width: 320px; height: 600px;z-Index:999999999 ',
                // shade: 0.3, // 弹出时开启遮罩 --- 2.8+
                ready: function () {
                    layui.use('element', function (element) {
                        element.render('tab');
                    });
                }
            });
        });
        // const images = ['/img/wallpaper.jpg', '/img/wallpaper-day.jpg', '/img/wallpaper-night.jpg'];
        // let index = 0;
        // setInterval(() => {
        //     index++;
        //     if (index >= images.length) index = 0;
        //     anime({
        //         targets: '#bg-bg',
        //         opacity: 0.5,
        //         duration: 2000,
        //         easing: 'linear',
        //         complete: function (anim) {
        //             $('#bg-bg').get(0).style.backgroundImage = `url(${images[index]})`;
        //             anime({
        //                 targets: '#bg-bg',
        //                 opacity: 1,
        //                 duration: 2000,
        //                 easing: 'linear',
        //             });
        //         },
        //     });
           
        // }, 5000);
        const app = Vue.createApp({
            data() {
                return {}
            },
            setup(prop) {
                var model = Vue.ref({ openwin: [] });
                const now = VueUse.useNow();
                //const eyeDropper = VueUse.useEyeDropper();
                //increment = () => {
                //    model.value.count++;
                //}
                //const myHoverableElement = Vue.ref()
                //// debugger;
                //const isHovered = VueUse.useElementHover(myHoverableElement)
                VueUse.tryOnBeforeMount(() => {
                    tAPP.eventManager.on($("body"), "openwin", (x, data) => {
                       
                        model.value.openwin.push(data) });
                    tAPP.eventManager.on($("body"), "closewin", (x, data) => {
               
                        model.value.openwin = Enumerable.from(model.value.openwin).where(x => x.com.index != data.com.index).toArray()
                    });
                })
                const setActiveWin = function (item) {
                    tAPP.dom.setActiveWin(item.com.index);
                }
                const moment= window.moment;
                //debugger;
                //const { state, style: elementStyle } = VueUse.reactiveStyle({
                //    opacity: 0,
                //    backgroundColor: 'blue',
                //})

                //const toggleColor = () => {
