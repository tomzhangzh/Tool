    <button @@click="increment">{{ model.count }}</button>

        <div v-if="eyeDropper.isSupported">
            <div>isSupported: {{ eyeDropper.isSupported }}</div>
            <div>sRGBHex: <span :style="{ color: eyeDropper.sRGBHex }">{{ eyeDropper.sRGBHex }}</span></div>
            <button :disabled="!eyeDropper.isSupported"
                    @@click="() => eyeDropper.open()">
                Open Eye Dropper
            </button>
        </div>
        <div v-else>
            <span>Not Supported by Your Browser</span>
        </div>
    <button id="myHoverableElement">
        {{ isHovered }}
    </button>
