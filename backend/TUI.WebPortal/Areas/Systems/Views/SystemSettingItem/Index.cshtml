@model SystemSettingItem
@inherits CustomRazorPage<TModel>
@inject IService<SystemSettingItem> service
@{

    //List<(long, long?, string, string)> List = this.ViewBag.List;
    var extId = "Ctrl" + Guid.NewGuid().ToString("N");
    if (this.PaginationInfo.SortName.IsNullOrEmpty() == true)
    {
        this.PaginationInfo.SortName = "ID";
        this.PaginationInfo.SortDir = "Asc";
    }
    var query = from x in service.Queryable()

                select x;
    if (string.IsNullOrEmpty(Model.Type) == false)
    {
        query = query.Where(x => x.Type.Contains(Model.Type));
    }
    if (string.IsNullOrEmpty(Model.Category) == false)
    {
        query = query.Where(x => x.Category.Contains(Model.Category));
    }
    if (string.IsNullOrEmpty(Model.Json) == false)
    {
        query = query.Where(x => x.Json.Contains(Model.Json));
    }
    var list = this.PaginationInfo.GetQuery(query).ToList();
}

<div id="@extId"></div>

<div id="panel-2" class="panel" data-panel-fullscreen="" data-panel-close="" data-panel-collapsed="" data-panel-locked="" data-panel-reset="" data-panel-color="" data-panel-custombutton="">
    <div class="panel-hdr bg-info-500" role="heading">
        <h2 style="gap:5px;">
            <i class="fal fa-search"></i>   System Setting Item
        </h2>
        <div class="panel-toolbar">
            <button class="btn btn-panel waves-effect waves-themed" data-action="panel-collapse" data-toggle="tooltip" data-offset="0,10" data-original-title="Collapse"></button>
        </div>
    </div>
    <div class="panel-container show">
        <div class="loader"><i class="fal fa-spinner-third fa-spin-4x fs-xxl"></i></div>
        <div class="panel-content app p-2 ">
            <div class="panel-tag">


                <el-form label-width="120px" :model="model" ref="formRef">
                    <el-row :gutter="20">
                        <el-col :span="8" :xl="6" :xs="24">
                            <el-form-item label="Type" style="align-items: center;" prop="Type">
                                <el-input v-model="model.Type" name="Type"></el-input>
                            </el-form-item>
                        </el-col>
                        <el-col :span="8" :xl="6" :xs="24">
                            <el-form-item label="Category" style="align-items: center;" prop="Category">
                                <el-input v-model="model.Category" name="Category"></el-input>
                            </el-form-item>
                        </el-col>
                        <el-col :span="8" :xl="6" :xs="24">
                            <el-form-item label="Json" style="align-items: center;" prop="Json">
                                <el-input v-model="model.Json" name="Json"></el-input>
                            </el-form-item>
                        </el-col>
                    </el-row>


                </el-form>

            </div>
        </div>
    </div>
    <div class="panel-content p-2 rounded-bottom border-faded border-left-0 border-right-0 border-bottom-0 text-muted">
        <div class="d-flex justify-content-between">
            <div>
                <button type="button" class="btn btn-info waves-effect waves-themed" myaction-postback id="Search">
                    <span class="fal fa-search mr-1"></span>
                    Search
                </button>
                <button type="button" class="btn btn-info waves-effect waves-themed" myaction-postback id="Clear">
                    <span class="fal fa-recycle mr-1"></span>
                    Clear
                </button>
            </div>
            <div>
                <button type="button" class="btn btn-info waves-effect waves-themed" myaction-openwindow="@(new  {options=new{ title = "Add System Setting Item", width="1000px",center=true},url="/Systems/SystemSettingItem/Detail",refresh=true }.ToJSON())">
                    <span class="fal fa-file mr-1"></span>
                    Add
                </button>
                <button type="button" class="btn btn-info waves-effect waves-themed" myaction-openwindow="@(new  {options=new{ title = "Current System Setting", width="1000px",center=true},url="/Systems/SystemSettingItem/PreviewSystemSetting",refresh=true }.ToJSON())">
                    <span class="fal fa-cogs mr-1"></span>
                    Current System Setting
                </button>
            </div>

        </div>
    </div>
    <div class="panel-content p-2 rounded-bottom border-faded border-left-0 border-right-0 border-bottom-0 text-muted">
        @Html.Partial("~/Views/AutoGenerate/Grid/SystemSettingItem_Grid.cshtml", list)
        @await Html.PartialAsync("~/Views/Shared/Components/Pagination/default.cshtml", this.PaginationInfo)
    </div>
    </div>
    <script>

    $(function () {
        var $this = $("#@(extId)").closest("[data-url]");
        //$this.find('#dt-basic-example').dataTable(
        //    {
        //        responsive: true,
        //        searching: false,
        //        bLengthChange: false
        //    });
        const App = {
            data() {
                return {
                    model: Vue.reactive( @Html.Raw(Model.ToJSON()))
                    }
            },
            methods: {
                a: function (ex) {
                    alert(ex);
                }
    }
        };
        const app = Vue.createApp(App);
        app.use(ElementPlus);
        app.mount($this.find(".app").get(0));

        $this.off("keyup").on("keyup", function (event) {
            if (event.which == 13) {
                $this.find("#Search").trigger("click");
            }
            else if (event.which == 27) {
                $this.find("#Clear").trigger("click");
            }
        })

    })
    </script>
