@model ScheduleTaskLog
@{
    ViewData["Title"] = "Detail";
    var extId = "Ctrl" + Guid.NewGuid().ToString("N");
}


<div id="@extId" myaction-winoptions="@(new{ title = $"{(Model.ID==0?"Add":"Edit")} Log", width="1000px",height="700px",center=true}.ToJSON())"></div>
<div class="p-2">
    <ul class="nav nav-tabs bg-indigo-50 pt-2 pl-2 border" role="tablist">
        <li class="nav-item"><a class="nav-link active" data-toggle="tab" href="#tab_config-1" role="tab" myaction-postback>General</a></li>
        @if (Model.ID != 0)
        {
            <li class="nav-item"><a class="nav-link" data-toggle="tab" href="#tab_config-2" role="tab" myaction-updatecontainter containter="#tab_config-2" url="/Task/ScheduleTaskLogHistory/Index?ScheduleTaskLogID=@Model.ID">History</a></li>

        }
    </ul>
    <div class="tab-content border border-top-0 p-0" style="min-height:600px">
        <div class="tab-pane fade show active" id="tab_config-1" role="tabpanel">
            <form myaction-initform autocomplete="off">
                @if (ViewData.ModelState.Keys.Any(k => ViewData.ModelState[k].Errors.Count() > 0))
                {
                    <div class="alert alert-danger">
                        <button class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
                        @Html.ValidationSummary(false)
                    </div>
                }
                <div class="card border-0">


                    <!-- panel footer with utility classes -->
                    <div class="card-header py-1">
                        <button class="btn btn-info waves-effect waves-themed" type="button" id="Save" myaction-postback><i class="fal fa-save p-1"></i>Save</button>
                    </div>
                    <div class="card-body" style="min-height:400px;">
                        @Html.Partial("~/Views/AutoGenerate/Detail/ScheduleTaskLog_Detail.cshtml", Model)

                    </div>

                </div>


            </form>
        </div>
        <div class="tab-pane fade" id="tab_config-2" role="tabpanel">

        </div>
    </div>
</div>







<script>

    $(function () {
        var $this = $("#@(extId)").closest("[data-url]");


    });
</script>