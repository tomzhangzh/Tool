

<style>
    .container {
        max-width: 800px;
        margin-right: auto;
        margin-left: auto;
    }

    .title {
        font-family: Algerian;
        font-size: 36px;
        margin-left:10px;
    }

    .subtitle {
        font-family: Arial;
        font-style: italic;
        font-size: 19px;
        margin-left:10px;
    }

    .logo {
        margin-left: 100px;
    }

        .logo img {
            width: 100px;
        }

    table {
        width: 100%;
    }

        table th {
            font-family: Arial;
            font-size: 16px;
            line-height: 40px;
        }

    .fuelTable {
        border: 1px solid black;
        margin: 10px;
        line-height: 30px;
    }

        .fuelTable th {
            border-bottom: 1px solid black;
        }

    .fuelName {
        font-family: Arial;
        font-size: 16px;
        font-weight: bold;
    }

    .fuelPrice {
        font-family: Arial;
        font-size: 20px;
        font-weight: bold;
        border-bottom: 1px solid black;
        text-align: center;
    }

    .effectiveTable {
        border: 1px solid black;
        font-family: Algerian;
        font-size: 18px;
        text-align: center;
        padding: 10px;
        margin: 10px;
        width: 100%;
    }

    .footerText {
        font-family: Arial;
        font-size: 20px;
        font-weight: bold;
        text-align: center;
        padding-top: 40px;
    }

    .fuelPriceMissing {
        text-indent: -9999px;
        line-height: 0;
    }

        .fuelPriceMissing:after {
            font-family: Arial;
            font-size: 20px;
            font-weight: bold;
            border-bottom: 1px solid black;
            text-align: center;
            color: red;
            display: block;
            content: 'N/A';
            text-indent: 0;
            line-height: initial;
        }

    .missingPriceMessage {
        padding-top: 20px;
        font-weight: bold;
        color: red;
    }
</style>


<table>
    <tr>
        <td colspan="2">
            <span><img style="margin-bottom: 50px; width:100%;" src="@Model.LogoRootUrl/SF-pdf-header.png" /></span>
        </td>
    </tr>
    <tr>
        <td>
            <span class="title">CURRENT UNBRANDED PRICES</span>
        </td>
        <td>&nbsp;</td>
    </tr>
</table>

<table>
    <tr>
        <td>
            <table class="fuelTable">
                <tr>
                    <th colspan="2">
                        <div> CITGO RACK PRICE</div>
                        @foreach (var item in Model.GetEffectiveTimeList("fCitgo"))
                        {
                        <div class="effTime">
                            Effective At @item
                        </div>
                        }

                    </th>
                </tr>
                <tr><td class="fuelName">(001) 87 OCT</td><td class="@Model.CitgoRackUnleadedCss">@Model.CitgoRackUnleaded</td></tr>
                <tr><td class="fuelName">&nbsp;</td></tr>
                <tr><td class="fuelName">(004) CLEAR DIESEL</td><td class="@Model.CitgoRackClearDieselCss">@Model.CitgoRackClearDiesel</td></tr>
                <tr><td class="fuelName">(006) DYED DIESEL</td><td class="@Model.CitgoRackDyedDieselCss">@Model.CitgoRackDyedDiesel</td></tr>
            </table>
        </td>
        <td>
            <table class="fuelTable">
                <tr>
                    <th colspan="2">
                        CHEVRON RACK PRICE
                        @foreach (var item in Model.GetEffectiveTimeList("fChevron"))
                        {
                        <div class="effTime">
                            Effective At @item
                        </div>
                        }
                    </th>
                </tr>
                <tr><td class="fuelName">(001) 87 OCT</td><td class="@Model.ChevronRackUnleadedCss">@Model.ChevronRackUnleaded</td></tr>
                <tr><td class="fuelName">&nbsp;</td></tr>
                @*<tr><td class="fuelName">(004) CLEAR DIESEL</td><td class="@Model.ChevronRackClearDieselCss">@Model.ChevronRackClearDiesel</td></tr>
                <tr><td class="fuelName">(006) DYED DIESEL</td><td class="@Model.ChevronRackDyedDieselCss">@Model.ChevronRackDyedDiesel</td></tr>*@
                <tr><td class="fuelName">(004) CLEAR DIESEL</td><td class="fuelPriceMissing">0</td></tr>
                <tr><td class="fuelName">(006) DYED DIESEL</td><td class="fuelPriceMissing">0</td></tr>
            </table>
        </td>
        <td>
            <table class="fuelTable">
                <tr>
                    <th colspan="2">
                        MOTIVA RACK PRICE
                        @foreach (var item in Model.GetEffectiveTimeList("fMotiva"))
                        {
                        <div class="effTime">
                            Effective At @item
                        </div>
                        }
                    </th>
                </tr>
                <tr><td class="fuelName">(001) 87 OCT</td><td class="@Model.MotivaRackUnleadedCss">@Model.MotivaRackUnleaded</td></tr>
                <tr><td class="fuelName">(005) REC 90</td><td class="@Model.MotivaRackRec90Css">@Model.MotivaRackRec90</td></tr>
                <tr><td class="fuelName">(004) CLEAR DIESEL</td><td class="@Model.MotivaRackClearDieselCss">@Model.MotivaRackClearDiesel</td></tr>
                <tr><td class="fuelName">(006) DYED DIESEL</td><td class="@Model.MotivaRackDyedDieselCss">@Model.MotivaRackDyedDiesel</td></tr>
            </table>
        </td>
    </tr>
    @*<tr>
        <td>&nbsp;</td>
        <td>&nbsp;</td>
        <td>
            <table class="effectiveTable">
                <tr><td>PRICES</td></tr>
                <tr><td>EFFECTIVE</td></tr>
                <tr><td>AT @Model.EffectiveTimeString</td></tr>
            </table>
        </td>
    </tr>*@

    @if (@Model.IsPriceMissing)
    {
        <tr><td class="missingPriceMessage" colspan="3">* Due to communication issues, we are unable to provide current prices. As soon as they become available, we will send out the price notification.</td></tr>
        @*<tr><td class="missingPriceMessage" colspan="3">** Please note displayed price is last known product price. We are currently pending price update from @("Texaco") for this specific product.</td></tr>*@
    }

    <tr><td class="footerText" colspan="3">@Model.FooterDate</td></tr>
    <tr><td colspan="3"><hr /></td></tr>
    <tr><td colspan="3">Date: @System.DateTime.Now.ToString("MMM/dd/yyyy HH:mm:ss")</td></tr>
</table>