
@model TUI.Services.DBModel.SystemSettingItem


@{var itemList = new List<DETAILITEM>();
DETAILITEM detailItem= null;
detailItem=new DETAILITEM(){   
COLUMNNAME="ID", 
AS1COLUMN=false, 
COLUMNTYPE="Hidden", 
HTMLATTRIBUTES="", 
ISREQUIRED=false, 
SORTID=100, 
VALIDATETYPE="", 
ISSHOW= true,
LABEL="ID", 
EXTENDEDPROPERTIES="",  
Disabled=false  
}; 
    itemList.Add(detailItem);
detailItem=new DETAILITEM(){   
COLUMNNAME="Type", 
AS1COLUMN=false, 
COLUMNTYPE="TextBox", 
HTMLATTRIBUTES="", 
ISREQUIRED=false, 
SORTID=200, 
VALIDATETYPE="", 
ISSHOW= true,
LABEL="Type", 
EXTENDEDPROPERTIES="",  
Disabled=false  
}; 
    itemList.Add(detailItem);
detailItem=new DETAILITEM(){   
COLUMNNAME="Category", 
AS1COLUMN=false, 
COLUMNTYPE="TextBox", 
HTMLATTRIBUTES="", 
ISREQUIRED=false, 
SORTID=300, 
VALIDATETYPE="", 
ISSHOW= true,
LABEL="Category", 
EXTENDEDPROPERTIES="",  
Disabled=false  
}; 
    itemList.Add(detailItem);
detailItem=new DETAILITEM(){   
COLUMNNAME="Json", 
AS1COLUMN=false, 
COLUMNTYPE="TextArea", 
HTMLATTRIBUTES="", 
ISREQUIRED=false, 
SORTID=400, 
VALIDATETYPE="", 
ISSHOW= true,
LABEL="Json", 
EXTENDEDPROPERTIES="{\"Rows\":20}",  
Disabled=false  
}; 
    itemList.Add(detailItem);
detailItem=new DETAILITEM(){   
COLUMNNAME="TypeFullName", 
AS1COLUMN=false, 
COLUMNTYPE="TextBox", 
HTMLATTRIBUTES="", 
ISREQUIRED=false, 
SORTID=500, 
VALIDATETYPE="", 
ISSHOW= true,
LABEL="Type Full Name", 
EXTENDEDPROPERTIES="",  
Disabled=false  
}; 
    itemList.Add(detailItem);
}


<div class="grid grid-cols-1 place-content-start gap-4 items-center">
    @foreach (var item in itemList)
    {
    if (item.COLUMNTYPE == "Hidden")
    {
    @Html.Editor(item.COLUMNNAME, item.COLUMNTYPE, new { detailItem = item, CurrentModel=Model  })
    }
    else
    {
    <div class="flex self-start items-center">

        <label class="itemLabel flex-shrink-0 text-right pr-3" style="width: 200px;">@item.LABEL</label>
        <div class="flex-grow inline-flex items-start w-full flex-column myctrl">
            @Html.Editor(item.COLUMNNAME, item.COLUMNTYPE, new { detailItem = item, CurrentModel=Model  })
        </div>
    </div>
    }
    }

</div>
  





