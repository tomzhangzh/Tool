<div class="grid grid-cols-1 place-content-start gap-4 items-center">
    @foreach (var item in itemList)
    {
        if (item.COLUMNTYPE == "Hidden")
        {
            @Html.Editor(item.COLUMNNAME, item.COLUMNTYPE, new { detailItem = item })
        }
        else
        {
            <div class="flex self-start items-center" >
               
                <label class="itemLabel flex-shrink-0 text-right pr-3"  style="width: 120px;">@item.LABEL</label>
                <div class="flex-grow inline-flex items-start w-full">
                    @Html.Editor(item.COLUMNNAME, item.COLUMNTYPE, new { detailItem = item })
                </div>
          </div>
        }
    }

</div>




