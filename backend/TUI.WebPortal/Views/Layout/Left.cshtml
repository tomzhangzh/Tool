@{
    Func<(string MenuName,string Url), Microsoft.AspNetCore.Html.IHtmlContent> addMenu = @<text>
        <li>
            <a href="javascript:void(0)" title="@item.MenuName" data-filter-tags="@item.MenuName.ToLower()" myaction-updatecontainter url="@item.Url" containter="#js-page-content">
                <span class="nav-link-text"> @item.MenuName</span>
            </a>
        </li>
    </text>;
}

<aside class="page-sidebar">
    <div class="page-logo">
        <a href="#" class="page-logo-link press-scale-down d-flex align-items-center position-relative" data-toggle="modal" data-target="#modal-shortcut">
            <img src="/img/logo.svg" alt="TUI Portal" aria-roledescription="logo">

            <span class="page-logo-text mr-1">TUI Portal</span>
            <span class="position-absolute text-white opacity-50 small pos-top pos-right mr-2 mt-n2"></span>
            <i class="fal fa-angle-down d-inline-block ml-1 fs-lg color-primary-300"></i>
        </a>
    </div>
    <!-- BEGIN PRIMARY NAVIGATION -->
    <nav id="js-primary-nav" class="primary-nav" role="navigation" data-nav-accordion="false">
        <div class="nav-filter">
            <div class="position-relative">
                <input type="text" id="nav_filter_input" placeholder="Filter menu" class="form-control" tabindex="0">
                <a href="#" onclick="return false;" class="btn-primary btn-search-close js-waves-off" data-action="toggle" data-class="list-filter-active" data-target=".page-sidebar">
                    <i class="fal fa-chevron-up"></i>
                </a>
            </div>
        </div>
        <div class="info-card">
            <img src="/img/demo/avatars/avatar-admin.png" class="profile-image rounded-circle" alt="James">
            <div class="info-card-text">
                <a href="#" class="d-flex align-items-center text-white">
                    <span class="text-truncate text-truncate-sm d-inline-block">
                        @App.CurrentUser?.UserName
                    </span>
                </a>
                @*<span class="d-inline-block text-truncate text-truncate-sm">james@webhosting.net</span>*@
            </div>
            <img src="/img/card-backgrounds/cover-2-lg.png" class="cover" alt="cover">
            <a href="#" onclick="return false;" class="pull-trigger-btn" data-action="toggle" data-class="list-filter-active" data-target=".page-sidebar" data-focus="nav_filter_input">
                <i class="fal fa-angle-down"></i>
            </a>
        </div>
        <ul id="js-nav-menu" class="nav-menu">
            <li>
                <a href="#" title="Application Intel" data-filter-tags="application intel">
                    <i class="fal fa-info-circle"></i>
                    <span class="nav-link-text" data-i18n="nav.application_intel">Application</span>
                </a>
                <ul>
                    @addMenu(("Analytics Dashboard", "/Home/ComingSoon"))
                    @addMenu(("Marketing Dashboard", "/Home/ComingSoon"))
                    @addMenu(("Introduction", "/Home/ComingSoon"))


                </ul>
            </li>

            <li class="open">
                <a href="#" title="Daily Fuel Pricing" data-filter-tags="daily fuel pricing">
                    <i class="fal fa-cog"></i>
                    <span class="nav-link-text" data-i18n="nav.theme_settings">Daily Fuel Pricing</span>
                </a>
                <ul style="display: block;">
                    @addMenu(("PriceBrand", "/Brand/PriceBrand/Index"))
                    @addMenu(("Email Recipients", "/Brand/PriceEmailRecipient/index"))
                    @addMenu(("Fax Recipients", "/Brand/PriceFaxRecipient/index"))
                    @addMenu(("SMS Recipients", "/Brand/PriceSmsRecipient/index"))
                    @addMenu(("Historical Pricing", "/Brand/HistoricalPricing/index"))
                    @addMenu(("Price History", "/Brand/PriceHistory/index"))

                </ul>
            </li>
            <li>
                <a href="#" title="Theme Settings" data-filter-tags="local taxes">
                    <i class="fal fa-map-marker-alt"></i>
                    <span class="nav-link-text" data-i18n="nav.theme_settings" myaction-updatecontainter url="/Home/ComingSoon" containter="#js-page-content">Local Taxes</span>
                </a>

            </li>
            <li>
                <a href="#" title="settings" data-filter-tags="System settings">
                    <i class="fal fa-cogs"></i>
                    <span class="nav-link-text">System Settings</span>
                </a>
                <ul style="display: block;">

                    @addMenu(("Email Template", "/Systems/EmailTemplate/Index"))
                    @addMenu(("Schedule Task", "/Task/ScheduleTask/Index"))
                    @addMenu(("System Setting Item", "/Systems/SystemSettingItem/Index"))
                    @addMenu(("Test", "/Systems/Test/Index"))
                    @addMenu(("SendEmail", "/Systems/SendEmail/Index"))
                </ul>
            </li>

            <li>
                <a href="#" title="Logs" data-filter-tags="Logs">
                    <i class="fal fa-file-alt"></i>
                    <span class="nav-link-text">Logs</span>
                </a>
                <ul style="display: block;">

                    @addMenu(("Systems Log", "/Logs/LogEvent/Index"))
                    @addMenu(("Send Grid Hook Log", "/Logs/SendGridHookLog/Index"))
                    @addMenu(("Sms Log", "/Logs/SmsLog/Index"))
                    @addMenu(("Fax Log", "/Logs/FaxLog/Index"))
                    @addMenu(("API Log", "/Logs/ApiLog/Index"))
                </ul>
            </li>
            <li class="nav-title">Reports</li>
            <li>
                <a href="#" title="Reports" data-filter-tags="Reports" myaction-updatecontainter url="/Home/ComingSoon" containter="#js-page-content">
                    <i class="fal fa-chart-pie"></i>
                    <span class="nav-link-text">Carrier Reports</span>
                </a>
                <ul>
                    <li>
                        <a href="javascript:void(0)" title="Carrier Performance" data-filter-tags="carrier performance" myaction-updatecontainter url="/Home/ComingSoon" containter="#js-page-content">
                            <span class="nav-link-text">Carrier Performance</span>
                        </a>
                    </li>
                    <li>
                        <a href="javascript:void(0)" title="Carrier Performance By Station" data-filter-tags="carrier performance by station" myaction-updatecontainter url="/Home/ComingSoon" containter="#js-page-content">
                            <span class="nav-link-text">Carrier Performance By Station</span>
                        </a>
                    </li>
                    <li>
                        <a href="javascript:void(0)" title="BOL Delivery" data-filter-tags="bol delivery" myaction-updatecontainter url="/Home/ComingSoon" containter="#js-page-content">
                            <span class="nav-link-text">BOL Delivery</span>
                        </a>
                    </li>

                </ul>
            </li>
        </ul>
        <div class="filter-message js-filter-message bg-success-600"></div>
    </nav>
    <!-- END PRIMARY NAVIGATION -->
    <!-- NAV FOOTER -->
    <div class="nav-footer shadow-top">
        <a href="#" onclick="return false;" data-action="toggle" data-class="nav-function-minify" class="hidden-md-down">
            <i class="ni ni-chevron-right"></i>
            <i class="ni ni-chevron-right"></i>
        </a>
        <ul class="list-table m-auto nav-footer-buttons">
            <li>
                <a href="javascript:void(0);" data-toggle="tooltip" data-placement="top" title="Chat logs">
                    <i class="fal fa-comments"></i>
                </a>
            </li>
            <li>
                <a href="javascript:void(0);" data-toggle="tooltip" data-placement="top" title="Support Chat">
                    <i class="fal fa-life-ring"></i>
                </a>
            </li>
            <li>
                <a href="javascript:void(0);" data-toggle="tooltip" data-placement="top" title="Make a call">
                    <i class="fal fa-phone"></i>
                </a>
            </li>
        </ul>
    </div> <!-- END NAV FOOTER -->
</aside>
