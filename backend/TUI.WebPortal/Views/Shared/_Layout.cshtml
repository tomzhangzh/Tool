    <script>
        $(() => {
            $.each(ActionHelper, function (key, f) {
                f('myaction-' + key, $("body"));
            });
            setInterval(function () {
                $.post("/Account/KeepSessionLive");
            }, 1000 * @(TUI.WebPortal.Properties.Settings.Default.KeepSessionLiveMinutes )*60);
        })
    </script>
    <div id="PublicDiv" style="display:none"></div>
