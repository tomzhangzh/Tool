@model object
@using TUI.Services.DBModel;
@using TUI.Services.Model;
@{
    DETAILITEM detailItem = null;
    if (ViewBag.detailItem != null)
    {
        detailItem = ViewBag.detailItem;
    }
    else
    {
        TUI.Services.DBModel.DETAILPAGE dPage = this.ViewBag.DetailPage;
        detailItem = dPage.DETAILITEM.First(x => x.COLUMNNAME == ViewData.ModelMetadata.PropertyName);
    }
    var extendP = detailItem.GetExtendProperty() as TUI.Services.Model.TextBoxSettingInfo;
    var HtmlAttributes = detailItem.GetHTMLATTRIBUTES();
}
@if (string.IsNullOrEmpty(extendP.AddonIconClass) && string.IsNullOrEmpty(extendP.AddonText))
{
    HtmlAttributes["class"] = "form-control " + detailItem.GetValidateClass();
    HtmlAttributes["placeholder"] = extendP.PlaceHolder;
    @Html.TextBoxFor(m => m, HtmlAttributes)
}
else
{
    HtmlAttributes["class"] = "form-control " + detailItem.GetValidateClass();
    HtmlAttributes["placeholder"] = extendP.PlaceHolder;
    <div class="input-group">

        @Html.TextBoxFor(m => m, HtmlAttributes)
        <span class="input-group-prepend">
            
            <span class="input-group-text bg-transparent border-left-0"><i class="@extendP.AddonIconClass"></i> @Html.Raw(extendP.AddonText)</span>
            
        </span>
    </div>
  
}
