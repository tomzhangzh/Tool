<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] ?? "VueLib V3 低代码平台"</title>
    <!-- Tailwind CSS (play CDN alternative, local build with preflight disabled) -->
    <link rel="stylesheet" href="~/css/tailwind.css" />
    <!-- Element Plus CSS -->
    <link rel="stylesheet" href="~/lib/element-plus.full.min.css" onerror="this.onerror=null;this.href='https://unpkg.com/element-plus/dist/index.css'" />
    <style>
        body { margin: 0; font-family: "Helvetica Neue", Helvetica, "PingFang SC", "Microsoft YaHei", sans-serif; }
        .dyn-loading { padding: 20px; text-align: center; color: #909399; }
        [dyn-init] { min-height: 1px; }
    </style>
</head>
<body>
    @RenderBody()

    <!-- Vendor UMD -->
    <script src="~/lib/vue.global.prod.js"></script>
    <script src="~/lib/lodash.min.js"></script>
    <script src="~/lib/element-plus.full.min.js"></script>
    <script src="~/lib/element-plus-icons.min.js"></script>
    <script src="~/lib/sortable/sortable.min.js"></script>

    <!-- dyn framework (no build step, UMD) -->
    <script src="~/js/dyn-core.js"></script>
    <script src="~/js/dyn-actionhelper.js"></script>
    <script src="~/js/dyn-loader.js"></script>
    <script src="~/js/dyn-com.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
