@{
    ViewData["Title"] = "组件元数据管理";
    Layout = "_Layout";
}
<div id="app" style="padding:20px;">
    <el-page-header @@back="goBack" content="组件元数据管理">
        <template #extra>
            <el-button type="primary" @@click="add">+ 新增组件</el-button>
        </template>
    </el-page-header>

    <el-card style="margin-top:16px;">
        <el-form inline>
            <el-form-item label="关键字">
                <el-input v-model="keyword" placeholder="ComponentName / Label" clearable @@keyup.enter="load" ></el-input>
            </el-form-item>
            <el-form-item>
                <el-button type="primary" @@click="load">查询</el-button>
            </el-form-item>
        </el-form>

        <el-table :data="rows" border stripe style="width:100%;">
            <el-table-column prop="componentName" label="ComponentName" min-width="160" show-overflow-tooltip ></el-table-column>
            <el-table-column prop="label" label="Label" min-width="120" show-overflow-tooltip ></el-table-column>
            <el-table-column prop="category" label="Category" width="100" ></el-table-column>
            <el-table-column prop="uiLibrary" label="UiLibrary" width="100" ></el-table-column>
            <el-table-column label="容器" width="70">
                <template #default="scope">
                    <el-tag v-if="scope.row.isContainer" type="success" size="small">是</el-tag>
                    <span v-else style="color:#c0c4cc">-</span>
                </template>
            </el-table-column>
            <el-table-column label="组合" width="70">
                <template #default="scope">
                    <el-tag v-if="scope.row.isComposite" type="warning" size="small">是</el-tag>
                    <span v-else style="color:#c0c4cc">-</span>
                </template>
            </el-table-column>
            <el-table-column prop="sortOrder" label="Sort" width="70" ></el-table-column>
            <el-table-column label="启用" width="80">
                <template #default="scope">
                    <el-tag :type="scope.row.isEnabled ? 'success' : 'info'" size="small">
                        {{ scope.row.isEnabled ? '启用' : '禁用' }}
                    </el-tag>
                </template>
            </el-table-column>
            <el-table-column label="操作" width="140" fixed="right">
                <template #default="scope">
                    <el-button size="small" @@click="edit(scope.row)">编辑</el-button>
                    <el-button size="small" type="danger" @@click="del(scope.row)">删除</el-button>
                </template>
            </el-table-column>
        </el-table>

        <el-pagination style="margin-top:12px;" background
                       layout="total, sizes, prev, pager, next, jumper"
                       :total="total" :page-size="size" :current-page="page"
                       :page-sizes="[10, 20, 50, 100]"
                       @@current-change="onPageChange" @@size-change="onSizeChange" ></el-pagination>
    </el-card>

    <el-dialog v-model="dialogVisible" :title="editing.id ? '编辑组件' : '新增组件'" width="780px" top="6vh">
        <el-form :model="editing" label-width="120px">
            <el-row :gutter="16">
                <el-col :span="12">
                    <el-form-item label="ComponentName">
                        <el-input v-model="editing.componentName" placeholder="如 DynNInput" ></el-input>
                    </el-form-item>
                </el-col>
                <el-col :span="12">
                    <el-form-item label="Label">
                        <el-input v-model="editing.label" ></el-input>
                    </el-form-item>
                </el-col>
            </el-row>
            <el-row :gutter="16">
                <el-col :span="12">
                    <el-form-item label="Category">
                        <el-select v-model="editing.category" style="width:100%;">
                            <el-option label="表单" value="表单" ></el-option>
                            <el-option label="布局" value="布局" ></el-option>
                            <el-option label="展示" value="展示" ></el-option>
                            <el-option label="通用" value="通用" ></el-option>
                            <el-option label="组合" value="组合" ></el-option>
                        </el-select>
                    </el-form-item>
                </el-col>
                <el-col :span="12">
                    <el-form-item label="UiLibrary">
                        <el-input v-model="editing.uiLibrary" placeholder="element / layui / native / custom" ></el-input>
                    </el-form-item>
                </el-col>
            </el-row>
            <el-form-item label="LoadUrl">
                <el-input v-model="editing.loadUrl" placeholder="如 /Areas/Components/Views/Data/DynNInput.cshtml" ></el-input>
            </el-form-item>
            <el-form-item label="DefaultConfigJson">
                <el-input v-model="editing.defaultConfigJson" type="textarea" :rows="4"
                          placeholder='{{ "{\\"label\\":\\"姓名\\",\\"required\\":true}" }}' ></el-input>
            </el-form-item>
            <el-form-item label="PropertyConfigJson">
                <el-input v-model="editing.propertyConfigJson" type="textarea" :rows="6" ></el-input>
            </el-form-item>
            <el-row :gutter="16">
                <el-col :span="8">
                    <el-form-item label="IsContainer">
                        <el-switch v-model="editing.isContainer" ></el-switch>
                    </el-form-item>
                </el-col>
                <el-col :span="8">
                    <el-form-item label="IsComposite">
                        <el-switch v-model="editing.isComposite" ></el-switch>
                    </el-form-item>
                </el-col>
                <el-col :span="8">
                    <el-form-item label="IsEnabled">
                        <el-switch v-model="editing.isEnabled" ></el-switch>
                    </el-form-item>
                </el-col>
            </el-row>
            <el-row :gutter="16">
                <el-col :span="12">
                    <el-form-item label="Icon">
                        <el-input v-model="editing.icon" ></el-input>
                    </el-form-item>
                </el-col>
                <el-col :span="12">
                    <el-form-item label="SortOrder">
                        <el-input-number v-model="editing.sortOrder" :min="0" ></el-input-number>
                    </el-form-item>
                </el-col>
            </el-row>
        </el-form>
        <template #footer>
            <el-button @@click="dialogVisible = false">取消</el-button>
            <el-button type="primary" @@click="save">保存</el-button>
        </template>
    </el-dialog>
</div>

@section Scripts {
<script>
const { createApp, ref, reactive, onMounted } = Vue;
createApp({
    setup() {
        const rows = ref([]);
        const total = ref(0);
        const page = ref(1);
        const size = ref(20);
        const keyword = ref('');
        const dialogVisible = ref(false);
        const editing = reactive({});

        async function load() {
            const url = `/api/admin/components?page=${page.value}&size=${size.value}&keyword=${encodeURIComponent(keyword.value || '')}`;
            const res = await fetch(url);
            const json = await res.json();
            if (json.success) {
                rows.value = json.data.rows || [];
                total.value = json.data.total || 0;
            } else {
                ElementPlus.ElMessage.error(json.message || '加载失败');
            }
        }
        function onPageChange(p) { page.value = p; load(); }
        function onSizeChange(s) { size.value = s; page.value = 1; load(); }

        function add() {
            Object.assign(editing, {
                id: 0, componentName: '', label: '', category: '通用', uiLibrary: 'element',
                icon: '', loadUrl: '', defaultConfigJson: '', propertyConfigJson: '',
                isContainer: false, isComposite: false, isEnabled: true, sortOrder: 0
            });
            dialogVisible.value = true;
        }
        function edit(row) {
            Object.keys(editing).forEach(k => delete editing[k]);
            Object.assign(editing, row);
            dialogVisible.value = true;
        }
        async function save() {
            if (!editing.componentName) { ElementPlus.ElMessage.warning('请填写 ComponentName'); return; }
            const res = await fetch('/api/admin/components', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(editing)
            });
            const json = await res.json();
            if (json.success) {
                ElementPlus.ElMessage.success('保存成功');
                dialogVisible.value = false;
                load();
            } else {
                ElementPlus.ElMessage.error(json.message || '保存失败');
            }
        }
        function del(row) {
            ElementPlus.ElMessageBox.confirm(`确认删除组件「${row.componentName}」？`, '提示', { type: 'warning' }).then(async () => {
                const res = await fetch('/api/admin/components/delete', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(row.id)
                });
                const json = await res.json();
                if (json.success) { ElementPlus.ElMessage.success('删除成功'); load(); }
                else ElementPlus.ElMessage.error(json.message || '删除失败');
            }).catch(() => {});
        }
        function goBack() { window.location.href = '/demo'; }

        onMounted(load);
        return { rows, total, page, size, keyword, dialogVisible, editing, load, onPageChange, onSizeChange, add, edit, save, del, goBack };
    }
}).use(ElementPlus).mount('#app');
</script>
}
