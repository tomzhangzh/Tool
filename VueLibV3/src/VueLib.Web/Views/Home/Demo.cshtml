@{
    ViewData["Title"] = "Demo 汇总";
    Layout = "_Layout";
}
<div id="app" style="padding:20px;">
    <h2>📋 Demo 页面</h2>
    <p style="color:#909399;">VueLib V3 低代码平台 · 各能力点现场可点的演示集合</p>

    <el-row :gutter="16" style="margin-top:16px;">
        <el-col :span="8" v-for="d in demos" :key="d.url">
            <el-card shadow="hover" style="cursor:pointer;margin-bottom:16px;" @@click="go(d.url)">
                <div style="text-align:center;padding:10px 0;">
                    <div style="font-size:28px;">{{ d.icon }}</div>
                    <div style="margin-top:8px;font-weight:bold;">{{ d.name }}</div>
                    <div style="font-size:12px;color:#909399;margin-top:4px;">{{ d.desc }}</div>
                </div>
            </el-card>
        </el-col>
    </el-row>

    <el-divider>Platform 管理</el-divider>
    <el-row :gutter="16">
        <el-col :span="8" v-for="p in platforms" :key="p.url">
            <el-card shadow="hover" style="cursor:pointer;margin-bottom:16px;" @@click="go(p.url)">
                <div style="text-align:center;padding:10px 0;">
                    <div style="font-size:28px;">{{ p.icon }}</div>
                    <div style="margin-top:8px;font-weight:bold;">{{ p.name }}</div>
                    <div style="font-size:12px;color:#909399;margin-top:4px;">{{ p.desc }}</div>
                </div>
            </el-card>
        </el-col>
    </el-row>

    <el-button @@click="go('/')">🏠 返回桌面</el-button>
</div>
@section Scripts {
<script>
const { createApp, ref } = Vue;
createApp({
    setup() {
        const demos = ref([
            { name: 'ActionHelper Demo', icon: '⚡', desc: '测试所有内置动作（Post/Get/Open/Close/Reload/...）', url: '/demo/actionhelper' },
            { name: 'Chain Editor', icon: '🔗', desc: '动作链可视化拖拽编排 + JSON 输出 + 预览执行', url: '/demo/chain-editor' },
            { name: '组合组件 Demo', icon: '🧩', desc: 'DynCompositeName / Grid 跨列 / 开放 slot', url: '/demo/composite' },
            { name: 'WebPage Demo', icon: '📄', desc: '模板选择 + 参数表单 + 动态渲染', url: '/demo/webpage' },
            { name: 'CRUD 三屏 Demo', icon: '🗂️', desc: 'Teachers 表 filter/list/detail 三屏联动', url: '/demo/crud' }
        ]);
        const platforms = ref([
            { name: '组件管理', icon: '🧱', desc: '/Platform/Component', url: '/Platform/Component' },
            { name: '动作管理', icon: '⚙️', desc: '/Platform/ActionHelper', url: '/Platform/ActionHelper' },
            { name: '模板管理', icon: '📐', desc: '/Platform/Template', url: '/Platform/Template' },
            { name: '页面管理', icon: '📃', desc: '/Platform/WebPage', url: '/Platform/WebPage' },
            { name: '字典管理', icon: '📚', desc: '/Platform/Dict', url: '/Platform/Dict' },
            { name: '设计器', icon: '🎨', desc: '/designer', url: '/designer' }
        ]);
        function go(url) { window.location.href = url; }
        return { demos, platforms, go };
    }
}).use(ElementPlus).mount('#app');
</script>
}
