@{
    ViewData["Title"] = "模板管理";
    Layout = "_Layout";
}
<div id="app" style="padding:20px;">
    <el-page-header @@back="goBack" content="模板管理">
        <template #extra>
            <el-button type="primary" @@click="add">+ 新增模板</el-button>
        </template>
    </el-page-header>

    <el-card style="margin-top:16px;">
        <el-table :data="rows" border stripe style="width:100%;">
            <el-table-column prop="name" label="Name" min-width="140" show-overflow-tooltip ></el-table-column>
            <el-table-column prop="code" label="Code" min-width="130" show-overflow-tooltip ></el-table-column>
            <el-table-column prop="templateType" label="TemplateType" width="110" ></el-table-column>
            <el-table-column prop="renderView" label="RenderView" min-width="160" show-overflow-tooltip ></el-table-column>
            <el-table-column prop="sortOrder" label="Sort" width="70" ></el-table-column>
            <el-table-column label="启用" width="80">
                <template #default="scope">
                    <el-tag :type="scope.row.isEnabled ? 'success' : 'info'" size="small">
                        {{ scope.row.isEnabled ? '启用' : '禁用' }}
                    </el-tag>
                </template>
            </el-table-column>
            <el-table-column label="操作" width="140" fixed="right">
                <template #default="scope">
                    <el-button size="small" @@click="edit(scope.row)">编辑</el-button>
                    <el-button size="small" type="danger" @@click="del(scope.row)">删除</el-button>
                </template>
            </el-table-column>
        </el-table>

        <el-pagination style="margin-top:12px;" background
                       layout="total, sizes, prev, pager, next, jumper"
                       :total="total" :page-size="size" :current-page="page"
                       :page-sizes="[10, 20, 50, 100]"
                       @@current-change="onPageChange" @@size-change="onSizeChange" ></el-pagination>
    </el-card>

    <el-dialog v-model="dialogVisible" :title="editing.id ? '编辑模板' : '新增模板'" width="780px" top="6vh">
        <el-form :model="editing" label-width="120px">
            <el-row :gutter="16">
                <el-col :span="12">
                    <el-form-item label="Name">
                        <el-input v-model="editing.name" ></el-input>
                    </el-form-item>
                </el-col>
                <el-col :span="12">
                    <el-form-item label="Code">
                        <el-input v-model="editing.code" placeholder="如 crud-list" ></el-input>
                    </el-form-item>
                </el-col>
            </el-row>
            <el-row :gutter="16">
                <el-col :span="12">
                    <el-form-item label="TemplateType">
                        <el-select v-model="editing.templateType" style="width:100%;">
                            <el-option label="CrudList" value="CrudList" ></el-option>
                            <el-option label="TreeList" value="TreeList" ></el-option>
                            <el-option label="HomeGrid" value="HomeGrid" ></el-option>
                            <el-option label="Custom" value="Custom" ></el-option>
                        </el-select>
                    </el-form-item>
                </el-col>
                <el-col :span="12">
                    <el-form-item label="RenderView">
                        <el-input v-model="editing.renderView" placeholder="cshtml 视图名" ></el-input>
                    </el-form-item>
                </el-col>
            </el-row>
            <el-form-item label="Description">
                <el-input v-model="editing.description" ></el-input>
            </el-form-item>
            <el-form-item label="ParamSchema">
                <el-input v-model="editing.paramSchema" type="textarea" :rows="6"
                          placeholder='{{ "[{\"key\":\"tableName\",\"label\":\"业务表\",\"type\":\"input\",\"required\":true}]" }}' ></el-input>
            </el-form-item>
            <el-form-item label="DefaultConfig">
                <el-input v-model="editing.defaultConfig" type="textarea" :rows="6" ></el-input>
            </el-form-item>
            <el-row :gutter="16">
                <el-col :span="12">
                    <el-form-item label="SortOrder">
                        <el-input-number v-model="editing.sortOrder" :min="0" ></el-input-number>
                    </el-form-item>
                </el-col>
                <el-col :span="12">
                    <el-form-item label="IsEnabled">
                        <el-switch v-model="editing.isEnabled" ></el-switch>
                    </el-form-item>
                </el-col>
            </el-row>
        </el-form>
        <template #footer>
            <el-button @@click="dialogVisible = false">取消</el-button>
            <el-button type="primary" @@click="save">保存</el-button>
        </template>
    </el-dialog>
</div>

@section Scripts {
<script>
const { createApp, ref, reactive, onMounted } = Vue;
createApp({
    setup() {
        const rows = ref([]);
        const total = ref(0);
        const page = ref(1);
        const size = ref(20);
        const dialogVisible = ref(false);
        const editing = reactive({});

        async function load() {
            const url = `/api/admin/templates?page=${page.value}&size=${size.value}`;
            const res = await fetch(url);
            const json = await res.json();
            if (json.success) {
                rows.value = json.data.rows || [];
                total.value = json.data.total || 0;
            } else {
                ElementPlus.ElMessage.error(json.message || '加载失败');
            }
        }
        function onPageChange(p) { page.value = p; load(); }
        function onSizeChange(s) { size.value = s; page.value = 1; load(); }

        function add() {
            Object.assign(editing, {
                id: 0, name: '', code: '', templateType: 'Custom', renderView: '',
                description: '', paramSchema: '', defaultConfig: '', sortOrder: 0, isEnabled: true
            });
            dialogVisible.value = true;
        }
        function edit(row) {
            Object.keys(editing).forEach(k => delete editing[k]);
            Object.assign(editing, row);
            dialogVisible.value = true;
        }
        async function save() {
            if (!editing.name || !editing.code) { ElementPlus.ElMessage.warning('请填写 Name 和 Code'); return; }
            const res = await fetch('/api/admin/templates', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(editing)
            });
            const json = await res.json();
            if (json.success) {
                ElementPlus.ElMessage.success('保存成功');
                dialogVisible.value = false;
                load();
            } else {
                ElementPlus.ElMessage.error(json.message || '保存失败');
            }
        }
        function del(row) {
            ElementPlus.ElMessageBox.confirm(`确认删除模板「${row.name}」？`, '提示', { type: 'warning' }).then(async () => {
                const res = await fetch('/api/admin/templates/delete', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(row.id)
                });
                const json = await res.json();
                if (json.success) { ElementPlus.ElMessage.success('删除成功'); load(); }
                else ElementPlus.ElMessage.error(json.message || '删除失败');
            }).catch(() => {});
        }
        function goBack() { window.location.href = '/demo'; }

        onMounted(load);
        return { rows, total, page, size, dialogVisible, editing, load, onPageChange, onSizeChange, add, edit, save, del, goBack };
    }
}).use(ElementPlus).mount('#app');
</script>
}
