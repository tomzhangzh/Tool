@{
    ViewData["Title"] = "VueLib V3 桌面";
    Layout = "_Layout";
}
<div id="app" style="padding:20px;">
    <h2 style="margin-bottom:16px;">🖥️ VueLib V3 低代码平台</h2>
    <el-row :gutter="16">
        <el-col :span="4" v-for="sc in shortcuts" :key="sc.id">
            <el-card shadow="hover" style="cursor:pointer;margin-bottom:16px;" @@click="openShortcut(sc)">
                <div style="text-align:center;padding:10px 0;">
                    <div style="font-size:32px;">{{ sc.icon || '📄' }}</div>
                    <div style="margin-top:8px;">{{ sc.name }}</div>
                </div>
            </el-card>
        </el-col>
    </el-row>
    <el-divider></el-divider>
    <p><el-button type="primary" @@click="go('/designer')">🎨 设计器</el-button>
       <el-button @@click="go('/demo')">📋 Demo 汇总</el-button>
       <el-button @@click="go('/Runtime/DynCrud/Tables')">🗃️ 业务表</el-button></p>
</div>

@section Scripts {
<script>
const { createApp, ref, onMounted } = Vue;
createApp({
    setup() {
        const shortcuts = ref(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.Solutions)));
        function openShortcut(sc) { window.location.href = sc.url; }
        function go(url) { window.location.href = url; }
        return { shortcuts, openShortcut, go };
    }
}).use(ElementPlus).mount('#app');
</script>
}
