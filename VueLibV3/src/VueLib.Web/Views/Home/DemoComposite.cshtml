@{
    ViewData["Title"] = "组合组件 Demo";
    Layout = "_Layout";
}
<div id="app" style="padding:20px;">
    <h2>🧩 组合组件 Demo</h2>
    <p style="color:#909399;">展示 DynCompositeName（双输入并排）、Grid 跨列布局、开放 slot（footer 自定义内容）。</p>

    <!-- 1. DynCompositeName：firstname + lastname 并排 -->
    <el-card style="margin-top:16px;">
        <template #header>① DynCompositeName（firstname + lastname 两个 input 并排）</template>
        <div style="display:flex;gap:12px;align-items:center;">
            <el-input v-model="name.first" placeholder="名 (First Name)" style="flex:1;" ></el-input>
            <span style="color:#909399;">+</span>
            <el-input v-model="name.last" placeholder="姓 (Last Name)" style="flex:1;" ></el-input>
            <el-tag style="margin-left:8px;">全名: {{ fullName }}</el-tag>
        </div>
        <div style="margin-top:10px;color:#606266;font-size:13px;">
            组合组件内部由两个 el-input 组成，外部通过 openProps 传入 v-model 绑定值。
        </div>
    </el-card>

    <!-- 2. Grid 跨列布局 -->
    <el-card style="margin-top:16px;">
        <template #header>② Grid 跨列布局（父容器 grid + 子元素 col-span-2）</template>
        <div :style="gridStyle">
            <el-card shadow="never" class="col-span-1" style="background:#ecf5ff;">
                <p style="margin:0;text-align:center;">col-span-1（左）</p>
            </el-card>
            <el-card shadow="never" class="col-span-1" style="background:#f0f9eb;">
                <p style="margin:0;text-align:center;">col-span-1（右）</p>
            </el-card>
            <el-card shadow="never" class="col-span-2" style="background:#fef0f0;grid-column:span 2;">
                <p style="margin:0;text-align:center;">col-span-2（跨两列，整行）</p>
            </el-card>
            <el-card shadow="never" class="col-span-1" style="background:#fdf6ec;">
                <p style="margin:0;text-align:center;">col-span-1</p>
            </el-card>
            <el-card shadow="never" class="col-span-1" style="background:#f4f4f5;">
                <p style="margin:0;text-align:center;">col-span-1</p>
            </el-card>
        </div>
        <div style="margin-top:10px;color:#606266;font-size:13px;">
            父容器 style: <code>{ display:'grid', gridTemplateColumns:'1fr 1fr', gap:'16px' }</code>；
            跨列子元素 class: <code>col-span-2</code> + 内联 <code>grid-column: span 2</code>。
        </div>
    </el-card>

    <!-- 3. 开放 slot（footer 自定义内容） -->
    <el-card style="margin-top:16px;">
        <template #header>③ 开放 Slot（footer 区域自定义内容）</template>
        <el-card shadow="hover" style="border:1px dashed #409eff;">
            <template #header>内置卡片头部（组件自带）</template>
            <p>这是组合组件的主体内容，由组件内部渲染。</p>
            <p>下方 footer 区域是开放 slot，外部可以传入任意内容：</p>
            <div style="margin-top:12px;padding:10px;background:#f5f7fa;border-radius:4px;border:1px dashed #c0c4cc;">
                <strong>📌 开放 slot = footer：</strong>
                <el-button size="small" type="primary" @@click="onSlotAction">外部传入的按钮 1</el-button>
                <el-button size="small" @@click="onSlotAction">外部传入的按钮 2</el-button>
                <span style="margin-left:10px;color:#909399;font-size:12px;">（这段内容由宿主页面注入，组件本身不关心）</span>
            </div>
        </el-card>
    </el-card>

    <el-button style="margin-top:16px;" @@click="goBack">← 返回 Demo 汇总</el-button>
</div>

@section Scripts {
<script>
const { createApp, ref, reactive, computed } = Vue;
createApp({
    setup() {
        const name = reactive({ first: '三', last: '张' });
        const fullName = computed(() => (name.last || '') + (name.first || ''));
        const gridStyle = {
            display: 'grid',
            gridTemplateColumns: '1fr 1fr',
            gap: '16px'
        };
        function onSlotAction() { ElementPlus.ElMessage.success('点击了 slot 中的外部按钮'); }
        function goBack() { window.location.href = '/demo'; }
        return { name, fullName, gridStyle, onSlotAction, goBack };
    }
}).use(ElementPlus).mount('#app');
</script>
}
