@{
    ViewData["Title"] = "WebPage Demo";
    Layout = "_Layout";
}
<div id="app" style="padding:20px;">
    <h2>📄 WebPage Demo（模板选择 + 参数 + 动态渲染）</h2>
    <p style="color:#909399;">选模板 → 填参数 → 渲染页面。下方按所选模板动态生成布局。</p>

    <!-- 顶部：模板选择 -->
    <el-card style="margin-top:16px;">
        <template #header>① 选择模板</template>
        <el-form :model="params" inline>
            <el-form-item label="模板">
                <el-select v-model="tpl" placeholder="请选择模板" @@change="onTplChange" style="width:220px;">
                    <el-option label="CRUD 列表" value="crud-list" ></el-option>
                    <el-option label="左树右列表" value="tree-list" ></el-option>
                    <el-option label="九宫格" value="grid9" ></el-option>
                    <el-option label="自定义" value="custom" ></el-option>
                </el-select>
            </el-form-item>
        </el-form>
    </el-card>

    <!-- 模板参数表单 -->
    <el-card style="margin-top:16px;" v-if="tpl">
        <template #header>② 模板参数（按模板类型显示）</template>

        <!-- CRUD 列表参数 -->
        <el-form v-if="tpl === 'crud-list'" :model="params" inline>
            <el-form-item label="表名">
                <el-select v-model="params.tableName" style="width:160px;">
                    <el-option label="Student" value="Student" ></el-option>
                    <el-option label="Teachers" value="Teachers" ></el-option>
                </el-select>
            </el-form-item>
            <el-form-item label="每页条数">
                <el-input-number v-model="params.pageSize" :min="3" :max="50" ></el-input-number>
            </el-form-item>
            <el-form-item label="关键字列">
                <el-input v-model="params.keywordColumns" placeholder="Name,ClassName" style="width:200px;" ></el-input>
            </el-form-item>
        </el-form>

        <!-- 左树右列表参数 -->
        <el-form v-else-if="tpl === 'tree-list'" :model="params" inline>
            <el-form-item label="树数据源">
                <el-select v-model="params.treeSource" style="width:160px;">
                    <el-option label="班级" value="ClassName" ></el-option>
                    <el-option label="学科" value="Subject" ></el-option>
                    <el-option label="性别" value="Gender" ></el-option>
                </el-select>
            </el-form-item>
            <el-form-item label="右侧表">
                <el-select v-model="params.tableName" style="width:160px;">
                    <el-option label="Student" value="Student" ></el-option>
                    <el-option label="Teachers" value="Teachers" ></el-option>
                </el-select>
            </el-form-item>
        </el-form>

        <!-- 九宫格参数 -->
        <el-form v-else-if="tpl === 'grid9'" :model="params" inline>
            <el-form-item label="每格图标">
                <el-input v-model="params.icon" placeholder="🏠" style="width:100px;" ></el-input>
            </el-form-item>
            <el-form-item label="标题前缀">
                <el-input v-model="params.titlePrefix" placeholder="菜单" ></el-input>
            </el-form-item>
            <el-form-item label="数量">
                <el-input-number v-model="params.count" :min="3" :max="24" ></el-input-number>
            </el-form-item>
        </el-form>

        <!-- 自定义参数 -->
        <el-form v-else :model="params" inline>
            <el-form-item label="自定义 HTML">
                <el-input v-model="params.html" type="textarea" :rows="3" style="width:400px;" placeholder="<p>任意 HTML</p>" />
            </el-form-item>
        </el-form>

        <el-button type="primary" @@click="renderPage" style="margin-top:8px;">🚀 渲染页面</el-button>
    </el-card>

    <!-- ③ 渲染结果区 -->
    <el-card style="margin-top:16px;" v-if="rendered">
        <template #header>③ 渲染结果（模板: {{ tpl }}）</template>

        <!-- CRUD 列表渲染 -->
        <div v-if="tpl === 'crud-list'">
            <el-form :model="filter" inline style="margin-bottom:10px;">
                <el-form-item label="关键字">
                    <el-input v-model="filter.keyword" placeholder="模糊搜索" clearable ></el-input>
                </el-form-item>
                <el-form-item>
                    <el-button type="primary" @@click="searchCrud">🔍 查询</el-button>
                    <el-button type="success" @@click="openEdit(null)">➕ 新增</el-button>
                </el-form-item>
            </el-form>
            <el-table :data="rows" border stripe>
                <el-table-column v-for="col in crudCols" :key="col.prop" :prop="col.prop" :label="col.label" ></el-table-column>
                <el-table-column label="操作" width="150" fixed="right">
                    <template #default="scope">
                        <el-button size="small" @@click="openEdit(scope.row)">编辑</el-button>
                        <el-button size="small" type="danger" @@click="delRow(scope.row)">删除</el-button>
                    </template>
                </el-table-column>
            </el-table>
            <el-pagination style="margin-top:12px;" background layout="total, prev, pager, next"
                           :total="total" :page-size="params.pageSize" :current-page="pageIndex"
                           @@current-change="onPage" ></el-pagination>
        </div>

        <!-- 左树右列表渲染 -->
        <div v-else-if="tpl === 'tree-list'" style="display:flex;gap:16px;">
            <el-card style="width:220px;">
                <template #header>树（{{ params.treeSource }}）</template>
                <div v-for="n in treeNodes" :key="n"
                     @@click="pickNode(n)"
                     :style="{padding:'8px 10px',margin:'3px 0',cursor:'pointer',background: activeNode===n?'#ecf5ff':'#f5f7fa',borderRadius:'4px'}">
                    📁 {{ n }}
                </div>
            </el-card>
            <el-card style="flex:1;">
                <template #header>右侧列表（{{ activeNode || '全部' }}）</template>
                <el-table :data="rows" border stripe>
                    <el-table-column v-for="col in crudCols" :key="col.prop" :prop="col.prop" :label="col.label" ></el-table-column>
                </el-table>
            </el-card>
        </div>

        <!-- 九宫格渲染 -->
        <div v-else-if="tpl === 'grid9'" style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px;">
            <el-card v-for="i in params.count" :key="i" shadow="hover" style="cursor:pointer;text-align:center;"
                     @@click="onGridClick(i)">
                <div style="font-size:32px;">{{ params.icon || '🏠' }}</div>
                <div style="margin-top:6px;">{{ params.titlePrefix || '菜单' }} {{ i }}</div>
            </el-card>
        </div>

        <!-- 自定义渲染 -->
        <div v-else>
            <div v-html="params.html || '<p style=\'color:#909399;\'>请输入 HTML</p>'"></div>
        </div>
    </el-card>

    <!-- CRUD 编辑对话框 -->
    <el-dialog v-model="dialogVisible" :title="editing.Id ? '编辑' : '新增'" width="480px">
        <el-form :model="editing" label-width="80px">
            <el-form-item v-for="col in editCols" :key="col" :label="col">
                <el-input v-model="editing[col]" ></el-input>
            </el-form-item>
        </el-form>
        <template #footer>
            <el-button @@click="dialogVisible = false">取消</el-button>
            <el-button type="primary" @@click="doSave">保存</el-button>
        </template>
    </el-dialog>

    <el-button style="margin-top:16px;" @@click="goBack">← 返回 Demo 汇总</el-button>
</div>

@section Scripts {
<script>
const { createApp, ref, reactive, computed, onMounted } = Vue;
createApp({
    setup() {
        const { ElMessage, ElMessageBox } = ElementPlus;
        const tpl = ref('');
        const rendered = ref(false);
        const params = reactive({
            tableName: 'Student', pageSize: 5, keywordColumns: 'Name,ClassName',
            treeSource: 'ClassName', icon: '🏠', titlePrefix: '菜单', count: 9,
            html: '<p>这是一段自定义 HTML</p><el-button type="primary">我是按钮</el-button>'
        });
        const filter = reactive({ keyword: '' });
        const rows = ref([]);
        const total = ref(0);
        const pageIndex = ref(1);
        const treeNodes = ref([]);
        const activeNode = ref('');
        const dialogVisible = ref(false);
        const editing = reactive({});

        const crudCols = computed(() => {
            if (params.tableName === 'Teachers')
                return [
                    { prop: 'Id', label: 'ID' }, { prop: 'Name', label: '姓名' },
                    { prop: 'Gender', label: '性别' }, { prop: 'Age', label: '年龄' },
                    { prop: 'Phone', label: '电话' }, { prop: 'Subject', label: '学科' },
                    { prop: 'Title', label: '职称' }
                ];
            return [
                { prop: 'Id', label: 'ID' }, { prop: 'Name', label: '姓名' },
                { prop: 'Age', label: '年龄' }, { prop: 'Gender', label: '性别' },
                { prop: 'ClassName', label: '班级' }, { prop: 'Score', label: '分数' }
            ];
        });
        const editCols = computed(() => crudCols.value.filter(c => c.prop !== 'Id').map(c => c.prop));

        function onTplChange() { rendered.value = false; rows.value = []; }

        async function loadCrud() {
            const keywordCols = (params.keywordColumns || '').split(',').map(s => s.trim()).filter(Boolean);
            const res = await fetch('/Runtime/DynCrud/Query?projectId=1', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    tableName: params.tableName,
                    filter: activeNode.value ? { [params.treeSource]: activeNode.value } : {},
                    keyword: filter.keyword || undefined,
                    keywordColumns: keywordCols,
                    pageIndex: pageIndex.value, pageSize: params.pageSize
                })
            });
            const json = await res.json();
            if (json.success) { rows.value = json.data.rows; total.value = json.data.totalCount; }
        }
        async function loadTree() {
            // 拉一批数据抽 distinct 值当树节点
            const res = await fetch('/Runtime/DynCrud/Query?projectId=1', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ tableName: params.tableName, pageIndex: 1, pageSize: 100 })
            });
            const json = await res.json();
            if (json.success) {
                const set = new Set(json.data.rows.map(r => r[params.treeSource]).filter(Boolean));
                treeNodes.value = Array.from(set);
            }
        }
        function renderPage() {
            rendered.value = true;
            pageIndex.value = 1; activeNode.value = '';
            if (tpl.value === 'crud-list' || tpl.value === 'tree-list') {
                loadCrud();
                if (tpl.value === 'tree-list') loadTree();
            }
            ElMessage.success('已渲染模板: ' + tpl.value);
        }
        function searchCrud() { pageIndex.value = 1; loadCrud(); }
        function onPage(p) { pageIndex.value = p; loadCrud(); }
        function pickNode(n) { activeNode.value = n; loadCrud(); }
        function onGridClick(i) { ElMessage.info('点击了第 ' + i + ' 格'); }
        function openEdit(row) {
            const blank = {};
            editCols.value.forEach(c => blank[c] = '');
            Object.assign(editing, row || Object.assign({ Id: 0 }, blank));
            dialogVisible.value = true;
        }
        async function doSave() {
            const res = await fetch('/Runtime/DynCrud/Save?projectId=1', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ tableName: params.tableName, data: { ...editing } })
            });
            const json = await res.json();
            if (json.success) { ElMessage.success('保存成功'); dialogVisible.value = false; loadCrud(); }
            else ElMessage.error(json.message);
        }
        function delRow(row) {
            ElMessageBox.confirm('确认删除?', '警告', { type: 'warning' }).then(async () => {
                const res = await fetch('/Runtime/DynCrud/Delete?projectId=1', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ tableName: params.tableName, id: row.Id })
                });
                const json = await res.json();
                if (json.success) { ElMessage.success('删除成功'); loadCrud(); }
                else ElMessage.error(json.message);
            }).catch(() => {});
        }
        function goBack() { window.location.href = '/demo'; }

        return {
            tpl, rendered, params, filter, rows, total, pageIndex,
            treeNodes, activeNode, dialogVisible, editing, crudCols, editCols,
            onTplChange, renderPage, searchCrud, onPage, pickNode, onGridClick,
            openEdit, doSave, delRow, goBack
        };
    }
}).use(ElementPlus).mount('#app');
</script>
}
