@{
    ViewData["Title"] = "Chain Editor";
    Layout = "_Layout";
}
<div id="app" style="padding:20px;">
    <h2>🔗 Chain Editor（动作链可视化编辑器）</h2>
    <p style="color:#909399;">从左侧拖拽动作到中间链，编辑参数 JSON，右侧实时生成配置；"预览执行"按顺序跑一遍。</p>

    <div style="display:flex;gap:16px;margin-top:16px;align-items:flex-start;">
        <!-- 左：可用动作（按分类分组） -->
        <el-card style="width:280px;">
            <template #header>可用动作（{{ actions.length }}）</template>
            <el-input v-model="keyword" placeholder="筛选动作..." size="small" style="margin-bottom:8px;" clearable ></el-input>
            <div v-for="group in groupedActions" :key="group.category">
                <div style="font-size:12px;color:#909399;margin:8px 0 4px;font-weight:bold;">{{ group.category }}</div>
                <div v-for="a in group.items" :key="a.code"
                     draggable="true"
                     @@dragstart="onDragStart($event, a)"
                     @@click="addToChain(a)"
                     style="padding:6px 10px;margin:3px 0;background:#f5f7fa;border:1px solid #e4e7ed;border-radius:4px;cursor:grab;font-size:13px;">
                    <strong>{{ a.name }}</strong>
                    <code style="color:#409eff;font-size:11px;">{{ a.code }}</code>
                </div>
            </div>
        </el-card>

        <!-- 中：动作链 -->
        <el-card style="flex:1;min-width:420px;"
                 @@dragover.prevent
                 @@drop="onDrop">
            <template #header>
                动作链（按顺序执行，共 {{ chain.length }} 步）
                <el-button size="small" type="danger" style="float:right;" @@click="clearChain" :disabled="!chain.length">清空</el-button>
            </template>
            <div v-if="!chain.length" style="color:#c0c4cc;text-align:center;padding:60px 0;">从左侧拖拽或点击动作到此处</div>
            <div v-for="(step, idx) in chain" :key="idx"
                 style="padding:10px;margin:6px 0;background:#ecf5ff;border:1px solid #b3d8ff;border-radius:4px;">
                <div style="display:flex;align-items:center;gap:8px;">
                    <el-tag size="small" type="primary">{{ idx + 1 }}</el-tag>
                    <strong>{{ step.name }}</strong>
                    <code style="color:#409eff;font-size:11px;">{{ step.code }}</code>
                    <span style="flex:1"></span>
                    <el-button size="small" @@click="moveUp(idx)" :disabled="idx===0" title="上移">↑</el-button>
                    <el-button size="small" @@click="moveDown(idx)" :disabled="idx===chain.length-1" title="下移">↓</el-button>
                    <el-button size="small" type="danger" @@click="removeStep(idx)" title="删除">✕</el-button>
                </div>
                <div style="margin-top:6px;">
                    <el-input v-model="step.argsText" type="textarea" :rows="2" placeholder='参数 JSON，如 {"url":"/api/xxx","message":"hi"}' ></el-input>
                    <div v-if="step.argsError" style="color:#f56c6c;font-size:12px;margin-top:4px;">{{ step.argsError }}</div>
                </div>
            </div>
        </el-card>

        <!-- 右：输出 + 预览 -->
        <el-card style="width:360px;">
            <template #header>生成的 JSON</template>
            <pre style="font-size:12px;background:#f5f7fa;padding:10px;border-radius:4px;max-height:320px;overflow:auto;">{{ outputJson }}</pre>
            <el-button type="primary" size="small" @@click="copyJson" style="margin-top:8px;">📋 复制 JSON</el-button>
            <el-button type="success" size="small" @@click="previewRun" style="margin-top:8px;margin-left:8px;" :disabled="!chain.length">▶ 预览执行</el-button>

            <el-divider>执行日志</el-divider>
            <pre style="font-size:12px;background:#0d1117;color:#c9d1d9;padding:10px;border-radius:4px;max-height:220px;overflow:auto;min-height:80px;">{{ logText || '（暂无日志）' }}</pre>
        </el-card>
    </div>

    <el-button style="margin-top:16px;" @@click="goBack">← 返回</el-button>
</div>

@section Scripts {
<script>
const { createApp, ref, reactive, computed, onMounted } = Vue;
createApp({
    setup() {
        const { ElMessage } = ElementPlus;
        const actions = ref([]);
        const chain = ref([]);
        const keyword = ref('');
        const logText = ref('');

        const groupedActions = computed(() => {
            const kw = keyword.value.trim().toLowerCase();
            const filtered = actions.value.filter(a =>
                !kw || (a.name || '').toLowerCase().includes(kw) || (a.code || '').toLowerCase().includes(kw));
            const map = {};
            filtered.forEach(a => {
                const cat = a.category || '其他';
                if (!map[cat]) map[cat] = [];
                map[cat].push(a);
            });
            return Object.keys(map).sort().map(c => ({ category: c, items: map[c] }));
        });

        const outputJson = computed(() => {
            const steps = chain.value.map(s => {
                let args = {};
                try { args = JSON.parse(s.argsText || '{}'); s.argsError = ''; }
                catch (e) { s.argsError = 'JSON 解析错误: ' + e.message; }
                return { action: s.code, args };
            });
            return JSON.stringify(steps, null, 2);
        });

        function onDragStart(e, a) {
            e.dataTransfer.setData('application/x-action', JSON.stringify(a));
        }
        function addToChain(a) {
            chain.value.push({
                name: a.name, code: a.code,
                argsText: a.paramsSchema && a.paramsSchema !== '[]' && a.paramsSchema !== '' ? a.paramsSchema : '{}'
            });
            ElMessage.success('已添加: ' + a.name);
        }
        function onDrop(e) {
            e.preventDefault();
            const data = e.dataTransfer.getData('application/x-action');
            if (!data) return;
            try { addToChain(JSON.parse(data)); } catch (err) {}
        }
        function moveUp(i) { if (i > 0) { [chain.value[i-1], chain.value[i]] = [chain.value[i], chain.value[i-1]]; } }
        function moveDown(i) { if (i < chain.value.length - 1) { [chain.value[i], chain.value[i+1]] = [chain.value[i+1], chain.value[i]]; } }
        function removeStep(i) { chain.value.splice(i, 1); }
        function clearChain() { chain.value = []; }
        function copyJson() {
            navigator.clipboard.writeText(outputJson.value).then(() => ElMessage.success('已复制到剪贴板'));
        }

        // 预览执行：按顺序"模拟"执行每个动作
        async function previewRun() {
            logText.value = '▶ 开始执行 ' + chain.value.length + ' 步动作链\n';
            for (let i = 0; i < chain.value.length; i++) {
                const s = chain.value[i];
                let args = {};
                try { args = JSON.parse(s.argsText || '{}'); } catch (e) {
                    logText.value += `[${i+1}] ❌ ${s.name} JSON 错误: ${e.message}\n`;
                    break;
                }
                logText.value += `[${i+1}] ⚡ ${s.name} (${s.code}) args=${JSON.stringify(args)}\n`;
                await new Promise(r => setTimeout(r, 200));
                // 真的调用一下 Save/Delete 之类可执行的动作
                if (s.code === 'Save') {
                    logText.value += `     → 模拟 Save 调用\n`;
                } else if (s.code === 'Message') {
                    ElementPlus.ElMessage.success(args.message || 'Message: hi');
                    logText.value += `     → ElMessage.success(${args.message || ''})\n`;
                } else if (s.code === 'Confirm') {
                    logText.value += `     → （预览模式跳过 Confirm）\n`;
                } else {
                    logText.value += `     → （前端模拟，未真实调用后端）\n`;
                }
            }
            logText.value += '✅ 动作链执行完毕\n';
        }

        function goBack() { window.location.href = '/demo'; }

        onMounted(async () => {
            try {
                const res = await fetch('/api/actionhelpers');
                const list = await res.json();
                actions.value = Array.isArray(list) ? list : (list.data || []);
            } catch (e) {
                ElMessage.error('加载动作失败: ' + e.message);
            }
        });
        return {
            actions, chain, keyword, groupedActions, outputJson, logText,
            onDragStart, onDrop, addToChain, moveUp, moveDown, removeStep, clearChain,
            copyJson, previewRun, goBack
        };
    }
}).use(ElementPlus).mount('#app');
</script>
}
