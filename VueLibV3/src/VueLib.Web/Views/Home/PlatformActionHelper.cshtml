@{
    ViewData["Title"] = "ActionHelper 脚本管理";
    Layout = "_Layout";
}
<div id="app" style="padding:20px;">
    <el-page-header @@back="goBack" content="ActionHelper 脚本管理">
        <template #extra>
            <el-button type="primary" @@click="add">+ 新增动作</el-button>
        </template>
    </el-page-header>

    <el-card style="margin-top:16px;">
        <el-form inline>
            <el-form-item label="关键字">
                <el-input v-model="keyword" placeholder="Name / Code" clearable @@keyup.enter="load" ></el-input>
            </el-form-item>
            <el-form-item>
                <el-button type="primary" @@click="load">查询</el-button>
            </el-form-item>
        </el-form>

        <el-table :data="rows" border stripe style="width:100%;">
            <el-table-column prop="name" label="Name" min-width="140" show-overflow-tooltip ></el-table-column>
            <el-table-column prop="code" label="Code" min-width="140" show-overflow-tooltip ></el-table-column>
            <el-table-column prop="category" label="Category" width="100" ></el-table-column>
            <el-table-column label="内置" width="80">
                <template #default="scope">
                    <el-tag v-if="scope.row.isBuiltin" type="warning" size="small">内置</el-tag>
                    <el-tag v-else type="info" size="small">自定义</el-tag>
                </template>
            </el-table-column>
            <el-table-column label="启用" width="80">
                <template #default="scope">
                    <el-tag :type="scope.row.isEnabled ? 'success' : 'info'" size="small">
                        {{ scope.row.isEnabled ? '启用' : '禁用' }}
                    </el-tag>
                </template>
            </el-table-column>
            <el-table-column prop="sortOrder" label="Sort" width="70" ></el-table-column>
            <el-table-column label="操作" width="140" fixed="right">
                <template #default="scope">
                    <el-button size="small" @@click="edit(scope.row)">编辑</el-button>
                    <el-button size="small" type="danger" @@click="del(scope.row)">删除</el-button>
                </template>
            </el-table-column>
        </el-table>

        <el-pagination style="margin-top:12px;" background
                       layout="total, sizes, prev, pager, next, jumper"
                       :total="total" :page-size="size" :current-page="page"
                       :page-sizes="[10, 20, 50, 100]"
                       @@current-change="onPageChange" @@size-change="onSizeChange" ></el-pagination>
    </el-card>

    <el-dialog v-model="dialogVisible" :title="editing.id ? '编辑动作' : '新增动作'" width="860px" top="4vh">
        <el-form :model="editing" label-width="110px">
            <el-row :gutter="16">
                <el-col :span="12">
                    <el-form-item label="Name">
                        <el-input v-model="editing.name" placeholder="显示名" ></el-input>
                    </el-form-item>
                </el-col>
                <el-col :span="12">
                    <el-form-item label="Code">
                        <el-input v-model="editing.code" placeholder="dyn-click-{Code}" ></el-input>
                    </el-form-item>
                </el-col>
            </el-row>
            <el-row :gutter="16">
                <el-col :span="12">
                    <el-form-item label="Category">
                        <el-select v-model="editing.category" style="width:100%;">
                            <el-option label="flow" value="flow" ></el-option>
                            <el-option label="data" value="data" ></el-option>
                            <el-option label="window" value="window" ></el-option>
                            <el-option label="ui" value="ui" ></el-option>
                            <el-option label="system" value="system" ></el-option>
                        </el-select>
                    </el-form-item>
                </el-col>
                <el-col :span="12">
                    <el-form-item label="SortOrder">
                        <el-input-number v-model="editing.sortOrder" :min="0" ></el-input-number>
                    </el-form-item>
                </el-col>
            </el-row>
            <el-form-item label="Description">
                <el-input v-model="editing.description" ></el-input>
            </el-form-item>
            <el-form-item label="ParamsSchema">
                <el-input v-model="editing.paramsSchema" type="textarea" :rows="4"
                          placeholder='{{ "[{\"key\":\"url\",\"label\":\"地址\",\"type\":\"input\",\"required\":true}]" }}' ></el-input>
            </el-form-item>
            <el-form-item label="ScriptContent">
                <el-input v-model="editing.scriptContent" type="textarea"
                          style="width:100%;"
                          :rows="14"
                          placeholder="function(ctx) {&#10;  // 动作函数体&#10;}" ></el-input>
            </el-form-item>
            <el-row :gutter="16">
                <el-col :span="8">
                    <el-form-item label="IsBuiltin">
                        <el-switch v-model="editing.isBuiltin" ></el-switch>
                    </el-form-item>
                </el-col>
                <el-col :span="8">
                    <el-form-item label="IsEnabled">
                        <el-switch v-model="editing.isEnabled" ></el-switch>
                    </el-form-item>
                </el-col>
            </el-row>
        </el-form>
        <template #footer>
            <el-button @@click="dialogVisible = false">取消</el-button>
            <el-button type="primary" @@click="save">保存</el-button>
        </template>
    </el-dialog>
</div>

<style>
    /* ScriptContent 等宽字体 */
    .el-dialog textarea { font-family: Consolas, "Courier New", monospace; font-size: 13px; line-height: 1.5; }
</style>

@section Scripts {
<script>
const { createApp, ref, reactive, onMounted } = Vue;
createApp({
    setup() {
        const rows = ref([]);
        const total = ref(0);
        const page = ref(1);
        const size = ref(20);
        const keyword = ref('');
        const dialogVisible = ref(false);
        const editing = reactive({});

        async function load() {
            const url = `/api/admin/actionhelpers?page=${page.value}&size=${size.value}&keyword=${encodeURIComponent(keyword.value || '')}`;
            const res = await fetch(url);
            const json = await res.json();
            if (json.success) {
                rows.value = json.data.rows || [];
                total.value = json.data.total || 0;
            } else {
                ElementPlus.ElMessage.error(json.message || '加载失败');
            }
        }
        function onPageChange(p) { page.value = p; load(); }
        function onSizeChange(s) { size.value = s; page.value = 1; load(); }

        function add() {
            Object.assign(editing, {
                id: 0, name: '', code: '', category: 'ui', description: '',
                paramsSchema: '', scriptContent: 'function(ctx) {\n    // TODO\n}',
                isBuiltin: false, isEnabled: true, sortOrder: 0
            });
            dialogVisible.value = true;
        }
        function edit(row) {
            Object.keys(editing).forEach(k => delete editing[k]);
            Object.assign(editing, row);
            dialogVisible.value = true;
        }
        async function save() {
            if (!editing.name || !editing.code) { ElementPlus.ElMessage.warning('请填写 Name 和 Code'); return; }
            const res = await fetch('/api/admin/actionhelpers', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(editing)
            });
            const json = await res.json();
            if (json.success) {
                ElementPlus.ElMessage.success('保存成功');
                dialogVisible.value = false;
                load();
            } else {
                ElementPlus.ElMessage.error(json.message || '保存失败');
            }
        }
        function del(row) {
            ElementPlus.ElMessageBox.confirm(`确认删除动作「${row.name}」？`, '提示', { type: 'warning' }).then(async () => {
                const res = await fetch('/api/admin/actionhelpers/delete', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(row.id)
                });
                const json = await res.json();
                if (json.success) { ElementPlus.ElMessage.success('删除成功'); load(); }
                else ElementPlus.ElMessage.error(json.message || '删除失败');
            }).catch(() => {});
        }
        function goBack() { window.location.href = '/demo'; }

        onMounted(load);
        return { rows, total, page, size, keyword, dialogVisible, editing, load, onPageChange, onSizeChange, add, edit, save, del, goBack };
    }
}).use(ElementPlus).mount('#app');
</script>
}
