@{
    ViewData["Title"] = "Platform 词典管理";
    Layout = "_Layout";
}
<div id="app" style="padding:20px;">
    <el-page-header @@back="goBack" content="Platform 词典管理">
        <template #extra>
            <el-button type="primary" @@click="add">+ 新增词条</el-button>
        </template>
    </el-page-header>

    <el-card style="margin-top:16px;">
        <el-form inline>
            <el-form-item label="DictType">
                <el-select v-model="dictType" placeholder="全部类型" clearable filterable allow-create
                           default-first-option style="width:220px;" @@change="load">
                    <el-option v-for="t in typeOptions" :key="t" :label="t" :value="t" ></el-option>
                </el-select>
            </el-form-item>
            <el-form-item>
                <el-button type="primary" @@click="load">查询</el-button>
            </el-form-item>
        </el-form>

        <el-table :data="rows" border stripe style="width:100%;">
            <el-table-column prop="dictType" label="DictType" min-width="140" show-overflow-tooltip ></el-table-column>
            <el-table-column prop="dictCode" label="DictCode" min-width="120" show-overflow-tooltip ></el-table-column>
            <el-table-column prop="dictText" label="DictText" min-width="160" show-overflow-tooltip ></el-table-column>
            <el-table-column prop="dictValue" label="DictValue" min-width="140" show-overflow-tooltip ></el-table-column>
            <el-table-column prop="sortOrder" label="Sort" width="80" ></el-table-column>
            <el-table-column label="启用" width="90">
                <template #default="scope">
                    <el-tag :type="scope.row.isEnabled ? 'success' : 'info'" size="small">
                        {{ scope.row.isEnabled ? '启用' : '禁用' }}
                    </el-tag>
                </template>
            </el-table-column>
            <el-table-column label="操作" width="140" fixed="right">
                <template #default="scope">
                    <el-button size="small" @@click="edit(scope.row)">编辑</el-button>
                    <el-button size="small" type="danger" @@click="del(scope.row)">删除</el-button>
                </template>
            </el-table-column>
        </el-table>

        <el-pagination style="margin-top:12px;" background
                       layout="total, sizes, prev, pager, next, jumper"
                       :total="total" :page-size="size" :current-page="page"
                       :page-sizes="[20, 50, 100, 200]"
                       @@current-change="onPageChange" @@size-change="onSizeChange" ></el-pagination>
    </el-card>

    <el-dialog v-model="dialogVisible" :title="editing.id ? '编辑词条' : '新增词条'" width="640px" top="10vh">
        <el-form :model="editing" label-width="100px">
            <el-form-item label="DictType">
                <el-input v-model="editing.dictType" placeholder="如 gender / status" ></el-input>
            </el-form-item>
            <el-row :gutter="16">
                <el-col :span="12">
                    <el-form-item label="DictCode">
                        <el-input v-model="editing.dictCode" ></el-input>
                    </el-form-item>
                </el-col>
                <el-col :span="12">
                    <el-form-item label="SortOrder">
                        <el-input-number v-model="editing.sortOrder" :min="0" ></el-input-number>
                    </el-form-item>
                </el-col>
            </el-row>
            <el-form-item label="DictText">
                <el-input v-model="editing.dictText" ></el-input>
            </el-form-item>
            <el-form-item label="DictValue">
                <el-input v-model="editing.dictValue" ></el-input>
            </el-form-item>
            <el-form-item label="IsEnabled">
                <el-switch v-model="editing.isEnabled" ></el-switch>
            </el-form-item>
        </el-form>
        <template #footer>
            <el-button @@click="dialogVisible = false">取消</el-button>
            <el-button type="primary" @@click="save">保存</el-button>
        </template>
    </el-dialog>
</div>

@section Scripts {
<script>
const { createApp, ref, reactive, computed, onMounted } = Vue;
createApp({
    setup() {
        const rows = ref([]);
        const total = ref(0);
        const page = ref(1);
        const size = ref(50);
        const dictType = ref('');
        const dialogVisible = ref(false);
        const editing = reactive({});

        // 从已加载行中聚合出 DictType 候选项
        const typeOptions = computed(() => {
            const set = new Set();
            rows.value.forEach(r => { if (r.dictType) set.add(r.dictType); });
            if (dictType.value) set.add(dictType.value);
            return Array.from(set).sort();
        });

        async function load() {
            const url = `/api/admin/dict?page=${page.value}&size=${size.value}&dictType=${encodeURIComponent(dictType.value || '')}`;
            const res = await fetch(url);
            const json = await res.json();
            if (json.success) {
                rows.value = json.data.rows || [];
                total.value = json.data.total || 0;
            } else {
                ElementPlus.ElMessage.error(json.message || '加载失败');
            }
        }
        function onPageChange(p) { page.value = p; load(); }
        function onSizeChange(s) { size.value = s; page.value = 1; load(); }

        function add() {
            Object.assign(editing, {
                id: 0, dictType: dictType.value || '', dictCode: '', dictText: '',
                dictValue: '', sortOrder: 0, isEnabled: true
            });
            dialogVisible.value = true;
        }
        function edit(row) {
            Object.keys(editing).forEach(k => delete editing[k]);
            Object.assign(editing, row);
            dialogVisible.value = true;
        }
        async function save() {
            if (!editing.dictType || !editing.dictText) { ElementPlus.ElMessage.warning('请填写 DictType 和 DictText'); return; }
            const res = await fetch('/api/admin/dict', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(editing)
            });
            const json = await res.json();
            if (json.success) {
                ElementPlus.ElMessage.success('保存成功');
                dialogVisible.value = false;
                load();
            } else {
                ElementPlus.ElMessage.error(json.message || '保存失败');
            }
        }
        function del(row) {
            ElementPlus.ElMessageBox.confirm(`确认删除词条「${row.dictText}」？`, '提示', { type: 'warning' }).then(async () => {
                const res = await fetch('/api/admin/dict/delete', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(row.id)
                });
                const json = await res.json();
                if (json.success) { ElementPlus.ElMessage.success('删除成功'); load(); }
                else ElementPlus.ElMessage.error(json.message || '删除失败');
            }).catch(() => {});
        }
        function goBack() { window.location.href = '/demo'; }

        onMounted(load);
        return { rows, total, page, size, dictType, dialogVisible, editing, typeOptions,
                 load, onPageChange, onSizeChange, add, edit, save, del, goBack };
    }
}).use(ElementPlus).mount('#app');
</script>
}
