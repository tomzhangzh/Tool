@{
    // DynElSelect —— Element Plus 下拉选择组件
}
<el-form-item :label="node.options.labeloptions.label" :required="node.options.labeloptions.required"
    :style="node.options.itemoptions.style" :class="node.options.itemoptions.class"
    v-if="node.options.labeloptions.show !== false">
    <el-select v-model="model[node.modelname]" v-bind="node.options.comoptions">
        <el-option v-for="opt in (node.options.comoptions.options || [])" :key="opt.value"
            :label="opt.label" :value="opt.value"></el-option>
    </el-select>
</el-form-item>
