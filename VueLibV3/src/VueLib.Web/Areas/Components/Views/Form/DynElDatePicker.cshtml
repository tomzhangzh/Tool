@{
    // DynElDatePicker —— Element Plus 日期选择组件
}
<el-form-item :label="node.options.labeloptions.label" :required="node.options.labeloptions.required"
    :style="node.options.itemoptions.style" :class="node.options.itemoptions.class"
    v-if="node.options.labeloptions.show !== false">
    <el-date-picker v-model="model[node.modelname]" v-bind="node.options.comoptions"></el-date-picker>
</el-form-item>
