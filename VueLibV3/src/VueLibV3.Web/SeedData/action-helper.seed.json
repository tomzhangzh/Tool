    "Script": "{url}",
    "Language": "javascript", "ParamsJson": { "url": { "label": "接口地址", "type": "string" }, "method": { "label": "方法", "type": "select", "options": ["GET", "POST"] } },
    "Description": "调用后端接口（返回 data）", "SortNo": "6", "IsActive": "1"
  },
  {
