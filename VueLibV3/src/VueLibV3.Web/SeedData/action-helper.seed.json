    "Description": "打开外部链接或页面", "SortNo": "4", "IsActive": "1"
  },
  {
    "Id": "ah-openpage", "Name": "打开动态页面", "Code": "OpenPage", "ActionType": "url",
    "Script": "/webpage.html?code={code}",
    "Language": "javascript", "ParamsJson": { "code": { "label": "页面Code", "type": "string" } },
    "Description": "按 Code 打开平台动态页面", "SortNo": "5", "IsActive": "1"
  },
  {
