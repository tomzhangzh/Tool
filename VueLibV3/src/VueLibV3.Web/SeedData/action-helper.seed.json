  },
  {
    "Id": "ah-chain", "Name": "动作链示例", "Code": "ChainDemo", "ActionType": "chain",
    "Script": "[{\"action\":\"ShowMessage\",\"params\":{\"message\":\"动作链第一步：提示\"},\"when\":\"\"},{\"action\":\"ShowConfirm\",\"params\":{\"message\":\"动作链第二步：确认\"},\"when\":\"\"},{\"action\":\"ShowMessage\",\"params\":{\"message\":\"动作链第三步：执行完成\",\"type\":\"success\"},\"when\":\"result\"}]",
    "Language": "javascript", "ParamsJson": {},
    "Description": "演示动作链：按顺序执行多个动作（条件执行）", "SortNo": "8", "IsActive": "1"
  },
