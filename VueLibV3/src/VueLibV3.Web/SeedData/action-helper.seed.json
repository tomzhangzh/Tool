[
  {
    "Id": "ah-msg", "Name": "消息提示", "Code": "ShowMessage", "ActionType": "script",
    "Script": "$api.msg($args.message || '操作成功', $args.type || 'success');",
    "Language": "javascript", "ParamsJson": { "message": { "label": "消息内容", "type": "string" }, "type": { "label": "类型", "type": "select", "options": ["success", "warning", "info", "error"] } },
    "Description": "弹出 ElementPlus 消息提示", "SortNo": "1", "IsActive": "1"
  },
  {
    "Id": "ah-confirm", "Name": "确认框", "Code": "ShowConfirm", "ActionType": "script",
    "Script": "return $api.confirm($args.message || '确定执行吗？', $args.title || '提示').then(function(ok){ if(ok) $api.msg('已确认'); return ok; });",
    "Language": "javascript", "ParamsJson": { "message": { "label": "提示内容", "type": "string" } },
    "Description": "弹出确认框，返回 Promise<boolean>", "SortNo": "2", "IsActive": "1"
  },
  {
    "Id": "ah-alert", "Name": "警告框", "Code": "ShowAlert", "ActionType": "script",
    "Script": "$api.alert($args.message || '提示');",
    "Language": "javascript", "ParamsJson": { "message": { "label": "内容", "type": "string" } },
    "Description": "弹出警告框", "SortNo": "3", "IsActive": "1"
  },
  {
    "Id": "ah-openurl", "Name": "打开链接", "Code": "OpenUrl", "ActionType": "url",
    "Script": "{url}",
