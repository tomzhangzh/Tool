@{
    Layout = "_Layout";
    ViewData["Title"] = "VueLibV3 企业级低代码平台";
}
<div id="app">
    <div class="desktop-shell" v-loading="loading">
        <div class="desktop-bar">
            <span class="brand">VueLibV3</span>
            <el-tag size="small" type="primary" effect="plain">UMD · 免模型 · 动态组件 · 全 NVARCHAR</el-tag>
            <el-button size="small" @@click="go('/Platform/Page/Designer')">🎨 页面设计器</el-button>
            <el-button size="small" @@click="go('/Platform/Page/Demo/ActionHelper')">⚡ 动作助手</el-button>
            <el-button size="small" @@click="go('/Platform/Page/Demo/Grid')">📐 栅格Demo</el-button>
            <el-button size="small" @@click="go('/Platform/Page/Demo/Crud')">📋 CRUD Demo</el-button>
            <el-button size="small" @@click="go('/Platform/Page/Demo/TemplateImport')">📥 模板导入</el-button>
        </div>
        <div class="desktop-main" v-if="solution">
            <dyn-desktop :solution-id="solution.Code" :columns="7"></dyn-desktop>
        </div>
        <div class="desktop-main" v-else style="text-align:center;color:#909399;padding-top:80px">
            正在加载桌面…
        </div>
        <div class="desktop-footer">双击图标打开应用 · 数据库：SQL Server（PlatformDb / BusinessDb，全 NVARCHAR）</div>
    </div>
</div>

<style>
    body { margin: 0; font-family: 'Helvetica Neue', Arial, 'PingFang SC', 'Microsoft YaHei', sans-serif; }
    .desktop-shell { min-height: 100vh; background: linear-gradient(160deg, #eef4ff 0%, #f8fafc 45%, #e8f0fe 100%); }
    .desktop-bar { display: flex; align-items: center; gap: 10px; padding: 12px 20px; background: rgba(255,255,255,.85); border-bottom: 1px solid #e4e7ed; backdrop-filter: blur(6px); }
    .desktop-bar .brand { font-size: 18px; font-weight: 700; color: #409eff; margin-right: auto; }
    .desktop-main { padding: 24px 12px 40px; }
    .desktop-footer { text-align: center; color: #909399; font-size: 12px; padding: 8px; }
</style>

@section Scripts {
    <script>
        (function () {
            var app = Vue.createApp({
                data: function () { return { solution: null, loading: true }; },
                methods: {
                    go: function (url) { window.location.href = url; },
                    load: function () {
                        var self = this;
                        fetch('/api/platform/desktopsolution/all')
                            .then(function (r) { return r.json(); })
                            .then(function (res) {
                                self.loading = false;
                                if (res.code === 0 && res.data && res.data.length) self.solution = res.data[0];
                            })
                            .catch(function () { self.loading = false; });
                    }
                },
                mounted: function () { this.load(); }
            });
            DynCom.setupApp(app);
            app.mount('#app');
        })();
    </script>
}
