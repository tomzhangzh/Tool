@{
    ViewBag.Title = "桌面管理 - VueLib2";
}
@* 桌面管理：快捷方式 / 解决方案（?type=shortcut|solution） *@
<div id="dm-app" class="max-w-4xl mx-auto p-6">
    <div class="flex items-center justify-between mb-4">
        <h1 class="text-xl font-bold">{{ isShortcut ? '快捷方式管理' : '解决方案管理' }}</h1>
        <div class="flex gap-2">
            <el-button size="small" @@click="isShortcut = !isShortcut; load();">{{ isShortcut ? '切到解决方案' : '切到快捷方式' }}</el-button>
            <el-button type="primary" size="small" @@click="add()">新增</el-button>
        </div>
    </div>

    <!-- 编辑表单 -->
    <el-card v-if="form" class="mb-4">
        <div class="grid grid-cols-2 gap-3">
            <div><el-input v-model="form.name" placeholder="名称"></el-input></div>
            <div><el-input v-model="form.icon" placeholder="图标(emoji)"></el-input></div>
            <template v-if="isShortcut">
                <div class="col-span-2"><el-input v-model="form.url" placeholder="URL（/designer、/component-manage、/#/page/demo-form）"></el-input></div>
                <div>
                    <el-select v-model="form.openType" placeholder="打开方式" style="width:100%">
                        <el-option label="窗口(iframe)" value="iframe"></el-option>
                        <el-option label="新标签页" value="newtab"></el-option>
                        <el-option label="模态窗口" value="modal"></el-option>
                        <el-option label="全屏" value="fullscreen"></el-option>
                    </el-select>
                </div>
                <div>
                    <el-select v-model="form.solutionId" placeholder="所属解决方案" clearable style="width:100%">
                        <el-option v-for="s in solutions" :key="s.id" :label="s.name" :value="s.id"></el-option>
                    </el-select>
                </div>
            </template>
            <div><el-input-number v-model="form.sortOrder" :min="0" controls-position="right" style="width:100%"></el-input-number></div>
            <div class="flex items-center gap-2"><span class="text-sm">启用</span><el-switch v-model="form.isEnabled"></el-switch></div>
        </div>
        <div class="mt-3 flex gap-2">
            <el-button type="primary" size="small" @@click="save()">保存</el-button>
            <el-button size="small" @@click="form = null">取消</el-button>
        </div>
    </el-card>

    <!-- 列表 -->
    <el-table :data="rows" border size="small">
        <el-table-column prop="name" label="名称"></el-table-column>
        <template v-if="isShortcut">
            <el-table-column prop="url" label="URL" show-overflow-tooltip></el-table-column>
            <el-table-column prop="openType" label="打开方式" width="100"></el-table-column>
            <el-table-column label="分组" width="110">
                <template #default="{ row }">{{ solName(row.solutionId) }}</template>
            </el-table-column>
        </template>
        <el-table-column prop="sortOrder" label="排序" width="70"></el-table-column>
        <el-table-column label="启用" width="70">
            <template #default="{ row }"><el-switch :model-value="row.isEnabled" size="small" @@change="toggle(row)"></el-switch></template>
        </el-table-column>
        <el-table-column label="操作" width="140">
            <template #default="{ row }">
                <el-button link type="primary" size="small" @@click="edit(row)">编辑</el-button>
                <el-button link type="danger" size="small" @@click="del(row)">删除</el-button>
            </template>
        </el-table-column>
    </el-table>
</div>

@section Scripts {
<script>
(function () {
    var app = Vue.createApp({
        data: function () {
            return { isShortcut: true, rows: [], solutions: [], form: null };
        },
        mounted: function () {
            var q = new URLSearchParams(location.search);
            if (q.get('type') === 'solution') this.isShortcut = false;
            this.load();
        },
        methods: {
            api: function () { return this.isShortcut ? '/api/desktop/shortcuts' : '/api/desktop/solutions'; },
            load: function () {
                var self = this;
                fetch(this.api()).then(function (r) { return r.json(); }).then(function (j) {
                    self.rows = j.data || [];
                });
                if (this.isShortcut) {
                    fetch('/api/desktop/solutions').then(function (r) { return r.json(); }).then(function (j) {
                        self.solutions = j.data || [];
                    });
                }
            },
            solName: function (id) {
                var s = this.solutions.find(function (x) { return x.id === id; });
                return s ? s.name : '未分组';
            },
            add: function () {
                this.form = this.isShortcut
                    ? { id: 0, name: '', url: '', openType: 'iframe', solutionId: null, icon: '📄', sortOrder: 0, isEnabled: true }
                    : { id: 0, name: '', icon: '📁', sortOrder: 0, isEnabled: true };
            },
            edit: function (row) { this.form = JSON.parse(JSON.stringify(row)); },
            save: function () {
                var self = this, f = this.form;
                var url = this.isShortcut ? '/api/desktop/shortcut' : '/api/desktop/solution';
                fetch(url, {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(f)
                }).then(function (r) { return r.json(); }).then(function (j) {
                    if (j.success) { self.form = null; self.load(); }
                    else window.VueLib.actions.helpers.notify({ type: 'error', message: '保存失败' }, {});
                });
            },
            toggle: function (row) {
                var self = this;
                var f = JSON.parse(JSON.stringify(row)); f.isEnabled = !f.isEnabled;
                var url = this.isShortcut ? '/api/desktop/shortcut' : '/api/desktop/solution';
                fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(f) })
                    .then(function () { self.load(); });
            },
            del: function (row) {
                var self = this;
                if (!confirm('删除「' + row.name + '」？')) return;
                var url = (this.isShortcut ? '/api/desktop/shortcut/' : '/api/desktop/solution/') + row.id;
                fetch(url, { method: 'DELETE' }).then(function () { self.load(); });
            }
        }
    });
    app.use(window.ElementPlus);
    app.mount('#dm-app');
})();
</script>
}
