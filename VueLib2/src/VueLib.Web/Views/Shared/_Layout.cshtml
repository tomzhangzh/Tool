    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VueLib2</title>
    <link rel="stylesheet" href="~/lib/element-plus/index.css?v=@V" />
    <link rel="stylesheet" href="~/css/tailwind.css?v=@V" />
    <link rel="stylesheet" href="~/css/vue-lib.css?v=@V" />
