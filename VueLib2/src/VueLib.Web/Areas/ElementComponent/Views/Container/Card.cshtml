@{
    Layout = "~/Areas/ElementComponent/Views/_ElementLayout.cshtml";
}
<div class="lc-card border border-gray-200 rounded-lg bg-white" :class="getClass(jc.options.itemoptions)" :style="getStyle(jc.options.itemoptions)">
    <div v-if="jc.options.comoptions.title" class="lc-card-header border-b border-gray-100 px-3 py-2 font-medium text-sm">{{ jc.options.comoptions.title }}</div>
    <div class="lc-card-body p-3">
        <lc-node v-for="(child, i) in safeChildren"
                 :key="child._id || childPath(i)"
                 :jsonconfig="child"
                 :parentmodelinfo="parentmodelinfo"
                 :node-path="childPath(i)"
                 :design="design"
                 :design-api="designApi"
                 :depth="depth + 1"></lc-node>
    </div>
</div>
@section setupScripts{
    let DVALUE = null;
}
