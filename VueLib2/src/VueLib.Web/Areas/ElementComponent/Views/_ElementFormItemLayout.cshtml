@* 表单项公共布局：LabelWrapper（标签 + 必填标记 + 校验错误提示）+ 内容区。
   注意：不输出 <template>（由 _ElementLayout 统一包裹）。 *@
@{
    Layout = "~/Areas/ElementComponent/Views/_ElementLayout.cshtml";
}

<div class="el-form-item lc-form-item"
     :class="[getClass(jc.options.itemoptions), { 'is-error': !comInnerInfo.validation.valid && comInnerInfo.validation.touched }]"
     :style="getStyle(jc.options.itemoptions, jc.options.wrapperoptions)">
    <label v-if="jc.options.labeloptions.show !== false"
           class="el-form-item__label"
           :style="labelStyle"
           :class="{ 'is-required': jc.options.labeloptions.required }">
        {{ jc.options.labeloptions.label }}
    </label>
    <div class="el-form-item__content">
        @RenderBody()
        <div v-if="!comInnerInfo.validation.valid && comInnerInfo.validation.touched && comInnerInfo.validation.errors.length"
             class="el-form-item__error">
            {{ comInnerInfo.validation.errors[0] }}
        </div>
    </div>
</div>

@section setupScripts{
    @RenderSection("setupScripts", false)
}
