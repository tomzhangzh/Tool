{
  "ConnectionStrings": {
    "PlatformDb": "Data Source=App_Data/Platform.db",
    "BusinessDb": "Data Source=App_Data/Business.db"
  },
  "Db": {
    "Provider": "Sqlite"
  },
  "Dyn": {
    "ShowRuntimeDesignEntry": true,
    "Rpc": {
      "Enabled": true,
      "EvalEnabled": true,
      "MaxRows": 10000,
      "TimeoutSeconds": 30
    }
  },
  "Urls": "http://localhost:5010",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
