@* 快捷方式表单片段（layer fragment；id 为空=新增，服务端注入默认值 dynmodel）。
   保存走 ActionHelper.submit（updateel）：body=表单 model，服务端返回 ApiResult + dyn-actions（提示/刷新表格/关弹窗），
   成功与失败的闭环全部由服务端动作驱动，片段零业务 JS。 *@
@inject IDesktopSolutionService _solutions
<div id="scFormFragment" class="p-4">
    <div data-dyn-init-createapp>
        <el-form label-width="92px" size="small">
            <el-form-item label="编码" required>
                <el-input v-model="model.Code" maxlength="64" placeholder="唯一编码，如 student-manage"></el-input>
            </el-form-item>
            <el-form-item label="名称" required>
                <el-input v-model="model.Name" maxlength="100"></el-input>
            </el-form-item>
            <el-form-item label="解决方案">
                <el-select v-model="model.SolutionId" clearable style="width:100%">
                    @foreach (var item in _solutions.Query().Where(x => x.IsActive).ToList())
            {
                <el-option  label="@item.Name" :value="@item.Id"></el-option>
            }
                </el-select>
            </el-form-item>
            <el-form-item label="打开方式">
                <el-select v-model="model.TargetType" style="width:100%">
                    <el-option label="页面" value="page"></el-option>
                    <el-option label="动作" value="action"></el-option>
                    <el-option label="外部链接" value="url"></el-option>
                </el-select>
            </el-form-item>
            <el-form-item label="地址">
                <el-input v-model="model.Url" placeholder="页面 URL / 动作编码 / 外部链接"></el-input>
            </el-form-item>
            <el-form-item label="图标">
                @* 虚拟化下拉（约 1900 个 Emoji）：中/英文/emoji 搜索，按分类分组；allow-create 兼容历史 CSS 图标样式手填 *@
                <el-select-v2 v-model="model.Icon"
                              :options="emojiOptions"
                              :filter-method="filterEmojis"
                              :loading="emojiLoading"
                              filterable clearable allow-create default-first-option
                              placeholder="搜索 Emoji（中/英文），也可手填图标样式"
                              style="width:100%">
                    <template #group="{ item }">
                        <span class="font-semibold text-gray-500">{{ item.label }}</span>
                    </template>
                    <template #default="{ item }">
                        <span style="font-size:17px;margin-right:8px">{{ item.value }}</span>
                        <span>{{ item.zh || item.en }}</span>
                        <span v-if="item.zh" class="text-gray-400" style="margin-left:8px;font-size:12px">{{ item.en }}</span>
                    </template>
                </el-select-v2>
            </el-form-item>
            <el-form-item label="排序">
                <el-input-number v-model="model.SortNo" :min="0"></el-input-number>
            </el-form-item>
            <el-form-item label="启用">
                <el-switch v-model="model.IsActive" :active-value="1" :inactive-value="0"></el-switch>
            </el-form-item>
        </el-form>
        <div class="flex justify-end gap-2 mt-3">
            <el-button size="small" dyn-click="ActionHelper.close">取消</el-button>
            <el-button type="primary" size="small"
                       data-dyn-click-submit='{"url":"/api/platform/dyndata/save?table=DesktopShortcut&gridId=grid_shortcut","target":"#scFormFragment"}'>保存</el-button>
        </div>


        <script type="application/json" tag="dynmodel">@Html.Raw(ViewBag.RowJson)</script>
        <script tag="dynconfig">
        var dynConfig = {
            data: function () {
                return { emojiLoading: false, emojiRaw: [], emojiQuery: '' };
            },
            computed: {
                // el-select-v2 是受控组件：options 必须由数据替换驱动；
                // 按 emojiQuery 实时过滤（中/英文/emoji），再分组输出 [{label, options:[{value,label,zh,en}]}]
                emojiOptions: function () {
                    var q = (this.emojiQuery || '').trim().toLowerCase();
                    var hit = this.emojiRaw;
                    if (q) {
                        hit = this.emojiRaw.filter(function (x) {
                            return (x.nameZh && x.nameZh.toLowerCase().indexOf(q) >= 0)
                                || (x.nameEn && x.nameEn.toLowerCase().indexOf(q) >= 0)
                                || (x.emoji && x.emoji.indexOf(q) >= 0);
                        });
                    }
                    return this.groupEmojis(hit);
                }
            },
            methods: {
                groupEmojis: function (list) {
                    var groups = [], index = {};
                    list.forEach(function (x) {
                        var g = x.groupZh || '其他';
                        if (!index[g]) { index[g] = { label: g, options: [] }; groups.push(index[g]); }
                        index[g].options.push({
                            value: x.emoji,
                            label: x.emoji + (x.nameZh ? ' ' + x.nameZh : ''),
                            zh: x.nameZh || '',
                            en: x.nameEn || ''
                        });
                    });
                    return groups;
                },
                // filter-method 只更新查询词，展示列表由 emojiOptions computed 替换（返回值无效）
                filterEmojis: function (q) { this.emojiQuery = q || ''; },
                loadEmojis: function () {
                    var self = this;
                    this.emojiLoading = true;
                    fetch('/api/dyncommon/emojis').then(function (r) { return r.json(); }).then(function (res) {
                        if (res && res.code === 0 && res.data) self.emojiRaw = res.data;
                        else dyn.showMessage((res && res.msg) || 'Emoji 加载失败', 'error');
                    }).catch(function (e) { dyn.showMessage('Emoji 加载失败：' + e.message, 'error'); })
                      .finally(function () { self.emojiLoading = false; });
                }
            },
            mounted: function () { this.loadEmojis(); }
        };
        </script>
        <div style="display:none" data-dyn-init-setwin='{"width":"700px","height":"520px"}'>调整窗口</div>
    </div>
</div>
