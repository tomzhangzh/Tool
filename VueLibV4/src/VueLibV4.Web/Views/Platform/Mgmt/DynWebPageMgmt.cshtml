@{
    ViewData["Title"] = "页面实例管理 - VueLibV4";
}
@*
  页面实例管理（DynWebPage）：
  · 选择一个 DynTemplate → 拉 paramschema：模板自身参数 UI 包 + DynTemplateBlock 各槽位 Block 的参数 UI 包
    （均为标准 DynamicControl DSL，槽位用 el-collapse 折叠分组）→ 保存实例
  · 新建页面：参数以各 UI 包 DefaultJson 初始化；编辑页面：后端合并已保存值，旧扁平 ConfigJson 自动迁移到槽位
  · 保存结构 ParamsJson = { …模板自身参数, blocks:{ slot:{settingId,model,options} } }
  · 运行入口：/Platform/Page/DynWebPage?id={Id}（可直接挂到系统菜单）
  · 数据走 /api/platform/dynwebpage/*（all / get / save / delete / paramschema）+ /api/platform/dyntemplate/all（模板）
*@
<div data-dyn-init-createapp class="p-4" style="height:100vh;box-sizing:border-box;display:flex;flex-direction:column;">

    <el-card shadow="never" style="flex:1;display:flex;flex-direction:column;min-height:0;padding:0;">
        <template #header>
            <div class="flex items-center justify-between">
                <span class="text-sm font-semibold">页面实例（{{ rows.length }}）</span>
                <el-button type="primary" size="small" @@click="onAdd">+ 新建页面</el-button>
            </div>
        </template>
        <div class="flex-1 min-h-0 overflow-auto" style="padding: 0 16px 16px;">
            <el-table :data="rows" border stripe v-loading="loading" size="small">
                <el-table-column prop="Id" label="Id" width="70"></el-table-column>
                <el-table-column prop="Code" label="Code" width="150"></el-table-column>
                <el-table-column prop="Name" label="页面名称" width="150"></el-table-column>
                <el-table-column label="模板" width="140">
                    <template #default="scope">{{ templateName(scope.row.TemplateId) }}</template>
                </el-table-column>
                <el-table-column label="数据表" width="130">
                    <template #default="scope">{{ paramOf(scope.row, 'TableName') }}</template>
                </el-table-column>
                <el-table-column label="运行地址" min-width="200" show-overflow-tooltip>
                    <template #default="scope">{{ '/Platform/Page/DynWebPage?id=' + scope.row.Id }}</template>
                </el-table-column>
                <el-table-column label="启用" width="70">
                    <template #default="scope">
                        <el-tag :type="scope.row.IsActive ? 'success' : 'info'" size="small">{{ scope.row.IsActive ? '启用' : '停用' }}</el-tag>
                    </template>
                </el-table-column>
                <el-table-column label="操作" width="250" fixed="right">
                    <template #default="scope">
                        <el-button size="small" type="primary" @@click="onOpen(scope.row)">打开</el-button>
                        <el-button size="small" @@click="onCopy(scope.row)">复制地址</el-button>
                        <el-button size="small" @@click="onEdit(scope.row)">编辑</el-button>
                        <el-button size="small" type="danger" @@click="onDelete(scope.row)">删除</el-button>
                    </template>
                </el-table-column>
            </el-table>
        </div>
    </el-card>

    <el-dialog v-model="dialog.visible" :title="dialog.title" width="760px" top="4vh" :close-on-click-modal="false">
        <el-form :model="form" label-width="100px" size="small" v-loading="saving">
            <el-form-item label="页面名称" required>
                <el-input v-model="form.Name" placeholder="如 页面设置管理"></el-input>
            </el-form-item>
            <el-form-item label="页面Code" required>
                <el-input v-model="form.Code" :disabled="form.Id > 0" placeholder="唯一标识，留空自动生成" />
            </el-form-item>
            <el-form-item label="使用模板" required>
                <el-select v-model="form.TemplateId" style="width:100%" @@change="onTemplateChange">
                    <el-option v-for="t in templates" :key="t.Id" :label="t.Name + '（' + t.Code + '）'" :value="t.Id"></el-option>
                </el-select>
                <div style="line-height:1.4;color:#909399;font-size:12px;margin-top:4px;">选择模板后，下方按模板/积木的参数 UI 包（DynamicControl DSL）分组渲染参数面板</div>
            </el-form-item>

            <el-divider content-position="left">模板参数（{{ currentTemplate ? currentTemplate.Name : '' }}）</el-divider>
            <dyn-dynamic-com v-if="templateCfg && templateCfg.component"
                             :jsonconfig="templateCfg"
                             :parentmodelinfo="params"
                             style="padding:0 2px;"></dyn-dynamic-com>
            <el-empty v-else-if="form.TemplateId" :image-size="60" description="该模板无自身参数"></el-empty>
            <el-empty v-else :image-size="60" description="请先选择模板"></el-empty>

            <template v-if="slots.length">
                <el-divider content-position="left">积木槽位参数（{{ slots.length }} 个 Block）</el-divider>
                <el-collapse v-model="activeSlots" style="margin:0 2px 4px;">
                    <el-collapse-item v-for="s in slots" :key="s.slot" :name="s.slot">
                        <template #title>
                            <span style="font-weight:600;">{{ s.slotName }}</span>
                            <el-tag size="small" type="info" effect="plain" style="margin-left:8px;">{{ s.blockName }}</el-tag>
                            <el-tag v-if="s.required" size="small" type="danger" effect="plain" style="margin-left:4px;">必选</el-tag>
                        </template>
                        <dyn-dynamic-com :jsonconfig="s.cfg"
                                         :parentmodelinfo="s.model"
                                         style="padding:0 2px;"></dyn-dynamic-com>
                    </el-collapse-item>
                </el-collapse>
                <div style="line-height:1.4;color:#909399;font-size:12px;padding:0 10px 6px;">
                    各 Block 的接口 URL 留空 → 自动走标准 dyndata 接口；手动填写 URL 优先（全 POST）。
                </div>
            </template>
            <div v-else-if="templateCfg && templateCfg.component" style="line-height:1.4;color:#909399;font-size:12px;padding:0 10px 6px;">
                TableName 有值且 ListUrl/AddUrl/EditUrl/DeleteUrl 留空 → 自动生成 dyndata 免 model 接口；手动填写 URL 优先。
            </div>

            <el-divider content-position="left">运行信息</el-divider>
            <div style="line-height:1.8;color:#303133;font-size:13px;">
                <div>运行入口：<code>/Platform/Page/DynWebPage?id={{ form.Id || '{Id}' }}</code></div>
                <div style="color:#909399;">生成后到「系统菜单 → 菜单管理」新增菜单，Url 填上面的入口即可挂到桌面/开始菜单。</div>
            </div>
        </el-form>
        <template #footer>
            <el-button size="small" @@click="dialog.visible=false">取消</el-button>
            <el-button type="primary" size="small" :loading="saving" @@click="onSave">保存</el-button>
        </template>
    </el-dialog>

    <script tag="dynconfig">
    var dynConfig = {
        data: function () {
            return {
                loading: false, saving: false,
                rows: [],
                templates: [],
                templateMap: {},
                dialog: { visible: false, title: '新建页面' },
                currentTemplate: null,
                // 模板自身参数 UI 包（ConfigJson 标准 DynamicControl DSL 配置树）
                templateCfg: {},
                // 模板 DSL 声明的参数键白名单（保存时只挑这些顶层键，丢弃已迁移到槽位的旧扁平键）
                declaredTemplateKeys: [],
                // 积木槽位：[{slot,slotName,required,blockCode,blockName,cfg,model,options}]
                slots: [],
                activeSlots: [],
                // 运行时「进入设计器」带 id 自动打开编辑的页面 Id
                autoEditId: null,
                form: { Id: 0, Code: '', Name: '', TemplateId: null, ParamsJson: '', IsActive: true },
                // 模板自身参数：作为 parentmodelinfo 传给 dyn-dynamic-com
                params: {}
            };
        },
        methods: {
            paramOf: function (row, key) {
                if (!row.ParamsJson) return '';
                try {
                    var o = JSON.parse(row.ParamsJson);
                    var v = o[key];
                    return v === null || v === undefined ? '' : String(v);
                } catch (e) { return ''; }
            },
            templateName: function (id) {
                var t = this.templateMap[id];
                return t ? t.Name : ('#' + id);
            },
            load: function () {
                var self = this;
                this.loading = true;
                Promise.all([
                    fetch('/api/platform/dynwebpage/all').then(function (r) { return r.json(); }),
                    fetch('/api/platform/dyntemplate/all').then(function (r) { return r.json(); })
                ]).then(function (arr) {
                    self.loading = false;
                    var wp = arr[0], tp = arr[1];
                    if (wp.code !== 0) { dyn.showMessage(wp.msg || '加载失败', 'error'); return; }
                    self.rows = wp.data || [];
                    self.templates = (tp.data || []).filter(function (x) { return x.IsActive; });
                    self.templateMap = {};
                    (tp.data || []).forEach(function (t) { self.templateMap[t.Id] = t; });
                }).catch(function () { self.loading = false; dyn.showMessage('加载失败', 'error'); });
            },
            resetForm: function () {
                this.form = { Id: 0, Code: '', Name: '', TemplateId: null, ParamsJson: '', IsActive: true };
                this.params = {};
                this.templateCfg = {};
                this.declaredTemplateKeys = [];
                this.slots = [];
                this.activeSlots = [];
                this.currentTemplate = null;
            },
            onAdd: function () {
                this.resetForm();
                this.dialog = { visible: true, title: '新建页面' };
            },
            // 选择模板后：拉参数 schema（模板自身参数 UI 包 + 各槽位 Block 参数 UI 包）；新建无 pageId
            onTemplateChange: function (tid) {
                this.currentTemplate = this.templateMap[tid] || null;
                this.templateCfg = {};
                this.declaredTemplateKeys = [];
                this.params = {};
                this.slots = [];
                this.activeSlots = [];
                if (!tid) return;
                this.loadParamSchema(tid, null);
            },
            onEdit: function (row) {
                var self = this;
                this.form = Object.assign({}, row);
                this.dialog = { visible: true, title: '编辑页面：' + row.Name };
                this.params = {};
                this.templateCfg = {};
                this.declaredTemplateKeys = [];
                this.slots = [];
                this.activeSlots = [];
                this.currentTemplate = null;
                var tid = row.TemplateId;
                if (!tid) return;
                this.form.TemplateId = tid;
                // pageId 带上后，后端从已保存 ParamsJson 回填模板参数与槽位 values（旧扁平值自动迁移）
                this.loadParamSchema(tid, row.Id);
            },
            // 拉取并装配参数 schema：template{configJson,defaultJson} + slots[{block.paramConfigJson,values}]
            loadParamSchema: function (tid, pageId) {
                var self = this;
                var url = '/api/platform/dynwebpage/paramschema?templateId=' + tid + (pageId ? '&pageId=' + pageId : '');
                fetch(url).then(function (r) { return r.json(); }).then(function (res) {
                    if (res.code !== 0 || !res.data) { dyn.showMessage(res.msg || '参数 schema 加载失败', 'error'); return; }
                    var d = res.data;
                    self.currentTemplate = { Id: d.template.id, Code: d.template.code, Name: d.template.name };

                    // ---- 模板自身参数：DSL 白名单键 × 模板默认值 × 已保存顶层值 ----
                    var cfg = {};
                    try { cfg = JSON.parse(d.template.configJson || '{}'); } catch (e) { cfg = {}; }
                    self.templateCfg = cfg;
                    var def = {};
                    try { def = JSON.parse(d.template.defaultJson || '{}'); } catch (e) { def = {}; }
                    var savedTop = d.params || {};
                    var merged = Object.assign({}, def);
                    var keys = [];
                    ((cfg && cfg.childrenctrls) || []).forEach(function (c) {
                        if (!c || !c.modelname) return;
                        keys.push(c.modelname);
                        if (savedTop[c.modelname] !== undefined && savedTop[c.modelname] !== null) {
                            merged[c.modelname] = savedTop[c.modelname];
                        }
                    });
                    self.declaredTemplateKeys = keys;
                    self.params = merged;

                    // ---- 槽位 Block 参数：values 已由后端合并（默认+保存+旧扁平迁移）----
                    var arr = [];
                    (d.slots || []).forEach(function (s) {
                        var scfg = {};
                        try { scfg = JSON.parse((s.block && s.block.paramConfigJson) || '{}'); } catch (e) { scfg = {}; }
                        var model = Object.assign({}, (s.values && s.values.model) || {});
                        model.settingId = s.values ? s.values.settingId : null;
                        arr.push({
                            slot: s.slot, slotName: s.slotName, required: !!s.required,
                            blockCode: s.block.code, blockName: s.block.name,
                            cfg: scfg, model: model, options: (s.values && s.values.options) || {}
                        });
                    });
                    self.slots = arr;
                    self.activeSlots = arr.map(function (s) { return s.slot; });
                });
            },
            onSave: function () {
                var self = this;
                if (!this.form.Name) { dyn.showMessage('页面名称必填', 'warning'); return; }
                if (!this.form.TemplateId) { dyn.showMessage('请选择模板', 'warning'); return; }
                // 必选槽位校验：settingId 不能为空
                for (var i = 0; i < this.slots.length; i++) {
                    var s = this.slots[i];
                    if (s.required && (s.model.settingId === null || s.model.settingId === undefined || s.model.settingId === '')) {
                        dyn.showMessage('槽位「' + s.slotName + '」为必选，请选择对应配置', 'warning');
                        if (this.activeSlots.indexOf(s.slot) === -1) this.activeSlots.push(s.slot);
                        return;
                    }
                }
                var code = this.form.Code || (this.currentTemplate ? this.currentTemplate.Code : 'page') + '-' + Date.now().toString(36);

                // ParamsJson = 模板自身参数（白名单键，顶层扁平）+ blocks 槽位分组
                var payloadParams = {};
                (this.declaredTemplateKeys || []).forEach(function (k) {
                    payloadParams[k] = self.params[k] === undefined ? null : self.params[k];
                });
                var blocks = {};
                this.slots.forEach(function (s) {
                    var sid = (s.model.settingId === undefined || s.model.settingId === '') ? null : s.model.settingId;
                    var model = {};
                    Object.keys(s.model).forEach(function (k) {
                        if (k !== 'settingId') model[k] = s.model[k];
                    });
                    blocks[s.slot] = { settingId: sid, model: model, options: s.options || {} };
                });
                payloadParams.blocks = blocks;

                this.saving = true;
                fetch('/api/platform/dynwebpage/save', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        Id: this.form.Id,
                        Code: code,
                        Name: this.form.Name,
                        TemplateId: this.form.TemplateId,
                        ParamsJson: JSON.stringify(payloadParams),
                        IsActive: this.form.IsActive === undefined ? true : this.form.IsActive
                    })
                }).then(function (r) { return r.json(); }).then(function (res) {
                    self.saving = false;
                    if (res.code !== 0) { dyn.showMessage(res.msg || '保存失败', 'error'); return; }
                    dyn.showMessage('保存成功', 'success');
                    self.dialog.visible = false;
                    self.load();
                }).catch(function () { self.saving = false; dyn.showMessage('保存失败', 'error'); });
            },
            onOpen: function (row) {
                window.open('/Platform/Page/DynWebPage?id=' + row.Id, '_blank');
            },
            onCopy: function (row) {
                var url = window.location.origin + '/Platform/Page/DynWebPage?id=' + row.Id;
                if (navigator.clipboard && navigator.clipboard.writeText) {
                    navigator.clipboard.writeText(url).then(function () {
                        dyn.showMessage('已复制：' + url, 'success');
                    }).catch(function () { dyn.showMessage(url, 'info'); });
                } else { dyn.showMessage(url, 'info'); }
            },
            onDelete: function (row) {
                var self = this;
                dyn.confirmAsync('确定删除页面实例「' + row.Name + '」吗？').then(function (ok) {
                    if (!ok) return;
                    fetch('/api/platform/dynwebpage/delete', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ Id: row.Id })
                    }).then(function (r) { return r.json(); }).then(function (res) {
                        if (res.code !== 0) { dyn.showMessage(res.msg || '删除失败', 'error'); return; }
                        dyn.showMessage('删除成功', 'success');
                        self.load();
                    });
                });
            }
        },
        mounted: function () {
            var self = this;
            this.load();
            // 支持 /DynWebPageMgmt?id={pageId}：加载完成后自动打开该页面编辑弹窗（运行时「进入设计器」入口）
            var m = (window.location.search || '').match(/[?&]id=(\d+)/);
            if (m && m[1]) {
                this.autoEditId = parseInt(m[1], 10);
                this.$watch('rows', function (rows) {
                    if (self.autoEditId == null) return;
                    var row = (rows || []).find(function (r) { return r.Id === self.autoEditId; });
                    if (row) { self.onEdit(row); self.autoEditId = null; }
                });
            }
        }
    };
    </script>
</div>
