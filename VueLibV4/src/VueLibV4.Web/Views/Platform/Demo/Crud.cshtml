@{
    Layout = "_Layout";
    ViewData["Title"] = "免模型 CRUD Demo - VueLibV4";
}
<div id="app">
    <div class="bar">
        <el-button size="small" text @@click="go('/Platform/Page/Desktop')">← 桌面</el-button>
        <span class="title">免模型 CRUD Demo（无需 Model，仅凭表名即可增删改查）</span>
        <el-tag size="small" type="success">SqlSugar 读取主键/字段信息</el-tag>
    </div>
    <div class="main">
        <dyn-crud-page :jsonconfig="crudConfig"></dyn-crud-page>
        <el-card shadow="never" style="margin-top:16px">
            <template #header><b>数据接口说明</b></template>
            <div style="font-size:13px;color:#606266;line-height:2">
                <div><code>GET /api/business/dyndata/page?table=Student&amp;project=Business-School&amp;page=1&amp;size=20&amp;filter={"Name":{"op":"like","value":"张"}}</code> — 分页+排序+条件</div>
                <div><code>POST /api/business/dyndata/save</code> — 新增/更新（带 Id 则更新，由主键驱动）</div>
                <div><code>POST /api/business/dyndata/delete</code> — 删除（传主键）</div>
                <div><code>GET /api/business/dyndata/meta?table=Student</code> — 表主键/字段信息</div>
                <div>业务库词典：<code>GET /api/business/dict/all</code>（业务词典放业务库，平台词典放平台库 DynDict）</div>
            </div>
        </el-card>
    </div>
</div>

<style>
    body { margin: 0; background: #f0f2f5; font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif; }
    .bar { display: flex; align-items: center; gap: 10px; padding: 10px 16px; background: #fff; border-bottom: 1px solid #e4e7ed; }
    .bar .title { font-weight: 600; margin-right: auto; }
    .main { padding: 16px; }
</style>

@section Scripts {
    <script>
        DynLib.ready(function () {
            var app = Vue.createApp({
                data: function () {
                    // V4 配置驱动：免模型 CRUD 组件统一吃 jsonconfig（comoptions 内声明表/项目/列/查询/表单）
                    var columns = [
                            { prop: 'Name', label: '姓名', width: 120 },
                            { prop: 'Gender', label: '性别', width: 80 },
                            { prop: 'Age', label: '年龄', width: 80 },
                            { prop: 'ClassName', label: '班级', width: 120 },
                            { prop: 'Score', label: '成绩', width: 100 },
                            { prop: 'Phone', label: '电话', width: 150 },
                            { prop: 'Address', label: '地址' },
                            { prop: 'CreateText', label: '创建时间', width: 160 }
                        ];
                    var searchFields = [
                            { prop: 'Name', label: '姓名', op: 'like' },
                            { prop: 'ClassName', label: '班级', op: 'eq', component: 'ElSelect', options: [{ label: '高一(1)班', value: '高一(1)班' }, { label: '高一(2)班', value: '高一(2)班' }, { label: '高二(1)班', value: '高二(1)班' }, { label: '高二(2)班', value: '高二(2)班' }] },
                            { prop: 'Gender', label: '性别', op: 'eq', component: 'ElSelect', options: [{ label: '男', value: 'M' }, { label: '女', value: 'F' }] }
                        ];
                    var formFields = [
                            { prop: 'Name', label: '姓名', component: 'ElInput', required: true },
                            { prop: 'Gender', label: '性别', component: 'ElSelect', options: [{ label: '男', value: 'M' }, { label: '女', value: 'F' }] },
                            { prop: 'Age', label: '年龄', component: 'ElInputNumber' },
                            { prop: 'ClassName', label: '班级', component: 'ElSelect', options: [{ label: '高一(1)班', value: '高一(1)班' }, { label: '高一(2)班', value: '高一(2)班' }, { label: '高二(1)班', value: '高二(1)班' }, { label: '高二(2)班', value: '高二(2)班' }] },
                            { prop: 'Score', label: '成绩', component: 'ElInputNumber' },
                            { prop: 'Phone', label: '电话', component: 'ElInput' },
                            { prop: 'Address', label: '地址', component: 'ElInput' },
                            { prop: 'CreateText', label: '创建时间', component: 'ElDatePicker' }
                        ];
                    return {
                        crudConfig: {
                            component: 'DynCrudPage',
                            modelname: '',
                            options: {
                                comoptions: {
                                    title: '学生管理（免模型）',
                                    table: 'Student',
                                    project: 'Business-School',
                                    pageSize: 20,
                                    columns: columns,
                                    searchFields: searchFields,
                                    formFields: formFields
                                }
                            }
                        }
                    };
                },
                methods: { go: function (url) { window.location.href = url; } }
            });
            DynCom.setupApp(app);
            DynCom.ensureRegistered(app).then(function(){ app.mount('#app'); });
        });
    </script>
}
