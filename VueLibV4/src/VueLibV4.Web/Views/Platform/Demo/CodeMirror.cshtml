@{
    Layout = "_Layout";
    ViewData["Title"] = "CodeMirror Demo - VueLibV4";
}
<div id="app">
    <div class="bar">
        <el-button size="small" text @@click="go('/Platform/Page/Desktop')">← 桌面</el-button>
        <span class="title">DynCodeMirror 组件 Demo（JSON 编辑 / 格式化 / 校验）</span>
    </div>
    <div class="main">
        <el-card shadow="never">
            <template #header><b>JSON 编辑器（用于设计器属性、页面配置）</b></template>
            <dyn-code-mirror :jsonconfig="jsonCfg" :parentmodelinfo="model"></dyn-code-mirror>
            <div :class="error ? 'error-box' : 'ok-box'">{{ error || 'JSON 格式正确' }}</div>
            <div style="margin-top:10px;display:flex;gap:8px">
                <el-button size="small" @@click="format">格式化</el-button>
                <el-button size="small" type="primary" @@click="renderPreview">渲染预览</el-button>
            </div>
        </el-card>
        <div>
            <el-card shadow="never">
                <template #header><b>渲染预览（编辑后可实时渲染）</b></template>
                <dyn-render v-if="previewCfg" :cfg="previewCfg"></dyn-render>
                <el-empty v-else description="点击『渲染预览』查看效果"></el-empty>
            </el-card>
            <el-card shadow="never" style="margin-top:16px">
                <template #header><b>多模式支持</b></template>
                <div style="display:flex;gap:8px;flex-wrap:wrap">
                    <el-button size="small" @@click="setMode('json')">JSON</el-button>
                    <el-button size="small" @@click="setMode('javascript')">JavaScript</el-button>
                    <el-button size="small" @@click="setMode('html')">HTML</el-button>
                    <el-button size="small" @@click="setMode('sql')">SQL</el-button>
                    <el-button size="small" @@click="setMode('css')">CSS</el-button>
                </div>
                <div style="margin-top:10px">
                    <dyn-code-mirror :jsonconfig="codeCfg" :parentmodelinfo="model" />
                </div>
            </el-card>
        </div>
    </div>
</div>

<style>
    body { margin: 0; background: #f0f2f5; font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif; }
    .bar { display: flex; align-items: center; gap: 10px; padding: 10px 16px; background: #fff; border-bottom: 1px solid #e4e7ed; }
    .bar .title { font-weight: 600; margin-right: auto; }
    .main { padding: 16px; display: grid; grid-template-columns: 1fr 1fr; gap: 16px; align-items: start; }
    @@media (max-width: 900px) { .main { grid-template-columns: 1fr; } }
    .error-box { color: #f56c6c; font-size: 12px; margin-top: 8px; }
    .ok-box { color: #67c23a; font-size: 12px; margin-top: 8px; }
</style>

@section Scripts {
    <script>
        (function () {
            var sample = {
                component: 'DynGridContainer',
                modelname: '',
                options: {
                    comoptions: { display: 'grid', 'grid-template-columns': '1fr 1fr', gap: '12px' },
                    comlisteners: {},
                    labeloptions: { label: '', required: false, show: false },
                    itemoptions: { style: {}, class: '' }
                },
                validators: [],
                childrenctrls: [
                    {
                        component: 'ElInput',
                        modelname: 'formData.name',
                        options: { comoptions: { placeholder: '姓名', clearable: true }, comlisteners: {}, labeloptions: { label: '姓名', required: true, show: true }, itemoptions: { style: {}, class: '' } },
                        validators: [{ type: 'required', message: '请输入姓名' }],
                        childrenctrls: [], slots: {}, extendinfo: {}
                    },
                    {
                        component: 'ElInput',
                        modelname: 'formData.phone',
                        options: { comoptions: { placeholder: '手机号' }, comlisteners: {}, labeloptions: { label: '手机号', required: false, show: true }, itemoptions: { style: {}, class: '' } },
                        validators: [{ type: 'phone', message: '手机号格式不正确' }],
                        childrenctrls: [], slots: {}, extendinfo: {}
                    }
                ],
                slots: {},
                extendinfo: {}
            };

            var app = Vue.createApp({
                data: function () {
                    return {
                        model: Vue.reactive({ json: JSON.stringify(sample, null, 2), codeText: '// 切换右上角模式可编辑不同类型代码\nvar demo = { ok: true };' }),
                        error: '',
                        previewCfg: null,
                        mode: 'json',
                        jsonCfg: {
                            component: 'DynCodeMirror',
                            modelname: 'json',
                            options: {
                                comoptions: { language: 'json', height: '360px', placeholder: '在此输入 JSON 配置…' },
                                comlisteners: {}, labeloptions: { label: 'JSON 配置', required: false, show: false },
                                itemoptions: { style: {}, class: '' }
                            },
                            validators: [], childrenctrls: [], slots: {}, extendinfo: {}
                        },
                        codeCfg: {
                            component: 'DynCodeMirror',
                            modelname: 'codeText',
                            options: {
                                comoptions: { language: 'json', height: '200px', placeholder: '切换右上角模式可编辑不同类型代码' },
                                comlisteners: {}, labeloptions: { label: '', required: false, show: false },
                                itemoptions: { style: {}, class: '' }
                            },
                            validators: [], childrenctrls: [], slots: {}, extendinfo: {}
                        }
                    };
                },
                watch: {
                    'model.json': function (v) {
                        try { JSON.parse(v); this.error = ''; }
                        catch (e) { this.error = 'JSON 格式错误: ' + e.message; }
                    }
                },
                methods: {
                    go: function (url) { window.location.href = url; },
                    format: function () {
                        try { this.model.json = JSON.stringify(JSON.parse(this.model.json), null, 2); this.error = ''; }
                        catch (e) { this.error = '无法格式化: ' + e.message; }
                    },
                    setMode: function (m) { this.mode = m; this.codeCfg.options.comoptions.language = m; },
                    renderPreview: function () {
                        try {
                            this.previewCfg = DynCore.normalize(JSON.parse(this.model.json));
                            this.error = '';
                            ElementPlus.ElMessage.success('渲染成功');
                        } catch (e) { this.error = 'JSON 格式错误: ' + e.message; }
                    }
                }
            });
            DynCom.setupApp(app);
            DynCom.ensureRegistered(app).then(function(){ app.mount('#app'); });
        })();
    </script>
}
