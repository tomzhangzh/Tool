@{
    ViewData["Title"] = "VueLibV4 桌面工作台";
    var extId = "Ctrl" + Guid.NewGuid().ToString("N");
}
<div id="@extId">
    <div class="desktop" @@contextmenu.prevent="showContextMenu($event)">
        <!-- 桌面快捷方式：两种展示模式（icons=经典平铺图标 / cards=分组卡片小组件） -->
        <div v-if="displayMode === 'icons'" class="desktop-icons">
            <div v-for="m in roots" :key="m.Id" class="desktop-icon"
                 :class="{ selected: selectedId === m.Id, folder: isFolder(m) }"
                 @@click.stop="onIconClick(m, $event)" @@dblclick="openApp(m)"
                 :title="isFolder(m) ? '文件夹：点击展开子菜单' : (m.TargetType === 'NewWindow' ? '新窗口打开' : '双击打开')">
                <div class="icon">{{ m.Icon || (isFolder(m) ? '📁' : '📄') }}</div>
                <div class="label">{{ m.Name }}</div>
            </div>
        </div>

        <!-- 卡片小组件模式：文件夹=分组卡片（hover 鱼眼弹跳），无分组菜单=独立图标 -->
        <div v-else class="desktop-cards">
            <div v-for="g in folderGroups" :key="g.Id" class="group-card">
                <div class="group-card-header">
                    <span class="gci">{{ g.Icon || '📁' }}</span>
                    <span class="gcn">{{ g.Name }}</span>
                </div>
                <div class="group-card-grid"
                     :class="cardFlow === 'column' ? 'flow-col' : 'flow-row'"
                     :style="cardFlow === 'column'
                        ? { gridTemplateRows: 'repeat(' + cardRows + ', auto)' }
                        : { gridTemplateColumns: 'repeat(' + cardColumns + ', minmax(0, 1fr))' }">
                    <div v-for="c in groupItems(g)" :key="c.Id"
                         class="group-card-item"
                         :class="isFolder(c) ? 'folder' : ''"
                         @@click.stop="onGroupItemClick(c, $event)"
                         :title="isFolder(c) ? '文件夹：点击展开子菜单' : c.Name">
                        <div class="icon">{{ c.Icon || (isFolder(c) ? '📁' : '📄') }}</div>
                        <div class="label">{{ c.Name }}</div>
                    </div>
                </div>
            </div>
            <!-- 无分组菜单：独立桌面图标，不包卡片，保持经典图标大小 -->
            <div v-for="m in nonFolderRoots" :key="m.Id" class="desktop-icon"
                 :class="{ selected: selectedId === m.Id }"
                 @@click.stop="onIconClick(m, $event)" @@dblclick="openApp(m)"
                 :title="m.TargetType === 'NewWindow' ? '新窗口打开' : '双击打开'">
                <div class="icon">{{ m.Icon || '📄' }}</div>
                <div class="label">{{ m.Name }}</div>
            </div>
        </div>

        <!-- 文件夹 float 子菜单（多级级联：子菜单仍有子菜单时右侧再浮一层） -->
        <div v-for="(layer, i) in floatStack" :key="i" class="float-menu"
             :style="{ left: layer.x + 'px', top: layer.y + 'px' }" @@click.stop>
            <div class="float-menu-title">{{ layer.menu.Name }}</div>
            <div v-for="c in layer.menu.children" :key="c.Id" class="float-menu-item" @@click="onFloatItemClick(c, $event)">
                <span class="icon">{{ c.Icon || (isFolder(c) ? '📁' : '📄') }}</span>
                <span class="name">{{ c.Name }}</span>
                <span v-if="isFolder(c)" class="float-arrow">›</span>
            </div>
        </div>

        <!-- 窗口 -->
        <div v-for="win in windows" :key="win.id" class="window"
            :class="{ minimized: win.minimized, maximized: win.maximized }"
            :style="{ left: win.x + 'px', top: win.y + 'px', width: win.width + 'px', height: win.height + 'px', zIndex: win.zIndex }"
            @@mousedown="focusWindow(win.id)">
            <div class="window-header" @@mousedown="startDrag($event, win)" @@dblclick="toggleMaximize(win)">
                <span class="icon">{{ win.icon }}</span>
                <span class="title">{{ win.title }}</span>
                <div class="window-controls">
                    <button class="win-btn" @@click.stop="minimizeWindow(win)" title="最小化">─</button>
                    <button class="win-btn" @@click.stop="toggleMaximize(win)" title="最大化">{{ win.maximized ? '❐' : '☐'
                        }}</button>
                    <button class="win-btn close" @@click.stop="closeWindow(win.id)" title="关闭">✕</button>
                </div>
            </div>
            <div class="window-body">
                <iframe :src="win.url"></iframe>
            </div>
        </div>

        <!-- 开始菜单 -->
        <div v-if="showStartMenu" class="start-menu" @@click.stop>
            <div class="start-menu-header">
                <strong>VueLibV4</strong>
                <div style="font-size:11px;color:rgba(255,255,255,0.5);margin-top:2px;">所有应用</div>
            </div>
            <div class="start-menu-body">
                <div v-for="g in startGroups" :key="g.Id" class="solution-group">
                    <div class="solution-title">{{ g.Icon || '📁' }} {{ g.Name }}</div>
                    <template v-if="g.children && g.children.length">
                        <div v-for="c in startChildren(g)" :key="c.Id" class="menu-item"
                            @@click="openApp(c); showStartMenu = false;">
                            <span class="icon">{{ c.Icon || '📄' }}</span>
                            <span class="name">{{ c.Name }}</span>
                        </div>
                    </template>
                    <template v-else>
                        <div class="menu-item" @@click="openApp(g); showStartMenu = false;">
                            <span class="icon">{{ g.Icon || '📄' }}</span>
                            <span class="name">{{ g.Name }}</span>
                        </div>
                    </template>
                </div>
            </div>
            <div class="start-menu-footer">
                <button @@click="go('/Platform/Page/Designer')">🎨 页面设计器</button>
                <button @@click="go('/Platform/Page/Demo/ActionHelper')">⚡ 动作助手</button>
                <button @@click="go('/Platform/Page/WebPageRender?code=student-manage')">🎓 学生管理</button>
            </div>
        </div>

        <!-- 右键菜单 -->
        <div v-if="contextMenu.show" class="context-menu"
            :style="{ left: contextMenu.x + 'px', top: contextMenu.y + 'px' }">
            <div class="context-menu-item" @@click="refreshDesktop">🔄 刷新</div>
            <div class="context-menu-divider"></div>
            <div class="context-menu-item" @@click="go('/Platform/Page/Designer')">🎨 设计器</div>
            <div class="context-menu-item" @@click="go('/Platform/Page/Demo/Crud')">📋 CRUD Demo</div>
        </div>

        <!-- 桌面设置面板（向上弹出，Tailwind） -->
        <div v-if="showSettingPanel" class="desktop-setting-panel" @@click.stop>
            <div class="panel-title">桌面视图设置</div>
            <div class="setting-item">
                <label>显示模式</label>
                <div class="setting-options">
                    <button @@click="setMode('icons')" :class="{ active: displayMode === 'icons' }" class="setting-option">经典平铺</button>
                    <button @@click="setMode('cards')" :class="{ active: displayMode === 'cards' }" class="setting-option">分组卡片</button>
                </div>
            </div>
            <div v-if="displayMode === 'cards'" class="setting-item">
                <label>卡片内部排列</label>
                <div class="setting-options">
                    <button @@click="cardFlow = 'row'" :class="{ active: cardFlow === 'row' }" class="setting-option">横向（行优先）</button>
                    <button @@click="cardFlow = 'column'" :class="{ active: cardFlow === 'column' }" class="setting-option">竖向（列优先）</button>
                </div>
            </div>
            <div v-if="displayMode === 'cards'" class="setting-item">
                <label>{{ cardFlow === 'column' ? '每列图标数量' : '每行图标数量' }}</label>
                <div class="setting-options">
                    <template v-if="cardFlow === 'column'">
                        <button @@click="cardRows = 2" :class="{ active: cardRows === 2 }" class="setting-option">每列 2 个</button>
                        <button @@click="cardRows = 3" :class="{ active: cardRows === 3 }" class="setting-option">每列 3 个</button>
                    </template>
                    <template v-else>
                        <button @@click="cardColumns = 2" :class="{ active: cardColumns === 2 }" class="setting-option">每行 2 个</button>
                        <button @@click="cardColumns = 3" :class="{ active: cardColumns === 3 }" class="setting-option">每行 3 个</button>
                        <button @@click="cardColumns = 4" :class="{ active: cardColumns === 4 }" class="setting-option">每行 4 个</button>
                    </template>
                </div>
            </div>
            <div class="setting-desc">修改后实时生效</div>
        </div>
        <div v-if="showSettingPanel" class="setting-mask" @@click="showSettingPanel = false"></div>

        <!-- 任务栏 -->
        <div class="taskbar">
            <div class="start-btn" @@click.stop="showStartMenu = !showStartMenu" title="开始">
                <svg viewBox="0 0 24 24" fill="currentColor">
                    <path d="M3 3h8v8H3V3zm10 0h8v8h-8V3zM3 13h8v8H3v-8zm10 0h8v8h-8v-8z" />
                </svg>
            </div>
            <div class="taskbar-windows">
                <div v-for="win in windows" :key="win.id" class="win-task-item"
                    :class="{ active: activeWinId === win.id && !win.minimized }" @@click="taskbarClick(win)">
                    <span class="icon">{{ win.icon }}</span>
                    <span class="title">{{ win.title }}</span>
                </div>
            </div>
            <div class="taskbar-switch" @@click="toggleDisplayMode"
                 :title="displayMode === 'icons' ? '切换到分组卡片小组件模式' : '切换到经典平铺图标模式'">
                <svg viewBox="0 0 24 24" fill="currentColor" width="14" height="14"><path d="M3 5h4v4H3V5zm7 0h11v2H10V5zm-7 5h4v4H3v-4zm7 0h11v2H10v-2zm-7 5h4v4H3v-4zm7 0h11v2H10v-2z"/></svg>
                {{ displayMode === 'icons' ? '分组卡片' : '经典图标' }}
            </div>
            <div class="taskbar-switch" @@click.stop="showSettingPanel = !showSettingPanel" title="桌面视图设置（向上弹出）">
                <svg viewBox="0 0 24 24" fill="currentColor" width="14" height="14"><path d="M19.14 12.94a7.07 7.07 0 0 0 0-1.88l2.03-1.58a.5.5 0 0 0 .12-.64l-1.92-3.32a.5.5 0 0 0-.6-.22l-2.39.96a7.03 7.03 0 0 0-1.63-.94l-.36-2.54a.5.5 0 0 0-.5-.42h-3.84a.5.5 0 0 0-.5.42l-.36 2.54c-.59.23-1.14.55-1.63.94l-2.39-.96a.5.5 0 0 0-.6.22L2.9 8.84a.5.5 0 0 0 .12.64l2.03 1.58a7.07 7.07 0 0 0 0 1.88l-2.03 1.58a.5.5 0 0 0-.12.64l1.92 3.32c.14.24.41.33.64.22l2.39-.96c.49.4 1.04.72 1.63.94l.36 2.54a.5.5 0 0 0 .5.42h3.84a.5.5 0 0 0 .5-.42l.36-2.54c.59-.22 1.14-.54 1.63-.94l2.39.96c.24.11.5.02.64-.22l1.92-3.32a.5.5 0 0 0-.12-.64l-2.03-1.58zM12 15.5A3.5 3.5 0 1 1 12 8a3.5 3.5 0 0 1 0 7.5z"/></svg>
                桌面设置
            </div>
            <div class="taskbar-switch" @@click="go('/Platform/Page/MacDesktopDemo')" title="切换到 Mac 风格桌面">
                <svg viewBox="0 0 24 24" fill="currentColor" width="14" height="14"><path d="M18 3H6a3 3 0 0 0-3 3v12a3 3 0 0 0 3 3h12a3 3 0 0 0 3-3V6a3 3 0 0 0-3-3zM8 7a2 2 0 1 1 0 4 2 2 0 0 1 0-4zm8 10H8v-1c0-1.66 3.34-3 4-3s4 1.34 4 3v1z"/></svg>
                Mac 桌面
            </div>
            <div class="system-tray">
                <div class="clock">
                    <div>{{ currentTime }}</div>
                    <div style="font-size:11px;opacity:0.7;">{{ currentDate }}</div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    html,
    body {
        width: 100%;
        height: 100%;
        overflow: hidden;
        font-family: 'Segoe UI', 'Microsoft YaHei', sans-serif;
        user-select: none;
    }

    .desktop {
        width: 100%;
        height: 100vh;
        position: relative;
        background: linear-gradient(135deg, #1e3c72 0%, #2a5298 50%, #6a11cb 100%);
        background-size: 400% 400%;
        animation: gradientShift 15s ease infinite;
    }

    @@keyframes gradientShift {
        0% {
            background-position: 0% 50%;
        }

        50% {
            background-position: 100% 50%;
        }

        100% {
            background-position: 0% 50%;
        }
    }

    .desktop-icons {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 48px;
        padding: 16px;
        display: flex;
        flex-direction: column;
        flex-wrap: wrap;
        align-content: flex-start;
        gap: 8px;
    }

    .desktop-icon {
        width: 80px;
        height: 90px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
        padding: 8px 4px;
        border-radius: 6px;
        cursor: pointer;
        transition: background 0.15s;
    }

    .desktop-icon:hover {
        background: rgba(255, 255, 255, 0.15);
    }

    .desktop-icon.selected {
        background: rgba(255, 255, 255, 0.25);
        border: 1px solid rgba(255, 255, 255, 0.4);
    }

    .desktop-icon .icon {
        font-size: 36px;
        line-height: 1;
        margin-bottom: 6px;
        filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.3));
    }

    .desktop-icon .label {
        color: #fff;
        font-size: 12px;
        text-align: center;
        text-shadow: 0 1px 3px rgba(0, 0, 0, 0.8);
        word-break: break-all;
        line-height: 1.3;
        max-height: 32px;
        overflow: hidden;
    }

    /* ===== 卡片小组件模式（displayMode='cards'）===== */
    .desktop-cards {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 48px;
        padding: 16px;
        display: flex;
        flex-wrap: wrap;
        align-content: flex-start;
        gap: 16px;
        overflow-y: auto;
    }

    .group-card {
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.16);
        border-radius: 12px;
        padding: 10px;
        min-width: 150px;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
        /* 鱼眼弹跳动画：hover 上浮 + 放大（回弹缓动） */
        transition: transform 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275), background 0.2s ease, box-shadow 0.35s ease;
    }

    .group-card:hover {
        transform: translateY(-8px) scale(1.12);
        background: rgba(255, 255, 255, 0.16);
        box-shadow: 0 14px 36px rgba(0, 0, 0, 0.4);
    }

    .group-card-header {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 2px 4px 8px;
        color: rgba(255, 255, 255, 0.78);
        font-size: 12px;
        font-weight: 600;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        margin-bottom: 8px;
    }

    .group-card-header .gci {
        font-size: 16px;
    }

    .group-card-header .gcn {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .group-card-grid {
        display: grid;
        gap: 6px;
    }

    /* 竖向（列优先）：每列固定宽，行数由 Vue 绑定 gridTemplateRows 控制 */
    .group-card-grid.flow-col {
        grid-auto-flow: column;
        grid-auto-columns: 64px;
    }

    /* 横向（行优先）：列数由 Vue 绑定 gridTemplateColumns 控制（每行 cardColumns 个） */
    .group-card-grid.flow-row {
        grid-auto-flow: row;
    }

    .group-card-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 4px;
        padding: 8px 4px;
        border-radius: 8px;
        cursor: pointer;
        transition: transform 0.25s ease, background 0.15s;
    }

    .group-card-item:hover {
        background: rgba(255, 255, 255, 0.14);
        transform: scale(1.22);
    }

    .group-card-item.folder {
        background: rgba(255, 255, 255, 0.06);
        border: 1px dashed rgba(255, 255, 255, 0.25);
    }

    .group-card-item .icon {
        font-size: 22px;
        filter: drop-shadow(0 2px 3px rgba(0, 0, 0, 0.3));
    }

    .group-card-item .label {
        color: #fff;
        font-size: 10px;
        text-align: center;
        text-shadow: 0 1px 2px rgba(0, 0, 0, 0.7);
        word-break: break-all;
        line-height: 1.2;
    }

    /* ===== 桌面设置面板（底部向上弹出）===== */
    .setting-mask {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.3);
        z-index: 99;
    }

    .desktop-setting-panel {
        position: fixed;
        bottom: 70px;
        left: 50%;
        transform: translateX(-50%);
        width: 420px;
        background: rgba(35, 35, 45, 0.96);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 14px;
        padding: 16px;
        z-index: 100;
        box-shadow: 0 16px 50px rgba(0, 0, 0, 0.5);
        animation: panelUp 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    @@keyframes panelUp {
        from {
            transform: translateX(-50%) translateY(120%);
            opacity: 0;
        }

        to {
            transform: translateX(-50%) translateY(0);
            opacity: 1;
        }
    }

    .panel-title {
        font-weight: 700;
        font-size: 16px;
        color: #fff;
        margin-bottom: 12px;
        text-align: center;
    }

    .setting-item {
        padding: 10px 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .setting-item label {
        display: block;
        color: rgba(255, 255, 255, 0.7);
        font-size: 12px;
        margin-bottom: 8px;
    }

    .setting-options {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    .setting-option {
        border: none;
        cursor: pointer;
        padding: 6px 14px;
        border-radius: 8px;
        font-size: 12px;
        color: rgba(255, 255, 255, 0.85);
        background: rgba(255, 255, 255, 0.1);
        transition: background 0.15s, color 0.15s;
    }

    .setting-option:hover {
        background: rgba(255, 255, 255, 0.2);
    }

    .setting-option.active {
        background: #3b82f6;
        color: #fff;
    }

    .setting-desc {
        margin-top: 12px;
        font-size: 11px;
        color: rgba(255, 255, 255, 0.5);
        text-align: center;
    }


    .taskbar {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 48px;
        background: rgba(30, 30, 30, 0.85);
        backdrop-filter: blur(20px);
        display: flex;
        align-items: center;
        padding: 0 8px;
        z-index: 1000;
        border-top: 1px solid rgba(255, 255, 255, 0.1);
    }

    .start-btn {
        width: 44px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 6px;
        cursor: pointer;
        transition: background 0.15s;
        color: #fff;
    }

    .start-btn:hover {
        background: rgba(255, 255, 255, 0.15);
    }

    .taskbar-switch {
        height: 32px;
        margin-right: 12px;
        padding: 0 12px;
        display: flex;
        align-items: center;
        gap: 6px;
        border-radius: 6px;
        color: #fff;
        font-size: 12px;
        cursor: pointer;
        background: rgba(255, 255, 255, 0.08);
        transition: background 0.15s;
        white-space: nowrap;
    }

    .taskbar-switch:hover {
        background: rgba(255, 255, 255, 0.2);
    }

    .start-btn svg {
        width: 22px;
        height: 22px;
    }

    .taskbar-windows {
        flex: 1;
        display: flex;
        gap: 4px;
        padding: 0 8px;
        overflow-x: auto;
        height: 100%;
        align-items: center;
    }

    .taskbar-windows::-webkit-scrollbar {
        display: none;
    }

    .win-task-item {
        height: 36px;
        min-width: 160px;
        max-width: 200px;
        padding: 0 10px;
        display: flex;
        align-items: center;
        gap: 8px;
        border-radius: 6px;
        cursor: pointer;
        transition: background 0.15s;
        color: #fff;
        font-size: 13px;
        background: rgba(255, 255, 255, 0.08);
    }

    .win-task-item:hover {
        background: rgba(255, 255, 255, 0.18);
    }

    .win-task-item.active {
        background: rgba(255, 255, 255, 0.25);
        border-bottom: 2px solid #4fc3f7;
    }

    .win-task-item .icon {
        font-size: 16px;
    }

    .win-task-item .title {
        flex: 1;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .system-tray {
        display: flex;
        align-items: center;
        gap: 12px;
        color: #fff;
        font-size: 12px;
        padding: 0 12px;
    }

    .system-tray .clock {
        text-align: right;
        line-height: 1.3;
    }

    .start-menu {
        position: absolute;
        bottom: 56px;
        left: 8px;
        width: 360px;
        max-height: 520px;
        background: rgba(40, 40, 40, 0.92);
        backdrop-filter: blur(30px);
        border-radius: 12px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        display: flex;
        flex-direction: column;
        z-index: 999;
        overflow: hidden;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
    }

    .start-menu-header {
        padding: 16px;
        color: #fff;
        font-size: 14px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .start-menu-body {
        flex: 1;
        overflow-y: auto;
        padding: 8px;
    }

    .solution-group {
        margin-bottom: 12px;
    }

    .solution-title {
        color: rgba(255, 255, 255, 0.6);
        font-size: 11px;
        padding: 4px 8px;
        text-transform: uppercase;
    }

    .menu-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px 10px;
        border-radius: 6px;
        cursor: pointer;
        color: #fff;
        transition: background 0.15s;
    }

    .menu-item:hover {
        background: rgba(255, 255, 255, 0.12);
    }

    .menu-item .icon {
        font-size: 20px;
        width: 28px;
        text-align: center;
    }

    .menu-item .name {
        font-size: 13px;
    }

    .start-menu-footer {
        padding: 12px 16px;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        display: flex;
        justify-content: space-between;
        gap: 8px;
    }

    .start-menu-footer button {
        background: none;
        border: none;
        color: rgba(255, 255, 255, 0.7);
        cursor: pointer;
        font-size: 12px;
        padding: 6px 12px;
        border-radius: 4px;
    }

    .start-menu-footer button:hover {
        background: rgba(255, 255, 255, 0.1);
        color: #fff;
    }

    .window {
        position: absolute;
        background: #fff;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
        display: flex;
        flex-direction: column;
        min-width: 400px;
        min-height: 300px;
    }

    .window.minimized {
        display: none;
    }

    .window.maximized {
        top: 0 !important;
        left: 0 !important;
        width: 100% !important;
        height: calc(100% - 48px) !important;
        border-radius: 0;
    }

    .window-header {
        height: 36px;
        background: linear-gradient(to bottom, #f5f5f5, #e8e8e8);
        display: flex;
        align-items: center;
        padding: 0 8px;
        cursor: move;
        border-bottom: 1px solid #ddd;
        flex-shrink: 0;
    }

    .window-header .icon {
        font-size: 16px;
        margin-right: 8px;
    }

    .window-header .title {
        flex: 1;
        font-size: 13px;
        color: #333;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .window-controls {
        display: flex;
        gap: 4px;
    }

    .win-btn {
        width: 28px;
        height: 24px;
        border: none;
        background: none;
        cursor: pointer;
        border-radius: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        color: #666;
        transition: background 0.15s;
    }

    .win-btn:hover {
        background: rgba(0, 0, 0, 0.08);
    }

    .win-btn.close:hover {
        background: #e81123;
        color: #fff;
    }

    .window-body {
        flex: 1;
        overflow: hidden;
        position: relative;
    }

    .window-body iframe {
        width: 100%;
        height: 100%;
        border: none;
    }

    .context-menu {
        position: absolute;
        background: rgba(50, 50, 50, 0.95);
        border-radius: 8px;
        padding: 6px;
        min-width: 160px;
        z-index: 2000;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .context-menu-item {
        padding: 8px 14px;
        color: #fff;
        font-size: 13px;
        border-radius: 4px;
        cursor: pointer;
        transition: background 0.15s;
    }

    .context-menu-item:hover {
        background: rgba(255, 255, 255, 0.15);
    }

    .context-menu-divider {
        height: 1px;
        background: rgba(255, 255, 255, 0.1);
        margin: 4px 0;
    }

    /* 文件夹 float 子菜单（父菜单点击后浮动在图标旁） */
    .float-menu {
        position: absolute;
        background: rgba(45, 45, 55, 0.95);
        backdrop-filter: blur(24px);
        border-radius: 10px;
        min-width: 180px;
        max-width: 240px;
        max-height: calc(100vh - 60px);
        overflow-y: auto;
        padding: 6px;
        z-index: 2100;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
        border: 1px solid rgba(255, 255, 255, 0.12);
    }

    .float-menu-title {
        color: rgba(255, 255, 255, 0.55);
        font-size: 11px;
        padding: 4px 10px 8px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        margin-bottom: 4px;
    }

    .float-menu-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px 10px;
        border-radius: 6px;
        cursor: pointer;
        color: #fff;
        font-size: 13px;
        transition: background 0.15s;
    }

    .float-menu-item:hover {
        background: rgba(255, 255, 255, 0.14);
    }

    .float-menu-item .icon {
        font-size: 18px;
        width: 24px;
        text-align: center;
    }

    .float-menu-item .float-arrow {
        margin-left: auto;
        color: rgba(255, 255, 255, 0.5);
        font-size: 14px;
    }

    .desktop-icon.folder {
        background: rgba(255, 255, 255, 0.06);
        border: 1px dashed rgba(255, 255, 255, 0.25);
    }
</style>

@section Scripts {
    <script>
        DynLib.ready(function () {
            var app = Vue.createApp({
                data: function () {
                    return {
                        roots: [], windows: [],
                        showStartMenu: false, selectedId: null, activeWinId: null,
                        currentTime: '', currentDate: '',
                        contextMenu: { show: false, x: 0, y: 0 },
                        treeData: [],
                        floatStack: [],
                        displayMode: 'icons', // 桌面快捷方式展示模式：icons=经典平铺 / cards=分组卡片小组件
                        cardRows: 3, // 卡片内部每列图标数（竖向列优先：一列 2 或 3 个）
                        cardColumns: 3, // 卡片内部每行图标数（横向行优先：一行 2/3/4 个）
                        cardFlow: 'column', // 卡片内部排列方向：row=行优先 / column=列优先
                        showSettingPanel: false, // 桌面设置面板显隐
                        _winId: 0, _z: 100
                    };
                },
                computed: {
                    // 卡片小组件模式（仅取顶层菜单，避免与文件夹子项重复）：
                    // 顶层文件夹 = 分组卡片；顶层非文件夹 = 独立图标（无分组，不包卡片）
                    folderGroups: function () {
                        return (this.treeData || []).filter(function (m) { return m.IsAddToDesktopRoot !== false && m.children && m.children.length; });
                    },
                    nonFolderRoots: function () {
                        return (this.treeData || []).filter(function (m) { return m.IsAddToDesktopRoot !== false && !(m.children && m.children.length); });
                    }
                },
                methods: {
                    go: function (url) { window.location.href = url; },
                    toggleDisplayMode: function () {
                        this.displayMode = this.displayMode === 'icons' ? 'cards' : 'icons';
                    },
                    setMode: function (m) { this.displayMode = m; },
                    groupItems: function (g) { return (g.children || []).filter(function (c) { return c.IsAddToDesktop !== false; }); },
                    load: function () {
                        var self = this;
                        fetch('/api/platform/sysmenu/desktoplist').then(function (r) { return r.json(); })
                            .then(function (res) {
                                if (res.code === 0) {
                                    var tree = res.data || [];
                                    self.treeData = tree; // 开始菜单分组用（保留树形）
                                    self.roots = self.collectDesktopRoots(tree); // 桌面根区：IsAddToDesktopRoot=true 的节点（平铺）
                                } else {
                                    console.error('加载桌面菜单失败', res.msg);
                                }
                            }).catch(function (e) { console.error('加载桌面菜单失败', e); });
                    },
                    // 递归收集显示在桌面根区的节点（IsAddToDesktopRoot !== false；带子级仍是文件夹）
                    collectDesktopRoots: function (nodes) {
                        var out = [];
                        var walk = function (list) {
                            list.forEach(function (n) {
                                if (n.IsAddToDesktopRoot !== false) out.push(n);
                                if (n.children && n.children.length) walk(n.children);
                            });
                        };
                        walk(nodes);
                        return out;
                    },
                    isFolder: function (m) {
                        return !!(m.children && m.children.length);
                    },
                    onIconClick: function (m, e) {
                        this.selectedId = m.Id;
                        this.closeFloatMenu();
                        if (this.isFolder(m)) this.openFloat(m, e);
                    },
                    // 卡片内子项点击：文件夹 → 弹级联 float 子菜单（多级嵌套）；叶子 → 直接打开
                    onGroupItemClick: function (c, e) {
                        this.selectedId = c.Id;
                        this.closeFloatMenu();
                        if (this.isFolder(c)) this.openFloat(c, e);
                        else this.openApp(c);
                    },
                    // 打开一层 float 面板（顶层定位在图标旁；放不下时向上展开）
                    openFloat: function (m, e) {
                        var rect = e && e.currentTarget ? e.currentTarget.getBoundingClientRect() : null;
                        var x = rect ? rect.right + 8 : (e ? e.clientX : 200);
                        var y = rect ? rect.top : (e ? e.clientY : 100);
                        if (x + 180 > window.innerWidth && rect) x = rect.left - 188;
                        this.floatStack.push(this.fitFloat(m, x, y));
                    },
                    // 面板位置校正：预估高度放不下屏幕底部时向上移（保留 8px 边距）
                    fitFloat: function (m, x, y) {
                        var estH = 42 + (m.children ? m.children.length : 0) * 40;
                        var bottom = window.innerHeight - 52; // 任务栏以上
                        if (y + estH > bottom) y = Math.max(8, bottom - estH);
                        return { menu: m, x: x, y: y };
                    },
                    // float 面板项点击：有子级 → 右侧再浮一层（级联）；无子级 → 打开
                    onFloatItemClick: function (c, e) {
                        if (this.isFolder(c)) {
                            var rect = e.currentTarget.getBoundingClientRect();
                            var x = rect.right + 4;
                            if (x + 180 > window.innerWidth) x = rect.left - 184;
                            this.floatStack.push(this.fitFloat(c, x, rect.top));
                        } else {
                            this.openApp(c);
                        }
                    },
                    closeFloatMenu: function () { this.floatStack = []; },
                    // 窗口尺寸解析：支持像素 "800" 或百分比 "50%"；无值返回 null
                    parseSize: function (v, max) {
                        if (!v) return null;
                        v = String(v).trim();
                        if (/%$/.test(v)) {
                            var p = parseFloat(v);
                            if (!(p > 0)) return null;
                            return Math.round(max * p / 100);
                        }
                        var n = parseInt(v, 10);
                        return n > 0 ? n : null;
                    },
                    // 开始菜单分组：根菜单中 IsAddToStartMenu=true
                    startGroups: function () {
                        return this.treeData.filter(function (n) { return n.IsAddToStartMenu !== false; });
                    },
                    // 分组内子项按 IsAddToStartMenu 过滤
                    startChildren: function (g) {
                        return (g.children || []).filter(function (c) { return c.IsAddToStartMenu !== false; });
                    },
                    openApp: function (m) {
                        var self = this;
                        if (this.isFolder(m)) { this.openFloat(m, {}); return; }
                        var url = m.Url;
                        if (!url) { dyn.showMessage('该菜单未配置访问地址', 'warning'); return; }
                        // TargetType：NewWindow=新窗口；FullScreen=全屏窗口；Windows=桌面窗口(用配置宽高)；Iframe=桌面窗口(默认尺寸)
                        if (m.TargetType === 'NewWindow') { window.open(url, '_blank'); return; }
                        var existing = this.windows.find(function (w) { return w.url === url; });
                        if (existing) { existing.minimized = false; this.focusWindow(existing.id); return; }
                        var isWin = m.TargetType === 'Windows';
                        var availW = Math.max(400, window.innerWidth - 40);
                        var availH = Math.max(300, window.innerHeight - 88);
                        var winW = this.parseSize(m.Width, availW);
                        var winH = this.parseSize(m.Height, availH);
                        var w = {
                            id: ++this._winId, title: m.Name, icon: m.Icon || '📄', url: url,
                            x: 80 + (this.windows.length * 30) % 200,
                            y: 60 + (this.windows.length * 30) % 150,
                            width: (isWin && winW) ? Math.min(winW, availW) : 960,
                            height: (isWin && winH) ? Math.min(winH, availH) : 640,
                            minimized: false,
                            maximized: m.TargetType === 'FullScreen',
                            zIndex: ++this._z
                        };
                        this.windows.push(w); this.activeWinId = w.id;
                        this.closeFloatMenu();
                    },
                    focusWindow: function (id) {
                        var w = this.windows.find(function (x) { return x.id === id; });
                        if (w) { w.zIndex = ++this._z; this.activeWinId = id; }
                    },
                    minimizeWindow: function (w) { w.minimized = true; },
                    toggleMaximize: function (w) { w.maximized = !w.maximized; },
                    closeWindow: function (id) {
                        var i = this.windows.findIndex(function (x) { return x.id === id; });
                        if (i >= 0) this.windows.splice(i, 1);
                    },
                    taskbarClick: function (w) {
                        if (w.minimized) { w.minimized = false; this.focusWindow(w.id); }
                        else if (this.activeWinId === w.id) w.minimized = true;
                        else this.focusWindow(w.id);
                    },
                    startDrag: function (e, w) {
                        var self = this;
                        if (w.maximized) return;
                        this.focusWindow(w.id);
                        var sx = e.clientX, sy = e.clientY, ox = w.x, oy = w.y;
                        var move = function (ev) { w.x = ox + (ev.clientX - sx); w.y = Math.max(0, oy + (ev.clientY - sy)); };
                        var up = function () { document.removeEventListener('mousemove', move); document.removeEventListener('mouseup', up); };
                        document.addEventListener('mousemove', move); document.addEventListener('mouseup', up);
                    },
                    showContextMenu: function (e) { this.contextMenu.show = true; this.contextMenu.x = e.clientX; this.contextMenu.y = e.clientY; },
                    refreshDesktop: function () { this.contextMenu.show = false; this.load(); },
                    tick: function () {
                        var n = new Date();
                        this.currentTime = n.toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit' });
                        this.currentDate = n.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit', weekday: 'short' });
                    }
                },
                mounted: function () {
                    this.load(); this.tick();
                    setInterval(this.tick, 1000);
                    var self = this;
                    document.addEventListener('click', function () { self.showStartMenu = false; self.contextMenu.show = false; self.selectedId = null; self.floatStack = []; });
                }
            });
            const container = document.querySelector('#@extId');
            app.mount(container);

        });
    </script>
}
