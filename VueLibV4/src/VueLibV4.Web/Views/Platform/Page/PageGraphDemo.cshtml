@{
    ViewData["Title"] = ViewData["Title"];
    var mermaid = ViewData["Mermaid"] as string ?? "";
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.min.css" />
<div style="padding:20px; background:#fff; min-height:100vh;">
    <h2 style="margin:0 0 4px;">🕸️ 页面组成图（Demo）</h2>
    <p style="color:#909399; margin:0 0 16px; font-size:13px;">
        当前页面：<b>@ViewData["WpName"]</b>　·　方块=Block　·　紫文档=PageSetting　·　粗箭头=消息流转　·　虚线=配置关系
    </p>
    <div style="background:#fafafa; border:1px solid #e4e7ed; border-radius:8px; padding:20px; overflow:auto;">
        <pre class="mermaid" id="graph">@mermaid</pre>
    </div>
    <details style="margin-top:12px;">
        <summary style="cursor:pointer; color:#909399; font-size:12px;">查看 Mermaid 源码</summary>
        <pre style="font-size:12px; background:#f5f5f5; padding:10px;">@mermaid</pre>
    </details>
</div>
<script src="~/lib/mermaid.min.js"></script>
<script>
    mermaid.initialize({ startOnLoad: true, theme: 'neutral', flowchart: { curve: 'basis', useMaxWidth: true } });
</script>
