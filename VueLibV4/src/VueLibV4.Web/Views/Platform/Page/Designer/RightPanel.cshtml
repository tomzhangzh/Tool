@* 右侧属性面板：基础(含控件类型+组件属性) / 布局样式 / 校验规则 / 高级 *@
<aside class="w-80 shrink-0 bg-white border-l border-gray-200 flex flex-col min-h-0"
       data-dyn-init-createapp data-dyn-use-scope="designer">
<div class="flex items-center justify-between px-3 h-10 border-b border-gray-100 shrink-0">
    <span class="font-semibold text-gray-700">属性配置</span>
  </div>

  <div v-if="!model.current" class="p-6 text-sm text-gray-300 text-center">选中组件后在此配置属性</div>

  <template v-else>
    <div class="px-3 py-2 bg-gray-50 border-b border-gray-100 flex items-center justify-between text-xs shrink-0">
      <span class="text-gray-600 font-medium">{{ model.current.component }}</span>
    </div>

    <el-tabs v-model="propTab" class="flex-1 overflow-hidden flex flex-col" size="small" type="border-card">
      @* ===== 基础：控件类型 + 通用字段 + 组件属性(comProps动态渲染) ===== *@
      <el-tab-pane label="基础" name="base" class="overflow-y-auto"><el-form size="small" label-position="left" label-width="90px" class="p-3">
          @* 控件类型（可切换组件） *@
          <el-form-item label="控件类型">
            <el-select v-model="model.current.component" size="small" filterable @@change="onComponentTypeChange">
              <el-option-group v-for="g in componentGroups" :key="g.group" :label="g.group">
                <el-option v-for="m in g.items" :key="m.ComponentName" :label="m.Label || m.ComponentName" :value="m.ComponentName"></el-option>
              </el-option-group>
            </el-select>
          </el-form-item>
          <el-form-item label="字段标识">
            <el-input v-model="model.current.modelname" size="small" placeholder="绑定数据字段名" clearable></el-input>
          </el-form-item>
          <el-form-item label="标签文本">
            <el-input v-model="model.current.options.labeloptions.label" size="small" placeholder="请输入标签文本" clearable></el-input>
          </el-form-item>
          <el-form-item label="显示标签">
            <el-switch v-model="model.current.options.labeloptions.show" size="small"></el-switch>
          </el-form-item>
          <el-form-item label="是否必填">
            <el-switch :model-value="isRequired" @@change="onRequiredChange($event)" size="small"></el-switch>
          </el-form-item>
        </el-form>

        @* 组件属性（动态渲染，comProps） *@
        <el-collapse v-model="comPropsActive" class="px-2 pb-2">
          <el-collapse-item title="组件属性" name="comAttr">
            <dyn-dynamic-com v-if="comProps" :key="propKey" :jsonconfig="comProps" :parentmodelinfo="model.current"></dyn-dynamic-com>
            <div v-if="!comProps" class="text-xs text-gray-400 text-center py-2">该组件暂无扩展属性</div>
          </el-collapse-item>
        </el-collapse>
      </el-tab-pane>

      @* ===== 布局样式 ===== *@
      <el-tab-pane label="布局样式" name="style" class="overflow-y-auto"><el-form size="small" label-position="left" label-width="90px" class="p-3">
          <el-form-item label="Label对齐">
            <el-radio-group v-model="model.current.options.labeloptions.labelposition" size="small">
              <el-radio value="left">左</el-radio>
              <el-radio value="right">右</el-radio>
              <el-radio value="top">上</el-radio>
            </el-radio-group>
          </el-form-item>
          <el-form-item label="Label宽度">
            <el-input v-model="model.current.options.labeloptions.labelwidth" size="small" placeholder="auto / 100px"></el-input>
          </el-form-item>
          <el-form-item v-if="model.current.component !== 'DynTable'" label="子控件尺寸">
            <el-radio-group v-model="model.current.options.comoptions.size" size="small">
              <el-radio value="default">默认</el-radio>
              <el-radio value="large">大</el-radio>
              <el-radio value="small">小</el-radio>
            </el-radio-group>
          </el-form-item>
          <el-form-item label="组件宽度">
            <el-input v-model="model.current.options.itemoptions.style.width" size="small" placeholder="100%"></el-input>
          </el-form-item>
          <el-form-item label="上边距">
            <el-input v-model="model.current.options.itemoptions.style.marginTop" size="small"></el-input>
          </el-form-item>
          <el-form-item label="下边距">
            <el-input v-model="model.current.options.itemoptions.style.marginBottom" size="small"></el-input>
          </el-form-item>
          <el-form-item label="自定义类名">
            <el-input v-model="model.current.options.itemoptions.class" size="small" placeholder="如 grid-span-2 可实现跨列"></el-input>
          </el-form-item>
        </el-form>

        <div class="px-3 pb-3">
          <div class="text-xs text-gray-500 mb-1">Style (JSON)</div>
          <textarea v-model="styleJsonText" @@blur="onStyleJsonBlur" rows="6"
                    class="w-full text-xs p-1 rounded"
                    style="font-family:monospace;border:1px solid #dcdfe6;min-height:80px;"></textarea>
          <div v-if="styleJsonError" class="text-xs text-red-500 mt-1">{{ styleJsonError }}</div>
        </div>
      </el-tab-pane>

      @* ===== 校验规则（规则数组，与组件 validators 直连） ===== *@
      <el-tab-pane label="校验" name="validate" class="overflow-y-auto">
        <div class="p-3">
          <div v-for="(rule, idx) in validators" :key="idx" class="border border-gray-200 rounded p-2 mb-2">
            <div class="flex items-center gap-1 mb-1">
              <el-select v-model="rule.type" size="small" class="flex-1" placeholder="选择规则">
                <el-option v-for="t in validatorTypes" :key="t.value" :label="t.label" :value="t.value"></el-option>
              </el-select>
              <el-button size="small" type="danger" link @@click="removeValidator(idx)">删除</el-button>
            </div>
            <el-input v-if="ruleNeedsValue(rule.type)" v-model="rule.value" size="small" class="mb-1"
                      :placeholder="validatorValuePlaceholder(rule.type)"></el-input>
            <el-input v-model="rule.message" size="small" placeholder="校验失败提示语（可空）"></el-input>
          </div>
          <el-button size="small" type="primary" plain class="w-full" @@click="addValidator">+ 新增校验规则</el-button>
          <div class="text-xs text-gray-400 mt-2 leading-5">
            支持：必填 / 邮箱 / 手机号 / 正则 / 最小最大值 / 最小长度 / 数字 / 自定义表达式。<br/>
            自定义的值填写返回布尔的 JS 表达式，可用变量 v（当前值）、model（表单数据）。
          </div>
        </div>
      </el-tab-pane>

      @* ===== 高级（联动脚本 evalCondition） ===== *@
      <el-tab-pane label="高级" name="advanced" class="overflow-y-auto">
        <div class="p-3">
          <div class="text-xs text-gray-500 mb-1">联动脚本 evalCondition（值变化时执行）</div>
          <textarea v-model="model.current.options.evalCondition" rows="8"
                    class="w-full text-xs p-1 rounded"
                    style="font-family:monospace;border:1px solid #dcdfe6;min-height:120px;"
                    placeholder="// ctx: { value, model, getByPath, safeGet }&#10;// 返回 { shell:{show:false}, labeloptions:{...}, comoptions:{...} } 动态控制显隐与属性"></textarea>
          <div class="text-xs text-gray-400 mt-2 leading-5">
            例：值为 1 时隐藏本组件：<br/>
            if(ctx.value===1) return { shell:{ show:false } };
          </div>
        </div>
      </el-tab-pane>
    </el-tabs>
  </template>

  <script tag="dynconfig">
  var dynConfig = {
    data: function () {
      return {
        propTab: 'base',
        comPropsActive: ['comAttr'],
        styleJsonError: '',
        validatorTypes: [
          { value: 'required', label: '必填' },
          { value: 'email', label: '邮箱格式' },
          { value: 'phone', label: '手机号格式' },
          { value: 'pattern', label: '正则表达式' },
          { value: 'min', label: '最小值' },
          { value: 'max', label: '最大值' },
          { value: 'length', label: '最小长度' },
          { value: 'number', label: '数字' },
          { value: 'custom', label: '自定义表达式' }
        ]
      };
    },
    computed: {
      isRequired: function () {
        var list = this.model.current && this.model.current.validators;
        return Array.isArray(list) && list.some(function (r) { return r && r.type === 'required'; });
      },
      validators: function () {
        if (!this.model.current.validators || !Array.isArray(this.model.current.validators)) {
          this.model.current.validators = [];
        }
        return this.model.current.validators;
      },
      comProps: function () {
        var cur = this.model.current;
        if (!cur) return null;
        var m = window.DynDesignerOps.metaOf(cur.component);
        if (!m) return null;
        var pj = m.PropertyConfigJson;
        if (!pj) return null;
        try {
          var parsed = typeof pj === 'string' ? JSON.parse(pj) : pj;
          if (parsed && parsed.component) {
            // 右侧属性面板统一 small + 左右label布局：
            // 作用于属性编辑器【容器】自身，容器再经 options.compassthrough 白名单
            // 把 comoptions.size / labeloptions.labelposition|labelwidth 向下 provide 给各属性条目
            if (!parsed.options) parsed.options = {};
            if (!parsed.options.comoptions) parsed.options.comoptions = {};
            if (!parsed.options.comoptions.size) parsed.options.comoptions.size = 'small';
            if (!parsed.options.labeloptions) parsed.options.labeloptions = {};
            if (!parsed.options.labeloptions.labelposition) parsed.options.labeloptions.labelposition = 'left';
            if (!parsed.options.labeloptions.labelwidth) parsed.options.labeloptions.labelwidth = '90px';
            return parsed;
          }
          return null;
        } catch (e) {
          console.warn('PropertyConfigJson parse error:', e);
          return null;
        }
      },
      propKey: function () {
        var c = this.model.current;
        return c ? (c.component + '_' + (c.__uid || 0)) : 'none';
      },
      componentGroups: function () {
        var list = this.model.componentMetaList || [];
        var map = {};
        list.forEach(function (m) {
          if (!m.ComponentName) return;
          var g = m.UiPlatform || '通用';
          if (!map[g]) map[g] = { group: g, items: [] };
          map[g].items.push(m);
        });
        // 排序：通用在前，然后按平台
        var keys = Object.keys(map).sort(function (a, b) {
          if (a === 'Common') return -1;
          if (b === 'Common') return 1;
          return a.localeCompare(b);
        });
        return keys.map(function (k) { return map[k]; });
      },
      styleJsonText: {
        get: function () {
          var s = this.model.current && this.model.current.options && this.model.current.options.itemoptions && this.model.current.options.itemoptions.style;
          if (!s) return '{}';
          try { return JSON.stringify(s, null, 2); } catch (e) { return '{}'; }
        },
        set: function (v) { this._styleText = v; }
      }
    },
    methods: {
      ruleNeedsValue: function (type) {
        return ['pattern', 'min', 'max', 'length', 'custom'].indexOf(type) >= 0;
      },
      validatorValuePlaceholder: function (type) {
        if (type === 'pattern') return '正则，如 ^1[3-9]\\d{9}$';
        if (type === 'min') return '最小值（数字）';
        if (type === 'max') return '最大值（数字）';
        if (type === 'length') return '最小长度';
        if (type === 'custom') return '如 v && v.length>=2';
        return '';
      },
      addValidator: function () {
        if (!this.model.current.validators) this.model.current.validators = [];
        this.model.current.validators.push({ type: 'required', message: '' });
        this.syncRequiredFlag();
      },
      removeValidator: function (idx) {
        this.model.current.validators.splice(idx, 1);
        this.syncRequiredFlag();
      },
      onRequiredChange: function (val) {
        if (!this.model.current.validators) this.model.current.validators = [];
        var idx = this.model.current.validators.findIndex(function (r) { return r && r.type === 'required'; });
        if (val) {
          if (idx < 0) this.model.current.validators.unshift({ type: 'required', message: '该项为必填项' });
        } else if (idx >= 0) {
          this.model.current.validators.splice(idx, 1);
        }
        this.syncRequiredFlag();
      },
      // 必填开关与 labeloptions.required 保持同步（标签红星/运行时校验共用）
      syncRequiredFlag: function () {
        var cur = this.model.current;
        if (!cur || !cur.options) return;
        if (!cur.options.labeloptions) cur.options.labeloptions = {};
        cur.options.labeloptions.required = this.isRequired;
      },
      onComponentTypeChange: function (newName) {
        var cur = this.model.current;
        if (!cur || !newName || cur.component === newName) return;
        var m = window.DynDesignerOps.metaOf(newName);
        if (!m) return;
        // 保留布局配置和modelname
        var keepItemOptions = cur.options && cur.options.itemoptions ? JSON.parse(JSON.stringify(cur.options.itemoptions)) : {};
        var keepModelName = cur.modelname || '';
        var keepValidators = cur.validators || [];
        var keepChildren = cur.childrenctrls || [];
        // 加载新组件默认配置
        var defaultCfg = m.DefaultConfigJson ?
          (typeof m.DefaultConfigJson === 'string' ? JSON.parse(m.DefaultConfigJson) : m.DefaultConfigJson)
          : { component: newName, options: {} };
        // 应用新配置
        cur.component = newName;
        cur.modelname = keepModelName;
        cur.options = defaultCfg.options || {};
        // 恢复布局配置
        if (Object.keys(keepItemOptions).length > 0) {
          cur.options.itemoptions = keepItemOptions;
        }
        // 恢复校验和子组件
        cur.validators = keepValidators;
        // 容器才保留子组件，非容器清空
        if (!window.DynDesignerOps.isContainer(newName)) {
          cur.childrenctrls = [];
        } else {
          cur.childrenctrls = keepChildren;
        }
      },
      onStyleJsonBlur: function () {
        this.styleJsonError = '';
        try {
          var obj = JSON.parse(this._styleText || this.styleJsonText || '{}');
          if (!this.model.current.options) this.model.current.options = {};
          if (!this.model.current.options.itemoptions) this.model.current.options.itemoptions = {};
          this.model.current.options.itemoptions.style = obj;
        } catch (e) {
          this.styleJsonError = 'JSON格式错误: ' + e.message;
        }
      }
    },
    watch: {
      // 规则增删/类型变化时同步必填星标
      'model.current.validators': {
        handler: function () { this.syncRequiredFlag(); },
        deep: true
      }
    }
  };
  </script>
</aside>
