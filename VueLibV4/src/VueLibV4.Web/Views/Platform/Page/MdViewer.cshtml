@{
    ViewData["Title"] = (string)(ViewBag.MdName ?? "文档") + " - VueLibV4";
}
@*
  Markdown 文档查看器：
  · 后端 MdViewer action 已按路径读 docs 目录内 md（安全限制在 docs 内），内容放 ViewBag.MdContent
  · 前端用 markdown-it（wwwroot/lib/markdown-it.min.js）渲染为 HTML
  · 样式为 GitHub 风格（标题 / 列表 / 表格 / 代码块 / 引用 / 图片）
*@
<script src="/lib/markdown-it.min.js"></script>
<div data-dyn-init-createapp class="md-app">
    <div class="md-shell">
        <div class="md-toolbar">
            <span class="md-title">📄 {{ mdName }}</span>
            <span class="md-path">{{ mdPath }}</span>
        </div>
        <div class="md-body" v-html="mdHtml"></div>
    </div>

    <script tag="dynconfig">
    var dynConfig = {
        data: function () {
            return { mdName: '@Html.Raw(ViewBag.MdName)', mdPath: '@Html.Raw(ViewBag.MdPath)', mdHtml: '' };
        },
        mounted: function () {
            try {
                var md = window.markdownit({
                    html: true,
                    linkify: true,
                    typographer: false,
                    breaks: true
                });
                var src = @Html.Raw(Json.Serialize(ViewBag.MdContent));
                this.mdHtml = md.render(src || '');
            } catch (e) {
                this.mdHtml = '<div style="color:#d33;padding:20px;">文档渲染失败：' + (e && e.message || e) + '</div>';
            }
        }
    };
    </script>
</div>

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: -apple-system, 'Segoe UI', 'Microsoft YaHei', sans-serif;
        background: #f6f8fa;
    }

    .md-shell {
        max-width: 920px;
        margin: 0 auto;
        padding: 0 16px 40px;
    }

    .md-toolbar {
        display: flex;
        align-items: baseline;
        gap: 12px;
        padding: 18px 4px 8px;
        border-bottom: 1px solid #e1e4e8;
        margin-bottom: 16px;
        position: sticky;
        top: 0;
        background: #f6f8fa;
        z-index: 10;
    }

    .md-title {
        font-size: 18px;
        font-weight: 600;
        color: #24292f;
    }

    .md-path {
        font-size: 12px;
        color: #6e7781;
        word-break: break-all;
    }

    .md-body {
        background: #fff;
        border: 1px solid #d0d7de;
        border-radius: 8px;
        padding: 24px 32px;
        line-height: 1.7;
        color: #24292f;
        font-size: 14px;
    }

    .md-body h1,
    .md-body h2,
    .md-body h3,
    .md-body h4 {
        margin: 24px 0 12px;
        line-height: 1.3;
        border-bottom: 1px solid #eaeef2;
        padding-bottom: 6px;
    }

    .md-body h1 { font-size: 26px; }
    .md-body h2 { font-size: 21px; }
    .md-body h3 { font-size: 17px; }
    .md-body h4 { font-size: 15px; }

    .md-body p {
        margin: 10px 0;
    }

    .md-body a {
        color: #0969da;
        text-decoration: none;
    }

    .md-body a:hover { text-decoration: underline; }

    .md-body ul,
    .md-body ol {
        padding-left: 26px;
        margin: 10px 0;
    }

    .md-body li { margin: 4px 0; }

    .md-body code {
        background: #eff1f3;
        border-radius: 4px;
        padding: 2px 5px;
        font-family: Consolas, Monaco, monospace;
        font-size: 12.5px;
        color: #c7254e;
    }

    .md-body pre {
        background: #f6f8fa;
        border: 1px solid #d0d7de;
        border-radius: 6px;
        padding: 14px 16px;
        overflow: auto;
        margin: 12px 0;
    }

    .md-body pre code {
        background: none;
        padding: 0;
        color: #24292f;
        font-size: 13px;
        line-height: 1.55;
        display: block;
    }

    .md-body blockquote {
        border-left: 4px solid #d0d7de;
        padding: 2px 14px;
        margin: 12px 0;
        color: #57606a;
        background: #f6f8fa;
        border-radius: 0 4px 4px 0;
    }

    .md-body table {
        border-collapse: collapse;
        margin: 14px 0;
        width: 100%;
        display: block;
        overflow-x: auto;
    }

    .md-body th,
    .md-body td {
        border: 1px solid #d0d7de;
        padding: 7px 13px;
        font-size: 13.5px;
    }

    .md-body th {
        background: #f6f8fa;
        font-weight: 600;
    }

    .md-body img {
        max-width: 100%;
        border-radius: 4px;
    }

    .md-body hr {
        border: none;
        border-top: 1px solid #d0d7de;
        margin: 20px 0;
    }

    .md-body h1:first-child {
        margin-top: 4px;
    }
</style>
