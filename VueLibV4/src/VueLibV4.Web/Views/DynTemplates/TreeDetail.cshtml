@model VueLibV4.Platform.Models.DynWebPage
@using VueLibV4.Platform.Services
@using VueLibV4.Services.Extensions
@using VueLibV4.Web.Core
@using Newtonsoft.Json.Linq
@inject IPageSettingService PageSettingService
@{
    // =====================================================================================
    // 通用树形管理模板（tree-detail）：左树 + 可拖拽分隔条 + 右侧明细表单。
    //   本模板【自身是一个 VueApp】（左树有真实动态 UI），但它与右侧 DetailApp 是【平级协作】：
    //     - 左树 app（data-blk-role=tree）：内聚组树/搜索/拖拽排序/分隔条；对外只发
    //         事件 nodeClick{row} / addRoot{} / addChild{preFill}，并接受命令 reload。
    //     - 右表单 DetailApp（独立 BlockApp）：保存/删除成功只 emit saved。
    //     - 两个 app 的 DOM 子树不相交（.tr-pane-left 与 .tr-pane-right 是纯布局兄弟节点，
    //       gutter 也是布局元素）；关系由本模板 Scripts 段的句柄接线显式表达：
    //         tree.nodeClick/addRoot/addChild → detail.editForm/newForm；detail.saved → tree.reload
    //   实例参数（ParamsJson）：树自身参数在顶层（TableName/KeyField/ParentField/TitleField/
    //     IconField/SortField/ListUrl/EditUrl(拖拽排序)/LeftWidth/EnableDrag/DragSameLevelOnly）；
    //     右侧表单走 blocks.detail 槽位 {settingId,model:{addUrl/editUrl/deleteUrl}}；旧扁平键自动回退。
    // =====================================================================================
    Layout = "_Layout";
    ViewData["Title"] = Model.Name + " - VueLibV4";

    var ps = DynPageViewHelper.ParseParams(Model.ParamsJson);
    static string? Top(JObject o, string k)
    {
        var v = o[k];
        return v == null || v.Type == JTokenType.Null ? null : v.ToString();
    }
    var tableName = Top(ps, "TableName") ?? "";
    var keyField = Top(ps, "KeyField") ?? "Id";
    var parentField = Top(ps, "ParentField") ?? "ParentId";
    var titleField = Top(ps, "TitleField") ?? "Name";
    var iconField = Top(ps, "IconField") ?? "Icon";
    var sortField = Top(ps, "SortField") ?? "SortNo";
    var project = Model.ProjectId?.ToString() ?? "";
    var loadUrl = DynPageViewHelper.UrlOr(Top(ps, "ListUrl"), DynPageViewHelper.BizSearch);
    // 树拖拽排序保存接口走模板自身参数；右侧 DetailApp 的接口走 detail 槽位（旧扁平 AddUrl/EditUrl/DeleteUrl 同键回退）
    var treeEditUrl = DynPageViewHelper.UrlOr(Top(ps, "EditUrl"), DynPageViewHelper.BizUpdate);
    var addUrl = DynPageViewHelper.UrlOr(DynPageViewHelper.SlotValue(ps, "detail", "addUrl", "AddUrl"), DynPageViewHelper.BizInsert);
    var editUrl = DynPageViewHelper.UrlOr(DynPageViewHelper.SlotValue(ps, "detail", "editUrl", "EditUrl"), DynPageViewHelper.BizUpdate);
    var deleteUrl = DynPageViewHelper.UrlOr(DynPageViewHelper.SlotValue(ps, "detail", "deleteUrl", "DeleteUrl"), DynPageViewHelper.BizDelete);
    var leftWidth = int.TryParse(Top(ps, "LeftWidth") ?? "30", out int lw) ? lw : 30;
    static bool ParseBool(string v)
    {
        if (string.IsNullOrWhiteSpace(v)) return false;
        if (v.Trim() == "1" || string.Equals(v.Trim(), "true", StringComparison.OrdinalIgnoreCase)) return true;
        return false;
    }
    var enableDrag = ParseBool(Top(ps, "EnableDrag"));
    var dragSameLevelOnly = ParseBool(Top(ps, "DragSameLevelOnly"));
    var detailPsId = DynPageViewHelper.SlotSettingId(ps, "detail", "DetailPageSettingId");

    // 左树 app 自读配置（dynmodel 承载）
    var treeParams = new JObject
    {
        ["table"] = tableName, ["keyField"] = keyField, ["parentField"] = parentField,
        ["titleField"] = titleField, ["iconField"] = iconField, ["sortField"] = sortField,
        ["loadUrl"] = loadUrl, ["editUrl"] = treeEditUrl, ["project"] = project,
        ["enableDrag"] = enableDrag, ["dragSameLevelOnly"] = dragSameLevelOnly
    };
    var treeModelForScript = DynPageViewHelper.SafeJson(new JObject { ["treeParams"] = treeParams });

    // 右侧 DetailApp 的唯一输入
    var detailCfg = new JObject();
    DynPageViewHelper.ApplyFrontSetting(detailCfg, PageSettingService, detailPsId, "detailConfig", "detailDefault");
    detailCfg["table"] = tableName;
    detailCfg["project"] = project;
    detailCfg["addUrl"] = addUrl;
    detailCfg["editUrl"] = editUrl;
    detailCfg["deleteUrl"] = deleteUrl;
    detailCfg["keyField"] = keyField;

    var extId = "Ttr" + Guid.NewGuid().ToString("N");
    var extIdTree = extId + "-tree";
    var extIdSplit = extId + "-split";
    var extIdGutter = extId + "-gutter";
    var extIdDetail = extId + "-detail";
    var title = Model.Name;
    var showDesignEntry = Convert.ToBoolean(ViewData["ShowDesignEntry"] ?? false);

    // 页面级统一参数声明（L1 静态层）：左树 app 与右侧 DetailApp 经父链共享
    var pageParams = new JObject
    {
        ["tableName"] = tableName,
        ["keyField"] = keyField,
        ["parentField"] = parentField,
        ["titleField"] = titleField,
        ["project"] = project
    };
}
<div class="tr-root" data-dyn-params="@DynPageViewHelper.SafeJson(pageParams)">
    @await Html.PartialAsync("~/Views/DynTemplates/Partials/DynPageHeader.cshtml", new ViewDataDictionary(ViewData) {
        ["Title"] = title, ["Code"] = "tree-detail", ["TableName"] = tableName,
        ["ShowBack"] = true, ["ShowDesign"] = showDesignEntry, ["PageId"] = Model.Id.ToString()
    })

    <div class="tr-split" id="@extIdSplit">
        @* ===== 左树：模板自身的 app（有真实 UI），与右侧 DetailApp 平级、DOM 子树不相交 ===== *@
        <div id="@extIdTree" data-dyn-mode="createApp" data-blk-role="tree" class="tr-pane-left" style="width:@(leftWidth)%">
            <script type="application/json" tag="dynmodel">@Html.Raw(treeModelForScript)</script>
            <script type="text/plain" tag="dynconfig">
            var dynConfig = {
                data: function () {
                    var tp = this.model.treeParams || {};
                    return {
                        title: '@title',
                        tableName: tp.table || '',
                        keyField: tp.keyField || 'Id',
                        parentField: tp.parentField || 'ParentId',
                        titleField: tp.titleField || 'Name',
                        iconField: tp.iconField || 'Icon',
                        sortField: tp.sortField || 'SortNo',
                        loadUrl: tp.loadUrl || '/api/business/dyndata/search',
                        editUrl: tp.editUrl || '/api/business/dyndata/update',
                        project: tp.project || '',
                        enableDrag: tp.enableDrag === true || tp.enableDrag === 'true',
                        dragSameLevelOnly: tp.dragSameLevelOnly === true || tp.dragSameLevelOnly === 'true',
                        treeData: [], treeLoading: false, filterText: '',
                        treeKey: 0,
                        split: @leftWidth,
                        current: null
                    };
                },
                computed: {
                    filteredTreeData: function () {
                        var val = this.filterText || '';
                        if (!val) return this.treeData;
                        var tf = this.titleField;
                        function walk(list) {
                            var out = [];
                            list.forEach(function (n) {
                                var hit = String(n[tf] || '').indexOf(val) !== -1;
                                var kids = (n.children && n.children.length) ? walk(n.children) : [];
                                if (hit || kids.length) { var c = Object.assign({}, n, { children: kids }); out.push(c); }
                            });
                            return out;
                        }
                        return walk(this.treeData);
                    }
                },
                watch: {
                    treeKey: function () { var self = this; this.$nextTick(function () { if (self.enableDrag) self.initSortable(); }); }
                },
                methods: {
                    // ---------------- 树数据：组树 + 加载 ----------------
                    buildTree: function (rows) {
                        var p = { keyField: this.keyField, parentField: this.parentField, sortField: this.sortField };
                        var map = {}, roots = [];
                        rows.forEach(function (r) { map[r[p.keyField]] = Object.assign({}, r, { children: [], __key: String(r[p.keyField]) }); });
                        rows.forEach(function (r) {
                            var node = map[r[p.keyField]];
                            var pid = r[p.parentField];
                            var parent = (pid !== null && pid !== undefined && pid !== '') ? map[pid] : null;
                            if (parent) parent.children.push(node); else roots.push(node);
                        });
                        (function sort(list) {
                            list.sort(function (a, b) { return ((a[p.sortField] != null ? a[p.sortField] : 0) - (b[p.sortField] != null ? b[p.sortField] : 0)); });
                            list.forEach(function (n) { if (n.children && n.children.length) sort(n.children); });
                        })(roots);
                        return roots;
                    },
                    loadTree: function () {
                        var self = this;
                        this.treeLoading = true;
                        DynBlocks.search(this.loadUrl, {
                            table: this.tableName, page: 1, size: 100000,
                            sort: { field: this.sortField, order: 'asc' }, project: this.project
                        }, element).then(function (res) {
                            var rows = (res && res.rows) || (res && res.data && res.data.rows) || [];
                            self.treeData = self.buildTree(rows);
                            self.treeKey = self.treeKey + 1;
                            self.scheduleInitSortable();
                        }).catch(function () { dyn.showMessage('加载树失败', 'error'); })
                          .finally(function () { self.treeLoading = false; });
                    },
                    // ---------------- 对外事件（只报告"发生了什么"，如何响应由模板接线） ----------------
                    onNodeClick: function (data) { this.current = data; this.__handle.emit('nodeClick', { row: data }); },
                    onAddRoot: function () { this.current = null; this.__handle.emit('addRoot', {}); },
                    onAddChild: function () {
                        var c = this.current;
                        if (!c || c[this.keyField] === null || c[this.keyField] === undefined || c[this.keyField] === '') {
                            dyn.showMessage('请先选择一个父节点', 'warning'); return;
                        }
                        var pre = {}; pre[this.parentField] = c[this.keyField];
                        this.__handle.emit('addChild', { preFill: pre });
                    },
                    resetSplit: function () {
                        this.split = @leftWidth;
                        element.style.width = '@(leftWidth)%';
                    },
                    // ---------------- 分隔条拖拽 ----------------
                    _dragStart: null,
                    onDragStart: function (e) {
                        e.preventDefault();
                        this._dragStart = { x: e.clientX, w: element.getBoundingClientRect().width, split: this.split };
                        document.body.style.userSelect = 'none';
                    },
                    onDragMove: function (e) {
                        if (!this._dragStart) return;
                        var dx = e.clientX - this._dragStart.x;
                        var pct = (this._dragStart.w > 0) ? (this._dragStart.w * this._dragStart.split / 100 + dx) / this._dragStart.w * 100 : this.split;
                        this.split = Math.min(60, Math.max(18, pct));
                        element.style.width = this.split + '%';
                    },
                    onDragEnd: function () {
                        if (!this._dragStart) return;
                        this._dragStart = null;
                        document.body.style.userSelect = '';
                    },
                    // ---------------- 拖拽排序（Sortable） ----------------
                    initSortable: function () {
                        if (!this.enableDrag) return;
                        var self = this;
                        this.destroySortable();
                        var treeRef = this.$refs.treeEl;
                        if (!treeRef || !treeRef.$el) return;
                        if (typeof Sortable === 'undefined') { dyn.showMessage('拖拽组件未加载', 'error'); return; }
                        var rootEl = treeRef.$el;
                        var lists = [rootEl];
                        rootEl.querySelectorAll('.el-tree-node__children').forEach(function (l) { lists.push(l); });
                        this._sortables = [];
                        lists.forEach(function (list) {
                            if (!list || !list.querySelectorAll) return;
                            var s = Sortable.create(list, {
                                group: 'dyn-tree-sort',
                                animation: 150,
                                handle: '.tr-node',
                                forceFallback: true,
                                fallbackOnBody: true,
                                fallbackTolerance: 2,
                                ghostClass: 'dyn-tree-ghost',
                                chosenClass: 'dyn-tree-chosen',
                                dragClass: 'dyn-tree-drag',
                                onMove: function (evt) {
                                    if (self.filterText) return false;
                                    if (self.dragSameLevelOnly && evt.from !== evt.to) return false;
                                    var dragged = evt.dragged;
                                    if (dragged && evt.to && (evt.to === dragged || dragged.contains(evt.to))) return false;
                                    return true;
                                },
                                onStart: function () {
                                    document.body.style.userSelect = 'none';
                                    document.body.style.webkitUserSelect = 'none';
                                    document.body.style.mozUserSelect = 'none';
                                },
                                onEnd: function () {
                                    document.body.style.userSelect = '';
                                    document.body.style.webkitUserSelect = '';
                                    document.body.style.mozUserSelect = '';
                                    self.saveOrder(arguments[0]);
                                }
                            });
                            self._sortables.push(s);
                        });
                    },
                    destroySortable: function () {
                        if (this._sortables) { this._sortables.forEach(function (s) { try { s.destroy(); } catch (e) { } }); this._sortables = []; }
                    },
                    scheduleInitSortable: function () {
                        var self = this;
                        if (!this.enableDrag) return;
                        var tries = 0;
                        (function tryInit() {
                            tries++;
                            var treeRef = self.$refs.treeEl;
                            var ready = treeRef && treeRef.$el && treeRef.$el.querySelectorAll('.el-tree-node__children').length > 0;
                            if (ready) { self.initSortable(); return; }
                            if (tries <= 10) setTimeout(tryInit, 120);
                        })();
                    },
                    parentKeyOfList: function (listEl) {
                        if (!listEl) return '';
                        if (listEl.classList && listEl.classList.contains('el-tree')) return '';
                        var nodeEl = listEl.closest ? listEl.closest('.el-tree-node') : null;
                        if (!nodeEl) return '';
                        var keyEl = nodeEl.querySelector(':scope > .el-tree-node__content [data-key]')
                                  || nodeEl.querySelector('[data-key]');
                        return keyEl ? keyEl.getAttribute('data-key') : '';
                    },
                    buildParentMap: function () {
                        var map = {};
                        (function walk(list, parentKey) {
                            (list || []).forEach(function (n) {
                                map[n.__key] = parentKey || '';
                                if (n.children && n.children.length) walk(n.children, n.__key);
                            });
                        })(this.treeData, '');
                        return map;
                    },
                    collectOrder: function (listEl, updates) {
                        var parent = this.parentKeyOfList(listEl);
                        var nodes = listEl.querySelectorAll(':scope > .el-tree-node');
                        for (var i = 0; i < nodes.length; i++) {
                            var keyEl = nodes[i].querySelector(':scope > .el-tree-node__content [data-key]')
                                     || nodes[i].querySelector('[data-key]');
                            var key = keyEl ? keyEl.getAttribute('data-key') : '';
                            if (!key) continue;
                            updates[key] = { key: key, sortNo: (i + 1) * 100, parent: parent };
                        }
                    },
                    saveOrder: function (evt) {
                        var self = this;
                        if (!evt || !evt.from) return;
                        var updates = {};
                        this.collectOrder(evt.from, updates);
                        if (evt.to && evt.to !== evt.from) this.collectOrder(evt.to, updates);
                        var keys = Object.keys(updates);
                        if (!keys.length) { this.loadTree(); return; }
                        var currentParent = this.buildParentMap();
                        var saveStyle = DynBlocks.apiStyle(self.editUrl);
                        var saveUrl = DynBlocks.saveUrl(saveStyle, self.editUrl, self.tableName, true);
                        var tasks = keys.map(function (k) {
                            var u = updates[k];
                            var oldParent = currentParent[k] != null ? currentParent[k] : '';
                            var parentChanged = oldParent !== (u.parent || '');
                            var flat = {};
                            flat[self.keyField] = u.key;
                            flat[self.sortField] = Number(u.sortNo);
                            if (parentChanged) flat[self.parentField] = u.parent || null;
                            return {
                                url: saveUrl,
                                body: DynBlocks.savePayload(saveStyle, self.tableName, flat, self.project)
                            };
                        });
                        // 串行提交：SQLite 并发写会 database is locked
                        var chain = Promise.resolve();
                        tasks.forEach(function (t) {
                            chain = chain.then(function () {
                                return DynCall.post(t.url, t.body, { scopeEl: element, silent: true });
                            });
                        });
                        chain.then(function () {
                            dyn.showMessage('排序已保存', 'success');
                            self.loadTree();
                        }).catch(function (e) {
                            dyn.showMessage('排序保存失败，已还原：' + ((e && e.message) || e), 'error');
                            self.loadTree();
                        });
                    }
                },
                mounted: function () {
                    var self = this;
                    // 实例句柄：对外 nodeClick/addRoot/addChild 事件 + reload 命令；不持有任何其他 app 的引用
                    this.__handle = DynBlocks.createBlockHandle(element);
                    this.__handle.reg('reload', function () { return self.loadTree(); });

                    // 分隔条拖拽（gutter 是树 app 之外的纯布局元素，用 id 绑定）
                    var gutterEl = document.getElementById('@extIdGutter');
                    var splitEl = document.getElementById('@extIdSplit');
                    self.__onGutterDown = function (e) { self.onDragStart(e); };
                    self.__onGutterDblClick = function () { self.resetSplit(); };
                    self.__onSplitMove = function (e) { self.onDragMove(e); };
                    self.__onWindowUp = function () { self.onDragEnd(); };
                    if (gutterEl) {
                        gutterEl.addEventListener('mousedown', self.__onGutterDown);
                        gutterEl.addEventListener('dblclick', self.__onGutterDblClick);
                    }
                    if (splitEl) splitEl.addEventListener('mousemove', self.__onSplitMove);
                    window.addEventListener('mouseup', self.__onWindowUp);
                    // mounted 只做自身首屏加载，不发对外事件
                    this.loadTree();
                },
                beforeUnmount: function () {
                    this.destroySortable();
                    var gutterEl = document.getElementById('@extIdGutter');
                    var splitEl = document.getElementById('@extIdSplit');
                    if (gutterEl && this.__onGutterDown) gutterEl.removeEventListener('mousedown', this.__onGutterDown);
                    if (gutterEl && this.__onGutterDblClick) gutterEl.removeEventListener('dblclick', this.__onGutterDblClick);
                    if (splitEl && this.__onSplitMove) splitEl.removeEventListener('mousemove', this.__onSplitMove);
                    if (this.__onWindowUp) window.removeEventListener('mouseup', this.__onWindowUp);
                    if (this.__handle) { this.__handle.destroy(); this.__handle = null; }
                }
            };
            </script>

            <div class="tr-pane-head">
                <span class="tr-pane-title">树</span>
                <div class="tr-pane-tools">
                    <el-button type="success" size="small" @@click="onAddRoot">+ 新增根</el-button>
                    <el-button type="primary" size="small" @@click="onAddChild" :disabled="!current">+ 子节点</el-button>
                    <el-button type="primary" size="small" text @@click="loadTree" :loading="treeLoading">刷新</el-button>
                </div>
            </div>
            <el-input v-model="filterText" placeholder="搜索节点" clearable size="small" style="margin-bottom:8px;width:100%;"></el-input>
            <div class="tr-tree-wrap">
                <el-tree ref="treeEl"
                         :key="treeKey"
                         :data="filteredTreeData"
                         :props="{ children: 'children', label: titleField }"
                         node-key="__key"
                         default-expand-all
                         highlight-current
                         :expand-on-click-node="false"
                         v-loading="treeLoading"
                         @@node-click="onNodeClick">
                    <template #default="{ data }">
                        <span class="tr-node" :data-key="data.__key" @@click.stop="onNodeClick(data)">
                            <span>{{ (data.children && data.children.length) ? (data[iconField] || '📁') : (data[iconField] || '📄') }}</span>
                            <span>{{ data[titleField] }}</span>
                            <el-tag v-if="data.IsActive === false || data.IsActive === 0" size="small" type="info" style="margin-left:4px">停用</el-tag>
                        </span>
                    </template>
                </el-tree>
            </div>
        </div>

        @* gutter：纯布局元素，不属于任何 app 的受管模板（双击复位由树 app mounted 原生绑定） *@
        <div class="tr-gutter" id="@extIdGutter" title="拖拽调整，双击复位">
            <span class="tr-gutter-bar"></span>
        </div>

        @* ===== 右表单：独立 DetailApp，与左树平级 ===== *@
        <div class="tr-pane-right">
            @await Html.PartialAsync("~/Views/DynBlocks/Apps/DetailApp.cshtml", new ViewDataDictionary(ViewData) {
                ["ExtId"] = extIdDetail, ["BlkConfig"] = DynPageViewHelper.SafeJson(detailCfg)
            })
        </div>
    </div>
</div>

<style>
    .tr-root { height: 100vh; box-sizing: border-box; display: flex; flex-direction: column;
        background: #f0f2f5; font-family: 'Helvetica Neue', Arial, 'PingFang SC', 'Microsoft YaHei', sans-serif; }
    .tr-split { flex: 1; min-height: 0; display: flex; margin: 14px; box-sizing: border-box; background: #fff; border: 1px solid #e4e7ed; border-radius: 8px; overflow: hidden; }
    .tr-pane-left { flex-shrink: 0; padding: 12px; box-sizing: border-box; overflow: hidden; display: flex; flex-direction: column; min-height: 0; }
    .tr-pane-right { flex: 1; padding: 12px 16px; box-sizing: border-box; overflow: auto; min-width: 0; }
    .tr-pane-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; }
    .tr-pane-tools { display: flex; align-items: center; gap: 4px; }
    .tr-pane-title { font-size: 13px; font-weight: 600; color: #303133; }
    .tr-tree-wrap { flex: 1; min-height: 0; overflow: auto; }
    .tr-gutter { flex-shrink: 0; width: 8px; cursor: col-resize; background: #f2f4f7; position: relative; display: flex; align-items: center; justify-content: center; }
    .tr-gutter:hover { background: #e4e7ed; }
    .tr-gutter-bar { width: 2px; height: 36px; border-radius: 2px; background: #c0c4cc; }
    .tr-node { display: inline-flex; align-items: center; gap: 4px; user-select: none; -webkit-user-select: none; -moz-user-select: none; -webkit-user-drag: none; -webkit-touch-callout: none; }
    /* ===== 拖拽排序占位/幽灵样式 ===== */
    .dyn-tree-ghost,
    body > .sortable-ghost,
    .sortable-ghost {
        opacity: 0.5;
        background: #d9ecff !important;
        border: 1px dashed #409eff !important;
        border-radius: 4px;
        box-sizing: border-box;
        min-width: 120px;
        min-height: 26px;
    }
    .dyn-tree-chosen { background: #ecf5ff; }
    .dyn-tree-drag { opacity: 0.9; }
    .tr-tree-wrap .sortable-placeholder,
    .tr-tree-wrap .sortable-ghost {
        height: 28px !important;
        background: #d9ecff !important;
        border: 1px dashed #409eff !important;
        border-radius: 4px !important;
        box-sizing: border-box !important;
        list-style: none;
    }
</style>

@section Scripts {
    <script src="~/dyn/blocks/dyn-blocks-common.js?v=2"></script>
    <script>
        DynLib.ready(function () {
            var tEl = document.getElementById('@extIdTree');
            var dEl = document.getElementById('@extIdDetail');

            // ===== 显式接线：左树 app 与右 DetailApp 平级，关系集中写在这里 =====
            window.Promise.all([window.dyn.mount(tEl), window.dyn.mount(dEl)]).then(function () {
                var tree = tEl.__dynBlock;
                var detail = dEl.__dynBlock;

                tree.on('nodeClick', function (p) { detail.send('editForm', { row: p.row }); });
                tree.on('addRoot', function () { detail.send('newForm', { preFill: {} }); });
                tree.on('addChild', function (p) { detail.send('newForm', { preFill: (p && p.preFill) || {} }); });
                // 表单保存/删除成功 → 刷新左树
                detail.on('saved', function () { tree.send('reload'); });

                console.log('[TreeDetail] 就绪（左树 app 与 DetailApp 平级 + 句柄接线）');
            });
        });
    </script>
}
