@model VueLibV4.Platform.Models.DynWebPage
@using VueLibV4.Platform.Services
@using VueLibV4.Services.Extensions
@using VueLibV4.Web.Core
@using Newtonsoft.Json.Linq
@inject IPageSettingService PageSettingService
@{
    // =====================================================================================
    // 三屏模板（triscreen-blocks）：纯布局 + 薄编排，本身【不是】 VueApp。
    //   Filter / List / Detail 三个 Block 各自独立 VueApp（Apps 目录），自读 data-blk-config。
    //   本模板只摆放三块 UI，并在 ready 里用实例句柄把关系显式接起来：
    //     filter.changed  → list.loadData
    //     list.add        → detail.newForm
    //     list.addChild   → detail.newForm(预填 ChildFkField)
    //     list.edit       → detail.editForm
    //     detail.saved    → list.reload（含新增/编辑/删除后刷新）
    //   Detail 常驻右侧（非弹窗）：cancel 事件无需外接（Block 内部已自行重置表单）。
    //   实例参数（ConfigJson）：TableName/ListUrl/AddUrl/EditUrl/DeleteUrl/
    //     FilterPageSettingId/ListPageSettingId/DetailPageSettingId/ChildFkField/KeyField
    // =====================================================================================
    Layout = "_Layout";
    ViewData["Title"] = Model.Name + " - VueLibV4";

    dynamic runTimeModel = ClayHelper.Parse(Model.ConfigJson ?? "{}");
    var tableName = ClayHelper.GetString(runTimeModel, "TableName") ?? "";
    var loadUrl = DynPageViewHelper.UrlOr(ClayHelper.GetString(runTimeModel, "ListUrl"), DynPageViewHelper.BizSearch);
    var addUrl = DynPageViewHelper.UrlOr(ClayHelper.GetString(runTimeModel, "AddUrl"), DynPageViewHelper.BizInsert);
    var editUrl = DynPageViewHelper.UrlOr(ClayHelper.GetString(runTimeModel, "EditUrl"), DynPageViewHelper.BizUpdate);
    var deleteUrl = DynPageViewHelper.UrlOr(ClayHelper.GetString(runTimeModel, "DeleteUrl"), DynPageViewHelper.BizDelete);
    var childFkField = ClayHelper.GetString(runTimeModel, "ChildFkField") ?? "";
    var keyField = ClayHelper.GetString(runTimeModel, "KeyField") ?? "Id";
    var project = Model.ProjectId?.ToString() ?? "";
    var filterPsId = int.TryParse(ClayHelper.GetString(runTimeModel, "FilterPageSettingId") ?? "", out int fv) ? fv : (int?)null;
    var listPsId = int.TryParse(ClayHelper.GetString(runTimeModel, "ListPageSettingId") ?? "", out int lv) ? lv : (int?)null;
    var detailPsId = int.TryParse(ClayHelper.GetString(runTimeModel, "DetailPageSettingId") ?? "", out int dv) ? dv : (int?)null;

    var filterCfg = new JObject();
    DynPageViewHelper.ApplyFrontSetting(filterCfg, PageSettingService, filterPsId, "filterConfig", "filterDefault");
    var listCfg = new JObject();
    DynPageViewHelper.ApplyListSetting(listCfg, PageSettingService, listPsId, "columns");
    listCfg["table"] = tableName;
    listCfg["keyField"] = keyField;
    listCfg["project"] = project;
    listCfg["loadUrl"] = loadUrl;
    listCfg["deleteUrl"] = deleteUrl;
    var detailCfg = new JObject();
    DynPageViewHelper.ApplyFrontSetting(detailCfg, PageSettingService, detailPsId, "detailConfig", "detailDefault");
    detailCfg["table"] = tableName;
    detailCfg["keyField"] = keyField;
    detailCfg["project"] = project;
    detailCfg["addUrl"] = addUrl;
    detailCfg["editUrl"] = editUrl;
    detailCfg["deleteUrl"] = deleteUrl;

    var extId = "Tsb" + Guid.NewGuid().ToString("N");
    var extIdFilter = extId + "-filter";
    var extIdList = extId + "-list";
    var extIdDetail = extId + "-detail";
    var title = Model.Name;
}
<div class="tsb-root">
    @await Html.PartialAsync("~/Views/DynTemplates/Partials/DynPageHeader.cshtml", new ViewDataDictionary(ViewData) {
        ["Title"] = title, ["Code"] = Model.Code, ["TableName"] = tableName
    })

    @* 布局卡片是纯 HTML 容器，不属于任何 app 的受管模板（避免外层 app 编译 Block 内部指令） *@
    <div class="tsb-card">
        @await Html.PartialAsync("~/Views/DynBlocks/Apps/FilterApp.cshtml", new ViewDataDictionary(ViewData) {
            ["ExtId"] = extIdFilter, ["BlkConfig"] = DynPageViewHelper.SafeJson(filterCfg)
        })
    </div>
    <div class="tsb-card">
        @await Html.PartialAsync("~/Views/DynBlocks/Apps/ListApp.cshtml", new ViewDataDictionary(ViewData) {
            ["ExtId"] = extIdList, ["BlkConfig"] = DynPageViewHelper.SafeJson(listCfg)
        })
    </div>
    <div class="tsb-card">
        @await Html.PartialAsync("~/Views/DynBlocks/Apps/DetailApp.cshtml", new ViewDataDictionary(ViewData) {
            ["ExtId"] = extIdDetail, ["BlkConfig"] = DynPageViewHelper.SafeJson(detailCfg)
        })
    </div>
</div>

<style>
    .tsb-root { min-height: 100vh; box-sizing: border-box; padding: 0 0 20px;
        background: #f0f2f5; font-family: 'Helvetica Neue', Arial, 'PingFang SC', 'Microsoft YaHei', sans-serif; }
    .tsb-card { background: #fff; margin: 14px 20px 0; padding: 14px 16px; border-radius: 8px; border: 1px solid #e4e7ed; }
</style>

@section Scripts {
    <script src="~/dyn/blocks/dyn-blocks-common.js?v=2"></script>
    <script>
        DynLib.ready(function () {
            var fEl = document.getElementById('@extIdFilter');
            var lEl = document.getElementById('@extIdList');
            var dEl = document.getElementById('@extIdDetail');

            var KEY_FIELD = '@keyField';
            var CHILD_FK_FIELD = '@childFkField';

            // 主子"+子"预填：父行主键 → 表单外键字段
            function childPreFill(row) {
                if (!CHILD_FK_FIELD || !row) return {};
                var pf = {}; pf[CHILD_FK_FIELD] = row[KEY_FIELD] || null; return pf;
            }

            // ===== 显式接线：三块 Block 互不认识，关系集中写在这里 =====
            window.Promise.all([window.dyn.mount(fEl), window.dyn.mount(lEl), window.dyn.mount(dEl)])
                .then(function () {
                    var filter = fEl.__dynBlock;
                    var list = lEl.__dynBlock;
                    var detail = dEl.__dynBlock;

                    filter.on('changed', function (params) {
                        list.send('loadData', { filter: params || {} });
                    });
                    list.on('add', function () { detail.send('newForm', { preFill: {} }); });
                    list.on('addChild', function (p) {
                        detail.send('newForm', { preFill: childPreFill(p && p.row) });
                    });
                    list.on('edit', function (p) { detail.send('editForm', { row: p.row }); });
                    // Detail 保存/删除成功 → 刷新列表（三屏形态不关窗）
                    detail.on('saved', function () { list.send('reload'); });

                    console.log('[TriScreenBlocks] 就绪（独立 BlockApp + 句柄接线）');
                });
        });
    </script>
}
