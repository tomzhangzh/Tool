@model VueLibV4.Web.Core.DynSharedModel
@{
    // =====================================================================================
    // 三屏组合模板（积木化·共享上下文版）：Filter / List / Detail 三块独立积木（各自独立 createApp），
    // 由本模板作为树根（TreeRoot）拼装。共享数据/通信不走 window 全局，也不依赖共享 scope：
    //   - 根 app（@extIdRoot, createApp）持有消息中心 + 模板自定义的业务配置 + 手写订阅转发
    //   - 根 model 的【业务 key 由本模板决定】：（filterCfg / listCfg / detailCfg 三个配置对象）
    //     唯一约定：消息中心固定放在 model.msgCenter（通信基础设施，属底层约定而非业务字段）
    //   - RenderPartial 三个 Block 时传入 RootExtId + ModelKey + MsgCenterKey（ViewData），
    //     Block 容器带 data-root-ext-id / data-model-key / data-msg-center-key
    //   - Block dynconfig 按 data-root-ext-id 用 dyn.getApp(根元素) 找到根 app，
    //     再按 data-model-key 动态读取对应配置对象、按 data-msg-center-key 读取消息中心
    //   - 挂载顺序：先 mount 根 app（写入配置 + 消息中心）→ 再 mount 三个积木（读根 app model）
    // 积木之间不直接通信，一律经消息中心；积木不关心自己被放哪（面板/弹窗/行展开）。
    // 数据来源：DynSharedModel（EffectiveParams 已含 TableName/ListUrl/AddUrl/EditUrl/DeleteUrl 及三屏 PageSettingId）。
    // =====================================================================================
    Layout = "_Layout";
    ViewData["Title"] = Model.PageTitle + " - VueLibV4";
    var sharedJson = Newtonsoft.Json.JsonConvert.SerializeObject(Model, new Newtonsoft.Json.JsonSerializerSettings
    {
        NullValueHandling = Newtonsoft.Json.NullValueHandling.Ignore,
        ReferenceLoopHandling = Newtonsoft.Json.ReferenceLoopHandling.Ignore
    });
    var extId = "Tsb" + Guid.NewGuid().ToString("N");
    var extIdRoot = extId + "-root";
    var extIdFilter = extId + "-filter";
    var extIdList = extId + "-list";
    var extIdDetail = extId + "-detail";
    var ep = Model.EffectiveParams;
    var title = Model.PageTitle;
    var tableName = (ep != null && ep.TryGetValue("TableName", out var t) ? t?.ToString() : null) ?? "";
    // 供注入 script 使用：把 JSON 中的 "</" 转义为 "<\/"（合法 JSON，防止内联 script 提前闭合）
    var sharedForScript = sharedJson.Replace("</", "<\\/");
}
<div class="tsb-root">
    <div class="tsb-head">
        <span class="tsb-title">@title</span>
        <el-tag size="small" type="info" effect="plain">@Model.TemplateCode</el-tag>
        <el-tag size="small" type="warning" effect="plain">@tableName</el-tag>
    </div>

    @* 根 app：共享上下文宿主（承载 shared 配置 + 消息中心 + 手写订阅转发），本身无可见 UI *@
    <div id="@extIdRoot" data-dyn-mode="createApp" class="tsb-rootapp">
        <script tag="dynconfig">
        // 根 app 的 dynconfig：mount 时把共享上下文写入自身 model（Filter/List/Detail 经 data-root-ext-id 找到本根 app 读取）
        var __shared = @Html.Raw(sharedForScript);
        function __parseJson(s, def) { try { var o = JSON.parse(s || 'null'); return o || def; } catch (e) { return def; } }
        var dynConfig = {
            methods: {
                // 主从预填：若实例参数配置了 ChildFkField，把当前行主键预填到表单该字段
                childPreFill: function (row) {
                    var fk = this.model.childFkField;
                    if (!fk) return {};
                    var pf = {}; pf[fk] = row ? row.Id : null; return pf;
                }
            },
            mounted: function () {
                var m = this.model;
                var ep = __shared.EffectiveParams || {};
                var table = ep.TableName || '';
                var loadUrl = ep.ListUrl || '';
                var addUrl = ep.AddUrl || '';
                var editUrl = ep.EditUrl || '';
                var deleteUrl = ep.DeleteUrl || '';
                var childFkField = ep.ChildFkField || '';
                // ===== 消息中心：固定 key 'msgCenter'（通信基础设施，Block 经 data-msg-center-key 读取）=====
                m.msgCenter = createMessageCenter();
                // ===== 模板自定义业务配置 key：Block 经 data-model-key 动态读取，名字由本模板决定，非平台硬编码 =====
                m.filterCfg = {
                    filterConfig: __shared.FilterConfig || null,
                    filterDefault: __parseJson(__shared.FilterDefaultJson, {})
                };
                m.listCfg = {
                    columns: (__shared.ListConfig && __shared.ListConfig.columns) || [],
                    table: table, loadUrl: loadUrl, deleteUrl: deleteUrl
                };
                m.detailCfg = {
                    detailConfig: __shared.DetailConfig || null,
                    detailDefault: __parseJson(__shared.DetailDefaultJson, {}),
                    table: table, addUrl: addUrl, editUrl: editUrl
                };
                m.childFkField = childFkField;
                var msg = m.msgCenter;
                var self = this;
                self.__unsubs = [];
                // ========== 手写订阅转发（树根接线）：见文件头注释 ==========
                self.__unsubs.push(msg.subscribeEvent('filter.changed', function (p) {
                    msg.sendCommand('list', { cmd: 'loadData', filter: p.params });
                }));
                self.__unsubs.push(msg.subscribeEvent('list.add', function () {
                    msg.sendCommand('detail', { cmd: 'newForm', preFill: {} });
                }));
                self.__unsubs.push(msg.subscribeEvent('list.addChild', function (p) {
                    msg.sendCommand('detail', { cmd: 'newForm', preFill: self.childPreFill(p.row) });
                }));
                self.__unsubs.push(msg.subscribeEvent('list.edit', function (p) {
                    msg.sendCommand('detail', { cmd: 'editForm', row: p.row });
                }));
                self.__unsubs.push(msg.subscribeEvent('detail.saved', function () {
                    msg.sendCommand('list', { cmd: 'reload' });
                }));
                console.log('[TriScreenBlocks] 三屏共享上下文已就绪');
            },
            beforeUnmount: function () {
                // 生命周期清理：注销全部订阅 + 销毁消息中心
                if (this.__unsubs) { this.__unsubs.forEach(function (f) { try { f(); } catch (e) { } }); this.__unsubs = []; }
                if (this.model && this.model.msgCenter) { try { this.model.msgCenter.destroy(); } catch (e) { } this.model.msgCenter = null; }
            }
        };
        </script>
    </div>

    <div class="tsb-card">
        @await Html.PartialAsync("~/Views/DynBlocks/FilterBlock.cshtml", new ViewDataDictionary(ViewData) {
            { "ExtId", extIdFilter }, { "RootExtId", extIdRoot }, { "ModelKey", "filterCfg" }, { "MsgCenterKey", "msgCenter" } })
    </div>
    <div class="tsb-card">
        @await Html.PartialAsync("~/Views/DynBlocks/ListBlock.cshtml", new ViewDataDictionary(ViewData) {
            { "ExtId", extIdList }, { "RootExtId", extIdRoot }, { "ModelKey", "listCfg" }, { "MsgCenterKey", "msgCenter" } })
    </div>
    <div class="tsb-card">
        @await Html.PartialAsync("~/Views/DynBlocks/DetailBlock.cshtml", new ViewDataDictionary(ViewData) {
            { "ExtId", extIdDetail }, { "RootExtId", extIdRoot }, { "ModelKey", "detailCfg" }, { "MsgCenterKey", "msgCenter" } })
    </div>
</div>

<style>
    body { margin: 0; background: #f0f2f5; font-family: 'Helvetica Neue', Arial, 'PingFang SC', 'Microsoft YaHei', sans-serif; }
    .tsb-root { padding: 0 0 20px; }
    .tsb-head { display: flex; align-items: center; gap: 10px; padding: 12px 20px; background: #fff; border-bottom: 1px solid #e4e7ed; }
    .tsb-title { font-size: 16px; font-weight: 600; color: #303133; }
    .tsb-card { background: #fff; margin: 14px 20px 0; padding: 14px 16px; border-radius: 8px; border: 1px solid #e4e7ed; }
    .tsb-rootapp { display: none; } /* 根 app 仅作共享上下文宿主，不渲染可见 UI */
</style>

@section Scripts {
    <script src="~/dyn/blocks/message-center.js?v=3"></script>
    <script>
        DynLib.ready(function () {
            // ========== 挂载根 app（写入共享 model 的 shared 上下文 + 消息中心）→ 再挂载三个积木 ==========
            var rootEl = document.getElementById('@extIdRoot');
            var fEl = document.getElementById('@extIdFilter');
            var lEl = document.getElementById('@extIdList');
            var dEl = document.getElementById('@extIdDetail');
            window.dyn.mount(rootEl).then(function () {
                return Promise.all([window.dyn.mount(fEl), window.dyn.mount(lEl), window.dyn.mount(dEl)]);
            }).then(function () {
                console.log('[TriScreenBlocks] 三屏积木已就绪（共享上下文模式）');
            });
        });
    </script>
}
