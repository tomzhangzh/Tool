@* Inspector 设计器面板：dyndebug=1 时显示浮动按钮，左侧抽屉用 dyn-dynamic-com 渲染各 slot *@
@{
    var wpId = ViewBag.WebpageId ?? 0;
}
<div id="inspector-app-@wpId" dyn-init="createApp" class="inspector-host">
    <button type="button" class="inspector-fab" @@click="open">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
        </svg>
        <span>设计器</span>
    </button>

    <div class="inspector-mask" v-if="visible" @@click="close"></div>

    <div class="inspector-drawer" :class="{ open: visible }">
        <div class="inspector-head">
            <span class="inspector-title">页面设计器</span>
            <span class="inspector-count">{{ slots.length }} blocks</span>
            <button class="inspector-close" @@click="close">×</button>
        </div>
        <div class="inspector-body">
            <div v-if="loading" class="inspector-loading">加载中…</div>
            <template v-else>
                <!-- 基础参数（可折叠） -->
                <div class="inspector-group">
                    <div class="inspector-group__title" @@click="toggle('provide')">
                        <span class="inspector-caret" :class="{open: openGroups.provide}">▸</span>
                        <span>基础参数</span>
                    </div>
                    <div class="inspector-group__body" v-show="openGroups.provide">
                        <div class="inspector-field"><label>数据表名</label><input v-model="provide.TableName" placeholder="如 SysMenu"></div>
                        <div class="inspector-field"><label>主键字段</label><input v-model="provide.KeyField" placeholder="Id"></div>
                        <div class="inspector-field"><label>项目ID</label><input v-model="provide.Project" placeholder="__platform__"></div>
                        <div class="inspector-field"><label>弹窗页ID</label><input v-model="provide.ModalPageId" placeholder="0"></div>
                    </div>
                </div>
                <!-- 各 slot：可折叠 -->
                <div class="inspector-group" v-for="s in slots" :key="s.slot">
                    <div class="inspector-group__title" @@click="toggle(s.slot)">
                        <span class="inspector-caret" :class="{open: openGroups[s.slot]}">▸</span>
                        <span class="inspector-dot" :class="'inspector-dot--' + s.slot"></span>
                        <span>{{ s.blockName }}</span>
                        <span class="inspector-slot-tag">{{ s.slot }}</span>
                    </div>
                    <div class="inspector-group__body" v-show="openGroups[s.slot]">
                        <div v-if="s.description" class="inspector-desc">{{ s.description }}</div>
                        <dyn-dynamic-com v-if="s.paramConfig"
                            :jsonconfig="s.paramConfig"
                            :parentmodelinfo="s.current"></dyn-dynamic-com>
                    </div>
                </div>
            </template>
        </div>
        <div class="inspector-foot">
            <button class="inspector-btn inspector-btn--ghost" @@click="close">关闭</button>
            <button class="inspector-btn inspector-btn--primary" @@click="save" :disabled="saving">
                {{ saving ? '保存中…' : '保存并刷新' }}
            </button>
        </div>
    </div>

    <script type="application/json" tag="dynmodel">{}</script>
    <script type="text/plain" tag="dynconfig">
    var __wpId = @wpId;
    var dynConfig = {
        data: function () {
            return {
                visible: false,
                loading: false,
                saving: false,
                provide: {},
                slots: [],
                openGroups: { provide: true }
            };
        },
        methods: {
            toggle: function (k) { this.openGroups[k] = !this.openGroups[k]; },
            open: function () {
                this.visible = true;
                if (!this.slots.length) this.load();
            },
            close: function () { this.visible = false; },
            load: function () {
                var self = this;
                this.loading = true;
                fetch('/Platform/Page/InspectorData?webpageId=' + __wpId)
                    .then(function (r) { return r.json(); })
                    .then(function (res) {
                        self.loading = false;
                        if (res.code !== 0) return;
                        self.provide = res.data.provide || {};
                        self.slots = res.data.slots || [];
                        // 默认展开所有 slot
                        var g = { provide: true };
                        self.slots.forEach(function (s) { g[s.slot] = true; });
                        self.openGroups = g;
                    })
                    .catch(function (e) { self.loading = false; console.error('[Inspector]', e); });
            },
            save: function () {
                var self = this;
                this.saving = true;
                var blocks = {};
                this.slots.forEach(function (s) { blocks[s.slot] = s.current; });
                fetch('/Platform/Page/SaveParams', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ webpageId: __wpId, paramsJson: { provide: this.provide, blocks: blocks } })
                }).then(function (r) { return r.json(); }).then(function (res) {
                    self.saving = false;
                    if (res.code === 0) { window.location.reload(); }
                    else { alert('保存失败: ' + (res.msg || '')); }
                }).catch(function (e) { self.saving = false; alert('保存异常: ' + e); });
            }
        }
    };
    </script>
</div>

<style>
.inspector-host { position: fixed; z-index: 9998; font-family: 'SF Mono', Consolas, monospace; }
.inspector-fab {
    position: fixed; left: 20px; bottom: 80px;
    display: inline-flex; align-items: center; gap: 6px;
    height: 34px; padding: 0 14px; border-radius: 6px;
    background: #3b82f6; color: #fff; border: 1px solid #2563eb; cursor: pointer;
    box-shadow: 0 4px 12px rgba(59,130,246,.4); font-size: 12px;
}
.inspector-fab:hover { background: #2563eb; }
.inspector-drawer {
    position: fixed; top: 0; left: 0; height: 100vh; width: 400px;
    background: #262626; color: #d4d4d4;
    box-shadow: 4px 0 24px rgba(0,0,0,.4);
    transform: translateX(-100%); transition: transform .2s ease;
    display: flex; flex-direction: column; z-index: 10000;
}
.inspector-drawer.open { transform: translateX(0); }
.inspector-head {
    display: flex; align-items: center; gap: 8px;
    padding: 0 12px; height: 36px; background: #1f1f1f;
    border-bottom: 1px solid #333; font-size: 12px;
}
.inspector-title { color: #e8e8e8; font-weight: 600; }
.inspector-count { color: #888; font-size: 11px; }
.inspector-close {
    margin-left: auto; background: none; border: none; color: #888;
    font-size: 18px; cursor: pointer; line-height: 1; padding: 0 4px;
}
.inspector-close:hover { color: #fff; }
.inspector-body { flex: 1; overflow-y: auto; padding: 10px; background: #262626; }
.inspector-loading { padding: 30px; text-align: center; color: #666; font-size: 12px; }
.inspector-foot {
    display: flex; justify-content: flex-end; gap: 8px; padding: 8px 12px;
    border-top: 1px solid #333; background: #1f1f1f;
}
.inspector-group {
    background: #2d2d2d; border: 1px solid #3a3a3a; border-radius: 4px;
    margin-bottom: 8px; overflow: hidden;
}
.inspector-group__title {
    display: flex; align-items: center; gap: 6px;
    padding: 6px 10px; background: #333; cursor: pointer;
    font-size: 11px; font-weight: 600; color: #ccc;
    user-select: none; letter-spacing: .3px;
}
.inspector-caret {
    display: inline-block; transition: transform .15s;
    font-size: 9px; color: #888; width: 10px;
}
.inspector-caret.open { transform: rotate(90deg); }
.inspector-group__body { padding: 8px 10px; }
.inspector-slot-tag {
    margin-left: auto; font-size: 10px; color: #888;
    background: #1f1f1f; padding: 1px 6px; border-radius: 3px; font-weight: normal;
}
.inspector-desc { font-size: 11px; color: #888; margin-bottom: 8px; line-height: 1.5; }
.inspector-dot { width: 7px; height: 7px; border-radius: 50%; background: #888; }
.inspector-dot--filter { background: #4ade80; }
.inspector-dot--list { background: #60a5fa; }
.inspector-dot--detail { background: #fbbf24; }
.inspector-dot--tree { background: #a78bfa; }
.inspector-field { display: flex; align-items: center; gap: 8px; margin-bottom: 6px; }
.inspector-field label { width: 70px; flex-shrink: 0; font-size: 11px; color: #999; text-align: right; }
.inspector-field input {
    flex: 1; height: 24px; padding: 0 6px; font-size: 11px; font-family: inherit;
    background: #1a1a1a; border: 1px solid #3a3a3a; border-radius: 3px; color: #e0e0e0;
}
.inspector-field input:focus { outline: none; border-color: #3b82f6; }
.inspector-btn {
    height: 26px; padding: 0 12px; font-size: 11px; border-radius: 3px; cursor: pointer;
    border: 1px solid #3a3a3a; background: #2d2d2d; color: #ccc; font-family: inherit;
}
.inspector-btn--primary { background: #3b82f6; border-color: #2563eb; color: #fff; }
.inspector-btn--primary:hover { background: #2563eb; }
.inspector-btn--primary:disabled { opacity: .6; cursor: not-allowed; }
.inspector-btn--ghost:hover { background: #3a3a3a; }
.inspector-mask { position: fixed; inset: 0; background: rgba(0,0,0,.45); z-index: 9999; }

/* dyn-dynamic-com 在暗色下协调 */
.inspector-body .el-form-item { margin-bottom: 8px; }
.inspector-body .el-form-item__label { color: #999 !important; font-size: 11px !important; }
.inspector-body .el-input__wrapper,
.inspector-body .el-select__wrapper,
.inspector-body .el-textarea__inner {
    background: #1a1a1a !important;
    box-shadow: 0 0 0 1px #3a3a3a inset !important;
}
.inspector-body .el-input__inner,
.inspector-body .el-select__placeholder,
.inspector-body .el-textarea__inner { color: #e0e0e0 !important; }
.inspector-body .el-input__inner::placeholder { color: #666 !important; }
</style>
