@model VueLibV4.Platform.Models.DynWebPage
@using VueLibV4.Platform.Services
@using VueLibV4.Services.Extensions
@using VueLibV4.Web.Core
@using Newtonsoft.Json.Linq
@inject IPageSettingService PageSettingService
@{
    // =====================================================================================
    // Detail 弹窗片段（detail-modal）：宿主页面经 fetchPartial 拉取、注入 layui layer 后挂载。
    //   本片段【零 JS、零根 app】：只把 WebPage 实例参数 + PageSetting UI 元数据组装成
    //   一个 JSON 交给 DetailApp（独立 BlockApp）。编辑回填/新增预填都是 DetailApp 自身能力。
    //   保存/删除成功 DetailApp 只 emit saved；关窗与刷新列表由宿主模板接线决定。
    //   入参（ViewBag）：RowId（编辑态主键）/ ProjectId / Prefill（主子预填 JSON）
    // =====================================================================================
    Layout = null;
    var rowId = (ViewBag.RowId as string) ?? "";
    var project = (ViewBag.ProjectId as string) ?? "";

    // 实例参数（ParamsJson）：TableName/KeyField 为模板自身参数（顶层）；
    // 表单配置与接口走 blocks.detail 槽位 {settingId,model:{addUrl/editUrl/deleteUrl}}；旧扁平键自动回退。
    var ps = DynPageViewHelper.ParseParams(Model.ParamsJson);
    var tableName = ps["TableName"]?.ToString() ?? "";
    var addUrl = DynPageViewHelper.UrlOr(DynPageViewHelper.SlotValue(ps, "detail", "addUrl", "AddUrl"), DynPageViewHelper.BizInsert);
    var editUrl = DynPageViewHelper.UrlOr(DynPageViewHelper.SlotValue(ps, "detail", "editUrl", "EditUrl"), DynPageViewHelper.BizUpdate);
    var deleteUrl = DynPageViewHelper.UrlOr(DynPageViewHelper.SlotValue(ps, "detail", "deleteUrl", "DeleteUrl"), DynPageViewHelper.BizDelete);
    var detailPsId = DynPageViewHelper.SlotSettingId(ps, "detail", "DetailPageSettingId");
    var keyField = ps["KeyField"]?.ToString() ?? "Id";

    var preFill = new JObject();
    var prefillRaw = (ViewBag.Prefill as string) ?? "";
    if (!string.IsNullOrWhiteSpace(prefillRaw))
    {
        try { if (JObject.Parse(prefillRaw) is JObject po) preFill = po; } catch { /* 非法预填忽略 */ }
    }

    // DetailApp 的唯一输入 data-blk-config
    var detailCfg = new JObject();
    DynPageViewHelper.ApplyFrontSetting(detailCfg, PageSettingService, detailPsId, "detailConfig", "detailDefault");
    detailCfg["table"] = tableName;
    detailCfg["project"] = project;
    detailCfg["addUrl"] = addUrl;
    detailCfg["editUrl"] = editUrl;
    detailCfg["deleteUrl"] = deleteUrl;
    detailCfg["keyField"] = keyField;
    detailCfg["rowId"] = rowId;
    detailCfg["preFill"] = preFill;

    var extIdDetail = "Tdb" + Guid.NewGuid().ToString("N");
    var title = Model.Name;
}
<div class="tsb-modal" style="padding:4px 2px;">
    <div class="tsb-mhead" style="display:flex;align-items:center;gap:8px;padding-bottom:10px;">
        <span style="font-size:14px;font-weight:600;color:#303133;">@title</span>
        <span class="el-tag el-tag--small el-tag--info el-tag--plain">@tableName</span>
        @if (!string.IsNullOrEmpty(rowId)) { <span class="el-tag el-tag--small el-tag--warning el-tag--plain">编辑 #@rowId</span> }
        else { <span class="el-tag el-tag--small el-tag--success el-tag--plain">新增</span> }
    </div>

    @await Html.PartialAsync("~/Views/DynBlocks/Apps/DetailApp.cshtml", new ViewDataDictionary(ViewData) {
        ["ExtId"] = extIdDetail, ["BlkConfig"] = DynPageViewHelper.SafeJson(detailCfg)
    })

    <style>
        .tsb-modal .dyn-blk-detail__btns { margin-top: 8px; }
    </style>
</div>
