@model VueLibV4.Platform.Models.DynWebPage
@using VueLibV4.Platform.Services
@using VueLibV4.Services.Extensions
@using VueLibV4.Web.Core
@using Newtonsoft.Json.Linq;
@inject IPageSettingService PageSettingService
@{
    Layout = Context.Request.Headers.TryGetValue("X-Requested-With", out var __xrw)
                && __xrw == "XMLHttpRequest" ? "_AjaxLayout" : "_Layout";
    ViewData["Title"] = Model.Name + " - VueLibV4";

    var ps = DynPageViewHelper.ParseParams(Model.ParamsJson);
    var tableName = ps["TableName"]?.ToString() ?? "";
    var keyField = ps["KeyField"]?.ToString() ?? "Id";
    var drawerWidth = ps["DrawerWidth"]?.ToString() ?? "40%";
    var execId = "T2-" + Guid.NewGuid().ToString("N");
    var title = Model.Name;
}
<div id="@execId" class="fld-root" >
    @await Html.PartialAsync("~/Views/DynTemplates/Partials/DynPageHeader.cshtml", new ViewDataDictionary(ViewData) {
        ["Title"] = title, ["Code"] = Model.Code, ["TableName"] = tableName
    })

    <div class="fld-body">
        <div class="fld-main">
            <div class="fld-card">
                <div class="fld-section-title"><span>筛选查询</span></div>
                <dyn-inject-host data-block-host="filter"><div class="dyn-loading">加载筛选区…</div></dyn-inject-host>
            </div>
            <div class="fld-card">
                <div class="fld-section-title"><span>数据列表</span></div>
                <dyn-inject-host data-block-host="list"><div class="dyn-loading">加载列表…</div></dyn-inject-host>
            </div>
        </div>
        <div dyn-init="createApp" id="@(execId)_drawerapp" class="fldl-drawer" data-dyn-mode-model="@(new { visible = false, drawerTitle = title }.ToJson())">
            <el-drawer ref="drawer" :title="model.drawerTitle" direction="ltr" size="@drawerWidth"
                       v-model="model.visible" :destroy-on-close="false" :modal="true" :append-to-body="false" v-on:closed="onClosed">
                <dyn-inject-host data-block-host="detail" ><div class="dyn-loading">加载明细…</div></dyn-inject-host>
            </el-drawer>
        </div>
    </div>
       
</div>

@if (Context.Request.Query.ContainsKey("dyndebug")) {
    ViewBag.WebpageId = Model.Id;
    @await Html.PartialAsync("~/Views/DynTemplates/Partials/InspectorPanel.cshtml")
}

<style>
    .fld-root { min-height: 100vh; background: #f0f2f5; font-family: 'Helvetica Neue', Arial, 'PingFang SC', 'Microsoft YaHei', sans-serif; }
    .fld-body { display: flex; }
    .fld-main { flex: 1; min-width: 0; }
    .fld-card { background: #fff; margin: 14px 20px 0; padding: 14px 16px; border-radius: 8px; border: 1px solid #e4e7ed; }
    .fld-section-title { display: flex; align-items: center; margin-bottom: 12px; font-size: 14px; font-weight: 600; color: #303133; }
    .fld-section-title::before { content: ''; display: inline-block; width: 3px; height: 14px; background: #409eff; border-radius: 2px; margin-right: 8px; }

    .fldl-drawer .el-drawer__header {
        margin-bottom: 0px;
        padding: 8px 12px;
        font-size: 14px;
    }

    .fldl-drawer .el-drawer__body {
        padding: 0 8px 8px;
    }
    .dyn-loading { padding: 20px; text-align: center; color: #909399; font-size: 13px; }
</style>

@section Scripts {
  <script>
    DynLib.ready(function () {
        var ROOT_ID = '@execId';
        var WEBPAGE_ID = @(Model.Id);
        var KEY_FIELD = '@keyField';
        var rootEl = document.getElementById(ROOT_ID);
        window.DynEventBus.registerRoot(rootEl);

        function loadBlockInto(blockName, hostEl, rowId) {
            var url = '/Platform/Page/LoadBlock?blockName=' + blockName
                + '&webpageId=' + WEBPAGE_ID
                + '&execId=' + ROOT_ID;
            if (rowId) url += '&rowId=' + rowId;
            return dyn.fetchPartial(url, {}, 'GET', 'text').then(function (html) {
                return dyn.html(hostEl, html, true);
            });
        }

        // 1. filter + list
        loadBlockInto('filter', rootEl.querySelector('[data-block-host="filter"]'));
        loadBlockInto('list', rootEl.querySelector('[data-block-host="list"]'));
        debugger;
        // 2. 抽屉
       

            function openDetailDrawer(rowId) {
                var drawerVm = dyn.getProxy("#@(execId)_drawerapp");
               if (!drawerVm) { dyn.showMessage('抽屉未就绪', 'error'); return; }

                drawerVm.model.drawerTitle = rowId ? ('编辑记录 #' + rowId) : '新增记录';
                drawerVm.model.visible = true;
                setTimeout(()=>{

                    loadBlockInto('detail', rootEl.querySelector('[data-block-host="detail"]'), rowId).catch(function (e) {
                        body.innerHTML = '<div style="padding:16px;color:#f56c6c;">加载失败：' + ((e && e.message) || e) + '</div>';
                    });
                },100);
                
            }

        window.DynEventBus.on(ROOT_ID, 'add', function () { openDetailDrawer(null); });
        window.DynEventBus.on(ROOT_ID, 'edit', function (p) {
            var row = p && p.row;
            openDetailDrawer(row ? row[KEY_FIELD] : null);
        });
        window.DynEventBus.on(ROOT_ID, 'saved', function () {
            if (drawerVm) drawerVm.model.visible = false;
        });
    });
    </script>
}
