@model VueLibV4.Platform.Models.DynWebPage
@using VueLibV4.Platform.Services
@using VueLibV4.Services.Extensions
@using VueLibV4.Web.Core
@using Newtonsoft.Json.Linq
@inject IPageSettingService PageSettingService
@{
    // =====================================================================================
    // 筛选+列表模板（filterlist-crud）：纯布局 + 薄编排，本身【不是】 VueApp。
    //   - 两个 Block 各自是独立 VueApp（FilterApp / ListApp），自读 data-blk-config，互不依赖。
    //   - 本模板只做两件事：摆放 Block（UI）+ 在 ready 里用实例句柄把它们的关系显式接起来。
    //   - 新增/编辑/+子 → 拉 DetailModal 片段（内含 DetailApp）注入 layer；
    //     DetailApp 保存/删除成功只 emit saved，本模板订阅后关窗；弹窗 end 是唯一刷新通道
    //     （保存自动关窗 / X / 取消都走 end → list reload），无 window 事件、无 tick 去重。
    //   实例参数（ParamsJson）：模板自身 TableName/ModalPageId/KeyField/ChildFkField（顶层）+
    //     blocks.filter/list 槽位 {settingId,model:{loadUrl/deleteUrl}}；旧扁平键自动回退。
    // =====================================================================================
    Layout = "_Layout";
    ViewData["Title"] = Model.Name + " - VueLibV4";

    var ps = DynPageViewHelper.ParseParams(Model.ParamsJson);
    var tableName = ps["TableName"]?.ToString() ?? "";
    var loadUrl = DynPageViewHelper.UrlOr(DynPageViewHelper.SlotValue(ps, "list", "loadUrl", "ListUrl"), DynPageViewHelper.BizSearch);
    var deleteUrl = DynPageViewHelper.UrlOr(DynPageViewHelper.SlotValue(ps, "list", "deleteUrl", "DeleteUrl"), DynPageViewHelper.BizDelete);
    var project = Model.ProjectId?.ToString() ?? "";
    var modalPageId = ps["ModalPageId"]?.ToString() ?? "";
    var childFkField = ps["ChildFkField"]?.ToString() ?? "";
    var keyField = ps["KeyField"]?.ToString() ?? "Id";
    var filterPsId = DynPageViewHelper.SlotSettingId(ps, "filter", "FilterPageSettingId");
    var listPsId = DynPageViewHelper.SlotSettingId(ps, "list", "ListPageSettingId");

    // Filter Block 配置：{filterConfig:UI树, filterDefault:骨架}
    var filterCfg = new JObject();
    DynPageViewHelper.ApplyFrontSetting(filterCfg, PageSettingService, filterPsId, "filterConfig", "filterDefault");
    // List Block 配置：{columns,table,keyField,project,loadUrl,deleteUrl}
    var listCfg = new JObject();
    DynPageViewHelper.ApplyListSetting(listCfg, PageSettingService, listPsId, "columns");
    listCfg["table"] = tableName;
    listCfg["keyField"] = keyField;
    listCfg["project"] = project;
    listCfg["loadUrl"] = loadUrl;
    listCfg["deleteUrl"] = deleteUrl;

    var extId = "Tfl" + Guid.NewGuid().ToString("N");
    var extIdFilter = extId + "-filter";
    var extIdList = extId + "-list";
    var title = Model.Name;

    // 页面级统一参数声明（L1 静态层）：Block 经父链即可读 $params.tableName 等；URL 同名参数仍可覆盖。
    var pageParams = new JObject
    {
        ["tableName"] = tableName,
        ["keyField"] = keyField,
        ["project"] = project,
        ["modalPageId"] = modalPageId,
        ["childFkField"] = childFkField
    };
}
<div class="flc-root" data-dyn-params="@DynPageViewHelper.SafeJson(pageParams)">
    @* 头部在任何 app 之外，纯原生元素 *@
    @await Html.PartialAsync("~/Views/DynTemplates/Partials/DynPageHeader.cshtml", new ViewDataDictionary(ViewData) {
        ["Title"] = title, ["Code"] = Model.Code, ["TableName"] = tableName
    })

    @* 布局卡片是纯 HTML 容器（不是任何 app 的受管模板，避免外层 app 编译 Block 内部指令） *@
    <div class="flc-card">
        @await Html.PartialAsync("~/Views/DynBlocks/Apps/FilterApp.cshtml", new ViewDataDictionary(ViewData) {
            ["ExtId"] = extIdFilter, ["BlkConfig"] = DynPageViewHelper.SafeJson(filterCfg)
        })
    </div>
    <div class="flc-card">
        @await Html.PartialAsync("~/Views/DynBlocks/Apps/ListApp.cshtml", new ViewDataDictionary(ViewData) {
            ["ExtId"] = extIdList, ["BlkConfig"] = DynPageViewHelper.SafeJson(listCfg)
        })
    </div>
</div>

<style>
    .flc-root { min-height: 100vh; box-sizing: border-box; padding: 0 0 20px;
        background: #f0f2f5; font-family: 'Helvetica Neue', Arial, 'PingFang SC', 'Microsoft YaHei', sans-serif; }
    .flc-card { background: #fff; margin: 14px 20px 0; padding: 14px 16px; border-radius: 8px; border: 1px solid #e4e7ed; }
</style>

@section Scripts {
    <script src="~/dyn/blocks/dyn-blocks-common.js?v=2"></script>
    <script>
        DynLib.ready(function () {
            var fEl = document.getElementById('@extIdFilter');
            var lEl = document.getElementById('@extIdList');

            // 模板编排常量（来自 WebPage 实例参数）
            var MODAL_PAGE_ID = '@modalPageId';
            var PROJECT = '@project';
            var KEY_FIELD = '@keyField';
            var CHILD_FK_FIELD = '@childFkField';

            // 主子"+子"预填：父行主键 → 表单外键字段
            function childPreFill(row) {
                if (!CHILD_FK_FIELD || !row) return {};
                var pf = {}; pf[CHILD_FK_FIELD] = row[KEY_FIELD] || null; return pf;
            }

            // 打开 Detail 弹窗：拉片段 → 注入 layer → 挂载 DetailApp → 用句柄接线。
            // 唯一刷新通道是 layer.end：保存成功 DetailApp emit saved → 关窗 → end 刷新；
            // X / 取消同样走 end → 刷新。不需要 window 事件与计数去重。
            function openDetailModal(rowId, preFill) {
                if (!MODAL_PAGE_ID) { dyn.showMessage('实例未配置 ModalPageId（Detail 弹窗页面 Id）', 'warning'); return; }
                var q = '/Platform/Page/DetailModal?id=' + MODAL_PAGE_ID +
                    '&rowId=' + (rowId || '') + '&project=' + encodeURIComponent(PROJECT || '');
                if (preFill && Object.keys(preFill).length) {
                    q += '&prefill=' + encodeURIComponent(JSON.stringify(preFill));
                }
                var holder = document.createElement('div');
                holder.className = 'dyn-modal-host dyn-layer-fragment';
                holder.style.padding = '0px';
                holder.innerHTML = '<div style="padding:16px;color:#909399;">加载中…</div>';
                document.body.appendChild(holder);
                // 统一参数链：弹窗片段从列表 Block 上下文 fork，rowId/preFill 作为 L0 入参层，
                // DetailApp 用 dyn.params(element).get('rowId') 取值，不再只依赖 URL query 烘值。
                if (window.DynParams && lEl.__dynParams) {
                    lEl.__dynParams.fork(holder, { rowId: rowId || '', preFill: preFill || null });
                }

                window.dyn.getLayer().then(function (layer) {
                    var idx = layer.open({
                        type: 1,
                        title: rowId ? ('编辑记录 #' + rowId) : '新增记录',
                        area: ['60%', '80%'], shadeClose: false, maxmin: true,
                        content: (window.layui && window.layui.$) ? window.layui.$(holder) : holder,
                        success: function () {
                            window.dyn.fetchPartial(q, {}, 'GET').then(function (html) {
                                holder.innerHTML = html;
                                var apps = holder.querySelectorAll('[data-dyn-mode="createApp"]');
                                var chain = window.Promise.resolve();
                                [].forEach.call(apps, function (ae) {
                                    chain = chain.then(function () { return window.dyn.mount(ae); });
                                });
                                chain.then(function () {
                                    var blocks = DynBlocks.scan(holder);
                                    var detail = blocks.detail;
                                    if (detail) {
                                        // 关窗权在模板：取消 / 保存删除成功 → 关窗（end 内统一刷新列表）
                                        detail.on('cancel', function () { layer.close(idx); });
                                        detail.on('saved', function () { layer.close(idx); });
                                    }
                                }).catch(function (e) { console.error('[FilterListCrud] 弹窗挂载失败', e); });
                            }).catch(function (e) {
                                holder.innerHTML = '<div style="padding:16px;color:#f56c6c;">加载失败：' + ((e && e.message) || e) + '</div>';
                            });
                        },
                        end: function () {
                            var apps = holder.querySelectorAll('[data-dyn-mode="createApp"]');
                            [].forEach.call(apps, function (ae) { try { window.dyn.unmount(ae); } catch (e) { } });
                            try { holder.remove(); } catch (e) { }
                            // 弹窗生命周期结束 → 刷新列表（单通道）
                            if (lEl.__dynBlock) lEl.__dynBlock.send('reload').catch(function () { });
                        }
                    });
                });
            }

            // ===== 显式接线：关系只写在这里，肉眼可见；Block 之间互不认识 =====
            window.Promise.all([window.dyn.mount(fEl), window.dyn.mount(lEl)]).then(function () {
                var filter = fEl.__dynBlock;
                var list = lEl.__dynBlock;
                filter.on('changed', function (params) {
                    list.send('loadData', { filter: params || {} });
                });
                list.on('add', function () { openDetailModal(null); });
                list.on('edit', function (p) {
                    openDetailModal(p.row ? p.row[KEY_FIELD] : null);
                });
                list.on('addChild', function (p) {
                    openDetailModal(null, childPreFill(p && p.row));
                });
                console.log('[FilterListCrud] 就绪（独立 BlockApp + 句柄接线）');
            });
        });
    </script>
}
