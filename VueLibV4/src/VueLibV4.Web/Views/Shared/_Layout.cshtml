@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "VueLibV4 企业级低代码平台")</title>
    <link rel="icon" href="data:,">
    <link rel="stylesheet" href="~/dyn/dyn.css" />
    @RenderSection("Head", required: false)
</head>
<body>
@RenderBody()


    @* 组件注册表（服务端 ViewComponent 输出 JSON，前端消费） *@
    @await Component.InvokeAsync("DynComRegistry")

    @* 唯一入口：dyn-lib.js 自动按顺序加载 vue / element-plus / layui / axios / 各 dyn 模块 *@
    <script src="~/dyn/dyn-lib.js" asp-append-version="true"></script>

    @RenderSection("Scripts", required: false)

    @* ExecJS 注册的服务端 dyn 动作（渲染为隐藏 div dyn-init-*，动作系统 init 扫描自动执行） *@
    @Html.RenderDynActions()
    <script>
            DynLib.ready(function () {
               dyn.initActions("body");
            });
    </script>
</body>
</html>
