@using VueLibV4.Web.Services
@inject DynAssetManifestService DynAssets
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "VueLibV4 企业级低代码平台")</title>
    <link rel="icon" href="data:,">
    <link rel="stylesheet" href="~/dyn/dyn.css" asp-append-version="true" />
    @RenderSection("Head", required: false)
</head>
<body>
@RenderBody()


    @* 组件注册表（服务端 ViewComponent 输出 JSON，前端消费） *@
    @await Component.InvokeAsync("DynComRegistry")

    @* 全局图表依赖（DynEChart 组件使用；本地文件，无 CDN 依赖） *@
    <script src="~/lib/echarts.min.js"></script>
    <script src="~/lib/markdown-it.min.js"></script>
    <script src="~/lib/mermaid.min.js"></script>

    @* dyn 模块内容哈希清单：dyn-lib.js 据此为每个模块拼 ?v=&lt;内容哈希&gt;，改 js 自动失效，免手工 bump *@
    <script>@Html.Raw(DynAssets.RenderInlineScript())</script>
    @* 唯一入口：dyn-lib.js 自动按顺序加载 vue / element-plus / layui / axios / 各 dyn 模块 *@
    <script src="~/dyn/dyn-lib.js" asp-append-version="true"></script>

    @RenderSection("Scripts", required: false)

    @* ExecJS 注册的服务端 dyn 动作（渲染为隐藏 div dyn-init-*，动作系统 init 扫描自动执行） *@
    @Html.RenderDynActions()
    <script>
            DynLib.ready(function () {
               dyn.initActions("body");
            });
    </script>

    @* 前端 JS 错误上报到后端 SysLog（开关在 appsettings: Dyn:Log:FrontendEnabled） *@
    <script>
    (function () {
        var _lastReport = 0;
        function report(err) {
            var now = Date.now();
            if (now - _lastReport < 3000) return; // 3秒去重
            _lastReport = now;
            try {
                fetch('/api/log/frontend-error', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        message: err.message || String(err),
                        source: err.filename || err.sourceURL || '',
                        line: err.lineno || 0,
                        column: err.colno || 0,
                        stack: err.stack || '',
                        url: location.href
                    })
                }).catch(function(){});
            } catch(e){}
        }
        // 链式接管：保留页面上已有的 onerror（如调试脚本/第三方库），不能直接覆盖
        var _prevOnError = window.onerror;
        window.onerror = function (msg, src, line, col, err) {
            report({ message: String(msg), filename: src, lineno: line, colno: col, stack: err && err.stack });
            if (typeof _prevOnError === 'function') {
                return _prevOnError.apply(window, arguments);
            }
        };
        window.addEventListener('unhandledrejection', function (e) {
            report({ message: 'UnhandledPromiseRejection: ' + (e.reason && e.reason.message || e.reason), stack: e.reason && e.reason.stack });
        });
        // Vue 错误上报：Vue 组件内错误不会冒泡到 window.onerror，需要手动挂
        window.addEventListener('app:error', function (e) {
            var err = e.detail || {};
            report({ message: '[Vue] ' + (err.message || 'Vue error'), stack: err.stack });
        });
    })();
    </script>
</body>
</html>
