@model dynamic
@inject IPageSettingService pageSettingService
@using System.Dynamic
@{
    // 双模入参：LoadBlock 片段入口传 Dictionary 模型；模板内联 PartialAsync 传 ViewDataDictionary
    // （此时 Model 是父页模型，如 DynWebPage，不能强转 IDictionary）——统一字典优先、ViewData 回退。
    IDictionary<string, object> M = Model is IDictionary<string, object> _md
        ? _md : new Dictionary<string, object>(StringComparer.OrdinalIgnoreCase);
    object V2(string k) {
        if (M.TryGetValue(k, out var v0) && v0 != null) return v0;
        if (ViewData.TryGetValue(k, out var v1) && v1 != null) return v1;
        return null;
    }
    string S(string k, string dft = "") { var x = V2(k); return x != null ? x.ToString() ?? dft : dft; }
    int I(string k, int dft = 0) { var x = V2(k); return x != null ? Convert.ToInt32(x) : dft; }

    var extId = S("ExtId", "db2-" + Guid.NewGuid().ToString("N")[..12]);
    var execId = S("ExecId");
    var detailPsId = I("DetailSettingId", ViewData["DetailSettingId"] != null ? Convert.ToInt32(ViewData["DetailSettingId"]) : 0);
    var tableName = S("TableName");
    var keyField = S("KeyField", "Id");
    var project = S("Project");
    var rowId = S("RowId");
    var addUrl = S("AddUrl", DynPageViewHelper.SaveUrl);
    var editUrl = S("EditUrl", DynPageViewHelper.SaveUrl);
    var deleteUrl = S("DeleteUrl", DynPageViewHelper.DeleteUrl);

    var detailSetting = detailPsId > 0 ? pageSettingService.GetById(detailPsId) : null;
}
<div id="@extId" dyn-init="createApp" class="dyn-blk-detail">
    <div class="dyn-actionbar">
        <div class="dyn-actionbar__group">
            <button type="button" class="dyn-actionbar__btn dyn-actionbar__btn--primary"
                    :disabled="loading" @@click="onSave()">
                <el-icon><Check /></el-icon><span>保存</span>
            </button>
        </div>
        <span class="dyn-actionbar__divider"></span>
        <div class="dyn-actionbar__group">
            <button type="button" class="dyn-actionbar__btn "
                    :disabled="loading || !canDelete" @@click="onCopy()">
                <el-icon><Copy-Document /></el-icon><span>复制</span>
            </button>
        </div>
        <div class="dyn-actionbar__right">
            <button type="button" class="dyn-actionbar__btn dyn-actionbar__btn--danger"
                    :disabled="loading || !canDelete" @@click="onDelete()">
                <el-icon><Delete /></el-icon><span>删除</span>
            </button>
            <button type="button" class="dyn-actionbar__btn dyn-actionbar__btn--text"
                    @@click="onCancel()">
                <el-icon><Close /></el-icon><span>取消</span>
            </button>
        </div>
    </div>
    <div class="dyn-blk-detail__errbar" v-if="formError">{{ formError }}</div>
    <div class="dyn-blk-detail__body">
        <dyn-dynamic-com v-if="detailCfg" :jsonconfig="detailCfg" :parentmodelinfo="form"></dyn-dynamic-com>
    </div>
    
    <script type="text/plain" tag="dynconfig">
    var __execId = '@execId';
    var __detailCfg = @Html.Raw(detailSetting?.ConfigJson ?? "null");
    var __defaultJson = @Html.Raw(detailSetting?.DefaultJson ?? "{}");
    var __table = '@tableName';
    var __keyField = '@keyField';
    var __project = '@project';
    var __rowId = '@rowId';
    var __addUrl = '@(string.IsNullOrEmpty(addUrl) ? DynPageViewHelper.SaveUrl : addUrl)';
    var __editUrl = '@(string.IsNullOrEmpty(editUrl) ? DynPageViewHelper.SaveUrl : editUrl)';
    var __deleteUrl = '@(string.IsNullOrEmpty(deleteUrl) ? DynPageViewHelper.DeleteUrl : deleteUrl)';
    var __createHandler = null, __updateHandler = null;

    var dynConfig = {
        data: function () {
            return {
                detailCfg: __detailCfg,
                form: JSON.parse(JSON.stringify(__defaultJson)),
                formError: '',
                loading: false,
                table: __table,
                addUrl: __addUrl,
                editUrl: __editUrl,
                deleteUrl: __deleteUrl,
                keyField: __keyField,
                project: __project,
                initForm: __defaultJson
            };
        },
        computed: {
            canDelete: function () {
                var id = this.form[this.keyField];
                return id !== null && id !== undefined && id !== '' && id !== 0;
            }
        },
        methods: {
            validateForm: function () {
                var errs = [];
                var nodes = element.querySelectorAll('*');
                for (var i = 0; i < nodes.length; i++) {
                    var n = nodes[i];
                    if (typeof n.__dynValidate === 'function') {
                        try {
                            if (n.__dynValidate() !== true) {
                                var msg = null;
                                if (n.__dynErrors && n.__dynErrors.length) {
                                    msg = n.__dynErrors.map(function (e) { return (e && e.message) || e; }).join('；');
                                }
                                if (!msg) msg = '存在未通过校验的字段';
                                if (errs.indexOf(msg) < 0) errs.push(msg);
                            }
                        } catch (e) { console.warn('[detail validate]', e); }
                    }
                }
                return errs;
            },
            newForm: function (preFill) {
                this.form = Object.assign({}, JSON.parse(JSON.stringify(this.initForm)), preFill || {});
                this.formError = '';
            },
            editForm: function (row) {
                this.form = Object.assign({}, JSON.parse(JSON.stringify(this.initForm)), row || {});
                this.formError = '';
            },
            onSave: function () {
                var self = this;
                var errs = this.validateForm();
                if (errs.length) {
                    this.formError = errs.join('；');
                    dyn.showMessage(errs.join('；'), 'warning');
                    return;
                }
                this.loading = true;
                var kf = this.keyField;
                var isEdit = this.form[kf] !== null && this.form[kf] !== undefined && this.form[kf] !== '';
                var req = DynBlocks.saveRequest(isEdit ? this.editUrl : this.addUrl, this.table, this.form, this.project);
                DynCall.post(req.url, req.body, { scopeEl: element })
                    .then(function () {
                        self.loading = false;
                        self.formError = '';
                        dyn.showMessage('保存成功', 'success');
                        // 统一只发 saved（signal）：壳负责关窗，list/tree 自行监听刷新
                        var payload = { action: isEdit ? 'update' : 'create', row: self.form };
                        if (window.DynEventBus && __execId)
                            window.DynEventBus.emit(__execId, 'saved', payload);
                    })
                    .catch(function () { self.loading = false; });
            },
            onCancel: function () {
                this.form = JSON.parse(JSON.stringify(this.initForm));
                this.formError = '';
                if (window.DynEventBus && __execId)
                    window.DynEventBus.emit(__execId, 'cancel', {});
            },
            onDelete: function () {
                var self = this;
                var kf = this.keyField;
                var id = this.form[kf];
                if (id === null || id === undefined || id === '' || id === 0) {
                    dyn.showMessage('请先选择要删除的记录', 'warning'); return;
                }
                var doDelete = function () {
                    self.loading = true;
                    var req = DynBlocks.deleteRequest(self.deleteUrl, self.table, id, kf, self.project);
                    DynCall.post(req.url, req.body, { scopeEl: element })
                        .then(function () {
                            self.loading = false;
                            dyn.showMessage('删除成功', 'success');
                            var rowKey = {}; rowKey[kf] = id;
                            self.form = JSON.parse(JSON.stringify(self.initForm));
                            self.formError = '';
                            if (window.DynEventBus && __execId)
                                window.DynEventBus.emit(__execId, 'saved', { action: 'delete', row: rowKey });
                        })
                        .catch(function () { self.loading = false; });
                };
                if (window.dyn && typeof window.dyn.confirmAsync === 'function') {
                    window.dyn.confirmAsync('确定删除该条记录吗？').then(function (ok) { if (ok) doDelete(); });
                } else { doDelete(); }
            },
            onCopy: function () {
                var kf = this.keyField;
                // 深拷贝当前表单，主键清零 → 下次保存走新增接口
                var cloned = JSON.parse(JSON.stringify(this.form));
                cloned[kf] = 0;
                this.form = cloned;
                this.formError = '';
                dyn.showMessage('已复制为新记录，修改后点击保存即可新增', 'success');
            }
        },
        mounted: function () {
            var self = this;
            if (!window.DynEventBus || !__execId) return;
            __createHandler = function (p) { self.newForm((p && p.preFill) || {}); };
            __updateHandler = function (p) { self.editForm((p && p.row) || {}); };
            // create/update 是 signal：只响应实时派发，不读历史快照
            window.DynEventBus.on(__execId, 'create', __createHandler);
            window.DynEventBus.on(__execId, 'update', __updateHandler);
            // 编辑态 rowId 兜底
            if (__rowId) {
                var getUrl = DynBlocks.getUrl(this.table, __rowId, this.project);
                DynCall.get(getUrl, {}, { silent: true })
                    .then(function (row) { if (row) self.editForm(row); })
                    .catch(function (e) { console.error('[DetailAppV2] 加载行失败', e); });
            }
        },
        beforeUnmount: function () {
            if (window.DynEventBus && __execId) {
                if (__createHandler) window.DynEventBus.off(__execId, 'create', __createHandler);
                if (__updateHandler) window.DynEventBus.off(__execId, 'update', __updateHandler);
            }
        }
    };
    </script>
</div>

<style>
    .dyn-blk-detail { display: flex; flex-direction: column; }
    .dyn-blk-detail__errbar { margin-bottom: 10px; padding: 9px 12px;
        background: rgba(245,108,108,.12); color: var(--site-danger);
        border: 1px solid var(--site-danger); border-radius: var(--site-radius-sm);
        font-size: var(--site-font-size); font-weight: 500; }
    .dyn-blk-detail__body { flex: 1; }

    /* ===== ProUI 风格紧凑操作栏 ===== */
    .dyn-actionbar {
        display: flex; align-items: center; gap: 6px;
        padding: 8px 12px; background: var(--site-bg-header);
        border: 1px solid var(--site-border); border-radius: var(--site-radius);
        margin-bottom: 12px; flex-wrap: wrap;
    }
    .dyn-actionbar__group { display: flex; align-items: center; gap: 4px; }
    .dyn-actionbar__right { margin-left: auto; display: flex; align-items: center; gap: 4px; }
    .dyn-actionbar__divider { width: 1px; height: 18px; background: var(--site-border-dark); margin: 0 4px; }
    .dyn-actionbar__btn {
        display: inline-flex; align-items: center; gap: 4px;
        height: 28px; padding: 0 10px; font-size: var(--site-font-size-sm);
        border: 1px solid var(--site-border-dark); border-radius: var(--site-radius-sm);
        background: var(--site-bg-card); color: var(--site-text); cursor: pointer;
        transition: all .15s ease; line-height: 1;
    }
    .dyn-actionbar__btn:hover:not(:disabled) { border-color: var(--site-border-dark); background: var(--site-bg-hover); }
    .dyn-actionbar__btn:disabled { opacity: .5; cursor: not-allowed; }
    .dyn-actionbar__btn--primary { background: var(--site-primary); border-color: var(--site-primary); color: #fff; }
    .dyn-actionbar__btn--primary:hover:not(:disabled) { background: var(--site-primary-hover); border-color: var(--site-primary-hover); color: #fff; }
    .dyn-actionbar__btn--danger { background: var(--site-bg-card); border-color: var(--site-danger); color: var(--site-danger); }
    .dyn-actionbar__btn--danger:hover:not(:disabled) { background: rgba(245,108,108,.12); border-color: var(--site-danger); color: var(--site-danger); }
    .dyn-actionbar__btn--text { border-color: transparent; background: transparent; color: var(--site-text-muted); }
    .dyn-actionbar__btn--text:hover:not(:disabled) { background: var(--site-bg-hover); color: var(--site-text); }
</style>
