@model dynamic
@inject IPageSettingService pageSettingService
@using System.Dynamic
@{
    IDictionary<string, object?> M = Model != null ? (IDictionary<string, object?>)Model : new Dictionary<string, object?>();
    string S(string k, string dft = "") => M.TryGetValue(k, out var v) && v != null ? v.ToString() ?? dft : dft;
    int I(string k, int dft = 0) => M.TryGetValue(k, out var v) && v != null ? Convert.ToInt32(v) : dft;

    var extId = S("ExtId", "fb2-" + Guid.NewGuid().ToString("N")[..12]);
    var execId = S("ExecId");
    var pagsettingId = I("FilterPageSettingId", ViewData["FilterPageSettingId"] != null ? Convert.ToInt32(ViewData["FilterPageSettingId"]) : 0);
    var pageSetting = pagsettingId > 0 ? pageSettingService.GetById(pagsettingId) : null;
}


<div id="@extId" dyn-init="createApp">
    <div class="dyn-blk-filter__body">
        @if (pageSetting!=null){
            <dyn-dynamic-com v-if="pageCfg" :jsonconfig="pageCfg" :parentmodelinfo="filterModel"></dyn-dynamic-com>
        }
        else{
            <div>暂无筛选配置</div>
        }
    </div>
    <div class="dyn-blk-filter__btns">
        <button type="button" class="el-button el-button--primary el-button--small" @@click="query()">
            <el-icon style="margin-right:4px"><Search /></el-icon>查询
        </button>
        <button type="button" class="el-button el-button--small" @@click="reset()">
            <el-icon style="margin-right:4px"><Refresh /></el-icon>重置
        </button>
    </div>
    <script type="text/plain" tag="dynconfig">
    var __uiCfg = @Html.Raw(pageSetting?.ConfigJson ?? "null");
    var __def = @Html.Raw(pageSetting?.DefaultJson ?? "{}");
    var __execId = '@execId';

    function __buildInit(fd) {
        var opMap = {}, initModel = {};
        Object.keys(fd || {}).forEach(function (k) {
            var v = fd[k];
            if (v && typeof v === 'object' && v.op) {
                opMap[k] = v.op;
                initModel[k] = { op: v.op, value: (v.value === undefined ? null : v.value) };
            } else { opMap[k] = 'eq'; initModel[k] = (v === null || v === undefined) ? null : v; }
        });
        return { opMap: opMap, initModel: initModel };
    }
    var __P = (window.dyn && dyn.params) ? dyn.params(element) : null;
    var __paramInit = (__P && __P.get('filterInit')) || {};
    var __init = __buildInit(Object.assign({}, __def, __paramInit));

    var dynConfig = {
        data: function () {
            return {
                pageCfg: __uiCfg,
                filterModel: JSON.parse(JSON.stringify(__init.initModel)),
                opMap: __init.opMap,
                initModel: __init.initModel
            };
        },
        methods: {
            buildSubmit: function () {
                var f = {}, self = this;
                Object.keys(this.filterModel).forEach(function (k) {
                    var v = self.filterModel[k];
                    if (v && typeof v === 'object' && !Array.isArray(v) && Object.prototype.hasOwnProperty.call(v, 'value')) {
                        if (v.value !== null && v.value !== undefined && v.value !== '')
                            f[k] = { op: v.op || self.opMap[k] || 'eq', value: v.value };
                    } else if (v !== null && v !== undefined && v !== '') {
                        f[k] = { op: self.opMap[k] || 'eq', value: v };
                    }
                });
                return f;
            },
            query: function () {
                if (window.DynEventBus && __execId)
                    window.DynEventBus.emit(__execId, 'filter.query', this.buildSubmit());
            },
            reset: function () {
                this.filterModel = JSON.parse(JSON.stringify(this.initModel));
                if (window.DynEventBus && __execId)
                        window.DynEventBus.emit(__execId, 'filter.query', this.buildSubmit());
            }
        },
        mounted: function () {
            var self = this;
            this.$nextTick(function () {
                if (window.DynEventBus && __execId)
                    window.DynEventBus.emit(__execId, 'filter.query', self.buildSubmit());
            });
        }
    };
    </script>
</div>

<style>
    .dyn-blk-filter { display: flex; align-items: flex-start; gap: 12px; flex-wrap: wrap; }
    .dyn-blk-filter__body { flex: 1; min-width: 200px; }
    .dyn-blk-filter__btns { flex-shrink: 0; }
</style>
