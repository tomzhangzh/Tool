@{
    // =====================================================================================
    // Filter 积木（平台规范·共享上下文版）：壳 + 动态配置渲染，行为定义在 dynconfig。
    //   - 容器 data-dyn-mode="createApp"，由宿主模板统一挂载；data-root-ext-id 指向根 app（模板注入 RootExtId）
    //   - 共享读取：dynconfig 按 data-root-ext-id 用 dyn.getApp(根元素) 找到根 app，读其 model 的
    //     filterConfig / filterDefault / msgCenter（根 app 已写入，不用 window 全局）
    //   - model：字段值结构 {字段:值}，DynElInput 正常显示；操作符 op 从 DefaultJson 提取
    //   - 消息：查询/重置 → 发事件 filter.changed{params:{字段:{op,value}}}，根 app 收到后命令 List 加载
    // =====================================================================================
    var extId = (ViewData["ExtId"] as string) ?? ("Fb" + Guid.NewGuid().ToString("N"));
    var rootExtId = (ViewData["RootExtId"] as string) ?? "";
}
<div id="@extId" data-dyn-mode="createApp" data-root-ext-id="@rootExtId" class="fb">
    <div class="fb-body">
        @* 注意：不能用键名 model —— mountCore 的 setup() 会暴露同名的 model 并覆盖 data，
            导致 DynElInput 输入写不进我们的数据；故用 filterModel 避开重名（Detail 用 form、List 用自身 model 均不冲突）*@
        <dyn-dynamic-com v-if="pageCfg" :jsonconfig="pageCfg" :parentmodelinfo="filterModel"></dyn-dynamic-com>
    </div>
    <div class="fb-btns">
        @* 按钮用 dyn-click 动作体系（平台规范，对齐 DetailTemplate）：动作经 defineAction 注册，
           委托在 document 捕获层触发，ctx.vm 自动指向本 Block 的 proxy。
           注意：Element Plus 的 el-button 会拦截事件冒泡、阻断 dyn 的 document 委托捕获，
           故此处用【原生 button + el-button 样式类】保持视觉一致，事件可正常冒泡到委托。 *@
        <button type="button" class="el-button el-button--primary el-button--small" data-dyn-click-FilterQuery>查询</button>
        <button type="button" class="el-button el-button--small" data-dyn-click-FilterReset>重置</button>
    </div>
    <script tag="dynconfig">
    // 注意：由 mount 以 new Function('element','dyn',...) 执行，必须顶层定义 var dynConfig（勿包 IIFE）
    // 共享上下文：按 data-root-ext-id 找到根 app（模板 RootExtId），读其 model（根 app mount 时已写入）
    var __rid = element.getAttribute('data-root-ext-id');
    var __rootApp = null;
    if (__rid) { var __rootEl = document.getElementById(__rid); if (__rootEl) __rootApp = dyn.getApp(__rootEl); }
    var __ctx = (__rootApp && __rootApp.model) || {};
    var dynConfig = {
        data: function () {
            var fd = __ctx.filterDefault || {};
            // model 用「字段值」结构；op 从 DefaultJson（{字段:{op}} 或 {字段:值} 两种写法兼容）
            var opMap = {}, initModel = {};
            Object.keys(fd).forEach(function (k) {
                var v = fd[k];
                if (v && typeof v === 'object' && v.op) { opMap[k] = v.op; initModel[k] = null; }
                else { opMap[k] = 'eq'; initModel[k] = (v === null || v === undefined) ? null : v; }
            });
            return { pageCfg: __ctx.filterConfig || null, filterModel: JSON.parse(JSON.stringify(initModel)), __opMap: opMap, __initModel: initModel };
        },
        methods: {
            // 组装 {字段:{op,value}} 提交结构；剔除空值字段
            buildSubmit: function () {
                var f = {}, self = this;
                Object.keys(this.filterModel).forEach(function (k) {
                    var v = self.filterModel[k];
                    if (v !== null && v !== undefined && v !== '') f[k] = { op: self.__opMap[k] || 'eq', value: v };
                });
                return f;
            },
            // 查询：发事件，根 app 收到后命令 List 重新加载
            query: function () {
                var msg = __ctx.msgCenter;
                if (msg) msg.emitEvent('filter.changed', { params: this.buildSubmit() });
            },
            // 重置：清空筛选条件并通知 List 恢复全量
            reset: function () {
                this.filterModel = JSON.parse(JSON.stringify(this.__initModel));
                var msg = __ctx.msgCenter;
                if (msg) msg.emitEvent('filter.changed', { params: {} });
            },
            // 注册本 Block 的查询/重置动作（dyn-click 委托在 document 捕获层触发，ctx.vm 即本 Block proxy）
            registerActions: function () {
                if (!dyn || typeof dyn.defineAction !== 'function') return;
                dyn.defineAction('FilterQuery', function (ctx) {
                    var vm = ctx && ctx.vm;
                    if (vm && typeof vm.query === 'function') return vm.query();
                });
                dyn.defineAction('FilterReset', function (ctx) {
                    var vm = ctx && ctx.vm;
                    if (vm && typeof vm.reset === 'function') return vm.reset();
                });
                // 注意：无需 dyn.rebindActions —— generateSelector 每次点击动态生成，动作注册即生效；
                // 多次 rebind 会导致 document 监听叠加（一次点击触发多次动作）。
            }
        },
        mounted: function () { this.registerActions(); }
    };
    </script>
</div>

<style>
    .fb { display: flex; align-items: flex-start; gap: 12px; flex-wrap: wrap; }
    .fb-body { flex: 1; min-width: 200px; }
    .fb-btns { flex-shrink: 0; }
</style>
