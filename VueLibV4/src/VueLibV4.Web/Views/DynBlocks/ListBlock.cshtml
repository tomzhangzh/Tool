@{
    // =====================================================================================
    // List 积木（平台规范·双模式版）：壳 + 动态列渲染，行为定义在 dynconfig。
    //   组合模式：容器带 data-root-ext-id + data-model-key + data-msg-center-key。
    //             dynconfig 用 DynBlocks 公共能力找根 app 并动态读取根 model 中【模板自定义】的
    //             配置对象（含 columns/table/loadUrl/deleteUrl/keyField）与消息中心；根 app 未就绪
    //             时有限重试，始终拿不到则渲染显式错误，绝不静默自建消息中心降级成孤岛 Block。
    //   独立模式：未传 RootExtId 时，从自身 data-blk-* 属性读取配置，自建消息中心
    //   - 列定义：PageSetting.ConfigJson 的 { columns:[...] }，el-table-column v-for 渲染
    //     列能力：width/minWidth/align/fixed；cellType:'tag' 标签；options:[{value,label,type}]
    //     字典映射；emptyText 空值占位
    //   - 自身 model：<script tag="dynmodel"> 初始骨架 { rows, page, size, total, loading, filter }
    //   - 消息（事件）：list.add / list.edit{row} / list.addChild{row}（经 msgCenter 发出）
    //   - 命令（接收）：loadData{filter} / reload —— 根 app 经消息中心 sendCommand 下发
    //   - 网络：统一走 DynBlocks/DynCall（信封解包 + 平台/业务两种接口契约，统一错误处理）
    // =====================================================================================
    var extId = (ViewData["ExtId"] as string) ?? ("Lb" + Guid.NewGuid().ToString("N"));
    var rootExtId = (ViewData["RootExtId"] as string) ?? "";
    var modelKey = (ViewData["ModelKey"] as string) ?? "";
    var msgCenterKey = (ViewData["MsgCenterKey"] as string) ?? "";
    // 独立模式参数（可选）：外部不传 RootExtId 时，Block 从这些 data-blk-* 属性读取配置自主运行
    var blkConfig = (ViewData["BlkConfig"] as string) ?? "";
    var blkTable = (ViewData["BlkTable"] as string) ?? "";
    var blkLoadUrl = (ViewData["BlkLoadUrl"] as string) ?? "";
    var blkDeleteUrl = (ViewData["BlkDeleteUrl"] as string) ?? "";
    var blkProject = (ViewData["BlkProject"] as string) ?? "";
    var blkKeyField = (ViewData["BlkKeyField"] as string) ?? "";
}
<div id="@extId" data-dyn-mode="createApp" data-root-ext-id="@rootExtId"
     data-model-key="@modelKey" data-msg-center-key="@msgCenterKey"
     data-blk-config="@blkConfig" data-blk-table="@blkTable"
     data-blk-loadurl="@blkLoadUrl" data-blk-deleteurl="@blkDeleteUrl"
     data-blk-project="@blkProject" data-blk-keyfield="@blkKeyField" class="dyn-blk-list">
    <div class="dyn-blk-list__error" v-if="ctxState==='error'">{{ ctxError }}</div>
    <div class="dyn-blk-list__toolbar">
        @* Block 内部固定行为直接用 Vue 原生事件（不再走 dyn 全局动作表，无需 defineAction 转发）。 *@
        <button type="button" class="el-button el-button--primary el-button--small" @@click="onAdd()">+ 新增</button>
    </div>
    <el-table :data="model.rows" v-loading="model.loading" size="small" border>
        <el-table-column v-for="col in columns" :key="col.field" :prop="col.field" :label="col.label"
            :width="col.width || undefined" :min-width="col.minWidth || undefined"
            :align="col.align || undefined" :fixed="col.fixed || undefined"
            :show-overflow-tooltip="col.cellType !== 'tag'">
            <template #default="scope">
                <el-tag v-if="col.cellType === 'tag'" :type="cellTagType(col, scope.row)" size="small" effect="light">
                    {{ formatCell(col, scope.row) }}
                </el-tag>
                <span v-else>{{ formatCell(col, scope.row) }}</span>
            </template>
        </el-table-column>
        <el-table-column label="操作" width="180" fixed="right">
            <template #default="scope">
                <button type="button" class="el-button el-button--small is-link" @@click="onEdit(scope.row)">编辑</button>
                <button type="button" class="el-button el-button--small is-link" @@click="onAddChild(scope.row)">+子</button>
                <button type="button" class="el-button el-button--small is-link is-text" @@click="onDelete(scope.row)">删除</button>
            </template>
        </el-table-column>
    </el-table>
    <div class="dyn-blk-list__page">
        <el-pagination background layout="total, prev, pager, next, sizes"
            :total="model.total" :current-page="model.page" :page-size="model.size"
            :page-sizes="[10, 20, 50, 100]" @@current-change="onPage" @@size-change="onSize"></el-pagination>
    </div>
    <script type="application/json" tag="dynmodel">{"rows":[],"page":1,"size":20,"total":0,"loading":false,"filter":{}}</script>
    <script type="text/plain" tag="dynconfig">
    // ========== 双模式上下文：组合（必须找到根 app，失败显式报错不降级）/ 独立（无 rootExtId，读 data-blk-*） ==========
    var __ctx = {
        columns: [], keyField: 'Id', table: '', loadUrl: '', deleteUrl: '', project: '',
        msgCenter: null, state: 'loading', error: ''
    };
    var __hydrateCb = null;
    var __unreg = null;
    function __finishCtx() { if (__hydrateCb) __hydrateCb(); }
    function __applyCombined(app) {
        var r = DynBlocks.combinedCtx(element, app);
        if (r.error) {
            __ctx.state = 'error'; __ctx.error = r.error;
            console.error('[ListBlock]', r.error);
            return;
        }
        __ctx.columns = r.cfg.columns || [];
        __ctx.keyField = r.cfg.keyField || 'Id';
        __ctx.table = r.cfg.table || '';
        __ctx.loadUrl = r.cfg.loadUrl || '';
        __ctx.deleteUrl = r.cfg.deleteUrl || '';
        __ctx.project = r.cfg.project || '';
        __ctx.msgCenter = r.msg;
        __ctx.state = 'ready';
    }
    function __applyStandalone() {
        var indCfg = DynBlocks.parseAttr(element, 'data-blk-config') || {};
        __ctx.columns = indCfg.columns || [];
        __ctx.table = element.getAttribute('data-blk-table') || '';
        __ctx.loadUrl = element.getAttribute('data-blk-loadurl') || '';
        __ctx.deleteUrl = element.getAttribute('data-blk-deleteurl') || '';
        __ctx.project = element.getAttribute('data-blk-project') || '';
        __ctx.keyField = element.getAttribute('data-blk-keyfield') || indCfg.keyField || 'Id';
        if (typeof createMessageCenter !== 'function') {
            __ctx.state = 'error'; __ctx.error = '独立模式缺少 message-center.js，无法创建消息中心';
            return;
        }
        __ctx.msgCenter = createMessageCenter();
        __ctx.state = 'ready';
    }
    var __root = DynBlocks.getRoot(element);
    if (!__root) {
        __applyStandalone();
    } else if (__root.app) {
        __applyCombined(__root.app);
    } else {
        // 声明了组合模式但根 app 未就绪：有限重试；超时显式报错，绝不静默自建消息中心
        DynBlocks.whenRootReady(element, function (app, err) {
            if (app) __applyCombined(app);
            else { __ctx.state = 'error'; __ctx.error = err; console.error('[ListBlock]', err); }
            __finishCtx();
        });
    }
    var dynConfig = {
        data: function () {
            return {
                ctxState: __ctx.state, ctxError: __ctx.error || '',
                columns: __ctx.columns || [],
                keyField: __ctx.keyField || 'Id',
                table: __ctx.table || '',
                loadUrl: __ctx.loadUrl || '',
                deleteUrl: __ctx.deleteUrl || '',
                project: __ctx.project || '',
                ctxBound: false
            };
        },
        methods: {
            // 上下文就绪后的统一水合：同步就绪时 mounted 直接调；异步就绪时回调调
            __hydrate: function () {
                this.ctxState = __ctx.state;
                this.ctxError = __ctx.error || '';
                if (__ctx.state !== 'ready') return;
                this.columns = __ctx.columns || [];
                this.keyField = __ctx.keyField || 'Id';
                this.table = __ctx.table || '';
                this.loadUrl = __ctx.loadUrl || '';
                this.deleteUrl = __ctx.deleteUrl || '';
                this.project = __ctx.project || '';
                this.__bind();
            },
            // 注册命令接收 + 首次加载（仅一次；registerBlock 同名多接收者由消息中心支持）
            __bind: function () {
                if (this.ctxBound) return;
                this.ctxBound = true;
                var self = this, msg = __ctx.msgCenter;
                if (msg && typeof msg.registerBlock === 'function') {
                    __unreg = msg.registerBlock('list', function (cmd, payload) { return self.handleCommand(cmd, payload); });
                }
                this.loadData();
            },
            // 加载列表：两种接口风格 POST body 同构 {table,page,size,filter,project}；
            // 统一走 DynBlocks.search（DynCall 信封解包，失败统一 toast）
            loadData: function () {
                var self = this;
                if (!this.table || !this.loadUrl) return Promise.resolve(null);
                this.model.loading = true;
                return DynBlocks.search(this.loadUrl, {
                    table: this.table, page: this.model.page, size: this.model.size,
                    filter: this.model.filter || {}, project: this.project
                }, element)
                    .then(function (data) {
                        self.model.loading = false;
                        self.model.rows = (data && data.rows) || [];
                        self.model.total = (data && data.total) || 0;
                        return data;
                    })
                    .catch(function (e) { self.model.loading = false; return null; });
            },
            // 命令入口：loadData（带筛选）/ reload（刷新当前）
            handleCommand: function (cmd, payload) {
                if (cmd === 'loadData') {
                    this.model.filter = (payload && payload.filter) || {};
                    this.model.page = 1;
                    return this.loadData();
                }
                if (cmd === 'reload') { return this.loadData(); }
                return Promise.resolve(null);
            },
            onPage: function (p) { this.model.page = p; this.loadData(); },
            onSize: function (s) { this.model.size = s; this.model.page = 1; this.loadData(); },
            // ---------------- 列值呈现（cellType=tag / options 字典映射 / 空值占位） ----------------
            // 命中列 options 项：options:[{value:1,label:'启用',type:'success'}]，值按字符串宽松比较
            cellOption: function (col, row) {
                var v = row ? row[col.field] : null;
                if (col.options && col.options.length) {
                    for (var i = 0; i < col.options.length; i++) {
                        if (String(col.options[i].value) === String(v)) return col.options[i];
                    }
                }
                return null;
            },
            // 显示文本：options.label 优先，其次原值；空值显示 col.emptyText（默认 '-'）
            formatCell: function (col, row) {
                var v = row ? row[col.field] : null;
                if (v === null || v === undefined || v === '') return col.emptyText || '-';
                var o = this.cellOption(col, row);
                if (o && o.label !== undefined && o.label !== null) return o.label;
                return v;
            },
            // tag 类型：options 项的 type 优先；无映射时按值真假给 success/info
            cellTagType: function (col, row) {
                var v = row ? row[col.field] : null;
                var o = this.cellOption(col, row);
                if (o && o.type) return o.type;
                if (col.tagType) return col.tagType;
                return v ? 'success' : 'info';
            },
            // 事件：+新增 / 行编辑 / +子（主子预填由根 app 处理）—— 经消息中心发出
            onAdd: function () { var msg = __ctx.msgCenter; if (msg) msg.emitEvent('list.add', {}); },
            onEdit: function (row) { var msg = __ctx.msgCenter; if (msg) msg.emitEvent('list.edit', { row: row }); },
            onAddChild: function (row) { var msg = __ctx.msgCenter; if (msg) msg.emitEvent('list.addChild', { row: row }); },
            // 删除：契约统一收口在 DynBlocks.deleteRequest——
            // 平台直连 delete 用 query 传 table/id（空 body）；业务 dyndata delete 用 body {table, keys:{主键}, project}。
            // 删除前用 dyn.confirmAsync 确认；成功后本地刷新（DynCall 统一 toast）。
            onDelete: function (row) {
                var self = this;
                var kf = this.keyField || 'Id';
                var id = row && row[kf];
                if (id === null || id === undefined) return;
                var doDelete = function () {
                    var req = DynBlocks.deleteRequest(self.deleteUrl, self.table, id, kf, self.project);
                    DynCall.post(req.url, req.body, { scopeEl: element })
                        .then(function () {
                            dyn.showMessage('删除成功', 'success');
                            self.loadData();
                        })
                        .catch(function (e) { /* DynCall 已统一 toast */ });
                };
                if (window.dyn && typeof window.dyn.confirmAsync === 'function') {
                    window.dyn.confirmAsync('确定删除该条记录吗？').then(function (ok) { if (ok) doDelete(); });
                } else {
                    doDelete();
                }
            }
        },
        // 挂载完成：水合（水合内注册命令并首次加载）
        mounted: function () {
            var self = this;
            __hydrateCb = function () { self.__hydrate(); };
            if (__ctx.state !== 'loading') this.__hydrate();
        },
        // 卸载：从消息中心摘除本接收者（同名多接收者支持），避免失效实例残留
        beforeUnmount: function () {
            if (__unreg) { try { __unreg(); } catch (e) { } __unreg = null; }
        }
    };
    </script>
</div>

<style>
    .dyn-blk-list { display: flex; flex-direction: column; }
    .dyn-blk-list__error { margin-bottom: 12px; padding: 9px 12px; background: #fef0f0; color: #f56c6c;
        border: 1px solid #fde2e2; border-radius: 4px; font-size: 13px; font-weight: 500; }
    .dyn-blk-list__toolbar { margin-bottom: 12px; }
    .dyn-blk-list .el-table { width: 100%; }
    .dyn-blk-list__page { display: flex; justify-content: flex-end; margin-top: 14px; }
</style>
