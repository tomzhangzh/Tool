@{
    // =====================================================================================
    // Detail 积木（平台规范·双模式版）：壳 + 动态表单渲染，行为定义在 dynconfig。
    //   组合模式：容器带 data-root-ext-id + data-model-key + data-msg-center-key。
    //             dynconfig 按 data-root-ext-id 用 dyn.getApp(根元素) 找到根 app，再按 data-model-key
    //             动态读取根 model 中【模板自定义】的配置对象（含 detailConfig/detailDefault/table/addUrl/editUrl），
    //             按 data-msg-center-key 读取消息中心。Block 不预设根 model 的任何固定 key。
    //   独立模式：未传 RootExtId 时，从自身 data-blk-config / data-blk-default / data-blk-table /
    //             data-blk-addurl / data-blk-editurl 读取配置，自建消息中心
    //   - 表单渲染：<dyn-dynamic-com :jsonconfig>（PageSetting.ConfigJson 表单组件树），
    //     :parentmodelinfo="form"（DefaultJson 骨架 + 命令预填/回填合并结果）
    //   - 命令（接收）：newForm{preFill} 新增（静态 default + preFill 浅合并）/ editForm{row} 编辑回填
    //   - 事件（发出）：detail.saved{action,row} —— 根 app 收到后命令 List 刷新
    //   - 网络：统一走 DynCall（信封解包 + 统一错误处理），不再手写 axios/fetch
    // =====================================================================================
    var extId = (ViewData["ExtId"] as string) ?? ("Db" + Guid.NewGuid().ToString("N"));
    var rootExtId = (ViewData["RootExtId"] as string) ?? "";
    var modelKey = (ViewData["ModelKey"] as string) ?? "";
    var msgCenterKey = (ViewData["MsgCenterKey"] as string) ?? "";
    // 独立模式参数（可选）：外部不传 RootExtId 时，Block 从这些 data-blk-* 属性读取配置自主运行
    var blkConfig = (ViewData["BlkConfig"] as string) ?? "";
    var blkDefault = (ViewData["BlkDefault"] as string) ?? "";
    var blkTable = (ViewData["BlkTable"] as string) ?? "";
    var blkAddUrl = (ViewData["BlkAddUrl"] as string) ?? "";
    var blkEditUrl = (ViewData["BlkEditUrl"] as string) ?? "";
    var blkProject = (ViewData["BlkProject"] as string) ?? "";
    var blkModal = (ViewData["BlkModal"] as string) ?? "";
}
<div id="@extId" data-dyn-mode="createApp" data-root-ext-id="@rootExtId"
     data-model-key="@modelKey" data-msg-center-key="@msgCenterKey"
     data-blk-config="@blkConfig" data-blk-default="@blkDefault" data-blk-table="@blkTable"
     data-blk-addurl="@blkAddUrl" data-blk-editurl="@blkEditUrl"
     data-blk-project="@blkProject" data-blk-modal="@blkModal" class="db">
    <div class="db-errbar" v-if="formError">{{ formError }}</div>
    <div class="db-body">
        <dyn-dynamic-com v-if="detailCfg" :jsonconfig="detailCfg" :parentmodelinfo="form"></dyn-dynamic-com>
    </div>
    <div class="db-btns">
        @* 按钮用 dyn-click 动作体系（平台规范，对齐 DetailTemplate），ctx.vm 即本 Block proxy。
           注意：el-button 会拦截冒泡阻断 dyn 委托，故用【原生 button + el-button 样式类】保持视觉一致；
           保存按钮用 :disabled 代替 loading（原生 button 无 loading 态）。 *@
        <button type="button" class="el-button el-button--small" data-dyn-click-DetailCancel>取消</button>
        <button type="button" class="el-button el-button--primary el-button--small" :disabled="loading" data-dyn-click-DetailSave>保存</button>
    </div>
    <script type="text/plain" tag="dynconfig">
    // ========== 双模式：组合（data-root-ext-id + data-model-key/data-msg-center-key，动态读根 model） / 独立（无，读自身 data-blk-*） ==========
    var __rid = element.getAttribute('data-root-ext-id');
    var __rootApp = null;
    if (__rid) { var __rootEl = document.getElementById(__rid); if (__rootEl) __rootApp = dyn.getApp(__rootEl); }
    var __ctx = {};
    if (__rootApp) {
        // 组合模式：配置对象由模板通过 data-model-key 指定，消息中心由 data-msg-center-key 指定（缺省 'msgCenter'）。
        // 模板根 model 用什么 key 完全由模板决定，Block 不预设任何固定字段，只按传入 key 动态读取。
        var __modelKey = element.getAttribute('data-model-key');
        var __msgKey = element.getAttribute('data-msg-center-key') || 'msgCenter';
        var __cfg = __modelKey ? __rootApp.model[__modelKey] : null;
        if (__cfg && typeof __cfg === 'object') {
            __ctx = __cfg;
        } else if (__rid) {
            console.error('[DetailBlock] 根 model 不存在 key【' + __modelKey + '】或值非对象，请检查模板 Partial 传参 ModelKey');
        }
        __ctx.msgCenter = __rootApp.model[__msgKey] || null;
    } else {        // 独立模式：外部未注入根上下文 → 从自身 data-blk-config / data-blk-default / data-blk-table / data-blk-addurl / data-blk-editurl 读取，并自建消息中心。
        // 约定：独立使用时，页面/容器需自行引入 message-center.js 并提供上述属性。
        var __P = function (s) { try { return JSON.parse(s || 'null') || null; } catch (e) { return null; } };
        __ctx = {
            detailConfig: __P(element.getAttribute('data-blk-config')),
            detailDefault: __P(element.getAttribute('data-blk-default')) || {},
            table: element.getAttribute('data-blk-table') || '',
            addUrl: element.getAttribute('data-blk-addurl') || '',
            editUrl: element.getAttribute('data-blk-editurl') || '',
            project: element.getAttribute('data-blk-project') || '',
            msgCenter: (typeof createMessageCenter === 'function') ? createMessageCenter() : null
        };
    }
    // 弹窗模式：data-blk-modal="true" 时，保存成功后发全局 dyndata.saved 事件并关闭弹窗（宿主页面据此刷新列表）
    __ctx.modal = element.getAttribute('data-blk-modal') === 'true';
    var dynConfig = {
        data: function () {
            var initForm = __ctx.detailDefault || {};
            return {
                detailCfg: __ctx.detailConfig || null,
                form: JSON.parse(JSON.stringify(initForm)),
                formError: '',
                loading: false,
                table: __ctx.table || '',
                addUrl: __ctx.addUrl || '',
                editUrl: __ctx.editUrl || '',
                project: __ctx.project || '',
                modal: __ctx.modal === true,
                __initForm: initForm
            };
        },
        methods: {
            // 表单校验：扫描容器内动态组件节点的 __dynValidate 钩子
            validateForm: function () {
                var errs = [];
                var nodes = element.querySelectorAll('*');
                for (var i = 0; i < nodes.length; i++) {
                    var n = nodes[i];
                    if (typeof n.__dynValidate === 'function') {
                        try {
                            var ok = n.__dynValidate();
                            if (ok !== true) {
                                var msg = null;
                                if (n.__dynErrors && n.__dynErrors.length) {
                                    msg = n.__dynErrors.map(function (e) { return (e && e.message) || e; }).join('；');
                                }
                                if (!msg) {
                                    try {
                                        var inst = n.__vueParentComponent;
                                        var comp = inst && inst.proxy;
                                        if (comp && comp.comInnerInfo && comp.comInnerInfo.validation && comp.comInnerInfo.validation.errors) {
                                            comp.comInnerInfo.validation.errors.forEach(function (e) { if (e && e.message) msg = e.message; });
                                        }
                                    } catch (e) { }
                                }
                                if (!msg) msg = '存在未通过校验的字段';
                                if (errs.indexOf(msg) < 0) errs.push(msg);
                            }
                        } catch (e) { console.warn('[detail validate]', e); }
                    }
                }
                return errs;
            },
            // 命令入口：newForm（新增，静态 default + preFill 浅合并，不改 PageSetting）/ editForm（回填）
            handleCommand: function (cmd, payload) {
                if (cmd === 'newForm') {
                    var preFill = (payload && payload.preFill) || {};
                    this.form = Object.assign({}, JSON.parse(JSON.stringify(this.__initForm)), preFill);
                    this.formError = '';
                    return Promise.resolve(null);
                }
                if (cmd === 'editForm') {
                    var row = (payload && payload.row) || {};
                    this.form = Object.assign({}, JSON.parse(JSON.stringify(this.__initForm)), row);
                    this.formError = '';
                    return Promise.resolve(null);
                }
                return Promise.resolve(null);
            },
            // 保存：校验 → 业务库 insert/update（body {table,data}，统一走 DynCall）→ 发 detail.saved 事件
            onSave: function () {
                var self = this;
                var errs = this.validateForm();
                if (errs.length) {
                    this.formError = errs.join('；');
                    dyn.showMessage(errs.join('；'), 'warning');
                    return;
                }
                this.loading = true;
                var isEdit = this.form && this.form.Id !== null && this.form.Id !== undefined && this.form.Id !== '';
                DynCall.post(isEdit ? this.editUrl : this.addUrl, { table: this.table, data: this.form, project: this.project }, { scopeEl: element })
                    .then(function () {
                        self.loading = false;
                        self.formError = '';
                        dyn.showMessage('保存成功', 'success');
                        var msg = __ctx.msgCenter;
                        if (msg) msg.emitEvent('detail.saved', { action: isEdit ? 'edit' : 'add', row: self.form });
                        // 弹窗模式：通知宿主页面刷新 + 关闭弹窗（宿主据此重新加载列表）
                        if (self.modal) {
                            try {
                                window.dispatchEvent(new CustomEvent('dyndata.saved', { detail: { table: self.table, project: self.project } }));
                            } catch (e) { }
                            var layero = element.closest ? element.closest('.layui-layer') : null;
                            if (window.layui && window.layui.layer) {
                                var times = layero ? layero.getAttribute('times') : null;
                                if (times && times !== '') window.layui.layer.close(times);
                                else window.layui.layer.closeAll();
                            }
                        }
                    })
                    .catch(function (e) { self.loading = false; /* DynCall 已统一 toast */ });
            },
            // 取消：清空表单（新增态骨架）
            onCancel: function () {
                this.form = JSON.parse(JSON.stringify(this.__initForm));
                this.formError = '';
            },
            // 注册本 Block 的保存/取消动作（dyn-click 委托在 document 捕获层触发，ctx.vm 即本 Block proxy）
            registerActions: function () {
                if (!dyn || typeof dyn.defineAction !== 'function') return;
                dyn.defineAction('DetailSave', function (ctx) {
                    var vm = ctx && ctx.vm;
                    if (vm && typeof vm.onSave === 'function') return vm.onSave();
                });
                dyn.defineAction('DetailCancel', function (ctx) {
                    var vm = ctx && ctx.vm;
                    if (vm && typeof vm.onCancel === 'function') return vm.onCancel();
                });
                // 注意：无需 dyn.rebindActions —— generateSelector 每次点击动态生成，动作注册即生效；
                // 多次 rebind 会导致 document 监听叠加（一次点击触发多次动作）。
            }
        },
        mounted: function () {
            this.registerActions();
            // 向根 app 消息中心注册本积木（接收 newForm/editForm 命令）
            var self = this, msg = __ctx.msgCenter;
            if (msg && typeof msg.registerBlock === 'function') {
                msg.registerBlock('detail', function (cmd, payload) { return self.handleCommand(cmd, payload); });
            }
        }
    };
    </script>
</div>

<style>
    .db { display: flex; flex-direction: column; }
    .db-errbar { margin-bottom: 10px; padding: 9px 12px; background: #fef0f0; color: #f56c6c;
        border: 1px solid #fde2e2; border-radius: 4px; font-size: 13px; font-weight: 500; }
    .db-body { flex: 1; }
    .db-btns { display: flex; justify-content: flex-end; gap: 8px; margin-top: 14px;
        padding-top: 12px; border-top: 1px solid #e4e7ed; }
</style>
