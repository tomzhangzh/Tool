@model VueLibV4.Platform.Models.DynWebPage
@using VueLibV4.Web.Core
@using VueLibV4.Platform.Services
@inject IDynTemplateService TemplateSvc
@{
    var Slots = ViewData["DynExtSlots"] as DynExtSlots ?? new DynExtSlots();

    // ① 页面参数卡片：每个分组各自折叠、默认全部展开
    Slots["detail:body-extra"] = @<text>
    <el-collapse v-if="pp.visible" v-model="pp.active" class="pp-collapse">
        <el-collapse-item v-if="pp.tplCfg" name="base" :title="'基础参数'">
            <dyn-dynamic-com :jsonconfig="pp.tplCfg" :parentmodelinfo="pageParams"></dyn-dynamic-com>
        </el-collapse-item>
        <el-collapse-item v-for="slot in pp.slots" :key="slot.slot" :name="slot.slot"
                          :title="'🧩 ' + slot.slotName">
            <div class="pp-sec__desc">{{ slot.block.description || '' }}</div>
            <dyn-dynamic-com v-if="slot.block.paramCfg" :jsonconfig="slot.block.paramCfg"
                             :parentmodelinfo="pageParams.blocks[slot.slot]"></dyn-dynamic-com>
        </el-collapse-item>
    </el-collapse>
    </text>;

    // ② 脚本：拉 paramschema、维护 pageParams、双向写回 form.ParamsJson
    Slots["detail:app-ext"] = @<script type="text/plain" tag="dynconfig-ext">
    var dynConfigExt = {
        data: function () {
            return {
                // 本地参数模型（与 ParamsJson 结构对应），任何变更同步序列化回 form.ParamsJson
                pageParams: {
                    TableName: '', KeyField: 'Id', ChildFkField: '', ModalPageId: null,
                    blocks: { filter: { settingId: null }, list: { settingId: null, loadUrl: '', deleteUrl: '' } }
                },
                pp: { visible: false, templateName: '', tplCfg: null, slots: [], active: ['base'] }
            };
        },
        watch: {
            // 模板/主键变化 → 重新拉 schema 并回填
            'form.Id': function () { this.ppLoad(); },
            'form.TemplateId': function () { this.ppLoad(); },
            // 参数变更 → 序列化回 ParamsJson
            pageParams: {
                deep: true,
                handler: function () { this.ppSync(); }
            }
        },
        mounted: function () {
            var self = this;
            // 编辑行异步回填后 form.TemplateId 才到位，watch 已能捕捉；这里兜底加载一次
            this.ppLoad();
        },
        methods: {
            ppLoad: function () {
                var self = this;
                var tid = Number(this.form && this.form.TemplateId);
                if (!tid || tid <= 0) { this.pp.visible = false; return; }
                var pageId = Number(this.form && this.form.Id) || 0;
                fetch('/api/platform/dynwebpage/paramschema?templateId=' + tid + '&pageId=' + pageId)
                    .then(function (r) { return r.json(); })
                    .then(function (res) {
                        if (!res || res.code !== 0 || !res.data) { self.pp.visible = false; return; }
                        var d = res.data;
                        self.pp.visible = true;
                        self.pp.templateName = d.template ? d.template.name : '';
                        self.pp.tplCfg = self.__parse(d.template && d.template.configJson);
                        // 槽位：paramConfigJson 是字符串，解析成对象
                        self.pp.slots = (d.slots || []).map(function (s) {
                            return {
                                slot: s.slot, slotName: s.slotName, required: s.required,
                                block: {
                                    name: s.block.name,
                                    description: s.block.description,
                                    paramCfg: self.__parse(s.block.paramConfigJson)
                                }
                            };
                        });
                        // 默认全部展开
                        self.pp.active = ['base'].concat(self.pp.slots.map(function (s) { return s.slot; }));
                        // 用已保存值回填 pageParams
                        self.__fillParams(d);
                    })
                    .catch(function () { self.pp.visible = false; });
            },
            __fillParams: function (d) {
                var p = d.params || {};
                var pp = this.pageParams;
                pp.TableName = p.TableName || '';
                pp.KeyField = p.KeyField || 'Id';
                pp.ChildFkField = p.ChildFkField || '';
                pp.ModalPageId = p.ModalPageId || null;
                // blocks：每个槽位 values.settingId / model
                (d.slots || []).forEach(function (s) {
                    var v = s.values || {};
                    if (!pp.blocks[s.slot]) pp.blocks[s.slot] = {};
                    pp.blocks[s.slot].settingId = v.settingId || null;
                    var m = v.model || {};
                    Object.keys(m).forEach(function (k) { pp.blocks[s.slot][k] = m[k]; });
                });
            },
            __parse: function (s) {
                if (!s) return null;
                try { return JSON.parse(s); } catch (e) { return null; }
            },
            ppSync: function () {
                if (!this.pp.visible) return;
                var pp = this.pageParams;
                var out = {
                    TableName: pp.TableName, KeyField: pp.KeyField,
                    ChildFkField: pp.ChildFkField, ModalPageId: pp.ModalPageId,
                    blocks: {}
                };
                var self = this;
                Object.keys(pp.blocks).forEach(function (slot) {
                    var b = pp.blocks[slot] || {};
                    var entry = { settingId: b.settingId || null, model: {} };
                    Object.keys(b).forEach(function (k) {
                        if (k === 'settingId') return;
                        if (b[k] !== '' && b[k] !== null && b[k] !== undefined) entry.model[k] = b[k];
                    });
                    out.blocks[slot] = entry;
                });
                this.form.ParamsJson = JSON.stringify(out);
            }
        }
    };
    </script>;
}

<style>
    .pp-collapse { margin-top: 14px; border: 1px solid #ebeef5; border-radius: 6px; }
    .pp-sec { background: #fafbfc; border: 1px solid #ebeef5; border-radius: 6px; padding: 10px 12px; margin-bottom: 10px; }
    .pp-sec:last-child { margin-bottom: 0; }
    .pp-sec__title { font-size: 12px; font-weight: 600; color: #606266; margin-bottom: 8px; }
    .pp-sec__desc { font-weight: 400; font-size: 11px; color: #a8abb2; margin-left: 6px; }
</style>
