@model VueLibV4.Platform.Models.DynWebPage
@using VueLibV4.Platform.Services
@using VueLibV4.Services.Extensions
@using VueLibV4.Web.Core
@using Newtonsoft.Json.Linq
@inject IPageSettingService PageSettingService
@{
    // =====================================================================================
    // 布局壳：list-master-detail（顶筛选 + 左列表 + 右明细，可拖拽分隔条）——壳模型 v1.1
    //
    // 第二个壳，用来验证 engine 抽象的通用性：
    //   槽位 filter 可选（spec 不放即整块消失，壳默认连线自动跳过）；
    //   master=list / detail=detail；主子"+子"预填经 shell.newChild 按 spec 外键名转发
    //   （这是第二个壳逼出来的引擎能力：壳命令 ctx.handles 可转发其他槽）。
    //
    // 页面规格（DynWebPage.SpecJson；空值回退 ParamsJson）：
    //   { layout:"list-master-detail",
    //     layoutProps:{leftWidth:50, childFkField:""},
    //     provide:{table,keyField,project?},
    //     slots:{
    //       filter:{block:"filter", settingId:87},          // 可整节省略
    //       master:{block:"list",   settingId:88},
    //       detail:{block:"detail", settingId:89} },
    //     wires:[ ... ], replaceDefaultWires:false }
    // =====================================================================================
    Layout = "_Layout";

    var spec = DynPageViewHelper.ParseShellSpec(Model);
    var provide = spec["provide"] as JObject ?? new JObject();
    string Prov(string key, string dft = "")
    {
        var v = provide[key];
        if (v == null || v.Type == JTokenType.Null) return dft;
        var s = v.ToString();
        return string.IsNullOrEmpty(s) ? dft : s;
    }

    var tableName = Prov("table");
    var keyField = Prov("keyField", "Id");
    var project = Prov("project", Model.ProjectId?.ToString() ?? "");

    var slots = spec["slots"] as JObject ?? new JObject();
    var filterSlot = slots["filter"] as JObject;
    var masterSlot = slots["master"] as JObject ?? new JObject();
    var detailSlot = slots["detail"] as JObject ?? new JObject();

    var filterBlock = filterSlot?["block"]?.ToString()?.Trim().ToLowerInvariant();
    var masterBlock = string.IsNullOrWhiteSpace(masterSlot["block"]?.ToString()) ? "list" : masterSlot["block"]!.ToString().Trim().ToLowerInvariant();
    var detailBlock = string.IsNullOrWhiteSpace(detailSlot["block"]?.ToString()) ? "detail" : detailSlot["block"]!.ToString().Trim().ToLowerInvariant();
    var filterPartial = string.IsNullOrEmpty(filterBlock) ? null : DynPageViewHelper.BlockAppPath(filterBlock);
    var masterPartial = DynPageViewHelper.BlockAppPath(masterBlock);
    var detailPartial = DynPageViewHelper.BlockAppPath(detailBlock);

    int? SlotSettingId(JObject slot) =>
        int.TryParse(slot?["settingId"]?.ToString(), out var i) ? i : null;

    // —— 三个槽的 Block 配置：数据域坐标 + PageSetting UI；零 URL ——
    var filterCfg = new JObject();
    DynPageViewHelper.ApplyFrontSetting(filterCfg, PageSettingService, SlotSettingId(filterSlot),
        "filterConfig", "filterDefault");
    filterCfg["project"] = project;

    var listCfg = new JObject();
    DynPageViewHelper.ApplyListSetting(listCfg, PageSettingService, SlotSettingId(masterSlot), "columns");
    listCfg["table"] = tableName;
    listCfg["keyField"] = keyField;
    listCfg["project"] = project;

    var detailCfg = new JObject();
    DynPageViewHelper.ApplyFrontSetting(detailCfg, PageSettingService, SlotSettingId(detailSlot),
        "detailConfig", "detailDefault");
    detailCfg["table"] = tableName;
    detailCfg["keyField"] = keyField;
    detailCfg["project"] = project;

    var layoutProps = spec["layoutProps"] as JObject ?? new JObject();
    var leftWidth = int.TryParse(layoutProps["leftWidth"]?.ToString(), out var lw0) ? lw0 : 50;
    var childFkField = layoutProps["childFkField"]?.ToString() ?? "";

    var extSlots = await Html.LoadPageExtAsync(Model);
    var extId = "Lmd" + Guid.NewGuid().ToString("N");
    var rootId = extId + "-root";
    var filterId = extId + "-filter";
    var masterId = extId + "-master";
    var detailId = extId + "-detail";
    var showDesignEntry = Convert.ToBoolean(ViewData["ShowDesignEntry"] ?? false);

    var pageParams = new JObject
    {
        ["table"] = tableName,
        ["tableName"] = tableName,
        ["keyField"] = keyField,
        ["project"] = project
    };
}
<div id="@rootId" class="lmd-root" data-dyn-layout="list-master-detail"
     data-dyn-params="@DynPageViewHelper.SafeJson(pageParams)"
     data-dyn-page-spec="@DynPageViewHelper.SafeJson(spec)">
    @await Html.PartialAsync("~/Views/DynTemplates/Partials/DynPageHeader.cshtml", new ViewDataDictionary(ViewData) {
        ["Title"] = Model.Name, ["Code"] = "list-master-detail", ["TableName"] = tableName,
        ["ShowBack"] = true, ["ShowDesign"] = showDesignEntry, ["PageId"] = Model.Id.ToString()
    })

    @if (masterPartial == null || detailPartial == null || (filterSlot != null && filterPartial == null))
    {
        <div class="lmd-fatal">
            壳槽位引用了未登记的 Block：filter=@(filterBlock ?? "(无)")，master=@masterBlock，detail=@detailBlock
        </div>
    }
    else
    {
        if (filterSlot != null)
        {
            <div class="lmd-card" data-layout-slot="filter">
                @await Html.PartialAsync(filterPartial, new ViewDataDictionary(ViewData) {
                    ["ExtId"] = filterId,
                    ["BlkConfig"] = DynPageViewHelper.SafeJson(filterCfg),
                    ["ExtSlots"] = extSlots
                })
            </div>
        }
        <div class="lmd-split" data-split-container>
            <div class="lmd-pane lmd-pane--master" data-layout-slot="master"
                 data-split-pane="master" style="width:@(leftWidth)%">
                @await Html.PartialAsync(masterPartial, new ViewDataDictionary(ViewData) {
                    ["ExtId"] = masterId,
                    ["BlkConfig"] = DynPageViewHelper.SafeJson(listCfg),
                    ["ExtSlots"] = extSlots
                })
            </div>

            <div class="lmd-gutter" data-split-gutter="" title="拖拽调整，双击复位">
                <span class="lmd-gutter-bar"></span>
            </div>

            <div class="lmd-pane lmd-pane--detail" data-layout-slot="detail">
                @await Html.PartialAsync(detailPartial, new ViewDataDictionary(ViewData) {
                    ["ExtId"] = detailId,
                    ["BlkConfig"] = DynPageViewHelper.SafeJson(detailCfg),
                    ["ExtSlots"] = extSlots
                })
            </div>
        </div>
    }
</div>

<style>
    .lmd-root { min-height: 100vh; box-sizing: border-box; display: flex; flex-direction: column;
        background: #f0f2f5; font-family: 'Helvetica Neue', Arial, 'PingFang SC', 'Microsoft YaHei', sans-serif; }
    .lmd-card { background: #fff; margin: 14px 20px 0; padding: 12px 16px; border-radius: 8px;
        border: 1px solid #e4e7ed; }
    .lmd-split { flex: 1; min-height: 480px; display: flex; margin: 14px 20px; box-sizing: border-box;
        background: #fff; border: 1px solid #e4e7ed; border-radius: 8px; overflow: hidden; }
    .lmd-pane { box-sizing: border-box; min-width: 0; }
    .lmd-pane--master { flex-shrink: 0; padding: 12px; overflow: hidden; min-height: 0; }
    .lmd-pane--detail { flex: 1; padding: 12px 16px; overflow: auto; }
    .lmd-gutter { flex-shrink: 0; width: 8px; cursor: col-resize; background: #f2f4f7;
        position: relative; display: flex; align-items: center; justify-content: center; }
    .lmd-gutter:hover { background: #e4e7ed; }
    .lmd-gutter-bar { width: 2px; height: 36px; border-radius: 2px; background: #c0c4cc; }
    .lmd-fatal { margin: 24px; padding: 16px; color: #c45656; background: #fef0f0;
        border: 1px solid #fde2e2; border-radius: 6px; }
</style>

@section Scripts {
    <script src="~/dyn/blocks/dyn-blocks-common.js" asp-append-version="true"></script>
    <script src="~/dyn/layouts/dyn-layout-engine.js" asp-append-version="true"></script>
    <script>
        DynLib.ready(function () {
            DynLayouts.register('list-master-detail', {
                slots: { filter: { expect: 'filter' }, master: { expect: 'list' }, detail: { expect: 'detail' } },
                defaultWires: [
                    { from: 'filter.changed', to: 'master.loadData', with: { filter: '$event' } },
                    { from: 'master.add',      to: 'detail.newForm',  with: { preFill: {} } },
                    { from: 'master.addChild', to: 'shell.newChild' },
                    { from: 'master.edit',     to: 'detail.editForm', with: { row: '$event.row' } },
                    { from: 'detail.saved',    to: 'master.reload' }
                ],
                commands: {
                    // 主子"+子"：父行主键 → spec.layoutProps.childFkField 指定的外键；未配置则空新增
                    newChild: function (payload, ctx) {
                        var spec = ctx.spec || {};
                        var lp = spec.layoutProps || {};
                        var provide = spec.provide || {};
                        var preFill = {};
                        var row = payload && payload.row;
                        if (lp.childFkField && row) {
                            var kf = provide.keyField || 'Id';
                            preFill[lp.childFkField] = row[kf] != null ? row[kf] : null;
                        }
                        if (!ctx.handles || !ctx.handles.detail) {
                            console.warn('[list-master-detail] detail 槽未挂载，newChild 忽略');
                            return;
                        }
                        return ctx.handles.detail.send('newForm', { preFill: preFill });
                    },
                    log: function (payload, ctx) {
                        var text = '[shell.log] ' + (ctx && ctx.spec ? ctx.spec.layout : '') + ' ← ' + JSON.stringify(payload);
                        console.info(text);
                        if (window.DynDebug && DynDebug.note) DynDebug.note(text, { source: 'shell' });
                    }
                },
                // 分隔条状态机（与 tree 壳同构：壳自有 UI，engine 不管）
                onMount: function (root, spec) {
                    var pane = root.querySelector('[data-split-pane="master"]');
                    var gutter = root.querySelector('[data-split-gutter]');
                    if (!pane || !gutter) return null;
                    var min = 20, max = 80;
                    var initial = (spec.layoutProps && spec.layoutProps.leftWidth) || 50;
                    var pct = initial, drag = null;

                    function apply(p) {
                        pct = Math.min(max, Math.max(min, p));
                        pane.style.width = pct + '%';
                    }
                    function onDown(e) {
                        e.preventDefault();
                        drag = { x: e.clientX, w: pane.getBoundingClientRect().width, pct: pct };
                        document.body.style.userSelect = 'none';
                    }
                    function onMove(e) {
                        if (!drag) return;
                        var p = drag.w > 0
                            ? (drag.w * drag.pct / 100 + (e.clientX - drag.x)) / drag.w * 100
                            : drag.pct;
                        apply(p);
                    }
                    function onUp() {
                        if (!drag) return;
                        drag = null;
                        document.body.style.userSelect = '';
                    }
                    function onDbl() { apply(initial); }

                    apply(initial);
                    gutter.addEventListener('mousedown', onDown);
                    window.addEventListener('mousemove', onMove);
                    window.addEventListener('mouseup', onUp);
                    gutter.addEventListener('dblclick', onDbl);
                    return {
                        dispose: function () {
                            gutter.removeEventListener('mousedown', onDown);
                            window.removeEventListener('mousemove', onMove);
                            window.removeEventListener('mouseup', onUp);
                            gutter.removeEventListener('dblclick', onDbl);
                        }
                    };
                }
            });

            DynLayouts.mount(document.getElementById('@rootId')).then(function (info) {
                window.__shell = info;
            });
        });
    </script>
}
