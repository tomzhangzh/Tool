@{
    Layout = "~/Areas/Component/Views/Common/_ContainerLayout.cshtml";
}

<template>
<!-- 透明容器（Fragment）ElementUI 版：设计模式保留容器 div 便于拖拽/选中；运行模式无外层 div 直接透出子组件 -->
    <div v-if="isDesignFrag" class="el-fragment lc-container"
         :style="getStyle(jc.options.itemoptions)"
         :class="getClass(jc.options.itemoptions)">
        <n-dynamic-com v-for="(child, idx) in safeChildren"
                       :key="child.component + '_' + idx"
                       :jsonconfig="child"
                       :parentmodelinfo="props.parentmodelinfo"
                       :node-path="props.nodePath + '.childrenctrls[' + idx + ']'">
        </n-dynamic-com>
        <!-- 直连模式：手写模板子元素 -->
        <slot v-if="$slots.default"></slot>
    </div>
    <template v-else>
        <n-dynamic-com v-for="(child, idx) in safeChildren"
                       :key="child.component + '_' + idx"
                       :jsonconfig="child"
                       :parentmodelinfo="props.parentmodelinfo"
                       :node-path="props.nodePath + '.childrenctrls[' + idx + ']'">
        </n-dynamic-com>
        <!-- 直连模式：手写模板子元素（运行态无外层 div，直接透出） -->
        <slot v-if="$slots.default"></slot>
    </template>
</template>

@section setupScripts{
    // 透明容器（Fragment）ElementUI 版：运行时不产生外层 div，直接透出子组件
    const isDesignFrag = computed(() => !!(designShared));
// 暴露组件特有变量给模板
const comExtra = { isDesignFrag };
}
