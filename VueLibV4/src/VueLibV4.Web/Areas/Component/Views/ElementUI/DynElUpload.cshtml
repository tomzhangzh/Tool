@{ Layout = "~/Areas/Component/Views/Common/_FormItemLayout.cshtml"; }

<el-upload :action="'/api/dyncommon/upload'"
           :accept="jc.options.comoptions.accept || ''"
           :limit="1"
           :show-file-list="true"
           :on-success="upOk"
           :on-error="upError"
           v-bind="comBind" v-bind="$attrs">
    <el-button type="primary" size="small">
        {{ jc.options.comoptions.buttonText || '点击上传' }}
    </el-button>
</el-upload>

@section setupScripts{
DVALUE = '';
function upOk(res) {
    if (res && res.code === 0 && res.data) {
        modelinfo.value = res.data.url || res.data;
    } else {
        dyn.showMessage((res && res.msg) || '上传失败', 'error');
    }
}
function upError() { dyn.showMessage('上传失败', 'error'); }
Object.assign(comExtra, { upOk, upError });
}
