@{
    Layout = "~/Areas/Component/Views/Common/_FormItemLayout.cshtml";
}
@section setupScripts{
    function upOk(res) {
        if (res && res.code === 0 && res.data) { modelinfo.value = res.data.url; }
        else { dyn.showMessage((res && res.msg) || '上传失败', 'error'); }
    }
    function upError() { dyn.showMessage('上传失败', 'error'); }
    Object.assign(comExtra, { upOk, upError });
}
<el-upload action="/api/dyncommon/upload" :show-file-list="false" :on-success="upOk" :on-error="upError"
           accept="image/*" v-bind="jc.options.comoptions" style="width:100%">
    <div style="width:88px; height:88px; border:1px dashed #d9d9d9; border-radius:6px; display:flex; align-items:center; justify-content:center; overflow:hidden; background:#fafafa; cursor:pointer;">
        <img v-if="modelinfo" :src="modelinfo" style="width:100%; height:100%; object-fit:cover;">
        <span v-else style="color:#8c939d; font-size:12px; text-align:center; line-height:1.4;">上传图片</span>
    </div>
</el-upload>