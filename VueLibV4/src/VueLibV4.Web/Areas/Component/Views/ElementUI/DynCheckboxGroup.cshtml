@{
    Layout = "~/Areas/Component/Views/Common/_FormItemLayout.cshtml";
}
@section setupScripts{
    // 数据源：static / dict / table / ajax —— 统一走 loadComOptions
    loadComOptions();
}
<el-checkbox-group v-model="modelinfo" v-bind="jc.options.comoptions" v-on="getComlisteners()">
    <el-checkbox v-for="opt in comInnerInfo.options" :key="opt.value" :value="opt.value">{{ opt.label }}</el-checkbox>
</el-checkbox-group>
