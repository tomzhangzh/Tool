@{
    Layout = "~/Areas/Component/Views/Common/_FormItemLayout.cshtml";
}
@section setupScripts{
    // 数据源：static / dict / table / ajax —— 统一走 loadComOptions
    loadComOptions();
}
<el-checkbox-group v-model="modelinfo" v-bind="comBind" v-on="getComlisteners()">
    <template v-if="comBind.type === 'button'">
        <el-checkbox-button v-for="opt in comInnerInfo.options" :key="opt.value" :label="opt.value">
            {{ opt.label }}
        </el-checkbox-button>
    </template>
    <template v-else>
        <el-checkbox v-for="opt in comInnerInfo.options" :key="opt.value" :label="opt.value">
            {{ opt.label }}
        </el-checkbox>
    </template>
</el-checkbox-group>