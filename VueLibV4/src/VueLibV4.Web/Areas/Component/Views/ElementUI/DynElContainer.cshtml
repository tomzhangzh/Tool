@{ Layout = "~/Areas/Component/Views/Common/_ContainerLayout.cshtml"; }

<template>
<el-container v-bind="comBind" v-on="getComlisteners()"
                  :style="getStyle(jc.options.itemoptions)"
                  :class="getClass(jc.options.itemoptions)">
        <div class="dyn-children-wrap dyn-is-flex" :class="designRootClass"><n-dynamic-com v-for="(child, idx) in safeChildren"
                       :key="child.__uid"
                       :jsonconfig="child"
                       :parentmodelinfo="props.parentmodelinfo"
                       :node-path="props.nodePath + '.childrenctrls[' + idx + ']'">
        </n-dynamic-com></div>
    </el-container>
</template>

@section setupScripts{
    DVALUE = null;
    // 无 wrapper：itemoptions（子项布局）统一合并进 options.itemoptions（组件根样式）
    comExtra.safeChildren = computed(() => {
        const rawList = (jc.childrenctrls || []).filter(c => c && typeof c === 'object');
        return rawList.map(child => {
            const io = child.itemoptions;
            if (!io || (!io.class && !io.style)) return child;
            const newChild = {
                ...child,
                options: { ...(child.options || {}), itemoptions: { ...((child.options || {}).itemoptions || {}) } }
            };
            const targetIo = newChild.options.itemoptions;
            if (io.class) {
                targetIo.class = [targetIo.class || "", io.class].filter(Boolean).join(" ");
            }
            if (io.style) {
                targetIo.style = { ...(targetIo.style || {}), ...io.style };
            }
            return newChild;
        });
    });
}
