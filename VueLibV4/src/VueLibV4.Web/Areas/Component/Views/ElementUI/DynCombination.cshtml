@{
    Layout = "~/Areas/Component/Views/Common/_ContainerLayout.cshtml";
}

<template>
<component :is="jc.options.comoptions.tag || 'div'"
               class="dyn-combination"
               :style="getStyle(jc.options.itemoptions)"
               :class="getClass(jc.options.itemoptions)">
        <!-- 组合组件：开放属性(comoptions) / 开放容器(childrenctrls) / 开放插槽(slots) -->
        <template v-for="(slotList, slotName) in (jc.slots || {})" :key="slotName">
            <slot :name="slotName"></slot>
            <DynRender v-for="(child, idx) in slotList" :key="child.component + '_' + idx" :cfg="child" />

        <DynRender v-for="(child, idx) in safeChildren" :key="child.component + '_' + idx" :cfg="child" />
    </component>
</template>
</template>

@section setupScripts{
    DVALUE = null;
}
