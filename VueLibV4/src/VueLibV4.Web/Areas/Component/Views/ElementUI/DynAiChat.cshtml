@{
    Layout = "~/Areas/Component/Views/Common/_BaseLayout.cshtml";
}

<template>
<div class="dyn-ai-chat" :style="{height: chatHeight}">
  <!-- 消息列表 -->
  <div class="chat-messages" ref="msgListRef">
    <div v-if="messages.length === 0" class="chat-empty">
      <el-icon :size="32" color="#c0c4cc"><ChatDotRound/></el-icon>
      <div class="empty-tip">有问题随时问我，我会边思考边回答</div>
    </div>

    <div v-for="(msg, idx) in messages" :key="idx" class="msg-row" :class="msg.role">
      <!-- 用户消息 -->
      <div v-if="msg.role === 'user'" class="bubble user-bubble">
        {{ msg.content }}
      </div>

      <!-- AI消息 -->
      <div v-else class="ai-wrap">
        <!-- 思考过程面板 -->
        <div v-if="msg.reasoning || msg.thinking" class="reasoning-box">
          <div class="reasoning-header" @click="msg.foldReasoning = !msg.foldReasoning">
            <el-icon v-if="msg.thinking" class="is-loading" color="#909399"><Loading/></el-icon>
            <el-icon v-else color="#606266"><MagicStick/></el-icon>
            <span class="reasoning-title">
              {{ msg.thinking ? '正在思考...' : '已完成思考（点击展开/收起）' }}
            </span>
          </div>
          <div v-show="!msg.foldReasoning" class="reasoning-content">
            {{ msg.reasoning }}
          </div>
        </div>

        <!-- 正式回答 -->
        <div v-if="msg.content || !msg.thinking" class="bubble ai-bubble" v-html="renderMarkdown(msg.content)"></div>
      </div>
    </div>
  </div>

  <!-- 输入区 -->
  <div class="chat-input-area">
    <el-input
      v-model="inputText"
      type="textarea"
      :rows="2"
      :placeholder="inputPlaceholder"
      @keyup.enter.ctrl="send"
      resize="none"
    />
    <el-button
      v-if="!generating"
      type="primary"
      class="send-btn"
      @click="send"
      :disabled="!inputText.trim()"
    >发送</el-button>
    <el-button
      v-else
      type="danger"
      class="send-btn"
      @click="stop"
    >停止生成</el-button>
  </div>
</div>
</template>

@section setupScripts{
const chatHeight = jc.options.comoptions.height || '500px';
const inputPlaceholder = jc.options.comoptions.placeholder || '输入问题，Ctrl+Enter发送...';
const systemPrompt = jc.options.comoptions.systemPrompt || '';

const messages = ref([]);
const inputText = ref('');
const generating = ref(false);
let abortController = null;
const msgListRef = ref(null);

function renderMarkdown(text) {
  if (!text) return '';
  if (window.markdownit) {
    try { return window.markdownit({html:true, linkify:true, breaks:true}).render(text); }
    catch(e) { return text; }
  }
  return text.replace(/\n/g, '<br>');
}

async function send() {
  const text = inputText.value.trim();
  if (!text || generating.value) return;
  inputText.value = '';

  // 加系统提示词作为第一条消息
  const sendMessages = [];
  if (systemPrompt) sendMessages.push({role: 'system', content: systemPrompt});
  sendMessages.push(...messages.value.map(m => ({role: m.role, content: m.role === 'assistant' ? m.content : m.content})));
  sendMessages.push({role: 'user', content: text});

  // 推用户消息
  messages.value.push({role: 'user', content: text});

  // 创建空AI消息占位
  const aiMsg = reactive({
    role: 'assistant',
    reasoning: '',
    content: '',
    thinking: true,
    foldReasoning: false
  });
  messages.value.push(aiMsg);
  generating.value = true;
  abortController = new AbortController();

  scrollToBottom();

  try {
    const resp = await fetch('/api/ai/chat/stream', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({messages: sendMessages}),
      signal: abortController.signal
    });

    const reader = resp.body.getReader();
    const decoder = new TextDecoder();
    let buffer = '';

    while(true) {
      const {done, value} = await reader.read();
      if (done) break;
      buffer += decoder.decode(value, {stream: true});
      const chunks = buffer.split('\n\n');
      buffer = chunks.pop();

      for (const chunk of chunks) {
        const line = chunk.replace('data: ', '').trim();
        if (!line) continue;
        if (line === '[DONE]') break;

        try {
          const data = JSON.parse(line);
          if (data.error) {
            aiMsg.content += '\n\n[出错了：' + data.error + ']';
            break;
          }
          if (data.reasoning) {
            aiMsg.reasoning += data.reasoning;
          }
          if (data.content) {
            if (aiMsg.thinking) {
              aiMsg.thinking = false;
              aiMsg.foldReasoning = true; // 开始回答就自动折叠思考区
            }
            aiMsg.content += data.content;
          }
          scrollToBottom();
        } catch(e) {}
      }
    }
  } catch(e) {
    if (e.name !== 'AbortError') {
      aiMsg.content += '\n\n[连接中断：' + e.message + ']';
    }
  } finally {
    aiMsg.thinking = false;
    generating.value = false;
    scrollToBottom();
  }
}

function stop() {
  abortController?.abort();
}

function scrollToBottom() {
  setTimeout(() => {
    if (msgListRef.value) {
      msgListRef.value.scrollTop = msgListRef.value.scrollHeight;
    }
  }, 10);
}

Object.assign(comExtra, { messages, inputText, generating, send, stop, chatHeight });
}

<style>
.dyn-ai-chat {
  display: flex;
  flex-direction: column;
  border: 1px solid #e4e7ed;
  border-radius: 8px;
  background: #fafafa;
  overflow: hidden;
}
.chat-messages {
  flex: 1;
  overflow-y: auto;
  padding: 16px;
}
.chat-empty {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #909399;
  gap: 12px;
}
.msg-row {
  margin-bottom: 16px;
  display: flex;
}
.msg-row.user {
  justify-content: flex-end;
}
.bubble {
  max-width: 80%;
  padding: 10px 14px;
  border-radius: 8px;
  line-height: 1.6;
  font-size: 14px;
}
.user-bubble {
  background: #409eff;
  color: white;
}
.ai-wrap {
  max-width: 85%;
}
.reasoning-box {
  margin-bottom: 8px;
  background: #f4f4f5;
  border-radius: 6px;
  overflow: hidden;
  font-size: 13px;
}
.reasoning-header {
  padding: 8px 12px;
  display: flex;
  align-items: center;
  gap: 6px;
  cursor: pointer;
  color: #606266;
  background: #ebeef5;
}
.reasoning-content {
  padding: 10px 12px;
  color: #909399;
  white-space: pre-wrap;
  max-height: 200px;
  overflow-y: auto;
}
.ai-bubble {
  background: white;
  border: 1px solid #e4e7ed;
}
.ai-bubble p { margin: 4px 0; }
.chat-input-area {
  display: flex;
  gap: 8px;
  padding: 12px;
  background: white;
  border-top: 1px solid #e4e7ed;
  align-items: flex-end;
}
.send-btn {
  flex-shrink: 0;
}
</style>
