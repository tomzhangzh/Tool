@{
    Layout = "~/Areas/Component/Views/Common/_ContainerLayout.cshtml";
}

<template>
<el-card v-bind="comBind"
             v-on="getComlisteners()">
        <template #header>
            <span>{{ jc.options?.comoptions.title || '' }}</span>

        <n-dynamic-com v-for="(child, idx) in safeChildren"
                       :key="child.component + '_' + idx"
                       :jsonconfig="child"
                       :parentmodelinfo="props.parentmodelinfo"
                       :node-path="props.nodePath + '.childrenctrls[' + idx + ']'">
        </n-dynamic-com>
    </el-card>
</template>
</template>

@section setupScripts{
    DVALUE = null;
}
