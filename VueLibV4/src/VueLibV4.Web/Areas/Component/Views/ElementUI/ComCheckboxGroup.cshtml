@{
    Layout = "~/Areas/Component/Views/Common/_FormItemLayout.cshtml";
}
@section setupScripts{
    // 数据源：static / dict / table / ajax —— 统一走 loadComOptions
    loadComOptions();
    // 多值：字符串逗号分隔 <-> 数组
    const modelinfoArray = Vue.computed({
        get() { return typeof modelinfo.value === 'string' && modelinfo.value ? modelinfo.value.split(',').map(s => s.trim()).filter(Boolean) : (Array.isArray(modelinfo.value) ? modelinfo.value : []); },
        set(arr) { modelinfo.value = Array.isArray(arr) ? arr.join(',') : (arr || ''); }
    });
    comExtra.modelinfoArray = modelinfoArray;
}
<el-checkbox-group v-model="modelinfoArray" v-bind="comBind" v-on="getComlisteners()">
    <el-checkbox v-for="opt in comInnerInfo.options" :key="opt.value" :label="opt.value">{{ opt.label }}</el-checkbox>
</el-checkbox-group>