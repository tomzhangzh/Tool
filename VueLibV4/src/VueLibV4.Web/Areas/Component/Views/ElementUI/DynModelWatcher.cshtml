@{ Layout = "~/Areas/Component/Views/Common/_BaseLayout.cshtml"; }

<!-- 隐藏的联动监听器：监听 model 变化，自动发请求并回填目标 model -->
<div v-if="false"></div>

@section setupScripts{
DVALUE = null;

const watchModel = computed(() => jc.options.comoptions.watchModel || '');
const rpcUrl = computed(() => jc.options.comoptions.url || '');
const rpcTarget = computed(() => jc.options.comoptions.targetModel || '');
const paramFrom = computed(() => jc.options.comoptions.paramFrom || '');

async function doReload() {
    if (!rpcUrl.value || !watchModel.value) return;
    const watchVal = props.parentmodelinfo ? props.parentmodelinfo[watchModel.value] : null;
    if (watchVal == null || watchVal === '') return;
    try {
        let url = rpcUrl.value;
        const qs = new URLSearchParams();
        qs.append(paramFrom.value || watchModel.value, watchVal);
        const sep = url.includes('?') ? '&' : '?';
        url = url + sep + qs.toString();
        const res = await fetch(url);
        const data = await res.json();
        if (rpcTarget.value && data) {
            const val = data.data !== undefined ? data.data : data;
            if (props.parentmodelinfo) {
                props.parentmodelinfo[rpcTarget.value] = val;
            }
        }
    } catch (e) {
        console.warn('[ModelWatcher] 请求失败:', e);
    }
}

onMounted(() => {
    if (watchModel.value && props.parentmodelinfo) {
        // 监听目标 model 变化
        watch(() => props.parentmodelinfo[watchModel.value], () => doReload());
    }
});

Object.assign(comExtra, { doReload });
}
