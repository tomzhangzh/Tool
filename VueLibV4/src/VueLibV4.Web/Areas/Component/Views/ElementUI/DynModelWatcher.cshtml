@{ Layout = "~/Areas/Component/Views/Common/_BaseLayout.cshtml"; }

<!-- 隐藏的通用监听器：监听 model 变化，执行 JS 代码或触发 ActionHelper 动作 -->
<div v-if="!showDebug"></div>
<div v-else class="dyn-watch-debug" style="border:1px dashed #67c23a;border-radius:4px;padding:8px;margin:4px;font-size:12px;background:#f0f9eb;">
  <div style="font-weight:600;color:#67c23a;margin-bottom:4px;">👁️ ModelWatcher [{{ watchModel }}]</div>
  <div style="color:#909399;font-size:11px;">触发次数: {{ triggerCount }}</div>
  <div v-if="lastValue" style="margin-top:4px;max-height:60px;overflow:auto;background:#fff;padding:4px;border-radius:2px;">
    <pre style="margin:0;font-size:11px;">{{ JSON.stringify(lastValue) }}</pre>
  </div>
</div>

@section setupScripts{
DVALUE = null;

const watchModel = computed(() => jc.options.comoptions.watchModel || '');
const runJsCode = computed(() => jc.options.comoptions.onChangeJs || '');
const runActionCode = computed(() => jc.options.comoptions.onChangeAction || '');
const conditionExpr = computed(() => jc.options.comoptions.condition || '');
const delay = computed(() => parseInt(jc.options.comoptions.delay || 0) || 0);
const showDebug = computed(() => jc.options.comoptions.showDebug === true || jc.options.comoptions.showDebug === 'true' || jc.options.comoptions.showDebug === 1);

const triggerCount = ref(0);
const lastValue = ref(null);
let _timer = null;

function checkCondition(nv, ov) {
    if (!conditionExpr.value) return true;
    try {
        const fn = new Function('model', 'newVal', 'oldVal', 'getByPath',
            'return (' + conditionExpr.value + ');');
        return !!fn(props.parentmodelinfo, nv, ov, getByPath);
    } catch (e) {
        console.warn('[ModelWatcher] 条件表达式错误:', e);
        return true;
    }
}

async function doTrigger(nv, ov) {
    if (nv === ov) return;
    if (!checkCondition(nv, ov)) return;
    triggerCount.value++;
    lastValue.value = nv;

    if (runJsCode.value) {
        try {
            const fn = new Function('model', 'newVal', 'oldVal', 'getByPath',
                runJsCode.value);
            fn(props.parentmodelinfo, nv, ov, getByPath);
        } catch (e) {
            console.warn('[ModelWatcher] JS执行失败:', e);
        }
    }
    if (runActionCode.value && window.DynAction && typeof window.DynAction.run === 'function') {
        try {
            await window.DynAction.run(runActionCode.value, { newVal: nv, oldVal: ov }, {
                element: null,
                model: props.parentmodelinfo
            });
        } catch (e) {
            console.warn('[ModelWatcher] 动作执行失败:', e);
        }
    }
}

function triggerWithDelay(nv, ov) {
    if (delay.value > 0) {
        if (_timer) clearTimeout(_timer);
        _timer = setTimeout(() => doTrigger(nv, ov), delay.value);
    } else {
        doTrigger(nv, ov);
    }
}

onMounted(() => {
    if (watchModel.value && props.parentmodelinfo) {
        // 支持逗号分隔监听多个字段
        const fields = watchModel.value.split(',').map(function(s){ return s.trim(); }).filter(function(s){ return s; });
        fields.forEach(function(f) {
            watch(() => getByPath(parentModel.value, f),
                  (nv, ov) => triggerWithDelay(nv, ov), { deep: true });
        });
    }
});

// 组件卸载后待触发的防抖定时器必须取消，否则会对已销毁实例执行动作
onBeforeUnmount(() => {
    if (_timer) { clearTimeout(_timer); _timer = null; }
});

Object.assign(comExtra, { doTrigger, triggerCount, lastValue, showDebug });
}
