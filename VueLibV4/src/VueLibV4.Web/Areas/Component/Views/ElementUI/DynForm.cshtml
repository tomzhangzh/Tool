@{
    Layout = "~/Areas/Component/Views/Common/_ContainerLayout.cshtml";
}

<template>
<el-form :model="formModel"
             :label-width="jc.options.comoptions.labelWidth || jc.options.labeloptions.labelWidth || '100px'"
             :inline="!!jc.options.comoptions.inline"
             :label-position="jc.options.comoptions.labelPosition || 'right'"
             :style="getStyle(jc.options.itemoptions)"
             :class="getClass(jc.options.itemoptions)">
        <div class="dyn-children-wrap" :class="designRootClass"><n-dynamic-com v-for="(child, idx) in safeChildren"
                       :key="child.__uid"
                       :jsonconfig="child"
                       :parentmodelinfo="formModel"
                       :node-path="props.nodePath + '.childrenctrls[' + idx + ']'">
        </n-dynamic-com></div>
    </el-form>
</template>

@section setupScripts{
    DVALUE = null;
    // 表单容器：labeloptions.labelWidth 支持（用户要求"容器中设置标签宽度"）
    const formModel = computed(() => {
        const pm = props.parentmodelinfo;
        if (pm) return pm;
        return modelinfo.value && typeof modelinfo.value === 'object' ? modelinfo.value : {};
    });
}
