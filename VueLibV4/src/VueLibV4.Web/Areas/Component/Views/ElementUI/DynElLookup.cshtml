@{ Layout = "~/Areas/Component/Views/Common/_FormItemLayout.cshtml"; }

<div class="dyn-lookup" style="display:flex;gap:8px;align-items:center;">
    <el-input v-model="modelinfo" v-bind="comBind" v-on="getComlisteners()"
              :placeholder="jc.options.comoptions.placeholder || '点击选择'"
              :readonly="true" style="cursor:pointer;" @click="openDialog">
    </el-input>
    <el-button type="primary" plain size="small" @click="openDialog">
        {{ jc.options.comoptions.buttonText || '选择' }}
    </el-button>

    <el-dialog v-model="dialogVisible"
               :title="jc.options.comoptions.dialogTitle || '请选择'"
               width="700px" top="5vh" destroy-on-close>
        <div v-if="dialogUrl" style="min-height:400px;" v-html="dialogContent"></div>
        <template #footer>
            <el-button @click="dialogVisible = false">取消</el-button>
        </template>
    </el-dialog>
</div>

@section setupScripts{
DVALUE = '';
const dialogVisible = ref(false);
const dialogUrl = ref('');
const dialogContent = ref('');

function buildUrl() {
    let url = jc.options.comoptions.url || '';
    const params = jc.options.comoptions.params || {};
    Object.keys(params).forEach(k => {
        let v = params[k];
        if (typeof v === 'string' && v.indexOf('{{model.') === 0) {
            const path = v.replace(/\{\{model\./, '').replace(/\}\}/, '');
            v = getByPath(parentModel.value, path);
        }
        params[k] = v;
    });
    const qs = new URLSearchParams(params).toString();
    if (qs) url += (url.includes('?') ? '&' : '?') + qs;
    return url;
}

async function openDialog() {
    dialogUrl.value = buildUrl();
    dialogContent.value = '<div style="color:#909399;padding:40px;text-align:center;">加载中...</div>';
    dialogVisible.value = true;
    try {
        const res = await fetch(dialogUrl.value);
        dialogContent.value = await res.text();
        // 注入回传回调：弹窗页面选完值后调用 window.__lookupSelect(value)
        setTimeout(() => {
            window.__lookupSelect = function(val) {
                if (jc.options.comoptions.targetModel) {
                    writeModel(jc.options.comoptions.targetModel, val);
                } else {
                    modelinfo.value = val;
                }
                dialogVisible.value = false;
            };
        }, 100);
    } catch (e) {
        dialogContent.value = '<div style="color:#f56c6c;padding:20px;">加载失败: ' + e.message + '</div>';
    }
}

function writeModel(path, val) {
    if (!path || !props.parentmodelinfo) return;
    if (window._ && _.set) { _.set(props.parentmodelinfo, path, val); return; }
    const parts = path.split('.');
    let obj = props.parentmodelinfo;
    for (let i = 0; i < parts.length - 1; i++) {
        if (typeof obj[parts[i]] !== 'object' || obj[parts[i]] === null) obj[parts[i]] = {};
        obj = obj[parts[i]];
    }
    obj[parts[parts.length - 1]] = val;
}

Object.assign(comExtra, { openDialog });
}
