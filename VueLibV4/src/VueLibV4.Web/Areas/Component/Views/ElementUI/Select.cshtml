@{
    Layout = "~/Areas/Component/Views/Common/_FormItemLayout.cshtml";
}

<el-select v-model="modelinfo"
               :key="'sel' + (comInnerInfo.options || []).length"
               style="width: 100%;"
               v-bind="jc.options.comoptions"
               v-on="getComlisteners()">
        <el-option v-for="item in comInnerInfo.options"
                   :key="item.value"
                   :label="item.label"
                   :value="item.value">
        </el-option>
    </el-select>



@section setupScripts{
    DVALUE = '';
    // 下拉选项统一走 _BaseLayout.loadComOptions：static(optionValuesText/optionValues) / dict / table / ajax
    comInnerInfo.options = [];
    loadComOptions();
    watch(function () {
        var co = (jc.options && jc.options.comoptions) || {};
        return [co.sourceType, co.dictType, co.optionValuesText, co.table, co.url];
    }, function () { loadComOptions(); }, { deep: true });
}
