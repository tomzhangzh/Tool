@{ Layout = "~/Areas/Component/Views/Common/_FormItemLayout.cshtml"; }

<el-transfer v-model="modelinfo" v-bind="comBind" v-on="getComlisteners()"
             :data="comInnerInfo.options || []"
             :titles="jc.options.comoptions.titles || ['待选', '已选']"
             :button-texts="jc.options.comoptions.buttonTexts || ['→', '←']"
             :filterable="jc.options.comoptions.filterable === true"
             :filter-placeholder="jc.options.comoptions.filterPlaceholder || '输入搜索'"
             :props="jc.options.comoptions.props || { key: 'value', label: 'label' }">
</el-transfer>

@section setupScripts{
DVALUE = [];
loadComOptions();
}
