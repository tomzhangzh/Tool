@{ Layout = "~/Areas/Component/Views/Common/_BaseLayout.cshtml"; }

<div ref="boxRef" class="dyn-html-box"
     :style="{ minHeight: jc.options.comoptions.minHeight || '100px', ...(jc.options.itemoptions && jc.options.itemoptions.style) }">
</div>

@section setupScripts{
DVALUE = null;
const boxRef = ref(null);

const boxUrl = computed(() => jc.options.comoptions.url || '');
const boxParams = computed(() => jc.options.comoptions.params || {});
const boxRefreshModel = computed(() => jc.options.comoptions.refreshOnModelChange || '');

const HB_PREFIX = String.fromCharCode(123, 123) + 'model.';
const HB_SUFFIX = String.fromCharCode(125, 125);
async function doLoad() {
    if (!boxUrl.value || !boxRef.value) return;
    try {
        let url = boxUrl.value;
        const params = {};
        Object.keys(boxParams.value || {}).forEach(k => {
            let v = boxParams.value[k];
            if (typeof v === 'string' && v.indexOf(HB_PREFIX) === 0) {
                const path = v.replace(HB_PREFIX, '').replace(HB_SUFFIX, '');
                v = getByPath(parentModel.value, path);
            }
            params[k] = v;
        });
        const qs = new URLSearchParams(params).toString();
        if (qs) url += (url.includes('?') ? '&' : '?') + qs;

        // 走框架自己的 dyn.mount：fetch HTML → 注入 → 递归挂载成 Vue app
        // 已挂载时 dyn.mount 会直接短路返回旧 app，必须先卸载才能真正按新 url 重新加载
        if (window.dyn && dyn.unmount && boxRef.value.__dynApp) {
            dyn.unmount(boxRef.value);
        }
        boxRef.value.setAttribute('data-dyn-url', url);
        boxRef.value.__dynLoaded = false;
        if (window.dyn && dyn.mount) {
            await dyn.mount(boxRef.value);
        }
    } catch (e) {
        if (boxRef.value) {
            boxRef.value.innerHTML = '<div style="color:#909399;padding:12px;">加载失败: ' + e.message + '</div>';
        }
    }
}

onMounted(() => {
    doLoad();
});
// refreshOnModelChange：在 setup 顶层注册（父模型常为异步加载，onMounted 时可能尚不存在）
if (boxRefreshModel.value) {
    watch(() => {
        const m = parentModel.value;
        return m ? getByPath(m, boxRefreshModel.value) : undefined;
    }, () => doLoad());
}
onBeforeUnmount(() => {
    if (boxRef.value && window.dyn && dyn.unmount) {
        try { dyn.unmount(boxRef.value); } catch (e) { }
    }
});

Object.assign(comExtra, { doLoad });
}
