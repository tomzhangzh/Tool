@{
    Layout = "~/Areas/Component/Views/Common/_FormItemLayout.cshtml";
}
@section setupScripts{
    // 数据源：static / dict / table / ajax —— 统一走 loadComOptions
    loadComOptions();
}
<el-radio-group v-model="modelinfo" v-bind="comBind" v-on="getComlisteners()">
    <el-radio v-for="opt in comInnerInfo.options" :key="opt.value" :value="opt.value">{{ opt.label }}</el-radio>
</el-radio-group>
