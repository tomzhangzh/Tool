@{ Layout = "~/Areas/Component/Views/Common/_FormItemLayout.cshtml"; }

<el-popover v-bind="comBind" v-on="getComlisteners()"
            :title="jc.options.comoptions.title || ''"
            :width="jc.options.comoptions.width || 200"
            :trigger="jc.options.comoptions.trigger || 'hover'"
            :content="jc.options.comoptions.content || ''"
            :placement="jc.options.comoptions.placement || 'top'">
    <template #reference>
        <el-button text size="small" :icon="jc.options.comoptions.icon || 'InfoFilled'">
            {{ jc.options.comoptions.triggerText || '查看说明' }}
        </el-button>
    </template>
</el-popover>

@section setupScripts{ DVALUE = null; }
