@{ Layout = "~/Areas/Component/Views/Common/_BaseLayout.cshtml"; }

<!-- 隐藏的 RPC 调用器 -->
<div v-if="!showDebug"></div>
<div v-else class="dyn-rpc-debug" style="border:1px dashed #409eff;border-radius:4px;padding:8px;margin:4px;font-size:12px;background:#ecf5ff;">
  <div style="font-weight:600;color:#409eff;margin-bottom:4px;">🔗 RpcLoader {{ rpcUrl || '(未配置URL)' }}</div>
  <div v-if="lastResult" style="margin-top:4px;max-height:100px;overflow:auto;background:#fff;padding:4px;border-radius:2px;">
    <pre style="margin:0;font-size:11px;">{{ JSON.stringify(lastResult, null, 2) }}</pre>
  </div>
  <div v-if="lastError" style="margin-top:4px;color:#f56c6c;font-size:11px;">{{ lastError }}</div>
  <el-button size="mini" type="primary" plain @@click="doLoad" style="margin-top:6px;">手动触发</el-button>
</div>

@section setupScripts{
DVALUE = null;

const rpcUrl = computed(() => jc.options.comoptions.url || '');
const rpcMethod = computed(() => jc.options.comoptions.method || 'GET');
const rpcAutoLoad = computed(() => jc.options.comoptions.autoLoad !== false);
const rpcParams = computed(() => jc.options.comoptions.params || {});
const rpcTarget = computed(() => jc.options.comoptions.targetModel || '');
const onSuccessJs = computed(() => jc.options.comoptions.onSuccessJs || '');
const onSuccessAction = computed(() => jc.options.comoptions.onSuccessAction || '');
const onErrorJs = computed(() => jc.options.comoptions.onErrorJs || '');
const onErrorAction = computed(() => jc.options.comoptions.onErrorAction || '');
const showDebug = computed(() => jc.options.comoptions.showDebug === true || jc.options.comoptions.showDebug === 'true' || jc.options.comoptions.showDebug === 1);
const delay = computed(() => parseInt(jc.options.comoptions.delay || 0) || 0);

const lastResult = ref(null);
const lastError = ref('');

function writeModel(path, val) {
    if (!path || !props.parentmodelinfo) return;
    if (window._ && _.set) { _.set(props.parentmodelinfo, path, val); return; }
    const parts = path.split('.');
    let obj = props.parentmodelinfo;
    parts.slice(0, -1).forEach(function (p) {
        if (typeof obj[p] !== 'object' || obj[p] === null) obj[p] = {};
        obj = obj[p];
    });
    obj[parts[parts.length - 1]] = val;
}

const RPC_PREFIX = String.fromCharCode(123, 123) + 'model.';
const RPC_SUFFIX = String.fromCharCode(125, 125);
async function doLoad() {
    if (!rpcUrl.value) return;
    try {
        let url = rpcUrl.value;
        const params = {};
        Object.keys(rpcParams.value || {}).forEach(k => {
            let v = rpcParams.value[k];
            if (typeof v === 'string' && v.indexOf(RPC_PREFIX) === 0) {
                const path = v.replace(RPC_PREFIX, '').replace(RPC_SUFFIX, '');
                v = getByPath(parentModel.value, path);
            }
            params[k] = v;
        });
        const opt = { method: rpcMethod.value };
        if (rpcMethod.value.toUpperCase() === 'POST') {
            opt.headers = { 'Content-Type': 'application/json' };
            opt.body = JSON.stringify(params);
        } else if (Object.keys(params).length) {
            const qs = new URLSearchParams(params).toString();
            url += (url.includes('?') ? '&' : '?') + qs;
        }
        const res = await fetch(url, opt);
        if (!res.ok) throw new Error('HTTP ' + res.status);
        const data = await res.json();
        const result = (data && data.data !== undefined) ? data.data : data;
        lastResult.value = result;
        lastError.value = '';

        if (rpcTarget.value) writeModel(rpcTarget.value, result);

        if (onSuccessJs.value) {
            try {
                const fn = new Function('result', 'model', 'getByPath',
                    onSuccessJs.value);
                fn(result, props.parentmodelinfo, getByPath);
            } catch (e) {
                console.warn('[RpcLoader] JS执行失败:', e);
            }
        }
        if (onSuccessAction.value && window.DynAction && typeof window.DynAction.run === 'function') {
            try {
                await window.DynAction.run(onSuccessAction.value, { result: result }, {
                    element: null,
                    model: props.parentmodelinfo
                });
            } catch (e) {
                console.warn('[RpcLoader] 动作执行失败:', e);
            }
        }
    } catch (e) {
        lastError.value = e.message || String(e);
        console.warn('[RpcLoader] 请求失败:', e);
        if (onErrorJs.value) {
            try {
                const fn = new Function('error', 'model', 'getByPath', onErrorJs.value);
                fn(e, props.parentmodelinfo, getByPath);
            } catch (je) { console.warn('[RpcLoader] onError JS失败:', je); }
        }
        if (onErrorAction.value && window.DynAction && typeof window.DynAction.run === 'function') {
            try {
                await window.DynAction.run(onErrorAction.value, { error: e.message }, { element: null, model: props.parentmodelinfo });
            } catch (je) { console.warn('[RpcLoader] onError 动作失败:', je); }
        }
    }
}

let _timer = null;
function loadWithDelay() {
    if (delay.value > 0) {
        if (_timer) clearTimeout(_timer);
        _timer = setTimeout(doLoad, delay.value);
    } else {
        doLoad();
    }
}

onMounted(() => {
    if (rpcAutoLoad.value) loadWithDelay();
    // 暴露给其他组件通过事件调用
    if (window.DynBus) {
        window.DynBus.on('rpc:' + (jc.options.modelname || jc.id), loadWithDelay);
    }
});

Object.assign(comExtra, { doLoad, loadWithDelay, lastResult, lastError, showDebug });
}
