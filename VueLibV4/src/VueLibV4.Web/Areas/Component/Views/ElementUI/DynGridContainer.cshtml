@{
    Layout = "~/Areas/Component/Views/Common/_ContainerLayout.cshtml";
}

<template>
<div class="dyn-children-wrap dyn-grid-container"
         :style="gridStyle"
         :class="[...getClass(jc.options.itemoptions), designRootClass]">
    <n-dynamic-com v-for="(child, idx) in safeChildren" :key="child.__uid" :jsonconfig="child" :parentmodelinfo="props.parentmodelinfo" :node-path="props.nodePath + '.childrenctrls[' + idx + ']'"></n-dynamic-com>
</div>
</template>

@section setupScripts{
    DVALUE = null;
    const gridStyle = computed(() => {
        const co = jc.options?.comoptions || {};
        const io = jc.options?.itemoptions?.style || {};
        return Object.assign({ display: 'grid' }, co, io);
    });
    comExtra.gridStyle = gridStyle;
}
