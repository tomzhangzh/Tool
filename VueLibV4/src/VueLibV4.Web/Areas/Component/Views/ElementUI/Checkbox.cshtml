﻿﻿﻿﻿﻿@{ Layout = "~/Areas/Component/Views/Common/_FormItemLayout.cshtml"; }

<el-checkbox-group v-model="modelinfo" v-bind="comBind" v-on="getComlisteners()">
    <template v-if="comBind.type === 'button'">
        <el-checkbox-button v-for="item in comInnerInfo.options" :key="item.value" :label="item.value">{{ item.label }}</el-checkbox-button>
    </template>
    <template v-else>
        <el-checkbox v-for="item in comInnerInfo.options" :key="item.value" :label="item.value" :border="comBind.border">{{ item.label }}</el-checkbox>
    </template>
</el-checkbox-group>



@section setupScripts{
    DVALUE = [];
    // 多选项统一走 _BaseLayout.loadComOptions：static(optionValuesText/optionValues) / dict / table / ajax
    comInnerInfo.options = [];
    loadComOptions();
    watch(function () {
        var co = (jc.options && jc.options.comoptions) || {};
        return [co.sourceType, co.dictType, co.optionValuesText, co.table, co.url];
    }, function () { loadComOptions(); }, { deep: true });
}
