@RenderBody()
<script tag='comconfig'>
var comConfig = {
    props: {
        jsonconfig: { type: Object, default: null },
        parentmodelinfo: { type: Object, default: null },
        nodePath: { type: String, default: '' },
        // ===== 直连模式（裸标签）支持：<dyn-el-input v-model="model.Name" label="名称" required placeholder="..." /> =====
        // 不传 jsonconfig 时，这些 props 合成内存配置，复用同一套配置驱动逻辑；与 jsonconfig 同时出现时 jsonconfig 打底、直连 props 覆盖
        modelname: { type: String, default: null },
        label: { type: String, default: null },
        required: { type: Boolean, default: false },
        placeholder: { type: String, default: null },
        // 生成视图（ViewGenerateService）/手写模板的裸标签：options 各组以属性传入。
        // cshtml 侧用 Razor 双写 at 符号转义（属性值里的变量引用由生成器写成 co0 形式），浏览器侧拿到的是 JSON 字符串；
        // 也支持 v-bind 对象形式 :comoptions="{...}" 直接传对象。
        comoptions: { type: [Object, String], default: null },
        labeloptions: { type: [Object, String], default: null },
        itemoptions: { type: [Object, String], default: null },
        wrapperoptions: { type: [Object, String], default: null },
        compassthrough: { type: String, default: null },
        evalcondition: { type: String, default: null },
        modelexpr: { type: String, default: null },
        modelsetexpr: { type: String, default: null },
        bindings: { type: [Object, String], default: null },
        modelValue: { default: null }
    },
    // v-model 直连通道：modelinfo setter 在无 parentmodelinfo+modelname 路径时 emit update:modelValue
    emits: ['update:modelValue'],
    setup(props, context) {
        const { ref, reactive, computed, inject, provide, watch, nextTick, onMounted, onBeforeUnmount, getCurrentInstance } = Vue;
        const _ = window._;
        // 配置机制层：合并/表达式求值/属性穿透/选项加载/校验的纯函数实现（wwwroot/dyn/dyn-node-config.js，可 node 单测）
        const NC = window.DynNodeConfig;
        const inst = Vue.getCurrentInstance();
        const dyn = inst?.proxy?.$dyn;
        /**
         * 组件【配置契约】默认结构：可序列化、会落库为 JSON（PageSetting.ConfigJson）。
         * 键名约定一律全小写无分隔（comoptions/labeloptions/itemoptions/modelname/...），
         * 与 SQL 种子、PageGen 生成器、设计器属性面板保持一致；勿新增驼峰配置键。
         * 运行时状态/方法不入此结构，统一走下方 comExtra 扩展槽。
         */
        const defaults = {
            component: null,
            modelname: null,
            options: {
                comoptions: {},
                comlisteners: {},
                labeloptions: { label: '', required: false, show: true },
                itemoptions: { style: {}, class: '' },
                wrapperoptions: {},
                // 父→子属性穿透白名单（逗号分隔的配置点路径，全小写契约）；
                // 容器把自身 comoptions/labeloptions 向下 provide，子组件仅继承在此声明且自身未显式配置的路径
                compassthrough: "comoptions.size,labeloptions.labelposition,labeloptions.labelwidth",
                uiGlobalProps: { size: undefined, disabled: undefined },
                defaultLabelOptions: { labelwidth: "auto", requiredmark: true },
                evalcondition: ""
            },
            validators: [],
            childrenctrls: [],
            slots: {},
            extendinfo: {}
        };
        // comoptions 中的"数据源私有键"：仅用于 loadComOptions 解析选项，
        // 不得随 v-bind 透传到 Element 组件根节点（否则泄漏为 optionvalues=... 等无效 attribute）
        const COM_OPTION_PRIVATE_KEYS = {
            sourceType: 1, optionValues: 1, optionValuesText: 1, dictType: 1,
            projectId: 1, table: 1, valueField: 1, textField: 1, sql: 1,
            parentField: 1, parentValuePath: 1, parentValue: 1,
            url: 1, valueKey: 1, labelKey: 1
        };
        // 裸标签 JSON 属性归一（对象直用 / JSON 字符串解析 / 失败回落 dft）见 NC.parseAttrJson
        // 直连模式（裸标签未传 jsonconfig）：用直连 props 合成内存 jc（不落库、不参与设计器导出），
        // 让下方全部配置驱动逻辑（label/绑定/校验/穿透）无差别复用。
        // 优先级：JSON 属性（生成视图/手写 comoptions=".."）打底；label/required/placeholder 直连 props 覆盖。
        const directMode = !props.jsonconfig;
        const syntheticJc = directMode ? {
            component: (inst && inst.type && inst.type.name) || null,
            modelname: props.modelname || null,
            modelexpr: props.modelexpr || null,
            modelsetexpr: props.modelsetexpr || null,
            bindings: NC.parseAttrJson(props.bindings, null),
            options: Object.assign(
                {
                    comoptions: props.placeholder
                        ? Object.assign(NC.parseAttrJson(props.comoptions, {}), { placeholder: props.placeholder })
                        : NC.parseAttrJson(props.comoptions, {}),
                    labeloptions: Object.assign(
                        { label: props.label || '', required: !!props.required, show: !!(props.label || props.required) },
                        NC.parseAttrJson(props.labeloptions, null) || {}
                    ),
                    itemoptions: NC.parseAttrJson(props.itemoptions, { style: {}, class: '' }),
                    wrapperoptions: NC.parseAttrJson(props.wrapperoptions, {})
                },
                props.compassthrough ? { compassthrough: props.compassthrough } : null,
                props.evalcondition ? { evalcondition: props.evalcondition } : null
            ),
            validators: [],
            childrenctrls: [],
            slots: {},
            extendinfo: {}
        } : null;
        // 直接引用 reactive 的 jsonconfig，不深拷贝；补齐缺失的默认字段
        const jc = props.jsonconfig || syntheticJc;
        // 补齐框架默认结构（原地写入，保持 jsonconfig 的响应式引用）
        NC.ensureDefaults(jc, defaults.options.compassthrough);
        // 配置键契约：options 下所有框架定义的组与子键一律「全小写无分隔」
        // （comoptions / labeloptions / itemoptions / wrapperoptions / compassthrough / evalcondition）。
        // 这里不做任何驼峰兼容：历史数据的键名由 Data/migrate-configkeys-20261027.sql 一次性迁移。
        // 仅做一次性诊断告警，避免旧库静默失效。
        if (!globalThis.__DYN_CFGKEY_WARNED__ &&
            (jc.options.comOptions || jc.options.labelOptions || jc.options.comInnerInfo)) {
            globalThis.__DYN_CFGKEY_WARNED__ = true;
            console.warn('[DynConfig] 检测到旧驼峰配置键（comOptions/labelOptions/comInnerInfo），' +
                '运行时不再兼容；请对数据库执行 src/VueLibV4.Web/Data/migrate-configkeys-20261027.sql。', jc.options);
        }
        // 配置合并 / labeloptions 合并 / 样式 class 组装见 NC.mergePatch / mergeLabelOptions / getStyle / getClass
        // 只保留函数型监听器（comlisteners 可能混入配置键）见 NC.getComlisteners
        function getComlisteners() { return NC.getComlisteners(jc.options?.comlisteners); }
        // comInnerInfo：校验状态 + 选项型组件的远程 options 数据
        const comInnerInfo = reactive({
            validation: { valid: true, errors: [], touched: false },
            options: []
        });
        let DVALUE = null;
        /**
         * comExtra —— 组件【运行时扩展槽】（组件私有成员的唯一合法出口）
         * 与上方 defaults / jc.options 的分工：
         *   - jc.options 是可序列化【配置契约】，落库为 PageSetting.ConfigJson，只放纯数据；
         *   - comExtra 只放运行时态：ref / reactive / computed / 方法，
         *     例如 DynTable 的 rows/total/loadList、FormItem 的 labelPos/labelStyle。
         * 用法：各组件在 setupScripts 内 Object.assign(comExtra, { ... }) 暴露，
         * 基座 return 时统一展开到模板（模板内直接以 rows、loadList 等名字访问）。
         * 约束：① 只许 Object.assign / 点赋值，不许整体重赋值；
         *       ② 禁止把 ref/函数挂进 jc.options；③ 不参与设计器 JSON 导出。
         */
        const comExtra = {};

        // ============ 选项数据源公共能力（DynSelect/ComSelect/Radio/Checkbox 共用） ============
        // 归一化 / 静态文本解析 / 远程加载（dict/table/sql/ajax）见 NC.normOptionList / optionsFromText / loadOptions
        /**
         * 按 comoptions.sourceType 加载下拉选项（dict / table / sql / ajax 的实现见 NC.loadOptions）。
         * setupScripts 阶段 modelinfo 尚未声明（暂时性死区），若数据源含 {{ }} 模板会触发
         * resolveTemplate → exprCtx → modelinfo 报错；检测到 TDZ 时延迟到 nextTick 重试。
         */
        function loadComOptions(forceType) {
            try { void modelinfo; } catch (e) { nextTick(function () { loadComOptions(forceType); }); return; }
            NC.loadOptions(jc.options && jc.options.comoptions, {
                forceType: forceType,
                ctx: exprCtx.value,
                parentModel: parentModel.value,
                onOptions: function (list) { comInnerInfo.options = list; }
            });
        }
        // ========== 属性穿透（实现见 NC.applyPassThrough） ==========
        // 白名单模式：true=启用（子自身 compassthrough 过滤，取交集）；false=关闭（忽略子白名单，父清单字段全收）
        // 穿透白名单：来自组件持久化配置 options.compassthrough（见 defaults），仅白名单模式启用时参与过滤
        comExtra.comPassThrough = jc.options.compassthrough;
        // 注入父穿透数据源
        const parentPassSource = inject('comExtraPass', null);
        // 透传白名单开关：容器 _ContainerLayout 顶部配置 provide；无容器父时默认 false（关闭白名单）
        const passWhiteListMode = inject('passThroughWhiteListMode', false) === true;
        // 合并本地配置 + 上层穿透
        const mergedOptions = computed(() => {
            return NC.applyPassThrough(jc.options, parentPassSource, comExtra.comPassThrough, passWhiteListMode);
        });
        // ========== end 属性穿透 ==========
        // inject before section scripts
        const injectParentModelPrefix = inject('parentModelPrefix', null);
        // 直连模式：容器通过插槽（<slot/>）渲染的裸标签子组件没有显式 parentmodelinfo prop，
        // 由最近容器 provide 的 dynSlotParentModel 兜底（可能是 computed ref 或原始对象）
        const injectSlotParentModelRaw = inject('dynSlotParentModel', null);
        const injectSlotParentModel = computed(() => {
            if (!injectSlotParentModelRaw) return null;
            return (typeof injectSlotParentModelRaw === 'object' && 'value' in injectSlotParentModelRaw)
                ? injectSlotParentModelRaw.value : injectSlotParentModelRaw;
        });
        // 实际生效的父模型：显式 prop 优先，inject 兜底
        const parentModel = computed(() => props.parentmodelinfo || injectSlotParentModel.value || null);
        const injectParentDefaultLabelOptions = inject('defaultLabelOptions', null);
        const injectUiGlobalProps = inject('ui_global_props', null);
        const injectDesignerScope = inject("designer", null);
        const injectParentComInnerInfo = inject('comInnerInfo', () => ({}));
        function lookupIsContainer(compName) {
            if (!injectDesignerScope || !injectDesignerScope.componentMetaList) return false;
            var list = injectDesignerScope.componentMetaList;
            for (var i = 0; i < list.length; i++) {
                var m = list[i];
                var nm = m.ComponentName || m.componentName;
                if (nm === compName) return !!(m.IsContainer || m.isContainer);
            }
            return false;
        }
        const pageCtx = inject('pageCtx', null);
        // designMode 必须是响应式：设计器顶部切换"预览/设计"时无需重建组件即可即时生效。
        // 设计器内 inject 的 designer scope 就是共享响应式 model（含 mode 字段），
        // 真实运行页无该 scope 时回退 pageCtx.designMode（兼容布尔或 ref 两种形态）。
        const designMode = computed(() => {
            if (injectDesignerScope && 'mode' in injectDesignerScope) return injectDesignerScope.mode !== 'preview';
            if (pageCtx) {
                var v = pageCtx.designMode;
                if (v && typeof v === 'object' && 'value' in v) return !!v.value;
                return !!v;
            }
            return false;
        });
        const designUid = computed(() => (designMode.value && pageCtx && pageCtx.uidOf) ? pageCtx.uidOf(jc) : null);
        // 设计模式交互（点击选中 / 画布 Sortable 生命周期）的实现见 NC.bindDesignerNode，此处只接线
        const designBinding = NC.bindDesignerNode({
            jc: jc,
            props: props,
            designMode: designMode,
            pageCtx: pageCtx,
            designUid: designUid,
            designerScope: injectDesignerScope,
            isTransparent: function () { return !!comExtra.transparentMode; },
            isContainer: lookupIsContainer
        });
        const onDesignClick = designBinding.handlers.click;
        const designRootClass = computed(() => NC.designRootClass(jc.component, jc.childrenctrls, designMode.value));
        let parentModelPrefixVal = injectParentModelPrefix;
        let parentDefaultLabelOpts = injectParentDefaultLabelOptions;
        let parentUiGlobal = injectUiGlobalProps;
        if (!parentModelPrefixVal && dyn) {
            const hostEl = dyn.findAncestor(context.root?.el, '[data-dyn-mode="createApp"]');
            if (hostEl && hostEl.__dynUiMeta) {
                const meta = hostEl.__dynUiMeta;
                parentModelPrefixVal = meta.parentModelPrefix;
                parentDefaultLabelOpts = meta.defaultLabelOptions;
                parentUiGlobal = meta.uiGlobalProps;
            }
        }
        const effectivePatch = reactive({
            shell: null,
            labeloptions: null,
            comoptions: null
        });
        // ===== 属性关联绑定 bindings =====
        // 键为属性路径（comoptions.disabled / labeloptions.show / itemoptions.style），
        // 值为 {{ expr }} 表达式或字面量。求值后按组打补丁，优先级：静态 < bindings < evalcondition
        const bindingsRaw = computed(() => {
            const b = jc.bindings ?? (typeof props.bindings === 'object' ? props.bindings : NC.parseAttrJson(props.bindings, null));
            return (b && typeof b === 'object') ? b : null;
        });
        // 统一表达式 ctx：bindings 与 evalCondition 共享同一套上下文变量
        const exprCtx = computed(() => ({
            model: parentModel.value,
            $self: modelinfo.value,
            value: modelinfo.value,
            row: null,
            fullModelName: fullModelName.value,
            getByPath: getByPath,
            safeGet: (path) => dyn?.getByPath(parentModel.value, path)
        }));
        // 求值并拆组（labeloptions/comoptions/itemoptions/shell）见 NC.bindingsPatch
        const bindingsPatch = computed(() => NC.bindingsPatch(bindingsRaw.value, exprCtx.value));
        const shellShow = computed(() => effectivePatch.shell?.show ?? bindingsPatch.value.shell.show ?? true);
        const shellClass = computed(() => effectivePatch.shell?.class ?? bindingsPatch.value.shell.class ?? []);
        const shellStyle = computed(() => effectivePatch.shell?.style ?? bindingsPatch.value.shell.style ?? {});
        // 从合并穿透后的 options 获取 labeloptions
        const originMergedLabelOpts = computed(() => {
            const base = NC.mergeLabelOptions(mergedOptions.value.labeloptions, parentDefaultLabelOpts);
            return base;
        });
        // 直连 props 补丁：label/required 显式传入时覆盖配置；evalCondition 的 effectivePatch 优先级最高
        const directLabelPatch = computed(() => {
            const p = {};
            if (props.label !== null && props.label !== undefined && props.label !== '') { p.label = props.label; p.show = true; }
            if (props.required) { p.required = true; p.show = true; }
            return p;
        });
        const finalLabelOptions = computed(() => {
            // 优先级：静态合并 < directLabelPatch < bindings < evalcondition(effectivePatch)
            let o = NC.mergePatch(originMergedLabelOpts.value, directLabelPatch.value);
            o = NC.mergePatch(o, bindingsPatch.value.labeloptions);
            o = NC.mergePatch(o, effectivePatch.labeloptions);
            return o;
        });
        const finalComOptions = computed(() => {
            // 优先级：静态合并 < bindings < evalcondition(effectivePatch)
            let o = NC.mergePatch(mergedOptions.value.comoptions, bindingsPatch.value.comoptions);
            o = NC.mergePatch(o, effectivePatch.comoptions);
            return o;
        });
        // 自动把穿透来的 size 同步到 jc.options.comoptions.size，让所有 v-bind="jc.options.comoptions" 的组件模板自动生效
        watch(() => mergedOptions.value.comoptions.size, (newSize) => {
            if (newSize && !jc.options.comoptions.size) {
                jc.options.comoptions.size = newSize;
            }
        }, { immediate: true });
        // 模板统一 v-bind="comBind"：基于 finalComOptions（含穿透 size + bindings + evalcondition），
        // 但剔除选项数据源私有键，避免泄漏到 Element 组件根节点
        comExtra.comBind = computed(() => {
            const co = finalComOptions.value || {};
            const o = {};
            Object.keys(co).forEach(function (k) { if (!COM_OPTION_PRIVATE_KEYS[k]) o[k] = co[k]; });
            // 直连模式 placeholder 显式 prop 覆盖（合成 jc 已含，此处再跟响应式 prop，保证动态修改生效）
            if (props.placeholder) o.placeholder = props.placeholder;
            return o;
        });
        const originUiGlobalMerged = computed(() => Object.assign({}, parentUiGlobal || {}, jc.options.uiGlobalProps));
        @RenderSection("setupScripts", false)
        const fullModelName = computed(() => {
            if (comExtra.transparentMode) {
                return parentModelPrefixVal || '';
            }
            // jc.modelname（DSL）或直连 prop modelname（裸标签）
            const raw = jc.modelname || props.modelname || '';
            if (!raw) {
                const p = parentModelPrefixVal || '';
                return p?.startsWith('~') ? p.slice(1) : p;
            }
            if (raw.startsWith('~')) return raw.slice(1);
            const prefix = parentModelPrefixVal;
            if (prefix) {
                if (raw.startsWith('[')) return prefix + raw;
                return prefix + '.' + raw;
            }
            return raw;
        });
        provide('parentModelPrefix', fullModelName.value);
        // 父→子穿透数据源 comExtraPass 由容器布局（_ContainerLayout）统一 provide，
        // 与是否处于设计器画布无关，保证属性面板/运行时/设计器三处穿透一致。
        const innerValue = ref(DVALUE);
        // 是否绑定了 v-model：emits 声明后监听器不进 attrs，从 vnode.props 判定
        function isVModelBound() {
            const vp = inst && inst.vnode && inst.vnode.props;
            return !!(vp && typeof vp['onUpdate:modelValue'] === 'function');
        }
        function getByPath(obj, path) { return !obj || !path ? undefined : _.get(obj, path); }
        function setByPath(obj, path, value) { if (!obj || !path) return; _.set(obj, path, value); }
        // 表达式求值 / {{ expr }} 行内替换见 NC.evalExpr / NC.resolveTemplate
        // 值绑定三通道（优先级从高到低）：
        // ① 表达式模式：modelexpr（只读，可选 modelsetexpr 写回）
        // ② 路径模式：parentmodelinfo（显式 prop 或容器 inject 兜底）+ modelname
        // ③ v-model 直连：<dyn-el-input v-model="x" /> —— get 读 modelValue，set emit update:modelValue
        // ④ 组件内部状态：无任何绑定时的本地 ref
        const modelinfo = computed({
            get() {
                const modelexpr = jc.modelexpr || props.modelexpr;
                if (modelexpr) {
                    // ctx 字段与 exprCtx 对齐，但 $self/value 用 innerValue（此时 modelinfo 尚未算出，避免循环）
                    return NC.evalExpr(modelexpr, {
                        model: parentModel.value,
                        $self: innerValue.value,
                        value: innerValue.value,
                        row: null,
                        fullModelName: fullModelName.value,
                        getByPath: getByPath,
                        safeGet: (path) => dyn?.getByPath(parentModel.value, path)
                    });
                }
                if (parentModel.value && fullModelName.value) {
                    const val = getByPath(parentModel.value, fullModelName.value);
                    return val === undefined ? DVALUE : val;
                }
                if (isVModelBound()) {
                    return props.modelValue === undefined || props.modelValue === null ? DVALUE : props.modelValue;
                }
                return innerValue.value;
            },
            set(val) {
                const modelexpr = jc.modelexpr || props.modelexpr;
                if (modelexpr) {
                    const setexpr = jc.modelsetexpr || props.modelsetexpr;
                    if (setexpr) {
                        try {
                            const fn = new Function('model', '$value', '$self', 'row', setexpr);
                            fn(parentModel.value, val, modelinfo.value, null);
                        } catch (e) {
                            console.error('[modelsetexpr 写回失败]', setexpr, e);
                        }
                    } else {
                        console.warn('[modelinfo] modelexpr 模式未配置 modelsetexpr，赋值被忽略');
                    }
                    if (comInnerInfo.validation.touched) validate();
                    return;
                }
                if (parentModel.value && fullModelName.value) {
                    setByPath(parentModel.value, fullModelName.value, val);
                } else if (isVModelBound()) {
                    context.emit('update:modelValue', val);
                } else {
                    innerValue.value = val;
                }
                if (comInnerInfo.validation.touched) validate();
            }
        });
        // 联动通用行为：选项列表变化时（如父级联动导致重新加载），
        // 若当前选中值不在新选项中，则清空/剔除该值，避免残留无效选项
        watch(() => comInnerInfo.options, function (newOpts) {
            var cur = modelinfo.value;
            if (cur === undefined || cur === null || cur === '') return;
            var list = Array.isArray(newOpts) ? newOpts : [];
            var validValues = {};
            list.forEach(function (o) { if (o && o.value !== undefined) validValues[o.value] = true; });
            if (Array.isArray(cur)) {
                // 多选：剔除不在选项中的值
                var filtered = cur.filter(function (v) { return validValues[v] === true; });
                if (filtered.length !== cur.length) {
                    nextTick(function () { modelinfo.value = filtered; });
                }
            } else {
                // 单选：值不在选项中则清空
                if (validValues[cur] !== true) {
                    nextTick(function () { modelinfo.value = ''; });
                }
            }
        });
	    let _rootEl = null; // 校验结果写回根元素，供父级（DetailTemplate validateForm）聚合具体错误消息
	    function validate() {
            // 实时读取当前值（不依赖 modelinfo computed 缓存），确保 form 已更新后校验拿到最新值
            const val = (parentModel.value && fullModelName.value)
                ? getByPath(parentModel.value, fullModelName.value)
                : modelinfo.value;
            // 规则执行（required/min/max/length/pattern/email/phone/number/custom + enableWhen）见 NC.runValidators
            const errors = NC.runValidators(jc.validators, val, parentModel.value, getByPath);
            comInnerInfo.validation.valid = errors.length === 0;
            comInnerInfo.validation.errors = errors;
            comInnerInfo.validation.touched = true;
	    if (_rootEl) _rootEl.__dynErrors = errors.slice();
	    return comInnerInfo.validation.valid;
        }
        function resetValidation() {
            comInnerInfo.validation.valid = true;
            comInnerInfo.validation.errors = [];
            comInnerInfo.validation.touched = false;
        }
        provide('comInnerInfo', comInnerInfo);
        provide('component_validate', validate);
        provide('component_resetValidation', resetValidation);
        // evalCondition：监听当前值 + 整个表单 model（deep），任何字段变化都重算；脚本执行见 NC.evalConditionPatch
        watch([modelinfo, () => parentModel.value], () => {
            effectivePatch.shell = null;
            effectivePatch.labeloptions = null;
            effectivePatch.comoptions = null;
            const patch = NC.evalConditionPatch(jc.options?.evalcondition, exprCtx.value);
            if (!patch) return;
            effectivePatch.shell = patch.shell;
            effectivePatch.labeloptions = patch.labeloptions;
            effectivePatch.comoptions = patch.comoptions;
        }, { deep: true });
        function getSlot(slotName) {
            if (context.slots[slotName]) {
                return context.slots[slotName];
            }
            const slotDef = jc.slots?.[slotName];
            return slotDef ?? null;
        }
        const safeChildren = computed(() => (jc.childrenctrls || []).filter(c => c && typeof c === 'object'));
        var _instance = getCurrentInstance();
        onMounted(() => {
            const rootEl = (_instance && _instance.proxy && _instance.proxy.$el) || context.root?.el;
            _rootEl = rootEl;
            // 透明渲染包装（DynDynamicCom）不覆盖真实组件的 meta/校验：两者挂在同一根元素，
            // 若覆盖会抹掉真实组件的 fullModelName 与 __dynValidate，导致 model 丢失、校验失效
            if (rootEl && !comExtra.transparentMode) {
                rootEl.__dynUiMeta = {
                    parentModelPrefix: fullModelName.value,
                    fullModelName: fullModelName.value,
                    defaultLabelOptions: finalLabelOptions.value,
                    uiGlobalProps: originUiGlobalMerged.value
                };
                            // 暴露组件校验方法到根元素，供父级（DetailTemplate 等）保存前聚合校验调用
                rootEl.__dynValidate = validate;
}
            // 联动：parentValuePath 变化时自动重新加载 options
            var _cascadePath = (jc.options && jc.options.comoptions && jc.options.comoptions.parentValuePath) || '';
            if (_cascadePath) {
                watch(function () { return getByPath(parentModel.value, _cascadePath); },
                    function (nv, ov) { if (nv !== ov) loadComOptions(); });
            }
            // 联动：sql / ajax 模板含 {{ }} 表达式时，model 任何变化都重新加载 options
            // 模板支持任意表达式（不只是 model.xxx 路径），故深监听 parentModel
            var _co = (jc.options && jc.options.comoptions) || {};
            var _hasTpl = (_co.sourceType === 'sql' && _co.sql && /\{\{/.test(_co.sql))
                || (_co.sourceType === 'ajax' && _co.url && /\{\{/.test(_co.url));
            if (_hasTpl) {
                watch(function () { return parentModel.value; },
                    function () { loadComOptions(); }, { deep: true });
            }
  			// 设计模式下，容器组件初始化 Sortable（重复绑定/透明层/切换预览的处理见 NC.bindDesignerNode）
            nextTick(function () { designBinding.setup(rootEl); });
            watch(designMode, function (isDesign) {
                nextTick(function () { isDesign ? designBinding.setup(rootEl) : designBinding.destroy(); });
            });
        });
        onBeforeUnmount(() => {
            designBinding.destroy();
        });
        return {
            jc,
            modelinfo,
            comInnerInfo,
            shellShow,
            shellClass,
            shellStyle,
            finalLabelOptions,
            finalComOptions,
            originUiGlobalMerged,
            validate,
            resetValidation,
            getStyle: NC.getStyle,
            getClass: NC.getClass,
            getComlisteners,
            safeChildren,
            getSlot,
            fullModelName,
            parentModelPrefixVal,
            props,
            context,
            dyn,
            designMode,
            designUid,
            designRootClass,
            onDesignClick,
            ...comExtra
        };
    }
};
</script>
