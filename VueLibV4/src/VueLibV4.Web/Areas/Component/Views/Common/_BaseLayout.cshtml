@RenderBody()
<script tag='comconfig'>
var comConfig = {
    props: {
        jsonconfig: { type: Object, default: null },
        parentmodelinfo: { type: Object, default: null },
        nodePath: { type: String, default: '' },
        // ===== 直连模式（裸标签）支持：<dyn-el-input v-model="model.Name" label="名称" required placeholder="..." /> =====
        // 不传 jsonconfig 时，这些 props 合成内存配置，复用同一套配置驱动逻辑；与 jsonconfig 同时出现时 jsonconfig 打底、直连 props 覆盖
        modelname: { type: String, default: null },
        label: { type: String, default: null },
        required: { type: Boolean, default: false },
        placeholder: { type: String, default: null },
        // 生成视图（ViewGenerateService）/手写模板的裸标签：options 各组以属性传入。
        // cshtml 侧用 Razor 双写 at 符号转义（属性值里的变量引用由生成器写成 co0 形式），浏览器侧拿到的是 JSON 字符串；
        // 也支持 v-bind 对象形式 :comoptions="{...}" 直接传对象。
        comoptions: { type: [Object, String], default: null },
        labeloptions: { type: [Object, String], default: null },
        itemoptions: { type: [Object, String], default: null },
        wrapperoptions: { type: [Object, String], default: null },
        compassthrough: { type: String, default: null },
        evalcondition: { type: String, default: null },
        modelexpr: { type: String, default: null },
        modelsetexpr: { type: String, default: null },
        bindings: { type: [Object, String], default: null },
        modelValue: { default: null }
    },
    // v-model 直连通道：modelinfo setter 在无 parentmodelinfo+modelname 路径时 emit update:modelValue
    emits: ['update:modelValue'],
    setup(props, context) {
        const { ref, reactive, computed, inject, provide, watch, nextTick, onMounted, onBeforeUnmount, getCurrentInstance } = Vue;
        const _ = window._;
        const inst = Vue.getCurrentInstance();
        const dyn = inst?.proxy?.$dyn;
        /**
         * 组件【配置契约】默认结构：可序列化、会落库为 JSON（PageSetting.ConfigJson）。
         * 键名约定一律全小写无分隔（comoptions/labeloptions/itemoptions/modelname/...），
         * 与 SQL 种子、PageGen 生成器、设计器属性面板保持一致；勿新增驼峰配置键。
         * 运行时状态/方法不入此结构，统一走下方 comExtra 扩展槽。
         */
        const defaults = {
            component: null,
            modelname: null,
            options: {
                comoptions: {},
                comlisteners: {},
                labeloptions: { label: '', required: false, show: true },
                itemoptions: { style: {}, class: '' },
                wrapperoptions: {},
                // 父→子属性穿透白名单（逗号分隔的配置点路径，全小写契约）；
                // 容器把自身 comoptions/labeloptions 向下 provide，子组件仅继承在此声明且自身未显式配置的路径
                compassthrough: "comoptions.size,labeloptions.labelposition,labeloptions.labelwidth",
                uiGlobalProps: { size: undefined, disabled: undefined },
                defaultLabelOptions: { labelwidth: "auto", requiredmark: true },
                evalCondition: ""
            },
            validators: [],
            childrenctrls: [],
            slots: {},
            extendinfo: {}
        };
        // comoptions 中的"数据源私有键"：仅用于 loadComOptions 解析选项，
        // 不得随 v-bind 透传到 Element 组件根节点（否则泄漏为 optionvalues=... 等无效 attribute）
        const COM_OPTION_PRIVATE_KEYS = {
            sourceType: 1, optionValues: 1, optionValuesText: 1, dictType: 1,
            projectId: 1, table: 1, valueField: 1, textField: 1, sql: 1,
            parentField: 1, parentValuePath: 1, parentValue: 1,
            url: 1, valueKey: 1, labelKey: 1
        };
        function deepMerge(target, ...sources) {
            return _.mergeWith(target, ...sources, (objValue, srcValue) => {
                if (Array.isArray(srcValue)) {
                    return srcValue;
                }
                return undefined;
            });
        }
        // 裸标签 JSON 属性归一：对象直接用；字符串按 JSON 解析（生成视图的 comoptions 属性到浏览器是 JSON 字符串）；
        // null/空串/解析失败回落到 dft，且不抛异常——手写模板写错一个属性不该让整页挂掉。
        function parseAttrJson(v, dft) {
            if (v === null || v === undefined) return dft;
            if (typeof v === 'object') return v;
            var s = String(v).trim();
            if (!s) return dft;
            try { var o = JSON.parse(s); return (o && typeof o === 'object') ? o : dft; }
            catch (e) { console.warn('[裸标签属性 JSON 解析失败]', e, s.slice(0, 120)); return dft; }
        }
        // 直连模式（裸标签未传 jsonconfig）：用直连 props 合成内存 jc（不落库、不参与设计器导出），
        // 让下方全部配置驱动逻辑（label/绑定/校验/穿透）无差别复用。
        // 优先级：JSON 属性（生成视图/手写 comoptions=".."）打底；label/required/placeholder 直连 props 覆盖。
        const directMode = !props.jsonconfig;
        const syntheticJc = directMode ? {
            component: (inst && inst.type && inst.type.name) || null,
            modelname: props.modelname || null,
            modelexpr: props.modelexpr || null,
            modelsetexpr: props.modelsetexpr || null,
            bindings: parseAttrJson(props.bindings, null),
            options: Object.assign(
                {
                    comoptions: props.placeholder
                        ? Object.assign(parseAttrJson(props.comoptions, {}), { placeholder: props.placeholder })
                        : parseAttrJson(props.comoptions, {}),
                    labeloptions: Object.assign(
                        { label: props.label || '', required: !!props.required, show: !!(props.label || props.required) },
                        parseAttrJson(props.labeloptions, null) || {}
                    ),
                    itemoptions: parseAttrJson(props.itemoptions, { style: {}, class: '' }),
                    wrapperoptions: parseAttrJson(props.wrapperoptions, {})
                },
                props.compassthrough ? { compassthrough: props.compassthrough } : null,
                props.evalcondition ? { evalCondition: props.evalcondition } : null
            ),
            validators: [],
            childrenctrls: [],
            slots: {},
            extendinfo: {}
        } : null;
        // 直接引用 reactive 的 jsonconfig，不深拷贝；补齐缺失的默认字段
        const jc = props.jsonconfig || syntheticJc;
        if (!jc.options) jc.options = {};
        if (!jc.options.comoptions) jc.options.comoptions = {};
        if (!jc.options.labeloptions) jc.options.labeloptions = { label: "", required: false, show: true };
        if (!jc.options.itemoptions) jc.options.itemoptions = { style: {}, class: "" };
        // === 旧命名兼容迁移（配置键全小写契约，原地修改；旧键迁移后删除，设计器保存即净化）===
        // ① 驼峰选项组与全小写组本是同一物：仅补齐缺失键后删除旧组
        // ② comInnerInfo 曾被误用作布局/尺寸配置槽（运行时实际不读）：size→comoptions.size，
        //    labelPosition/labelWidth→labeloptions 全小写，comPassThrough→compassthrough
        // ③ labeloptions 内驼峰子键 → 全小写
        (function _migrateLegacyOptions(o) {
            if (!o || typeof o !== 'object') return;
            if (o.comOptions && typeof o.comOptions === 'object') {
                Object.keys(o.comOptions).forEach(function (k) { if (!(k in o.comoptions)) o.comoptions[k] = o.comOptions[k]; });
                delete o.comOptions;
            }
            if (o.labelOptions && typeof o.labelOptions === 'object') {
                if (!o.labeloptions) o.labeloptions = {};
                Object.keys(o.labelOptions).forEach(function (k) { if (!(k in o.labeloptions)) o.labeloptions[k] = o.labelOptions[k]; });
                delete o.labelOptions;
            }
            var lo = o.labeloptions;
            if (lo) {
                if ('labelPosition' in lo) { if (!('labelposition' in lo)) lo.labelposition = lo.labelPosition; delete lo.labelPosition; }
                if ('labelWidth' in lo) { if (!('labelwidth' in lo)) lo.labelwidth = lo.labelWidth; delete lo.labelWidth; }
            }
            var ci = o.comInnerInfo;
            if (ci && typeof ci === 'object') {
                if (ci.size != null && o.comoptions.size == null) o.comoptions.size = ci.size;
                if (lo) {
                    if (ci.labelPosition != null && lo.labelposition == null) lo.labelposition = ci.labelPosition;
                    if (ci.labelWidth != null && lo.labelwidth == null) lo.labelwidth = ci.labelWidth;
                }
                if (ci.comPassThrough && !o.compassthrough) o.compassthrough = ci.comPassThrough;
                delete o.comInnerInfo;
            }
        })(jc.options);
        if (!jc.options.compassthrough) jc.options.compassthrough = defaults.options.compassthrough;
        if (!Array.isArray(jc.childrenctrls)) jc.childrenctrls = [];
        if (!Array.isArray(jc.validators)) jc.validators = [];
        if (!jc.slots) jc.slots = {};
        if (!jc.extendinfo) jc.extendinfo = {};
        function mergePatch(origin, patch) {
            const res = Object.assign({}, origin);
            if (!patch || typeof patch !== "object") return res;
            // 遍历 patch 的 key：既更新 origin 已有键，也新增 patch 独有的键（如 bindings 注入的 disabled）
            for (const key in patch) {
                if (patch[key] !== undefined) {
                    res[key] = patch[key];
                }
            }
            return res;
        }
        function mergeLabelOptions(selfOpt, parentDefaultOpt) {
            const result = Object.assign({}, parentDefaultOpt || {});
            for (const key in selfOpt) {
                const v = selfOpt[key];
                if (v === null) {
                    result[key] = null;
                } else if (v !== undefined) {
                    result[key] = v;
                }
            }
            return result;
        }
        function getStyle(...opts) { return Object.assign({}, ...opts.map(o => o?.style || {})); }
        function getClass(...opts) { return opts.flatMap(o => (o?.class || '').split(' ')).filter(Boolean); }
        function getComlisteners() {
            const listeners = jc.options?.comlisteners || {};
            const result = {};
            for (const key in listeners) {
                const val = listeners[key];
                if (typeof val === 'function') result[key] = val;
            }
            return result;
        }
        // comInnerInfo：校验状态 + 选项型组件的远程 options 数据
        const comInnerInfo = reactive({
            validation: { valid: true, errors: [], touched: false },
            options: []
        });
        let DVALUE = null;
        /**
         * comExtra —— 组件【运行时扩展槽】（组件私有成员的唯一合法出口）
         * 与上方 defaults / jc.options 的分工：
         *   - jc.options 是可序列化【配置契约】，落库为 PageSetting.ConfigJson，只放纯数据；
         *   - comExtra 只放运行时态：ref / reactive / computed / 方法，
         *     例如 DynTable 的 rows/total/loadList、FormItem 的 labelPos/labelStyle。
         * 用法：各组件在 setupScripts 内 Object.assign(comExtra, { ... }) 暴露，
         * 基座 return 时统一展开到模板（模板内直接以 rows、loadList 等名字访问）。
         * 约束：① 只许 Object.assign / 点赋值，不许整体重赋值；
         *       ② 禁止把 ref/函数挂进 jc.options；③ 不参与设计器 JSON 导出。
         */
        const comExtra = {};

        // ============ 选项数据源公共能力（DynSelect/ComSelect/Radio/Checkbox 共用） ============
        /** 把任意形态（字符串或 {value,label}）归一为 {value,label}，支持 valueKey/labelKey 映射 */
        function _normOptionList(list, valueKey, labelKey) {
            return (Array.isArray(list) ? list : []).map(function (x) {
                if (x !== null && typeof x === 'object') {
                    var v = valueKey ? x[valueKey] : x.value;
                    var l = labelKey ? x[labelKey] : x.label;
                    return { value: v !== undefined ? v : x.value, label: l !== undefined ? l : x.label };
                }
                return { value: x, label: String(x) };
            });
        }
        /** static 数据源：优先 optionValuesText（每行“值,标签”，无逗号时值即标签），否则读 optionValues 数组 */
        function initOptionsFromConfig() {
            var co = jc.options && jc.options.comoptions ? jc.options.comoptions : {};
            if (typeof co.optionValuesText === 'string' && co.optionValuesText.trim()) {
                comInnerInfo.options = co.optionValuesText.split(/\r?\n/).map(function (line) {
                    var s = line.trim();
                    if (!s) return null;
                    var parts = s.split(/[,，]/);
                    var v = parts[0].trim();
                    var lab = parts.length > 1 ? parts.slice(1).join(',').trim() : v;
                    return { value: v, label: lab || v };
                }).filter(Boolean);
                return;
            }
            var ov = co.optionValues;
            comInnerInfo.options = _normOptionList(ov);
        }
        /**
         * 按 comoptions.sourceType 加载下拉选项：
         *   static - 静态 optionValues
         *   dict   - 平台字典 DynDict（dictType）
         *   table  - 工程表（projectId/table/valueField/textField，parentField+parentValuePath 联动）
         *   ajax   - 任意接口（url 支持 {{model.field}} 占位，valueKey/labelKey 映射）
         */
        function loadComOptions(forceType) {
            var s = (jc.options && jc.options.comoptions) || {};
            var t = forceType || s.sourceType || 'static';
            if (t === 'static') { initOptionsFromConfig(); return; }
            if (t === 'dict') {
                if (!s.dictType) return;
                fetch('/api/dyncommon/dicts?type=' + encodeURIComponent(s.dictType))
                    .then(function (r) { return r.json(); })
                    .then(function (res) { if (res && res.code === 0) comInnerInfo.options = _normOptionList(res.data); })
                    .catch(function (e) { console.warn('[dict options]', e); });
                return;
            }
            if (t === 'table') {
                if (!s.projectId || !s.table) return;
                var qs = 'projectId=' + encodeURIComponent(s.projectId)
                    + '&table=' + encodeURIComponent(s.table)
                    + '&valueField=' + encodeURIComponent(s.valueField || 'Id')
                    + '&textField=' + encodeURIComponent(s.textField || 'Name');
                if (s.parentField) {
                    var pv = '';
                    if (s.parentValuePath) pv = getByPath(parentModel.value, s.parentValuePath);
                    else if (s.parentValue !== undefined) pv = s.parentValue;
                    if (pv !== undefined && pv !== null && pv !== '') {
                        qs += '&parentField=' + encodeURIComponent(s.parentField)
                            + '&parentValue=' + encodeURIComponent(pv);
                    }
                }
                fetch('/api/dyncommon/options?' + qs)
                    .then(function (r) { return r.json(); })
                    .then(function (res) { if (res && res.code === 0) comInnerInfo.options = _normOptionList(res.data); })
                    .catch(function (e) { console.warn('[table options]', e); });
                return;
            }
            if (t === 'sql') {
                if (!s.sql) return;
                // 支持 {{model.city}} 等占位符联动：从 parentModel 取值替换后再发给后端
                // 注意：值会转义单引号防 SQL 语法破坏，但整体仍是"执行配置者写的 SQL"，信任配置者
                var resolvedSql = String(s.sql).replace(/\{\{\s*model\.([\w.]+)\s*\}\}/g, function (_, p) {
                    var v = getByPath(parentModel.value, p);
                    var str = v == null ? '' : String(v);
                    return str.replace(/'/g, "''");
                });
                var q = 'projectId=' + encodeURIComponent(s.projectId || '') + '&sql=' + encodeURIComponent(resolvedSql);
                fetch('/api/dyncommon/sqloptions?' + q)
                    .then(function (r) { return r.json(); })
                    .then(function (res) { if (res && res.code === 0) comInnerInfo.options = _normOptionList(res.data); })
                    .catch(function (e) { console.warn('[sql options]', e); });
                return;
            }
            if (t === 'ajax') {
                if (!s.url) return;
                var url = String(s.url).replace(/\{\{\s*model\.([\w.]+)\s*\}\}/g, function (_, p) {
                    var v = getByPath(parentModel.value, p);
                    return encodeURIComponent(v == null ? '' : v);
                });
                fetch(url)
                    .then(function (r) { return r.json(); })
                    .then(function (res) {
                        var list = res && res.code === 0 ? res.data : (Array.isArray(res) ? res : (res && res.data) || []);
                        comInnerInfo.options = _normOptionList(list, s.valueKey, s.labelKey);
                    })
                    .catch(function (e) { console.warn('[ajax options]', e); });
            }
        }
        // ========== 新增：属性穿透相关 ==========
        /**
         * 合并父容器穿透配置
         * @@param {object} localOptions 当前组件 jc.options
         * @@param {object} parentPass 父注入的 comExtraPass（父 compassthrough 清单提取的 路径→值 映射）
         * @@param {string} passStr comExtra.comPassThrough 白名单字符串（仅白名单模式启用时使用）
         * @@param {boolean} whiteListMode 透传白名单开关（来自容器 provide 的 passThroughWhiteListMode）
         * @@returns {object} 合并后的完整options
         */
        function applyPassThrough(localOptions, parentPass, passStr, whiteListMode) {
            const opts = _.cloneDeep(localOptions || {});
            if (!parentPass) return opts;
            const parentVals = parentPass.passValues || {};
            const paths = Object.keys(parentVals);
            // 白名单模式：true=启用（子自身 compassthrough 过滤，取交集）；false=关闭（忽略子白名单，父清单字段全收）
            let allowed = paths;
            if (whiteListMode) {
                const childKeys = (passStr || '')
                    .split(',')
                    .map(i => i.trim())
                    .filter(path => !!path);
                allowed = paths.filter(function (p) { return childKeys.indexOf(p) >= 0; });
            }
            for (const path of allowed) {
                const localVal = _.get(opts, path);
                // 子组件该路径未显式定义，才继承父的值
                if (localVal === undefined) {
                    const pVal = parentVals[path];
                    if (pVal !== undefined) {
                        _.set(opts, path, pVal);
                    }
                }
            }
            return opts;
        }
        // 穿透白名单：来自组件持久化配置 options.compassthrough（见 defaults），仅白名单模式启用时参与过滤
        comExtra.comPassThrough = jc.options.compassthrough;
        // 注入父穿透数据源
        const parentPassSource = inject('comExtraPass', null);
        // 透传白名单开关：容器 _ContainerLayout 顶部配置 provide；无容器父时默认 false（关闭白名单）
        const passWhiteListMode = inject('passThroughWhiteListMode', false) === true;
        // 合并本地配置 + 上层穿透
        const mergedOptions = computed(() => {
            return applyPassThrough(jc.options, parentPassSource, comExtra.comPassThrough, passWhiteListMode);
        });
        // ========== end 属性穿透 ==========
        // inject before section scripts
        const injectParentModelPrefix = inject('parentModelPrefix', null);
        // 直连模式：容器通过插槽（<slot/>）渲染的裸标签子组件没有显式 parentmodelinfo prop，
        // 由最近容器 provide 的 dynSlotParentModel 兜底（可能是 computed ref 或原始对象）
        const injectSlotParentModelRaw = inject('dynSlotParentModel', null);
        const injectSlotParentModel = computed(() => {
            if (!injectSlotParentModelRaw) return null;
            return (typeof injectSlotParentModelRaw === 'object' && 'value' in injectSlotParentModelRaw)
                ? injectSlotParentModelRaw.value : injectSlotParentModelRaw;
        });
        // 实际生效的父模型：显式 prop 优先，inject 兜底
        const parentModel = computed(() => props.parentmodelinfo || injectSlotParentModel.value || null);
        const injectParentDefaultLabelOptions = inject('defaultLabelOptions', null);
        const injectUiGlobalProps = inject('ui_global_props', null);
        const injectDesignerScope = inject("designer", null);
        const injectParentComInnerInfo = inject('comInnerInfo', () => ({}));
        function lookupIsContainer(compName) {
            if (!injectDesignerScope || !injectDesignerScope.componentMetaList) return false;
            var list = injectDesignerScope.componentMetaList;
            for (var i = 0; i < list.length; i++) {
                var m = list[i];
                var nm = m.ComponentName || m.componentName;
                if (nm === compName) return !!(m.IsContainer || m.isContainer);
            }
            return false;
        }
        const pageCtx = inject('pageCtx', null);
        // designMode 必须是响应式：设计器顶部切换"预览/设计"时无需重建组件即可即时生效。
        // 设计器内 inject 的 designer scope 就是共享响应式 model（含 mode 字段），
        // 真实运行页无该 scope 时回退 pageCtx.designMode（兼容布尔或 ref 两种形态）。
        const designMode = computed(() => {
            if (injectDesignerScope && 'mode' in injectDesignerScope) return injectDesignerScope.mode !== 'preview';
            if (pageCtx) {
                var v = pageCtx.designMode;
                if (v && typeof v === 'object' && 'value' in v) return !!v.value;
                return !!v;
            }
            return false;
        });
        const designUid = computed(() => (designMode.value && pageCtx && pageCtx.uidOf) ? pageCtx.uidOf(jc) : null);
        function onDesignDragstart(e) { if (designMode.value && pageCtx.onDragStartCfg) { e.stopPropagation(); pageCtx.onDragStartCfg(props.jsonconfig, e); } }
        function onDesignClick(e) {
            if (!designMode.value || !pageCtx.onSelect) return;
            var selfUid = designUid.value;
            if (selfUid) {
                var inner = e.target.closest('[data-dyn-uid]');
                if (inner && inner.getAttribute('data-dyn-uid') !== selfUid) return;
            }
            pageCtx.onSelect(props.jsonconfig, e);
        }
        function onDesignDragover(e) { if (designMode.value && pageCtx.onDragOver) { e.preventDefault(); e.stopPropagation(); pageCtx.onDragOver(props.jsonconfig, e); } }
        function onDesignDrop(e) { if (designMode.value && pageCtx.onDrop) { e.preventDefault(); e.stopPropagation(); pageCtx.onDrop(props.jsonconfig, e); } }
        function onDesignDragleave(e) { if (designMode.value && pageCtx.onDragLeave) { e.stopPropagation(); pageCtx.onDragLeave(props.jsonconfig, e); } }
        const designRootClass = computed(() => {
            if (!designMode.value) return "";
            var c = jc.component || "";
            var isContainer = /Container|Form|Card|Tabs|Collapse|Row|Col|Panel/.test(c);
            if (isContainer && (!jc.childrenctrls || jc.childrenctrls.length === 0)) return "designer-empty-container";
            return "";
        });
        let parentModelPrefixVal = injectParentModelPrefix;
        let parentDefaultLabelOpts = injectParentDefaultLabelOptions;
        let parentUiGlobal = injectUiGlobalProps;
        if (!parentModelPrefixVal && dyn) {
            const hostEl = dyn.findAncestor(context.root?.el, '[data-dyn-mode="createApp"]');
            if (hostEl && hostEl.__dynUiMeta) {
                const meta = hostEl.__dynUiMeta;
                parentModelPrefixVal = meta.parentModelPrefix;
                parentDefaultLabelOpts = meta.defaultLabelOptions;
                parentUiGlobal = meta.uiGlobalProps;
            }
        }
        const effectivePatch = reactive({
            shell: null,
            labeloptions: null,
            comoptions: null
        });
        // ===== 属性关联绑定 bindings =====
        // 键为属性路径（comoptions.disabled / labeloptions.show / itemoptions.style），
        // 值为 {{ expr }} 表达式或字面量。求值后按组打补丁，优先级：静态 < bindings < evalcondition
        const bindingsRaw = computed(() => {
            const b = jc.bindings ?? (typeof props.bindings === 'object' ? props.bindings : parseAttrJson(props.bindings, null));
            return (b && typeof b === 'object') ? b : null;
        });
        // 统一表达式 ctx：bindings 与 evalCondition 共享同一套上下文变量
        const exprCtx = computed(() => ({
            model: parentModel.value,
            $self: modelinfo.value,
            value: modelinfo.value,
            row: null,
            fullModelName: fullModelName.value,
            getByPath: getByPath,
            safeGet: (path) => dyn?.getByPath(parentModel.value, path)
        }));
        const bindingsPatch = computed(() => {
            const b = bindingsRaw.value;
            const patch = { labeloptions: {}, comoptions: {}, itemoptions: {}, shell: {} };
            if (!b) return patch;
            const ctx = exprCtx.value;
            for (const key in b) {
                const val = evalExpr(b[key], ctx);
                const dot = key.indexOf('.');
                if (dot < 0) continue;
                const group = key.slice(0, dot);
                const sub = key.slice(dot + 1);
                if (group === 'labeloptions' || group === 'comoptions' || group === 'itemoptions' || group === 'shell') {
                    _.set(patch[group], sub, val);
                }
            }
            return patch;
        });
        const shellShow = computed(() => effectivePatch.shell?.show ?? bindingsPatch.value.shell.show ?? true);
        const shellClass = computed(() => effectivePatch.shell?.class ?? bindingsPatch.value.shell.class ?? []);
        const shellStyle = computed(() => effectivePatch.shell?.style ?? bindingsPatch.value.shell.style ?? {});
        // 从合并穿透后的 options 获取 labelOptions
        const originMergedLabelOpts = computed(() => {
            const base = mergeLabelOptions(mergedOptions.value.labeloptions, parentDefaultLabelOpts);
            return base;
        });
        // 直连 props 补丁：label/required 显式传入时覆盖配置；evalCondition 的 effectivePatch 优先级最高
        const directLabelPatch = computed(() => {
            const p = {};
            if (props.label !== null && props.label !== undefined && props.label !== '') { p.label = props.label; p.show = true; }
            if (props.required) { p.required = true; p.show = true; }
            return p;
        });
        const finalLabelOptions = computed(() => {
            // 优先级：静态合并 < directLabelPatch < bindings < evalcondition(effectivePatch)
            let o = mergePatch(originMergedLabelOpts.value, directLabelPatch.value);
            o = mergePatch(o, bindingsPatch.value.labeloptions);
            o = mergePatch(o, effectivePatch.labeloptions);
            return o;
        });
        const finalComOptions = computed(() => {
            // 优先级：静态合并 < bindings < evalcondition(effectivePatch)
            let o = mergePatch(mergedOptions.value.comoptions, bindingsPatch.value.comoptions);
            o = mergePatch(o, effectivePatch.comoptions);
            return o;
        });
        // 自动把穿透来的 size 同步到 jc.options.comoptions.size，让所有 v-bind="jc.options.comoptions" 的组件模板自动生效
        watch(() => mergedOptions.value.comoptions.size, (newSize) => {
            if (newSize && !jc.options.comoptions.size) {
                jc.options.comoptions.size = newSize;
            }
        }, { immediate: true });
        // 模板统一 v-bind="comBind"：基于 finalComOptions（含穿透 size + bindings + evalcondition），
        // 但剔除选项数据源私有键，避免泄漏到 Element 组件根节点
        comExtra.comBind = computed(() => {
            const co = finalComOptions.value || {};
            const o = {};
            Object.keys(co).forEach(function (k) { if (!COM_OPTION_PRIVATE_KEYS[k]) o[k] = co[k]; });
            // 直连模式 placeholder 显式 prop 覆盖（合成 jc 已含，此处再跟响应式 prop，保证动态修改生效）
            if (props.placeholder) o.placeholder = props.placeholder;
            return o;
        });
        const originUiGlobalMerged = computed(() => Object.assign({}, parentUiGlobal || {}, jc.options.uiGlobalProps));
        @RenderSection("setupScripts", false)
        const fullModelName = computed(() => {
            if (comExtra.transparentMode) {
                return parentModelPrefixVal || '';
            }
            // jc.modelname（DSL）或直连 prop modelname（裸标签）
            const raw = jc.modelname || props.modelname || '';
            if (!raw) {
                const p = parentModelPrefixVal || '';
                return p?.startsWith('~') ? p.slice(1) : p;
            }
            if (raw.startsWith('~')) return raw.slice(1);
            const prefix = parentModelPrefixVal;
            if (prefix) {
                if (raw.startsWith('[')) return prefix + raw;
                return prefix + '.' + raw;
            }
            return raw;
        });
        provide('parentModelPrefix', fullModelName.value);
        // 父→子穿透数据源 comExtraPass 由容器布局（_ContainerLayout）统一 provide，
        // 与是否处于设计器画布无关，保证属性面板/运行时/设计器三处穿透一致。
        const innerValue = ref(DVALUE);
        // 是否绑定了 v-model：emits 声明后监听器不进 attrs，从 vnode.props 判定
        function isVModelBound() {
            const vp = inst && inst.vnode && inst.vnode.props;
            return !!(vp && typeof vp['onUpdate:modelValue'] === 'function');
        }
        function getByPath(obj, path) { return !obj || !path ? undefined : _.get(obj, path); }
        function setByPath(obj, path, value) { if (!obj || !path) return; _.set(obj, path, value); }
        // 表达式求值：{{ ... }} 包裹的按 JS 表达式求值，否则原样返回（字面量）
        // 作用域：model=表单对象, $self=当前值, row=行数据
        function evalExpr(raw, ctx) {
            if (raw === null || raw === undefined) return raw;
            if (typeof raw !== 'string') return raw;
            const s = raw.trim();
            if (s.startsWith('{{') && s.endsWith('}}')) {
                const body = s.slice(2, -2).trim();
                if (!body) return undefined;
                try {
                    // 参数顺序与 exprCtx 对齐：model, $self, value, row, fullModelName, getByPath, safeGet
                    const fn = new Function('model', '$self', 'value', 'row', 'fullModelName', 'getByPath', 'safeGet', 'return (' + body + ');');
                    return fn(ctx.model, ctx.$self, ctx.value, ctx.row, ctx.fullModelName, ctx.getByPath, ctx.safeGet);
                } catch (e) {
                    console.warn('[bindings/modelexpr 表达式求值失败]', body, e);
                    return undefined;
                }
            }
            return raw;
        }
        // 值绑定三通道（优先级从高到低）：
        // ① 表达式模式：modelexpr（只读，可选 modelsetexpr 写回）
        // ② 路径模式：parentmodelinfo（显式 prop 或容器 inject 兜底）+ modelname
        // ③ v-model 直连：<dyn-el-input v-model="x" /> —— get 读 modelValue，set emit update:modelValue
        // ④ 组件内部状态：无任何绑定时的本地 ref
        const modelinfo = computed({
            get() {
                const modelexpr = jc.modelexpr || props.modelexpr;
                if (modelexpr) {
                    // ctx 字段与 exprCtx 对齐，但 $self/value 用 innerValue（此时 modelinfo 尚未算出，避免循环）
                    return evalExpr(modelexpr, {
                        model: parentModel.value,
                        $self: innerValue.value,
                        value: innerValue.value,
                        row: null,
                        fullModelName: fullModelName.value,
                        getByPath: getByPath,
                        safeGet: (path) => dyn?.getByPath(parentModel.value, path)
                    });
                }
                if (parentModel.value && fullModelName.value) {
                    const val = getByPath(parentModel.value, fullModelName.value);
                    return val === undefined ? DVALUE : val;
                }
                if (isVModelBound()) {
                    return props.modelValue === undefined || props.modelValue === null ? DVALUE : props.modelValue;
                }
                return innerValue.value;
            },
            set(val) {
                const modelexpr = jc.modelexpr || props.modelexpr;
                if (modelexpr) {
                    const setexpr = jc.modelsetexpr || props.modelsetexpr;
                    if (setexpr) {
                        try {
                            const fn = new Function('model', '$value', '$self', 'row', setexpr);
                            fn(parentModel.value, val, modelinfo.value, null);
                        } catch (e) {
                            console.error('[modelsetexpr 写回失败]', setexpr, e);
                        }
                    } else {
                        console.warn('[modelinfo] modelexpr 模式未配置 modelsetexpr，赋值被忽略');
                    }
                    if (comInnerInfo.validation.touched) validate();
                    return;
                }
                if (parentModel.value && fullModelName.value) {
                    setByPath(parentModel.value, fullModelName.value, val);
                } else if (isVModelBound()) {
                    context.emit('update:modelValue', val);
                } else {
                    innerValue.value = val;
                }
                if (comInnerInfo.validation.touched) validate();
            }
        });
	    let _rootEl = null; // 校验结果写回根元素，供父级（DetailTemplate validateForm）聚合具体错误消息
	    function validate() {
            const rules = jc.validators || [];
            // 实时读取当前值（不依赖 modelinfo computed 缓存），确保 form 已更新后校验拿到最新值
            const val = (parentModel.value && fullModelName.value)
                ? getByPath(parentModel.value, fullModelName.value)
                : modelinfo.value;
            const errors = [];
            for (const rule of rules) {
                if (rule.enableWhen !== undefined) {
                    try {
                        const fn = new Function("ctx", rule.enableWhen);
                        const enable = fn({ value: val, model: parentModel.value, getByPath });
                        if (!enable) continue;
                    } catch (e) {
                        console.warn("[validator enableWhen error]", e);
                    }
                }
                const validatorsMap = {
                    required: (v) => v !== null && v !== undefined && v !== '' && !(Array.isArray(v) && v.length === 0),
                    min: (v, m) => v === '' || v === null || v === undefined || Number(v) >= Number(m),
                    max: (v, m) => v === '' || v === null || v === undefined || Number(v) <= Number(m),
                    length: (v, m) => !v || String(v).length >= Number(m),
                    pattern: (v, p) => !v || new RegExp(p).test(String(v)),
                    email: (v) => !v || /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(String(v)),
                    phone: (v) => !v || /^1[3-9]\d{9}$/.test(String(v)),
                    number: (v) => v === '' || v === null || v === undefined || !isNaN(Number(v)),
                    // custom：rule.value 为返回布尔值的 JS 表达式脚本（参数 v=当前值, model=表单模型）
                    custom: (v, script) => {
                        if (!script) return true;
                        try { return !!new Function('v', 'model', 'return (' + script + ');')(val, parentModel.value); }
                        catch (e) { console.warn('[validator custom error]', e); return false; }
                    }
                };
                const fn = validatorsMap[rule.type];
                if (!fn) continue;
                if (!fn(val, rule.value)) errors.push(rule.message || `验证失败: ${rule.type}`);
            }
            comInnerInfo.validation.valid = errors.length === 0;
            comInnerInfo.validation.errors = errors;
            comInnerInfo.validation.touched = true;
	    if (_rootEl) _rootEl.__dynErrors = errors.slice();
	    return comInnerInfo.validation.valid;
        }
        function resetValidation() {
            comInnerInfo.validation.valid = true;
            comInnerInfo.validation.errors = [];
            comInnerInfo.validation.touched = false;
        }
        provide('comInnerInfo', comInnerInfo);
        provide('component_validate', validate);
        provide('component_resetValidation', resetValidation);
        // evalCondition：监听当前值 + 整个表单 model（deep），任何字段变化都重算
        watch([modelinfo, () => parentModel.value], () => {
            effectivePatch.shell = null;
            effectivePatch.labeloptions = null;
            effectivePatch.comoptions = null;
            const scriptText = jc.options?.evalCondition;
            if (!scriptText) return;
            if (window.DYN_LIB_CONFIG?.disableEvalJs) {
                console.warn("[BaseLayout] evalCondition全局关闭");
                return;
            }
            try {
                // ctx 与 bindings 完全一致：model / $self / value / row / fullModelName / getByPath / safeGet
                const fn = new Function("ctx", scriptText);
                const ret = fn(exprCtx.value);
                if (ret && typeof ret === "object") {
                    effectivePatch.shell = ret.shell ?? null;
                    effectivePatch.labeloptions = ret.labeloptions ?? null;
                    effectivePatch.comoptions = ret.comoptions ?? null;
                }
            } catch (e) {
                console.error("[evalCondition脚本执行异常]", e, scriptText);
            }
        }, { deep: true });
        function getSlot(slotName) {
            if (context.slots[slotName]) {
                return context.slots[slotName];
            }
            const slotDef = jc.slots?.[slotName];
            return slotDef ?? null;
        }
        const safeChildren = computed(() => (jc.childrenctrls || []).filter(c => c && typeof c === 'object'));
        var _sortableIns = null;
        var _instance = getCurrentInstance();
        onMounted(() => {
            const rootEl = (_instance && _instance.proxy && _instance.proxy.$el) || context.root?.el;
            _rootEl = rootEl;
            // 透明渲染包装（DynDynamicCom）不覆盖真实组件的 meta/校验：两者挂在同一根元素，
            // 若覆盖会抹掉真实组件的 fullModelName 与 __dynValidate，导致 model 丢失、校验失效
            if (rootEl && !comExtra.transparentMode) {
                rootEl.__dynUiMeta = {
                    parentModelPrefix: fullModelName.value,
                    fullModelName: fullModelName.value,
                    defaultLabelOptions: finalLabelOptions.value,
                    uiGlobalProps: originUiGlobalMerged.value
                };
                            // 暴露组件校验方法到根元素，供父级（DetailTemplate 等）保存前聚合校验调用
                rootEl.__dynValidate = validate;
}
            // 联动：parentValuePath 变化时自动重新加载 options
            var _cascadePath = (jc.options && jc.options.comoptions && jc.options.comoptions.parentValuePath) || '';
            if (_cascadePath) {
                watch(function () { return getByPath(parentModel.value, _cascadePath); },
                    function (nv, ov) { if (nv !== ov) loadComOptions(); });
            }
            // 联动：sql / ajax 模板中 {{model.xxx}} 引用的字段变化时重新加载 options
            // 从 sql/url 字符串中正则提取所有 model.xxx 路径，逐一监听
            var _co = (jc.options && jc.options.comoptions) || {};
            var _tpl = (_co.sourceType === 'sql' && _co.sql) ? _co.sql
                : (_co.sourceType === 'ajax' && _co.url) ? _co.url : '';
            if (_tpl) {
                var _paths = [];
                var _re = /\{\{\s*model\.([\w.]+)\s*\}\}/g, _m;
                while ((_m = _re.exec(_tpl)) !== null) {
                    if (_paths.indexOf(_m[1]) < 0) _paths.push(_m[1]);
                }
                _paths.forEach(function (p) {
                    watch(function () { return getByPath(parentModel.value, p); },
                        function (nv, ov) { if (nv !== ov) loadComOptions(); });
                });
            }
  			// 设计模式下，容器组件初始化 Sortable
            // 注意：DynDynamicCom 透明包装层（transparentMode）与真实容器组件挂在同一根元素、
            // 都能看到同一个 .dyn-children-wrap，若两层都初始化会在同一元素上重复绑定 Sortable，
            // 嵌套容器时残留的旧实例 mousedown 监听器会与内层实例争抢，导致子组件拖不动。
            // designMode 为响应式：切换到"预览"时销毁 Sortable（禁用拖放），切回"设计"时重建。
            var teardownSortable = function () {
                if (_sortableIns) {
                    window.DesignerSortable.destroy(_sortableIns);
                    _sortableIns = null;
                }
            };
            var setupSortable = function () {
                if (!designMode.value || comExtra.transparentMode || !window.DesignerSortable || !rootEl) return;
                if (_sortableIns) return;
                var compName = jc.component || "";
                var isContainer = lookupIsContainer(compName);
                var isGrid = compName === "DynGridContainer";
                if (isContainer) {
                    var listEl = (rootEl.classList && rootEl.classList.contains("dyn-children-wrap")) ? rootEl : (typeof rootEl.querySelector === "function" ? rootEl.querySelector(".dyn-children-wrap") : null);
                    if (listEl) {
                        var designerScope = injectDesignerScope;
                        _sortableIns = window.DesignerSortable.createCanvasContainer(listEl, jc, designerScope, isGrid);
                    }
                }
            };
            nextTick(setupSortable);
            watch(designMode, function (isDesign) {
                nextTick(function () { isDesign ? setupSortable() : teardownSortable(); });
            });
        });
        onBeforeUnmount(() => {
            if (_sortableIns) window.DesignerSortable.destroy(_sortableIns);
        });
        return {
            jc,
            modelinfo,
            comInnerInfo,
            shellShow,
            shellClass,
            shellStyle,
            finalLabelOptions,
            finalComOptions,
            originUiGlobalMerged,
            validate,
            resetValidation,
            getStyle,
            getClass,
            getComlisteners,
            safeChildren,
            getSlot,
            fullModelName,
            parentModelPrefixVal,
            props,
            context,
            dyn,
            designMode,
            designUid,
            designRootClass,
            onDesignDragstart,
            onDesignClick,
            onDesignDragover,
            onDesignDrop,
            onDesignDragleave,
            ...comExtra
        };
    }
};
</script>
