@RenderBody()
<script tag='comconfig'>
var comConfig = {
    props: {
        jsonconfig: { type: Object, default: null },
        parentmodelinfo: { type: Object, default: null },
        nodePath: { type: String, default: '' }
    },
    setup(props, context) {
        const { ref, reactive, computed, inject, provide, watch, nextTick, onMounted, onBeforeUnmount, getCurrentInstance } = Vue;
        const _ = window._;
        const inst = Vue.getCurrentInstance();
        const dyn = inst?.proxy?.$dyn;
        const defaults = {
            component: null,
            modelname: null,
            options: {
                comoptions: {},
                comlisteners: {},
                labeloptions: { label: '', required: false, show: true },
                itemoptions: { style: {}, class: '' },
                wrapperoptions: {},
                uiGlobalProps: { size: undefined, disabled: undefined },
                defaultLabelOptions: { labelWidth: "auto", requiredMark: true },
                evalCondition: ""
            },
            validators: [],
            childrenctrls: [],
            slots: {},
            extendinfo: {}
        };
        function deepMerge(target, ...sources) {
            return _.mergeWith(target, ...sources, (objValue, srcValue) => {
                if (Array.isArray(srcValue)) {
                    return srcValue;
                }
                return undefined;
            });
        }
        // 直接引用 reactive 的 jsonconfig，不深拷贝；补齐缺失的默认字段
        const jc = props.jsonconfig || {};
        if (!jc.options) jc.options = {};
        if (!jc.options.comoptions) jc.options.comoptions = {};
        if (!jc.options.labeloptions) jc.options.labeloptions = { label: "", required: false, show: true };
        if (!jc.options.itemoptions) jc.options.itemoptions = { style: {}, class: "" };
        if (!jc.options.comInnerInfo) jc.options.comInnerInfo = {};
        if (!Array.isArray(jc.childrenctrls)) jc.childrenctrls = [];
        if (!Array.isArray(jc.validators)) jc.validators = [];
        if (!jc.slots) jc.slots = {};
        if (!jc.extendinfo) jc.extendinfo = {};
        // labelOptions 顶层配置（新结构）；兼容旧的 jc.options.labeloptions
        if (!jc.options.labeloptions) {
          jc.options.labeloptions = Object.assign({}, jc.options.labeloptions || {});
        }
        function mergePatch(origin, patch) {
            const res = Object.assign({}, origin);
            if (!patch || typeof patch !== "object") return res;
            for (const key in origin) {
                if (patch[key] !== undefined) {
                    res[key] = patch[key];
                }
            }
            return res;
        }
        function mergeLabelOptions(selfOpt, parentDefaultOpt) {
            const result = Object.assign({}, parentDefaultOpt || {});
            for (const key in selfOpt) {
                const v = selfOpt[key];
                if (v === null) {
                    result[key] = null;
                } else if (v !== undefined) {
                    result[key] = v;
                }
            }
            return result;
        }
        function getStyle(...opts) { return Object.assign({}, ...opts.map(o => o?.style || {})); }
        function getClass(...opts) { return opts.flatMap(o => (o?.class || '').split(' ')).filter(Boolean); }
        function getComlisteners() {
            const listeners = jc.options?.comlisteners || {};
            const result = {};
            for (const key in listeners) {
                const val = listeners[key];
                if (typeof val === 'function') result[key] = val;
            }
            return result;
        }
        // comInnerInfo：校验状态 + 选项型组件的远程 options 数据
        const comInnerInfo = reactive({
            validation: { valid: true, errors: [], touched: false },
            options: []
        });
        let DVALUE = null;
        let comExtra = {};

        // ============ 选项数据源公共能力（DynSelect/ComSelect/Radio/Checkbox 共用） ============
        /** 把任意形态（字符串或 {value,label}）归一为 {value,label}，支持 valueKey/labelKey 映射 */
        function _normOptionList(list, valueKey, labelKey) {
            return (Array.isArray(list) ? list : []).map(function (x) {
                if (x !== null && typeof x === 'object') {
                    var v = valueKey ? x[valueKey] : x.value;
                    var l = labelKey ? x[labelKey] : x.label;
                    return { value: v !== undefined ? v : x.value, label: l !== undefined ? l : x.label };
                }
                return { value: x, label: String(x) };
            });
        }
        /** static 数据源：优先 optionValuesText（每行“值,标签”，无逗号时值即标签），否则读 optionValues 数组 */
        function initOptionsFromConfig() {
            var co = jc.options && jc.options.comoptions ? jc.options.comoptions : {};
            if (typeof co.optionValuesText === 'string' && co.optionValuesText.trim()) {
                comInnerInfo.options = co.optionValuesText.split(/\r?\n/).map(function (line) {
                    var s = line.trim();
                    if (!s) return null;
                    var parts = s.split(/[,，]/);
                    var v = parts[0].trim();
                    var lab = parts.length > 1 ? parts.slice(1).join(',').trim() : v;
                    return { value: v, label: lab || v };
                }).filter(Boolean);
                return;
            }
            var ov = co.optionValues;
            comInnerInfo.options = _normOptionList(ov);
        }
        /**
         * 按 comoptions.sourceType 加载下拉选项：
         *   static - 静态 optionValues
         *   dict   - 平台字典 DynDict（dictType）
         *   table  - 工程表（projectId/table/valueField/textField，parentField+parentValuePath 联动）
         *   ajax   - 任意接口（url 支持 {{model.field}} 占位，valueKey/labelKey 映射）
         */
        function loadComOptions(forceType) {
            var s = (jc.options && jc.options.comoptions) || {};
            var t = forceType || s.sourceType || 'static';
            if (t === 'static') { initOptionsFromConfig(); return; }
            if (t === 'dict') {
                if (!s.dictType) return;
                fetch('/api/dyncommon/dicts?type=' + encodeURIComponent(s.dictType))
                    .then(function (r) { return r.json(); })
                    .then(function (res) { if (res && res.code === 0) comInnerInfo.options = _normOptionList(res.data); })
                    .catch(function (e) { console.warn('[dict options]', e); });
                return;
            }
            if (t === 'table') {
                if (!s.projectId || !s.table) return;
                var qs = 'projectId=' + encodeURIComponent(s.projectId)
                    + '&table=' + encodeURIComponent(s.table)
                    + '&valueField=' + encodeURIComponent(s.valueField || 'Id')
                    + '&textField=' + encodeURIComponent(s.textField || 'Name');
                if (s.parentField) {
                    var pv = '';
                    if (s.parentValuePath) pv = getByPath(props.parentmodelinfo, s.parentValuePath);
                    else if (s.parentValue !== undefined) pv = s.parentValue;
                    if (pv !== undefined && pv !== null && pv !== '') {
                        qs += '&parentField=' + encodeURIComponent(s.parentField)
                            + '&parentValue=' + encodeURIComponent(pv);
                    }
                }
                fetch('/api/dyncommon/options?' + qs)
                    .then(function (r) { return r.json(); })
                    .then(function (res) { if (res && res.code === 0) comInnerInfo.options = _normOptionList(res.data); })
                    .catch(function (e) { console.warn('[table options]', e); });
                return;
            }
            if (t === 'ajax') {
                if (!s.url) return;
                var url = String(s.url).replace(/\{\{\s*model\.([\w.]+)\s*\}\}/g, function (_, p) {
                    var v = getByPath(props.parentmodelinfo, p);
                    return encodeURIComponent(v == null ? '' : v);
                });
                fetch(url)
                    .then(function (r) { return r.json(); })
                    .then(function (res) {
                        var list = res && res.code === 0 ? res.data : (Array.isArray(res) ? res : (res && res.data) || []);
                        comInnerInfo.options = _normOptionList(list, s.valueKey, s.labelKey);
                    })
                    .catch(function (e) { console.warn('[ajax options]', e); });
            }
        }
        // ========== 新增：属性穿透相关 ==========
        /**
         * 按 comExtra.comPassThrough 白名单合并父穿透配置
         * @@param {object} localOptions 当前组件 jc.options
         * @@param {object} parentPass 父注入的 comExtraPass
         * @@param {string} passStr comExtra.comPassThrough 白名单字符串，支持 ,, 空项
         * @@returns {object} 合并后的完整options
         */
        function applyPassThrough(localOptions, parentPass, passStr) {
            const opts = _.cloneDeep(localOptions || {});
            if (!parentPass || !passStr) return opts;
            // 分割，trim，过滤空字符串，自动忽略 ,, 产生的空条目
            const keys = passStr.split(',')
                .map(i => i.trim())
                .filter(path => !!path);
            const parentVals = parentPass.passValues;
            for (const path of keys) {
                const localVal = _.get(opts, path);
                // 子组件该路径未显式定义，才继承父的值
                if (localVal === undefined) {
                    const pVal = _.get(parentVals, path);
                    if (pVal !== undefined) {
                        _.set(opts, path, pVal);
                    }
                }
            }
            return opts;
        }
        // 白名单，支持逗号连续空项
        comExtra.comPassThrough = "comOptions.size,labelOptions.css,labelOptions.style";
        // 注入父穿透数据源
        const parentPassSource = inject('comExtraPass', null);
        // 合并本地配置 + 上层穿透
        const mergedOptions = computed(() => {
            return applyPassThrough(jc.options, parentPassSource, comExtra.comPassThrough);
        });
        // ========== end 属性穿透 ==========
        // inject before section scripts
        const injectParentModelPrefix = inject('parentModelPrefix', null);
        const injectParentDefaultLabelOptions = inject('defaultLabelOptions', null);
        const injectUiGlobalProps = inject('ui_global_props', null);
        const injectDesignerScope = inject("designer", null);
        const injectParentComInnerInfo = inject('comInnerInfo', () => ({}));
        function lookupIsContainer(compName) {
            if (!injectDesignerScope || !injectDesignerScope.componentMetaList) return false;
            var list = injectDesignerScope.componentMetaList;
            for (var i = 0; i < list.length; i++) {
                var m = list[i];
                var nm = m.ComponentName || m.componentName;
                if (nm === compName) return !!(m.IsContainer || m.isContainer);
            }
            return false;
        }
        const pageCtx = inject('pageCtx', null);
        const designMode = !!(pageCtx && pageCtx.designMode);
        const designUid = (designMode && pageCtx.uidOf) ? pageCtx.uidOf(jc) : null;
        function onDesignDragstart(e) { if (designMode && pageCtx.onDragStartCfg) { e.stopPropagation(); pageCtx.onDragStartCfg(props.jsonconfig, e); } }
        function onDesignClick(e) {
            if (!designMode || !pageCtx.onSelect) return;
            var selfUid = designUid;
            if (selfUid) {
                var inner = e.target.closest('[data-dyn-uid]');
                if (inner && inner.getAttribute('data-dyn-uid') !== selfUid) return;
            }
            pageCtx.onSelect(props.jsonconfig, e);
        }
        function onDesignDragover(e) { if (designMode && pageCtx.onDragOver) { e.preventDefault(); e.stopPropagation(); pageCtx.onDragOver(props.jsonconfig, e); } }
        function onDesignDrop(e) { if (designMode && pageCtx.onDrop) { e.preventDefault(); e.stopPropagation(); pageCtx.onDrop(props.jsonconfig, e); } }
        function onDesignDragleave(e) { if (designMode && pageCtx.onDragLeave) { e.stopPropagation(); pageCtx.onDragLeave(props.jsonconfig, e); } }
        const designRootClass = computed(() => {
            if (!designMode) return "";
            var c = jc.component || "";
            var isContainer = /Container|Form|Card|Tabs|Collapse|Row|Col|Panel/.test(c);
            if (isContainer && (!jc.childrenctrls || jc.childrenctrls.length === 0)) return "designer-empty-container";
            return "";
        });
        let parentModelPrefixVal = injectParentModelPrefix;
        let parentDefaultLabelOpts = injectParentDefaultLabelOptions;
        let parentUiGlobal = injectUiGlobalProps;
        if (!parentModelPrefixVal && dyn) {
            const hostEl = dyn.findAncestor(context.root?.el, '[data-dyn-mode="createApp"]');
            if (hostEl && hostEl.__dynUiMeta) {
                const meta = hostEl.__dynUiMeta;
                parentModelPrefixVal = meta.parentModelPrefix;
                parentDefaultLabelOpts = meta.defaultLabelOptions;
                parentUiGlobal = meta.uiGlobalProps;
            }
        }
        const effectivePatch = reactive({
            shell: null,
            labeloptions: null,
            comoptions: null
        });
        const shellShow = computed(() => effectivePatch.shell?.show ?? true);
        const shellClass = computed(() => effectivePatch.shell?.class ?? []);
        const shellStyle = computed(() => effectivePatch.shell?.style ?? {});
        // 从合并穿透后的 options 获取 labelOptions
        const originMergedLabelOpts = computed(() => {
            const base = mergeLabelOptions(mergedOptions.value.labeloptions, parentDefaultLabelOpts);
            return base;
        });
        const finalLabelOptions = computed(() => mergePatch(originMergedLabelOpts.value, effectivePatch.labeloptions));
        const finalComOptions = computed(() => {
            const base = mergePatch(mergedOptions.value.comoptions, effectivePatch.comoptions);
            return base;
        });
        // 自动把穿透来的 size 同步到 jc.options.comoptions.size，让所有 v-bind="jc.options.comoptions" 的组件模板自动生效
        watch(() => mergedOptions.value.comoptions.size, (newSize) => {
            if (newSize && !jc.options.comoptions.size) {
                jc.options.comoptions.size = newSize;
            }
        }, { immediate: true });
        const originUiGlobalMerged = computed(() => Object.assign({}, parentUiGlobal || {}, jc.options.uiGlobalProps));
        @RenderSection("setupScripts", false)
        const fullModelName = computed(() => {
            if (comExtra.transparentMode) {
                return parentModelPrefixVal || '';
            }
            const raw = jc.modelname || '';
            if (!raw) {
                const p = parentModelPrefixVal || '';
                return p?.startsWith('~') ? p.slice(1) : p;
            }
            if (raw.startsWith('~')) return raw.slice(1);
            const prefix = parentModelPrefixVal;
            if (prefix) {
                if (raw.startsWith('[')) return prefix + raw;
                return prefix + '.' + raw;
            }
            return raw;
        });
        provide('parentModelPrefix', fullModelName.value);
        // 【重要】容器组件需要向下继续传递穿透配置，实现链式穿透
        // 如果当前是容器组件，则把自己合并后的配置继续provide给子
        if(lookupIsContainer(jc.component)){
            const passValues = reactive({
                comOptions: mergedOptions.value.comoptions,
                labelOptions: mergedOptions.value.labeloptions
            });
            provide('comExtraPass', {
                passValues
            });
            comExtra.passValues = passValues;
        }
        const innerValue = ref(DVALUE);
        function getByPath(obj, path) { return !obj || !path ? undefined : _.get(obj, path); }
        function setByPath(obj, path, value) { if (!obj || !path) return; _.set(obj, path, value); }
        const modelinfo = computed({
            get() {
                if (props.parentmodelinfo && fullModelName.value) {
                    const val = getByPath(props.parentmodelinfo, fullModelName.value); 
                    return val === undefined ? DVALUE : val;
                }
                return innerValue.value;
            },
            set(val) {
                if (props.parentmodelinfo && fullModelName.value) {
                    setByPath(props.parentmodelinfo, fullModelName.value, val);
                } else {
                    innerValue.value = val;
                }
                if (comInnerInfo.validation.touched) validate();
            }
        });
        function validate() {
            const rules = jc.validators || [];
            const val = modelinfo.value;
            const errors = [];
            for (const rule of rules) {
                if (rule.enableWhen !== undefined) {
                    try {
                        const fn = new Function("ctx", rule.enableWhen);
                        const enable = fn({ value: val, model: props.parentmodelinfo, getByPath });
                        if (!enable) continue;
                    } catch (e) {
                        console.warn("[validator enableWhen error]", e);
                    }
                }
                const validatorsMap = {
                    required: (v) => v !== null && v !== undefined && v !== '' && !(Array.isArray(v) && v.length === 0),
                    min: (v, m) => v === '' || v === null || v === undefined || Number(v) >= Number(m),
                    max: (v, m) => v === '' || v === null || v === undefined || Number(v) <= Number(m),
                    length: (v, m) => !v || String(v).length >= Number(m),
                    pattern: (v, p) => !v || new RegExp(p).test(String(v)),
                    email: (v) => !v || /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(String(v)),
                    phone: (v) => !v || /^1[3-9]\d{9}$/.test(String(v)),
                    number: (v) => v === '' || v === null || v === undefined || !isNaN(Number(v)),
                    // custom：rule.value 为返回布尔值的 JS 表达式脚本（参数 v=当前值, model=表单模型）
                    custom: (v, script) => {
                        if (!script) return true;
                        try { return !!new Function('v', 'model', 'return (' + script + ');')(val, props.parentmodelinfo); }
                        catch (e) { console.warn('[validator custom error]', e); return false; }
                    }
                };
                const fn = validatorsMap[rule.type];
                if (!fn) continue;
                if (!fn(val, rule.value)) errors.push(rule.message || `验证失败: ${rule.type}`);
            }
            comInnerInfo.validation.valid = errors.length === 0;
            comInnerInfo.validation.errors = errors;
            comInnerInfo.validation.touched = true;
            return comInnerInfo.validation.valid;
        }
        function resetValidation() {
            comInnerInfo.validation.valid = true;
            comInnerInfo.validation.errors = [];
            comInnerInfo.validation.touched = false;
        }
        provide('comInnerInfo', comInnerInfo);
        provide('component_validate', validate);
        provide('component_resetValidation', resetValidation);
        watch(modelinfo, () => {
            effectivePatch.shell = null;
            effectivePatch.labeloptions = null;
            effectivePatch.comoptions = null;
            const scriptText = jc.options?.evalCondition;
            if (!scriptText) return;
            if (window.DYN_LIB_CONFIG?.disableEvalJs) {
                console.warn("[BaseLayout] evalCondition全局关闭");
                return;
            }
            try {
                const safeGet = (path) => dyn?.getByPath(props.parentmodelinfo, path);
                const fn = new Function("ctx", scriptText);
                const ret = fn({
                    value: modelinfo.value,
                    model: props.parentmodelinfo,
                    fullModelName: fullModelName.value,
                    getByPath,
                    safeGet
                });
                if (ret && typeof ret === "object") {
                    effectivePatch.shell = ret.shell ?? null;
                    effectivePatch.labeloptions = ret.labeloptions ?? null;
                    effectivePatch.comoptions = ret.comoptions ?? null;
                }
            } catch (e) {
                console.error("[evalCondition脚本执行异常]", e, scriptText);
            }
        }, { deep: true });
        function getSlot(slotName) {
            if (context.slots[slotName]) {
                return context.slots[slotName];
            }
            const slotDef = jc.slots?.[slotName];
            return slotDef ?? null;
        }
        const safeChildren = computed(() => (jc.childrenctrls || []).filter(c => c && typeof c === 'object'));
        var _sortableIns = null;
        var _instance = getCurrentInstance();
        onMounted(() => {
            const rootEl = (_instance && _instance.proxy && _instance.proxy.$el) || context.root?.el;
            if (rootEl) {
                rootEl.__dynUiMeta = {
                    parentModelPrefix: fullModelName.value,
                    defaultLabelOptions: finalLabelOptions.value,
                    uiGlobalProps: originUiGlobalMerged.value
                };
            }
  			// 设计模式下，容器组件初始化 Sortable
            nextTick(() => {
            if (designMode && window.DesignerSortable && rootEl) {
                var compName = jc.component || "";
                var isContainer = lookupIsContainer(compName);
                var isGrid = compName === "DynGridContainer";
                if (isContainer) {
                    var listEl = (rootEl.classList && rootEl.classList.contains("dyn-children-wrap")) ? rootEl : (typeof rootEl.querySelector === "function" ? rootEl.querySelector(".dyn-children-wrap") : null);
                    if (listEl) {
                        var designerScope = injectDesignerScope;
                        _sortableIns = window.DesignerSortable.createCanvasContainer(listEl, jc, designerScope, isGrid);
                    }
                }
            }
            });
        });
        onBeforeUnmount(() => {
            if (_sortableIns) window.DesignerSortable.destroy(_sortableIns);
        });
        return {
            jc,
            modelinfo,
            comInnerInfo,
            shellShow,
            shellClass,
            shellStyle,
            finalLabelOptions,
            finalComOptions,
            originUiGlobalMerged,
            validate,
            resetValidation,
            getStyle,
            getClass,
            getComlisteners,
            safeChildren,
            getSlot,
            fullModelName,
            parentModelPrefixVal,
            props,
            context,
            dyn,
            designMode,
            designUid,
            designRootClass,
            onDesignDragstart,
            onDesignClick,
            onDesignDragover,
            onDesignDrop,
            onDesignDragleave,
            ...comExtra
        };
    }
};
</script>
