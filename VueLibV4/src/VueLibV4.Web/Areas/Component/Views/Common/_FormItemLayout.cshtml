@{
    Layout = "~/Areas/Component/Views/Common/_BaseLayout.cshtml";
}
<template>
    <div v-if="shellShow"
         :class="[...getClass(jc.options.itemoptions), ...shellClass, formItemRootClass]"
         :style="[getStyle(jc.options.itemoptions), shellStyle, formItemRootStyle]">
        <label v-if="finalLabelOptions.show !== false"
               class="el-form-item__label"
               :style="labelStyle"
               
               :class="{ 'is-required': finalLabelOptions.required }">
            {{ finalLabelOptions.label }}
          </label>
        <div class="el-form-item__content" :style="contentStyle" style="position:relative;">
            <!-- 字段变更标记：左上角小红三角 -->
             <span v-if="enableDiff && isChanged"
                  style=" position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
    border-right: 10px solid transparent;
    border-top: 10px solid #f56c6c;
    border-bottom: 0;
    cursor: help;
    z-index: 10;
    filter: drop-shadow(0 0 2px #f56c6c);"
                  :title="'原值: ' + formatVal(originValue) + '\n新值: ' + formatVal(currentValue)">
                  </span>
        
            @RenderBody()
            <div v-if="comInnerInfo.validation && !comInnerInfo.validation.valid && comInnerInfo.validation.touched && comInnerInfo.validation.errors && comInnerInfo.validation.errors.length"
                 class="el-form-item__error">
                <div v-for="err in comInnerInfo.validation.errors" :key="err">{{err}}</div>
            </div>
        </div>
    </div>
</template>
@section setupScripts{
    @RenderSection("setupScripts", false)
    // 布局方向从 finalLabelOptions.labelposition 读取（已合并容器穿透值）
    const labelPos = computed(() => finalLabelOptions.value?.labelposition || 'top');

    const formItemRootClass = computed(() => ({
        'dyn-form-item--horizontal': labelPos.value === 'left' || labelPos.value === 'right',
        'dyn-form-item--vertical': labelPos.value === 'top'
    }));

    const formItemRootStyle = computed(() => {
        const base = (labelPos.value === 'left' || labelPos.value === 'right')
            ? { display: 'flex', alignItems: 'flex-start' }
            : { display: 'block' };
        // 尊重配置中显式声明的 display（如主键隐藏域 itemoptions.style.display='none'），
        // 否则下方的 formItemRootStyle 会覆盖它导致隐藏域显示出来
        const optStyle = (jc.options && jc.options.itemoptions && jc.options.itemoptions.style) || {};
        if (optStyle.display) base.display = optStyle.display;
        return base;
    });

    // comoptions.size 穿透后同步影响 label 字号与行高（与 el-input 高度匹配）
    const finalSize = computed(() => finalComOptions.value?.size || 'default');
    const labelStyle = computed(() => {
        const size = finalSize.value;
        const fontSize = size === 'small' ? '12px' : '14px';
        const lineHeight = size === 'small' ? '24px' : (size === 'large' ? '40px' : '32px');
        // 注意：.el-form-item__label 默认 display:inline-flex，text-align 对 flex 容器不生效，
        // 必须用 display:flex + justifyContent 控制文字水平对齐
        if (labelPos.value === 'left') {
            // 标签在左、文字左对齐
            return {
                height:lineHeight,
                width: finalLabelOptions.value?.labelwidth || 'auto',
                flexShrink: '0',
                display: 'flex',
                alignItems: 'center',
                justifyContent: 'flex-start',
                paddingRight: '12px',
                fontSize
            };
        } else if (labelPos.value === 'right') {
            // 标签在左、文字右对齐（Element 语义），与内容留 12px 间距
            return {
                width: finalLabelOptions.value?.labelwidth || 'auto',
                flexShrink: '0',
                display: 'flex',
                alignItems: 'center',
                justifyContent: 'flex-end',
                paddingRight: '12px',
                fontSize,
                lineHeight
            };
        }
        // top：标签在顶部，字号随 size
        return {
            width: '100%',
            display: 'block',
            textAlign: 'left',
            marginBottom: '4px',
            fontSize
        };
    });

    const contentStyle = computed(() => {
        if (labelPos.value === 'left' || labelPos.value === 'right') {
            return { flex: '1', minWidth: '0' };
        }
        return { width: '100%' };
    });

    // 暴露给模板
    comExtra.labelPos = labelPos;
    comExtra.formItemRootClass = formItemRootClass;
    comExtra.formItemRootStyle = formItemRootStyle;
    comExtra.labelStyle = labelStyle;
    comExtra.finalSize = finalSize;
    comExtra.contentStyle = contentStyle;

    // ============ 字段变更标记（diff marker）============
    // comoptions.diffMarker !== false 时启用：值变化后 label 左上角亮红三角，hover 看原值→新值
    const enableDiff = computed(() => jc.options?.comoptions?.diffMarker !== false);
    const isChanged = ref(false);
    const originValue = ref(undefined);
    const currentValue = ref(undefined);
    let snapshotted = false;
    let _diffStop = null;

    function cloneVal(v) {
        if (v === null || v === undefined) return v;
        try { return JSON.parse(JSON.stringify(v)); } catch (e) { return v; }
    }
    function formatVal(v) {
        if (v === null || v === undefined || v === '') return '（空）';
        if (typeof v === 'object') { try { return JSON.stringify(v); } catch (e) { return String(v); } }
        return String(v);
    }

    // onMounted 后再启动：此时 fullModelName / parentModel / modelinfo 均已初始化
    onMounted(() => {
        if (!enableDiff.value) return;
        if (!fullModelName.value) return;
        function readField() {
            if (!parentModel.value) return undefined;
            return getByPath(parentModel.value, fullModelName.value);
        }
        function resetSnapshot() {
            // 整个 model 被重置（重新加载数据）时，重新以新数据为基准快照
            originValue.value = cloneVal(readField());
            currentValue.value = originValue.value;
            isChanged.value = false;
            snapshotted = true;
        }
        function check() {
            if (!parentModel.value) return;  // model 未就绪，等下一次
            const cur = readField();
            currentValue.value = cur;
            if (!snapshotted) {
                resetSnapshot();
                return;
            }
            isChanged.value = JSON.stringify(cloneVal(originValue.value)) !== JSON.stringify(cloneVal(cur));
        }
        check();
        _diffStop = watch(readField, check, { deep: true });
        // 监听整个 parentModel 引用变化（表单重新加载/重置时触发），重新快照
        @* _diffStop = watch(() => parentModel.value, () => {
            if (parentModel.value) resetSnapshot();
        }); *@
    });
    onBeforeUnmount(() => { if (_diffStop) _diffStop(); });

    comExtra.enableDiff = enableDiff;
    comExtra.isChanged = isChanged;
    comExtra.originValue = originValue;
    comExtra.currentValue = currentValue;
    comExtra.formatVal = formatVal;
}

<style>
/* 字段变更标记：左上角小红三角 */
.diff-marker-triangle {
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
    border-left: 10px solid #f56c6c;
    border-top: 10px solid transparent;
    border-bottom: 0;
    cursor: help;
    z-index: 10;
    filter: drop-shadow(0 0 2px #f56c6c);
}
</style>
