@{
    ViewData["Title"] = "组件属性配置 - VueLibV4";
    var extId = "Meta" + Guid.NewGuid().ToString("N")[..10];
    var componentId = ViewBag.ComponentId ?? 0;
}
<div id="@extId">
    <div class="bar">
        <b class="title">组件属性配置（PropertyConfigJson）</b>
        <el-tag size="small" type="info" effect="plain">{{ componentName }}</el-tag>
        <el-button size="small" @@click="resetAll">重置</el-button>
        <el-button size="small" type="primary" :loading="saving" @@click="saveMeta">保存</el-button>
    </div>

    <div class="main">
        <div class="col-editor">
            <div class="pane-head">DSL（自动提示：组件名 / comoptions. / labeloptions. / 枚举值）</div>
            <div class="editor-box">
                <textarea id="dsl-host" class="cm-host" spellcheck="false"></textarea>
            </div>
            <div class="err-box">
                <div v-if="errors.length" class="error-line" v-for="e in errors" :key="e.line + e.msg">⚠ 第 {{ e.line }} 行：{{ e.msg }}</div>
                <div v-else-if="warnings.length" class="warn-line" v-for="w in warnings" :key="w.line + w.msg">⚡ {{ w.msg }}</div>
                <div v-else class="ok-line">✓ DSL 语法正确</div>
            </div>
        </div>

        <div class="col-right">
            <div class="pane-head">渲染预览</div>
            <div class="preview-box">
                <dyn-dynamic-com v-if="previewCfg && previewCfg.component" :jsonconfig="previewCfg" :parentmodelinfo="model" :key="previewKey"></dyn-dynamic-com>
                <div v-else class="empty-tip">等待 DSL 解析…</div>
            </div>
            <div class="pane-head">组件 JSON</div>
            <pre class="json-pre">{{ jsonText }}</pre>
        </div>
    </div>
</div>

<style>
body { margin: 0; background: #f0f2f5; font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif; }
.bar { display: flex; align-items: center; gap: 10px; padding: 10px 16px; background: #fff; border-bottom: 1px solid #e4e7ed; }
.bar .title { font-weight: 600; margin-right: auto; }
.main { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; padding: 12px; height: calc(100vh - 64px); box-sizing: border-box; }
.col-editor, .col-right { display: flex; flex-direction: column; min-height: 0; gap: 8px; }
.col-right { display: grid; grid-template-rows: auto 1fr auto; }
.pane-head { font-size: 12px; font-weight: 600; color: #606266; padding: 6px 10px; background: #f5f7fa; border: 1px solid #e4e7ed; border-bottom: none; border-radius: 6px 6px 0 0; }
.editor-box { flex: 1; min-height: 0; background: #fff; border: 1px solid #e4e7ed; border-radius: 0 0 6px 6px; position: relative; }
.cm-host { width: 100%; height: 100%; box-sizing: border-box; }
.editor-box .CodeMirror { height: 100%; font-size: 13px; line-height: 1.6; }
.err-box { font-size: 12px; min-height: 22px; }
.error-line { color: #f56c6c; }
.warn-line { color: #e6a23c; }
.ok-line { color: #67c23a; }
.preview-box { flex: 1; min-height: 0; overflow: auto; background: #fff; border: 1px solid #e4e7ed; border-radius: 0 0 6px 6px; padding: 16px; margin: 0 auto; width: 100%; box-sizing: border-box; }
.empty-tip { text-align: center; color: #909399; font-size: 13px; padding: 60px 0; }
.json-pre { margin: 0; padding: 10px; background: #1e1e1e; color: #d4d4d4; font-family: Consolas, Monaco, monospace; font-size: 12px; line-height: 1.5; border: 1px solid #e4e7ed; border-radius: 0 0 6px 6px; white-space: pre-wrap; word-break: break-all; max-height: 200px; overflow: auto; }
.dyn-dsl-hint { z-index: 2147483000 !important; }
</style>

@section Scripts {
<script>
DynLib.ready(function () {
    var rawCm = null;

    var app = Vue.createApp({
        data: function () {
            return {
                componentId: @componentId,
                componentName: '',
                saving: false,
                model: Vue.reactive({}),
                jsonText: '',
                errors: [],
                warnings: [],
                previewCfg: null,
                previewKey: 0,
                originDsl: '',
                _timer: null
            };
        },
        methods: {
            parseAndRender: function () {
                if (!rawCm) return;
                var self = this;
                var text = rawCm.getValue();
                var hintIndex = (window.DynDsl && typeof window.DynDsl.getHintIndex === 'function') ? window.DynDsl.getHintIndex() : null;
                var res;
                try {
                    res = window.DynDsl.parseDsl(text, (hintIndex && hintIndex.byName) ? hintIndex.byName : null);
                } catch (e) {
                    this.errors = [{ line: 0, msg: '解析异常: ' + (e && e.message) }];
                    this.previewCfg = null; this.jsonText = '{}';
                    return;
                }
                this.errors = (res && res.errors) ? res.errors : [];
                this.warnings = (res && res.warnings) ? res.warnings : [];
                if (window.DynDsl && typeof window.DynDsl.markDslIssues === 'function' && rawCm) {
                    try { window.DynDsl.markDslIssues(rawCm, this.errors, this.warnings); } catch (e) {}
                }
                if (!text.trim()) { this.previewCfg = null; this.jsonText = '{}'; return; }
                this.previewCfg = (res && res.cfg) ? res.cfg : null;
                this.previewKey++;
                try { this.jsonText = JSON.stringify((res && res.cfg) || {}, null, 2); } catch (e) { this.jsonText = '{}'; }
            },
            loadMetaData: function () {
                var self = this;
                fetch('/api/platform/componentmeta/getmeta?id=' + encodeURIComponent(this.componentId), { cache: 'no-store' })
                    .then(function (r) { return r.json(); })
                    .then(function (res) {
                        if (!res || res.code !== 0 || !res.data) { dyn.showMessage((res && res.msg) || '加载失败', 'error'); return; }
                        var d = res.data;
                        self.componentName = d.componentName || '';
                        self.originDsl = d.propertyConfigJson ? self.jsonToDsl(d.propertyConfigJson) : '';
                        if (rawCm) {
                            rawCm.setValue(self.originDsl);
                            Vue.nextTick(function() { setTimeout(function(){ if(rawCm) rawCm.refresh(); }, 50); });
                        }
                        self.parseAndRender();
                    })
                    .catch(function (e) { dyn.showMessage('加载异常：' + e.message, 'error'); });
            },
            jsonToDsl: function (jsonStr) {
                try { return window.DynDsl.toDsl(JSON.parse(jsonStr)); } catch (e) { return ''; }
            },
            resetAll: function () {
                if (rawCm) rawCm.setValue(this.originDsl);
                this.parseAndRender();
            },
            saveMeta: function () {
                var self = this;
                if (!rawCm) return;
                var text = rawCm.getValue();
                var hintIndex = (window.DynDsl && typeof window.DynDsl.getHintIndex === 'function') ? window.DynDsl.getHintIndex() : null;
                var res;
                try { res = window.DynDsl.parseDsl(text, hintIndex ? hintIndex.byName : null); }
                catch (e) { dyn.showMessage('DSL 解析异常：' + e.message, 'error'); return; }
                if (res.errors && res.errors.length) { dyn.showMessage('第 ' + res.errors[0].line + ' 行：' + res.errors[0].msg, 'error'); return; }
                this.saving = true;
                fetch('/api/platform/componentmeta/savemeta', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ componentId: this.componentId, propertyConfigJson: JSON.stringify(res.cfg) })
                })
                    .then(function (r) { return r.json(); })
                    .then(function (res) {
                        if (res && res.code === 0) {
                            dyn.showMessage('保存成功');
                            self.originDsl = rawCm.getValue();
                            setTimeout(function () {
                                try {
                                    if (window.opener) { try { window.opener.location.reload(); } catch (e) {} try { window.close(); } catch (e) {} }
                                    else if (window.parent && window.parent !== window) { try { window.parent.location.reload(); } catch (e) {} }
                                    else { try { window.location.reload(); } catch (e) {} }
                                } catch (e) {}
                            }, 800);
                        } else { dyn.showMessage((res && res.msg) || '保存失败', 'error'); self.saving = false; }
                    })
                    .catch(function (e) { dyn.showMessage('保存异常：' + e.message, 'error'); self.saving = false; });
            }
        },
        mounted: function () {
            var self = this;
            window.DynDsl.loadMeta().then(function (hintIndex) {
                if (typeof window.CodeMirror !== 'function') return;
                var host = document.getElementById('dsl-host');
                if (!host) return;
                var parentBox = host.parentNode;
                parentBox.innerHTML = '';
                var cm = window.CodeMirror(parentBox, {
                    value: '',
                    mode: 'dsl', lineNumbers: true, lineWrapping: true,
                    indentUnit: 2, tabSize: 2,
                    placeholder: '>> DynGridContainer comoptions.gridTemplateColumns="1fr 1fr"\n  - DynElInput modelname="title" label="标题"'
                });
                rawCm = Vue.markRaw(cm);
                cm.on('change', function () {
                    clearTimeout(self._timer);
                    self._timer = setTimeout(function () { self.parseAndRender(); }, 200);
                });
                if (hintIndex && typeof window.DynDsl.attachDslHints === 'function') {
                    try { window.DynDsl.attachDslHints(cm, hintIndex); } catch (e) {}
                }
                self.loadMetaData();
                Vue.nextTick(function() { setTimeout(function(){ cm.refresh(); }, 150); });
            }).catch(function(err) { console.error('[MetaDsl] loadMeta', err); });
        }
    });

    DynCom.setupApp(app);
    DynCom.ensureRegistered(app).then(function () {
        const container = document.querySelector('#@extId');
        if (!container) return;
        app.mount(container);
        Vue.nextTick(function() {
            setTimeout(function() { if (rawCm) rawCm.refresh(); }, 150);
        });
    });
});
</script>
}
