@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>修改密码 - VueLibV4</title>
    <style>
        body { margin:0; font-family:'Helvetica Neue',Arial,'PingFang SC','Microsoft YaHei',sans-serif; background:#f5f7fa; min-height:100vh; display:flex; align-items:center; justify-content:center; }
        .box { background:#fff; border-radius:8px; padding:30px; width:380px; box-shadow:0 2px 12px rgba(0,0,0,0.1); }
        .title { font-size:18px; font-weight:600; color:#303133; margin-bottom:24px; }
        .item { margin-bottom:16px; }
        .item label { display:block; font-size:14px; color:#606266; margin-bottom:6px; }
        .item input { width:100%; padding:8px 10px; border:1px solid #dcdfe6; border-radius:4px; font-size:14px; box-sizing:border-box; }
        .item input:focus { outline:none; border-color:#409eff; }
        .btn { width:100%; padding:10px; background:#409eff; color:#fff; border:none; border-radius:4px; font-size:14px; cursor:pointer; margin-top:8px; }
        .btn:hover { background:#66b1ff; }
        .msg { font-size:14px; text-align:center; margin-top:10px; display:none; }
        .ok { color:#67c23a; }
        .err { color:#f56c6c; }
    </style>
</head>
<body>
    <div class="box">
        <div class="title">修改密码</div>
        <div class="item">
            <label>旧密码</label>
            <input id="oldPwd" type="password" />
        </div>
        <div class="item">
            <label>新密码</label>
            <input id="newPwd" type="password" />
        </div>
        <div class="item">
            <label>确认新密码</label>
            <input id="newPwd2" type="password" />
        </div>
        <button class="btn" onclick="doChange()">确认修改</button>
        <div class="msg" id="msg"></div>
    </div>
    <script>
        async function doChange() {
            var oldPwd = document.getElementById('oldPwd').value;
            var newPwd = document.getElementById('newPwd').value;
            var newPwd2 = document.getElementById('newPwd2').value;
            var msg = document.getElementById('msg');
            msg.style.display = 'none';
            if (!oldPwd || !newPwd) { showMsg('请填写完整', false); return; }
            if (newPwd !== newPwd2) { showMsg('两次新密码不一致', false); return; }
            try {
                var res = await fetch('/api/platform/permission/changepassword', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ oldPassword: oldPwd, newPassword: newPwd })
                });
                var json = await res.json();
                if (json.code === 0) showMsg('修改成功', true);
                else showMsg(json.msg || '失败', false);
            } catch (e) { showMsg('网络错误', false); }
        }
        function showMsg(text, ok) {
            var msg = document.getElementById('msg');
            msg.textContent = text;
            msg.className = 'msg ' + (ok ? 'ok' : 'err');
            msg.style.display = 'block';
        }
    </script>
</body>
</html>
