@* 左侧面板：组件库 / 组件树 / 我的组合 三个 tab；可折叠为窄轨；树支持拖拽排序与悬停操作 *@
@* 注意：aside 是 Vue 挂载点，其属性不被 Vue 编译，所以 :style/@mousedown 必须放在内部包裹 div 上 *@
<aside class="dyn-panel shrink-0 bg-white border-r border-gray-200 min-h-0 relative"
       dyn-init="createapp" v-cloak data-dyn-use-scope="designer">
  <div class="dyn-panel-inner is-left flex flex-col min-h-0 h-full relative"
       :class="{ 'is-collapsed': model.leftCollapsed }"
       :style="{ width: model.leftCollapsed ? '36px' : (model.leftWidth + 'px') }">
  @* 右侧拖拽条 *@
  <div v-if="!model.leftCollapsed" class="dyn-resizer dyn-resizer-right" @@mousedown="onStartResizeLeft"></div>

  @* ===== 折叠态窄轨：整轨点击展开，图标直达对应 tab ===== *@
  <div class="dyn-panel-rail" @@click="setCollapsed(false)">
    <button class="dyn-rail-icon" title="展开组件面板" @@click.stop="setCollapsed(false)">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
    </button>
    <span class="dyn-rail-divider"></span>
    <button class="dyn-rail-tab" title="组件库" @@click.stop="expandTo('lib')">🧩</button>
    <button class="dyn-rail-tab" title="组件树" @@click.stop="expandTo('tree')">🌳</button>
    <button class="dyn-rail-tab" title="我的组合" @@click.stop="expandTo('comp')">📦</button>
    <span class="dyn-rail-title">组件</span>
  </div>

  <div class="dyn-panel-body flex flex-col min-h-0" style="width:100%;">
  <div class="flex items-center justify-between px-3 h-10 border-b border-gray-100 shrink-0">
    <span class="font-semibold text-gray-700">组件</span>
    <button class="dyn-panel-collapse" title="收起面板" @@click="setCollapsed(true)">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
    </button>
  </div>

  <el-tabs v-model="tab" class="px-2 flex-1 overflow-hidden flex flex-col">
    <el-tab-pane label="组件库" name="lib" class="flex-1 flex flex-col min-h-0">
      <el-input v-model="libKeyword" size="small" clearable class="mb-2" placeholder="搜索组件：名称 / 标签 / 分类">
        <template #prefix><span class="text-gray-400">🔍</span></template>
      </el-input>
      <el-select v-model="category" size="small" class="w-full mb-2" placeholder="全部组件">
        <el-option label="全部组件" value=""></el-option>
        <el-option v-for="c in allCategories" :key="c" :label="c" :value="c"></el-option>
      </el-select>
      <div class="flex flex-wrap gap-1 mb-3">
        <div v-for="c in allCategories" :key="c"
             class="px-2.5 py-1 text-xs rounded cursor-pointer"
             :class="category === c ? 'bg-blue-500 text-white' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'"
             @@click="category = (category === c ? '' : c)">
          {{ c }}
        </div>
      </div>
      <div id="component-lib-wrap" class="grid grid-cols-2 gap-2 overflow-y-auto pb-2" style="flex:0 1 auto;min-height:0;max-height:100%;align-content:start;">
        <div v-for="c in filteredComponents" :key="c.ComponentName"
             class="border border-gray-200 rounded p-2 flex flex-col items-center cursor-grab hover:border-blue-400 hover:bg-blue-50 transition"
             :data-meta="c.ComponentName" draggable="false"
             @@dblclick="onDblClickLib(c)" title="双击添加到画布末尾">
          <div class="text-3xl leading-none mb-1">{{ c.Icon }}</div>
          <div class="text-xs text-gray-600">{{ c.Label || c.ComponentName }}</div>
        </div>
      </div>
    </el-tab-pane>

    <el-tab-pane label="组件树" name="tree" class="flex-1 overflow-auto">
      <el-input v-model="treeFilter" size="small" clearable class="dyn-tree-filter"
                placeholder="过滤：类型 / modelname / label">
        <template #prefix><span class="text-gray-400">🔍</span></template>
      </el-input>
      <div class="dyn-tree-hint">拖拽可排序 / 跨容器移动，悬停节点显示操作按钮</div>
      <el-tree ref="compTree" :data="treeData" :props="{ label: 'label', children: 'children' }"
               default-expand-all node-key="uid" highlight-current
               :current-node-key="model.selectedUid"
               :filter-node-method="filterTreeNode"
               draggable
               :expand-on-click-node="false"
               :allow-drag="allowDragNode"
               :allow-drop="allowDropNode"
               @@node-click="onTreeNodeClick"
               @@node-drop="onTreeNodeDrop"
               class="dyn-comp-tree">
        <template #default="slotProps">
          <span class="dyn-tree-row" :class="{ 'dyn-tree-slot': !slotProps.data.cfg }">
            <span class="dyn-tree-label"><span class="mr-1">{{ slotProps.data.icon }}</span>{{ slotProps.data.label }}<span v-if="slotProps.data.userLabel" class="dyn-tree-userlabel">· {{ slotProps.data.userLabel }}</span></span>
            <span v-if="slotProps.data.cfg && slotProps.data.cfg !== model.pageJson" class="dyn-tree-ops" @@click.stop>
              <button title="上移" @@click.stop="onTreeOp(slotProps.data, 'up')">↑</button>
              <button title="下移" @@click.stop="onTreeOp(slotProps.data, 'down')">↓</button>
              <button title="复制" @@click.stop="onTreeOp(slotProps.data, 'copy')">⧉</button>
              <button class="dyn-tree-op-del" title="删除" @@click.stop="onTreeOp(slotProps.data, 'del')">✕</button>
            </span>
          </span>
        </template>
      </el-tree>
    </el-tab-pane>

    <el-tab-pane label="组合" name="comp" class="flex-1 flex flex-col min-h-0">
      <div class="text-xs text-gray-400 mb-2 leading-5">本地组合库：顶栏「存组合」入库，可直接拖入画布复用</div>
      <div id="composition-lib-wrap" class="grid grid-cols-2 gap-2 overflow-y-auto pb-2" style="flex:0 1 auto;min-height:0;align-content:start;">
        <div v-for="c in compositionItems" :key="c.Id"
             class="dyn-comp-card border border-gray-200 rounded p-2 flex flex-col items-center cursor-grab hover:border-blue-400 hover:bg-blue-50 transition"
             :data-meta="c.ComponentName" draggable="false">
          <button class="dyn-comp-del" title="删除组合" @@click.stop="removeComposition(c.Id)">✕</button>
          <div class="text-3xl leading-none mb-1">📦</div>
          <div class="text-xs text-gray-600 text-center break-all w-full">{{ c.Label }}</div>
        </div>
        <div v-if="!compositionItems.length" class="col-span-2 text-xs text-gray-300 text-center py-8">
          暂无组合<br/>选中组件（或整页）后点顶栏「存组合」
        </div>
      </div>
    </el-tab-pane>
  </el-tabs>
  </div>
  </div>

  <script tag="dynconfig">
  var COMPOSITION_KEY = 'dyn-designer-compositions';
  var dynConfig = {
    data: function () {
      return { tab: 'lib', category: '', libKeyword: '', allCategories: [], allComponents: [], compositions: [], treeFilter: '' };
    },
    computed: {
      filteredComponents: function () {
        var list = this.allComponents || [];
        var self = this;
        var kw = String(this.libKeyword || '').trim().toLowerCase();
        if (this.category) list = list.filter(function (c) { return c.Category === self.category; });
        if (kw) {
          list = list.filter(function (c) {
            return ((c.ComponentName || '') + ' ' + (c.Label || '') + ' ' + (c.Category || '')).toLowerCase().indexOf(kw) >= 0;
          });
        }
        return list;
      },
      treeData: function () {
        return window.DynDesignerOps.buildTreeData(this.model.pageJson);
      },
      // 组合拖拽源：伪装成 meta 卡片（含 ComponentName='__composition__'），
      // sortable onAdd 时识别该标记并展开为真实 cfg
      compositionItems: function () {
        return (this.compositions || []).map(function (c) {
          return { Id: c.id, Label: c.name, ComponentName: '__composition__', compCfg: c.cfg };
        });
      }
    },
    watch: {
      category: function () {
        var self = this;
        self.$nextTick(function () { self._initLibDrag(); });
      },
      libKeyword: function () {
        var self = this;
        self.$nextTick(function () { self._initLibDrag(); });
      },
      compositionItems: function () {
        var self = this;
        self.$nextTick(function () { self._initCompDrag(); });
      },
      treeFilter: function (v) {
        var self = this;
        self.$nextTick(function () {
          if (self.$refs.compTree) self.$refs.compTree.filter(v);
        });
      },
      // 画布变更后树重建：若有过滤词需重新套用
      treeData: function () {
        var self = this;
        if (self.treeFilter) {
          self.$nextTick(function () {
            if (self.$refs.compTree) self.$refs.compTree.filter(self.treeFilter);
          });
        }
      },
      'model.leftCollapsed': function (v) {
        try { localStorage.setItem('dyn-designer-left-collapsed', v ? '1' : '0'); } catch (e) {}
      }
    },
    mounted: function () {
      var self = this;
      try { if (localStorage.getItem('dyn-designer-left-collapsed') === '1') this.model.leftCollapsed = true; } catch (e) {}
      this.compositions = this._readCompositions();
      window.addEventListener('dyn-compositions-changed', this._onCompositionsChanged);
      fetch('/api/platform/componentmeta/grouped')
        .then(function (r) { return r.json(); })
        .then(function (res) {
          var groups = (res && res.data) || [];
          self.allCategories = groups.map(function (g) { return g.category; });
          var flat = [];
          groups.forEach(function (g) { g.components.forEach(function (c) { c.Category = g.category; flat.push(c); }); });
          self.allComponents = flat;
          self.model.componentMetaList = flat;
          self.$nextTick(function () { self._initLibDrag(); self._initCompDrag(); });
        });
      if (window.DynCom && window.DynCom.loadMeta) window.DynCom.loadMeta();
    },
    beforeUnmount: function () {
      window.removeEventListener('dyn-compositions-changed', this._onCompositionsChanged);
      if (this._libSortable && this._libSortable.destroy) {
        try { this._libSortable.destroy(); } catch (e) {}
      }
      if (this._compSortable && this._compSortable.destroy) {
        try { this._compSortable.destroy(); } catch (e) {}
      }
    },
    methods: {
      setCollapsed: function (v) { this.model.leftCollapsed = !!v; },
      // 折叠窄轨快捷图标：展开并直达指定 tab
      expandTo: function (name) { this.tab = name; this.model.leftCollapsed = false; },
      // 双击组件库项 → 添加到画布末尾
      onDblClickLib: function (c) {
        var Ops = window.DynDesignerOps;
        if (!Ops) return;
        Ops.saveSnapshot(this.model);
        var child = Ops.defaultCfg(c.ComponentName);
        this.model.pageJson.childrenctrls = this.model.pageJson.childrenctrls || [];
        this.model.pageJson.childrenctrls.push(child);
        Ops.select(this.model, child);
      },
      // 右侧拖拽条：拖动调整左面板宽度
      onStartResizeLeft: function (e) {
        e.preventDefault();
        var self = this;
        var startX = e.clientX;
        var startW = this.model.leftWidth || 288;
        function onMove(ev) {
          var w = Math.max(180, Math.min(600, startW + (ev.clientX - startX)));
          self.model.leftWidth = w;
        }
        function onUp() {
          document.removeEventListener('mousemove', onMove);
          document.removeEventListener('mouseup', onUp);
          document.body.style.cursor = '';
          document.body.style.userSelect = '';
        }
        document.body.style.cursor = 'col-resize';
        document.body.style.userSelect = 'none';
        document.addEventListener('mousemove', onMove);
        document.addEventListener('mouseup', onUp);
      },
      _initLibDrag: function () {
        if (this._libSortable && this._libSortable.destroy) {
          try { this._libSortable.destroy(); } catch (e) {}
        }
        var libDom = document.getElementById("component-lib-wrap");
        if (libDom && window.DesignerSortable) {
          this._libSortable = window.DesignerSortable.createComponentLibrary(libDom, this.filteredComponents, this.model);
        }
      },
      _initCompDrag: function () {
        if (this._compSortable && this._compSortable.destroy) {
          try { this._compSortable.destroy(); } catch (e) {}
        }
        var compDom = document.getElementById("composition-lib-wrap");
        if (compDom && window.DesignerSortable && this.compositionItems.length) {
          this._compSortable = window.DesignerSortable.createComponentLibrary(compDom, this.compositionItems, this.model);
        }
      },
      _readCompositions: function () {
        try {
          var list = JSON.parse(localStorage.getItem(COMPOSITION_KEY) || '[]');
          return Array.isArray(list) ? list : [];
        } catch (e) { return []; }
      },
      _writeCompositions: function (list) {
        localStorage.setItem(COMPOSITION_KEY, JSON.stringify(list));
        window.dispatchEvent(new Event('dyn-compositions-changed'));
      },
      _onCompositionsChanged: function () {
        this.compositions = this._readCompositions();
      },
      removeComposition: function (id) {
        var self = this;
        var layer = window.layui && window.layui.layer;
        var doRemove = function () {
          var list = self._readCompositions().filter(function (c) { return c.id !== id; });
          self._writeCompositions(list);
          self.compositions = list;
          self.$nextTick(function () { self._initCompDrag(); });
          if (layer) layer.msg('组合已删除', { icon: 1 });
        };
        if (layer) layer.confirm('删除该组合？仅删除本地组合库，不影响画布。', { title: '删除组合' }, function (idx) { layer.close(idx); doRemove(); });
        else if (window.confirm('删除该组合？')) doRemove();
      },
      onTreeNodeClick: function (data) {
        if (data && data.cfg) window.DynDesignerOps.select(this.model, data.cfg);
      },
      // 组件树过滤：关键字命中 类型 / 组件名 / modelname / label
      filterTreeNode: function (value, data) {
        if (!value) return true;
        var kw = String(value).trim().toLowerCase();
        if (!kw) return true;
        return (data.search || '').toLowerCase().indexOf(kw) >= 0;
      },
      // ===== 组件树拖拽：el-tree 原生 draggable，落点校验/回写统一走 ops =====
      allowDragNode: function (node) {
        var d = node && node.data;
        return !!(d && d.cfg && d.cfg !== this.model.pageJson);
      },
      allowDropNode: function (dragNode, dropNode, dropType) {
        var Ops = window.DynDesignerOps;
        if (!Ops || !dragNode || !dropNode) return false;
        return Ops.treeAllowDrop(this.model, dragNode.data && dragNode.data.cfg, dropNode.data && dropNode.data.cfg, dropType);
      },
      onTreeNodeDrop: function (dragNode, dropNode, dropType) {
        var Ops = window.DynDesignerOps;
        if (!Ops || !dragNode || !dropNode) return;
        Ops.treeReorder(this.model, dragNode.data.cfg, dropNode.data.cfg, dropType);
      },
      // ===== 树节点悬停操作：先选中再复用画布同款 ops =====
      onTreeOp: function (data, op) {
        if (!data || !data.cfg) return;
        var m = this.model, Ops = window.DynDesignerOps;
        Ops.select(m, data.cfg);
        if (op === 'up') Ops.moveSelected(m, -1);
        else if (op === 'down') Ops.moveSelected(m, 1);
        else if (op === 'copy') Ops.duplicateSelected(m);
        else if (op === 'del') Ops.removeSelected(m);
      }
    }
  };
  </script>
</aside>
