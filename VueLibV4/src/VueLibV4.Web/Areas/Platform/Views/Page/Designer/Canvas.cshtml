@* 中间画布：标尺(@@scena/ruler) + DynRender 递归渲染 + overlay 选中浮层 + drop 指示线 + 底部路径 *@
<main class="flex-1 relative flex flex-col min-h-0 bg-gray-100 overflow-hidden"
      dyn-init="createapp" v-cloak data-dyn-use-scope="designer">
  <!-- 标尺区：左上角 + 水平标尺（手写 canvas 标尺，随 zoom / 画布滚动同步） -->
  <div v-if="model.showRuler" class="flex shrink-0 z-20 bg-gray-100 border-b border-gray-300" style="height:20px;">
    <div class="dyn-ruler-corner shrink-0" style="width:20px;height:20px;background:#f3f4f6;border-right:1px solid #e5e7eb;"></div>
    <div ref="rulerHRef" class="flex-1 min-w-0 overflow-hidden" style="height:20px;"><canvas ref="rulerHCanvas" style="display:block;"></canvas></div>
  </div>

  <div class="flex flex-1 min-h-0 overflow-hidden">
    <!-- 垂直标尺 -->
    <div ref="rulerVRef" v-if="model.showRuler" class="dyn-ruler-v shrink-0 z-20 bg-gray-100 border-r border-gray-300 overflow-hidden" style="width:20px;"><canvas ref="rulerVCanvas" style="display:block;"></canvas></div>
    <!-- 画布滚动区（标尺与画布共用同一坐标系：刻度 = 画布坐标 × zoom，滚动同步 scrollPos） -->
    <div class="flex-1 min-w-0 min-h-0 overflow-auto relative" ref="canvasScrollRef" @@scroll="onCanvasScroll">
      <!-- 拖拽背景层 -->
      <div class="min-h-full">

  @* ===== JSON 模式：直接编辑整页配置，应用后写回画布（可撤销） ===== *@
  <div v-if="model.mode === 'json'" class="dyn-json-mode p-4">
    <div class="bg-white shadow-lg rounded p-3">
      <div class="flex items-center justify-between mb-2">
        <span class="text-sm font-semibold text-gray-700">页面配置 JSON</span>
        <span class="flex gap-2">
          <el-button size="small" @@click="formatJsonMode">格式化</el-button>
          <el-button size="small" @@click="refreshJsonMode">重新读取</el-button>
          <el-button size="small" type="primary" @@click="applyJsonMode">应用到画布</el-button>
        </span>
      </div>
      <textarea v-model="jsonModeText" rows="28" spellcheck="false"></textarea>
      <div v-if="jsonModeError" class="text-xs text-red-500 mt-1">{{ jsonModeError }}</div>
      <div v-else class="text-xs text-gray-400 mt-1">应用前校验 JSON 语法与 component 字段；空字段会在保存时自动清理。</div>
    </div>
  </div>

  <!-- 页面纸张（design mode：所有 n-dynamic-com 节点自带 data-dyn-uid + 可拖拽；预览模式不挂 design-mode 类，悬停描边等设计态 CSS 全部失效） -->
  <div v-show="model.mode !== 'json'" class="bg-white shadow-lg m-4 relative"
       :class="{ 'design-mode': designMode }"
       data-designer-canvas
       :style="{ width: (model.pageWidth || 1200) + 'px', minHeight: (model.pageHeight || 800) + 'px', transform: 'scale(' + (model.zoom / 100) + ')', '--dyn-zoom': (model.zoom / 100), transformOrigin: '0 0' }"
       @@click.self="onCanvasClick">
    <!-- key 绑定 canvasVersion：撤销/重做替换 pageJson 后强制整树重建（容器模板 setup 快照 jc 不响应顶层引用替换）；
         追加 mode 段：设计/预览切换时整树重挂载，保证 data-dyn-uid、Sortable、onMounted 数据加载等行为与真实页面一致 -->
    <dyn-dynamic-com :key="'root_' + (model.canvasVersion || 0) + '_' + (model.mode === 'preview' ? 'p' : 'd')" :jsonconfig="model.pageJson" :parentmodelinfo="model.mode === 'preview' ? model.defaultModel : null"></dyn-dynamic-com>

    <!-- overlay：不干扰容器自身 style/class，纯绝对定位覆盖层 -->
    <div v-if="model.overlay.uid && designMode"
         data-designer-overlay
         class="absolute border-2 border-blue-400 pointer-events-none z-30"
         :style="{ top: model.overlay.top + 'px', left: model.overlay.left + 'px', width: model.overlay.width + 'px', height: model.overlay.height + 'px' }">
      <div class="absolute -top-7 left-0 bg-blue-500 text-white text-xs px-2 py-0.5 flex items-center gap-1 pointer-events-auto rounded whitespace-nowrap" @@click.stop>
        <span v-if="ops.metaOf(model.selected && model.selected.component).Icon" class="mr-0.5">{{ ops.metaOf(model.selected.component).Icon }}</span>
        <span class="mr-1">{{ model.overlay.label }}</span>
        @* ===== 组件专属操作（ComponentMeta.DesignerOperates，command/view）===== *@
        <button v-for="op in customOperates" :key="op.operateKey"
                class="hover:bg-blue-600 px-1" :title="op.label"
                @@click.stop="ops.execOperate(model, op)">{{ op.icon || op.label }}</button>
        @* ===== 通用子项管理（ComponentMeta.DesignerMeta.childrenSchemaPath，Tab页/列等）===== *@
        <template v-if="childManager.available">
          <button class="hover:bg-blue-600 px-1" @@click.stop="overlayMenuOpen = !overlayMenuOpen" title="子项管理">⋯</button>
          <div v-if="overlayMenuOpen" class="dyn-overlay-menu" @@click.stop>
            <button @@click.stop="menuChild('add')">＋ 新增子项</button>
            <button @@click.stop="menuChild('remove')">− 删除当前子项</button>
            <button @@click.stop="menuChild('prev')">◀ 上一项（仅预览）</button>
            <button @@click.stop="menuChild('next')">▶ 下一项（仅预览）</button>
            <button @@click.stop="menuChild('up')">⇧ 子项上移</button>
            <button @@click.stop="menuChild('down')">⇩ 子项下移</button>
          </div>
        </template>
        @* ===== 基础操作 ===== *@
        <button v-if="model.selected && model.selected !== model.pageJson"
                class="hover:bg-blue-600 px-1" @@click.stop="ops.select(model, ops.findParent(model.pageJson, model.selected).parent)" title="选择父容器">⤴</button>
        <button class="hover:bg-blue-600 px-1" @@click.stop="ops.moveSelected(model,-1)" title="上移">↑</button>
        <button class="hover:bg-blue-600 px-1" @@click.stop="ops.moveSelected(model,1)" title="下移">↓</button>
        <button class="hover:bg-blue-600 px-1" @@click.stop="ops.duplicateSelected(model)" title="复制">⧉</button>
        <button class="hover:bg-red-600 px-1" @@click.stop="ops.removeSelected(model)" title="删除">✕</button>
      </div>
    </div>
  </div>
  </div>
  </div>
  </div>

  <!-- 底部组件路径面包屑 -->
  <div class="shrink-0 bg-white border-t border-gray-200 px-3 py-1.5 text-xs flex items-center gap-1 z-10">
    <span class="text-gray-400">路径：</span>
    <template v-if="model.pathList.length">
      <span v-for="(p, i) in model.pathList" :key="i" class="flex items-center gap-1">
        <span class="cursor-pointer hover:text-blue-500 flex items-center gap-0.5" @@click="ops.select(model, p)">
          <span v-if="ops.metaOf(p.component).Icon">{{ ops.metaOf(p.component).Icon }}</span>
          {{ ops.metaOf(p.component).Label || p.component }}
        </span>
        <span v-if="i < model.pathList.length - 1" class="text-gray-300">/</span>
      </span>
    </template>
    <span v-else class="text-gray-300">未选中</span>
  </div>

  @* ===== 设计器自定义视图（view 类型，designerOperates）===== *@
  <el-dialog v-model="model.viewState.open" :title="viewTitle" width="840px" top="6vh" append-to-body>
    @* —— TableColumnConfigView：DynTable 批量列配置（编辑副本，确认才写回节点）—— *@
    <template v-if="model.viewState.name === 'TableColumnConfigView'">
      <el-table :data="model.viewState.columns" border stripe size="small" max-height="420">
        <el-table-column label="字段 prop" width="170">
          <template #default="s"><el-input v-model="s.row.prop" size="small" placeholder="字段标识"></el-input></template>
        </el-table-column>
        <el-table-column label="标题 label" width="170">
          <template #default="s"><el-input v-model="s.row.label" size="small" placeholder="列标题"></el-input></template>
        </el-table-column>
        <el-table-column label="宽度" width="110">
          <template #default="s"><el-input v-model="s.row.width" size="small" placeholder="120"></el-input></template>
        </el-table-column>
        <el-table-column label="对齐" width="110">
          <template #default="s">
            <el-select v-model="s.row.align" size="small">
              <el-option label="左" value="left"></el-option>
              <el-option label="中" value="center"></el-option>
              <el-option label="右" value="right"></el-option>
            </el-select>
          </template>
        </el-table-column>
        <el-table-column label="显示" width="80">
          <template #default="s"><el-switch v-model="s.row.show"></el-switch></template>
        </el-table-column>
        <el-table-column label="排序/操作" width="130">
          <template #default="s">
            <el-button link type="primary" size="small" @@click="colMove(s.$index, -1)">⇧</el-button>
            <el-button link type="primary" size="small" @@click="colMove(s.$index, 1)">⇩</el-button>
            <el-button link type="danger" size="small" @@click="colRemove(s.$index)">删</el-button>
          </template>
        </el-table-column>
      </el-table>
      <div class="mt-2 flex items-center justify-between">
        <el-button type="primary" size="small" @@click="colAdd">＋ 新增列</el-button>
        <span class="text-xs text-gray-400">共 {{ model.viewState.columns.length }} 列 · 修改不自动保存，点「确定」写回组件</span>
      </div>
    </template>
    @* —— TabConfigView：DynElTabs 标签页配置（编辑副本，确认才写回节点）—— *@
    <template v-else-if="model.viewState.name === 'TabConfigView'">
      <el-table :data="model.viewState.items" border stripe size="small" max-height="420">
        <el-table-column label="标签页名称" width="240">
          <template #default="s"><el-input v-model="s.row.options.labeloptions.label" size="small" placeholder="标签页名称"></el-input></template>
        </el-table-column>
        <el-table-column label="图标 icon" width="180">
          <template #default="s"><el-input v-model="s.row.options.labeloptions.icon" size="small" placeholder="如 🚀 或留空"></el-input></template>
        </el-table-column>
        <el-table-column label="内部组件" width="140">
          <template #default="s">{{ s.row.component }}</template>
        </el-table-column>
        <el-table-column label="排序/操作" width="130">
          <template #default="s">
            <el-button link type="primary" size="small" @@click="tabMove(s.$index, -1)">⇧</el-button>
            <el-button link type="primary" size="small" @@click="tabMove(s.$index, 1)">⇩</el-button>
            <el-button link type="danger" size="small" @@click="tabRemove(s.$index)">删</el-button>
          </template>
        </el-table-column>
      </el-table>
      <div class="mt-2 flex items-center justify-between">
        <el-button type="primary" size="small" @@click="tabAdd">＋ 新增标签页</el-button>
        <span class="text-xs text-gray-400">共 {{ model.viewState.items.length }} 页 · 修改不自动保存，点「确定」写回组件</span>
      </div>
    </template>
    @* —— CollapseConfigView：DynElCollapse 折叠项配置（编辑副本，确认才写回节点）—— *@
    <template v-else-if="model.viewState.name === 'CollapseConfigView'">
      <el-table :data="model.viewState.items" border stripe size="small" max-height="420">
        <el-table-column label="折叠项标题" width="280">
          <template #default="s"><el-input v-model="s.row.options.comoptions.label" size="small" placeholder="折叠项标题"></el-input></template>
        </el-table-column>
        <el-table-column label="内部组件" width="180">
          <template #default="s">{{ s.row.component || '（空项）' }}</template>
        </el-table-column>
        <el-table-column label="排序/操作" width="130">
          <template #default="s">
            <el-button link type="primary" size="small" @@click="collapseMove(s.$index, -1)">⇧</el-button>
            <el-button link type="primary" size="small" @@click="collapseMove(s.$index, 1)">⇩</el-button>
            <el-button link type="danger" size="small" @@click="collapseRemove(s.$index)">删</el-button>
          </template>
        </el-table-column>
      </el-table>
      <div class="mt-2 flex items-center justify-between">
        <el-button type="primary" size="small" @@click="collapseAdd">＋ 新增折叠项</el-button>
        <span class="text-xs text-gray-400">共 {{ model.viewState.items.length }} 项 · 修改不自动保存，点「确定」写回组件</span>
      </div>
    </template>
    @* —— StepsConfigView：DynElSteps 步骤项配置（编辑副本，确认才写回节点）—— *@
    <template v-else-if="model.viewState.name === 'StepsConfigView'">
      <el-table :data="model.viewState.items" border stripe size="small" max-height="420">
        <el-table-column label="步骤标题" width="200">
          <template #default="s"><el-input v-model="s.row.options.comoptions.title" size="small" placeholder="步骤标题"></el-input></template>
        </el-table-column>
        <el-table-column label="描述 description" width="230">
          <template #default="s"><el-input v-model="s.row.options.comoptions.description" size="small" placeholder="步骤描述（可空）"></el-input></template>
        </el-table-column>
        <el-table-column label="图标 icon" width="120">
          <template #default="s"><el-input v-model="s.row.options.comoptions.icon" size="small" placeholder="如 🚀"></el-input></template>
        </el-table-column>
        <el-table-column label="状态 status" width="150">
          <template #default="s">
            <el-select v-model="s.row.options.comoptions.status" size="small" clearable placeholder="默认">
              <el-option label="等待 wait" value="wait"></el-option>
              <el-option label="进行中 process" value="process"></el-option>
              <el-option label="完成 finish" value="finish"></el-option>
              <el-option label="错误 error" value="error"></el-option>
              <el-option label="成功 success" value="success"></el-option>
            </el-select>
          </template>
        </el-table-column>
        <el-table-column label="排序/操作" width="130">
          <template #default="s">
            <el-button link type="primary" size="small" @@click="stepsMove(s.$index, -1)">⇧</el-button>
            <el-button link type="primary" size="small" @@click="stepsMove(s.$index, 1)">⇩</el-button>
            <el-button link type="danger" size="small" @@click="stepsRemove(s.$index)">删</el-button>
          </template>
        </el-table-column>
      </el-table>
      <div class="mt-2 flex items-center justify-between">
        <el-button type="primary" size="small" @@click="stepsAdd">＋ 新增步骤</el-button>
        <span class="text-xs text-gray-400">共 {{ model.viewState.items.length }} 步 · 修改不自动保存，点「确定」写回组件</span>
      </div>
    </template>
    <template #footer>
      <el-button @@click="viewCancel">取消</el-button>
      <el-button type="primary" @@click="viewConfirm">确定</el-button>
    </template>
  </el-dialog>

  @* ===== 渲染 HTML 查看器（TopBar「HTML」开关）===== *@
  <el-dialog v-model="htmlViewerOpen" title="渲染 HTML（当前画布快照）" width="820px" top="6vh" append-to-body>
    <div class="mb-2 flex items-center justify-between">
      <span class="text-xs text-gray-400">画布真实渲染 DOM 快照（已剥离设计器标记），可编辑后复制</span>
      <span class="flex gap-2">
        <el-button size="small" @@click="captureHtml">重新抓取</el-button>
        <el-button size="small" type="primary" @@click="copyHtml">复制</el-button>
      </span>
    </div>
    <textarea v-model="htmlViewerText" rows="22" spellcheck="false"
              style="width:100%;font-family:Consolas,monospace;font-size:12px;border:1px solid #dcdfe6;border-radius:4px;padding:8px;resize:vertical;"></textarea>
  </el-dialog>

  <script tag="dynconfig">
  var dynConfig = {
    data: function () {
      return { ops: window.DynDesignerOps, _rulerH: null, _rulerV: null, _stopWatchZoom: null, _stopWatchRuler: null, _csScroll: null, _onWinResize: null,
               overlayMenuOpen: false,
               jsonModeText: '', jsonModeError: '', htmlViewerOpen: false, htmlViewerText: '' };
    },
    watch: {
      // 切入 JSON 模式：拉取最新清理后的整页配置
      'model.mode': function (v) {
        if (v === 'json') { this.refreshJsonMode(); return; }
        if (v === 'preview') {
          // 进入预览：清除选中浮层与拖拽态，画布与真实渲染页完全一致
          window.DynDesignerOps.select(this.model, null);
        }
      },
      // TopBar「HTML」开关：打开渲染 HTML 查看器
      'model.showCode': function (v) { if (v) { this.htmlViewerOpen = true; this.captureHtml(); } },
      htmlViewerOpen: function (v) { if (!v && this.model.showCode) this.model.showCode = false; }
    },
    computed: {
      // 选中组件的设计器扩展操作（designerOperates）
      customOperates: function () {
        var sel = this.model.selected;
        return window.DynDesignerOps.designerOperatesOf(sel && sel.component) || [];
      },
      // 选中组件是否有通用子项管理（designerMeta.childrenSchemaPath）
      childManager: function () {
        var sel = this.model.selected;
        var dm = sel ? window.DynDesignerOps.designerMetaOf(sel.component) : null;
        return { available: !!(dm && dm.childrenSchemaPath) };
      },
      // 自定义视图标题
      viewTitle: function () {
        var vs = this.model.viewState || {};
        if (vs.name === 'TableColumnConfigView') return '表格批量列配置';
        if (vs.name === 'TabConfigView') return '标签页配置';
        if (vs.name === 'CollapseConfigView') return '折叠项配置';
        if (vs.name === 'StepsConfigView') return '步骤项配置';
        return '自定义视图';
      },
      designMode: function () { return this.model.mode !== 'preview'; }
    },
    provide: function () {
      var self = this;
      return {
        designer: self.model,
        pageCtx: {
          designMode: this.designMode,
          uidOf: function (cfg) { return window.DynDesignerOps.uidOf(cfg); },
          onSelect: function (cfg, e) { if (e) e.stopPropagation(); window.DynDesignerOps.select(self.model, cfg); },
          parentOf: function (cfg) { var h = window.DynDesignerOps.findParent(self.model.pageJson, cfg); return h ? h.parent : null; }
        }
      };
    },
    mounted: function () {
      var self = this;
      // 选中 / 整树重建 / 设计预览切换：重算 overlay 并重新监听选中节点尺寸
      this._stopWatch = this.$watch(
        function () { return self.model.selectedUid + '|' + (self.model.canvasVersion || 0) + '|' + self.model.mode; },
        function () {
          self.overlayMenuOpen = false;
          setTimeout(function () {
            window.DynDesignerOps.updateOverlay(self.model);
            self._bindOverlayObserver();
          }, 50);
        }
      );
      // hover 描边：只描当前指针下最近的一个设计节点
      var paper = this.$el && this.$el.querySelector ? this.$el.querySelector('[data-designer-canvas]') : null;
      if (paper) {
        this._hoverEl = null;
        this._onHover = function (e) {
          if (self.model.mode === 'preview' || self.model.dragging) return;
          var span = e.target && e.target.closest ? e.target.closest('[data-dyn-uid]') : null;
          if (!span) return;
          var el = span;
          if (getComputedStyle(span).display === 'contents') el = span.firstElementChild || span;
          if (el === self._hoverEl) return;
          if (self._hoverEl) self._hoverEl.classList.remove('dyn-hover-node');
          self._hoverEl = el;
          el.classList.add('dyn-hover-node');
        };
        this._onHoverOut = function () { if (self._hoverEl) self._hoverEl.classList.remove('dyn-hover-node'); self._hoverEl = null; };
        paper.addEventListener('pointerover', this._onHover);
        paper.addEventListener('pointerleave', this._onHoverOut);
        this._paperEl = paper;
      }
      this._bindOverlayObserver();
      window.addEventListener('resize', function () { window.DynDesignerOps.updateOverlay(self.model); });
      var mainEl = this.$el;
      if (mainEl) {
        this._wheelH = function (e) {
          if (!e.ctrlKey) return;
          e.preventDefault();
          var z = Math.round((self.model.zoom || 100) + (e.deltaY < 0 ? 5 : -5));
          self.model.zoom = Math.max(50, Math.min(150, z));
        };
        mainEl.addEventListener('wheel', this._wheelH, { passive: false });
      }
      // ===== 标尺（手写 canvas）：初始化 + zoom 联动 + 画布滚动同步 =====
      this.initRulers();
      this._stopWatchZoom = this.$watch(function () { return self.model.zoom; }, function (z) {
        self.setRulerZoom(z);
      });
      this._stopWatchRuler = this.$watch(function () { return self.model.showRuler; }, function (show) {
        self.destroyRulers();
        if (show) self.initRulers();
      });
      var cs = this.$refs.canvasScrollRef;
      if (cs) {
        this._csScroll = function () { self.syncRulerScroll(); };
        cs.addEventListener('scroll', this._csScroll, { passive: true });
      }
      this._onWinResize = function () { self.resizeRulers(); };
      window.addEventListener('resize', this._onWinResize);
    },
    beforeUnmount: function () {
      if (this._stopWatch) this._stopWatch();
      if (this._stopWatchZoom) this._stopWatchZoom();
      if (this._stopWatchRuler) this._stopWatchRuler();
      if (this.$el && this._wheelH) this.$el.removeEventListener('wheel', this._wheelH);
      var cs = this.$refs.canvasScrollRef;
      if (cs && this._csScroll) cs.removeEventListener('scroll', this._csScroll);
      if (this._onWinResize) window.removeEventListener('resize', this._onWinResize);
      if (this._ovRO) { this._ovRO.disconnect(); this._ovRO = null; }
      if (this._paperEl) {
        if (this._onHover) this._paperEl.removeEventListener('pointerover', this._onHover);
        if (this._onHoverOut) this._paperEl.removeEventListener('pointerleave', this._onHoverOut);
      }
      if (this._hoverEl) this._hoverEl.classList.remove('dyn-hover-node');
      this.destroyRulers();
    },
    methods: {
      // 监听选中节点尺寸：属性改动导致高度变化时，选中框立即贴合
      _bindOverlayObserver: function () {
        var self = this;
        if (this._ovRO) { this._ovRO.disconnect(); this._ovRO = null; }
        var uid = this.model.selectedUid;
        if (!uid || this.model.mode === 'preview') return;
        var span = document.querySelector('[data-dyn-uid="' + uid + '"]');
        if (!span) return;
        var el = span;
        if (getComputedStyle(span).display === 'contents') el = span.firstElementChild || span;
        if (!window.ResizeObserver) return;
        this._ovRO = new ResizeObserver(function () { window.DynDesignerOps.updateOverlay(self.model); });
        this._ovRO.observe(el);
      },
      // 子项管理菜单：统一入口，执行后收起
      menuChild: function (action) {
        var m = this.model;
        this.overlayMenuOpen = false;
        if (action === 'add') window.DynDesignerOps.addChildItem(m);
        else if (action === 'remove') window.DynDesignerOps.removeActiveChild(m);
        else if (action === 'prev') window.DynDesignerOps.stepActive(m, -1);
        else if (action === 'next') window.DynDesignerOps.stepActive(m, 1);
        else if (action === 'up') window.DynDesignerOps.moveActiveChild(m, -1);
        else if (action === 'down') window.DynDesignerOps.moveActiveChild(m, 1);
      },
      // ===== 标尺（canvas 绘制下沉到 dyn-designer-ruler.js）=====
      rulerZoom: function () { return (this.model.zoom || 100) / 100; },
      initRulers: function () {
        var self = this;
        if (!this.model.showRuler) return;
        this.$nextTick(function () {
          self._hCanvas = self.$refs.rulerHCanvas;
          self._vCanvas = self.$refs.rulerVCanvas;
          self._hWrap = self.$refs.rulerHRef;
          self._vWrap = self.$refs.rulerVRef;
          self.drawRulers();
        });
      },
      destroyRulers: function () {
        this._hCanvas = null; this._vCanvas = null; this._hWrap = null; this._vWrap = null;
      },
      setRulerZoom: function () { this.drawRulers(); },
      resizeRulers: function () { this.drawRulers(); },
      syncRulerScroll: function () { this.drawRulers(); },
      // 重绘两个标尺
      drawRulers: function () {
        var api = window.DynDesignerRuler;
        if (!api) return;
        var z = this.rulerZoom();
        var cs = this.$refs.canvasScrollRef;
        var off = 16; // 画布在滚动区内 16px margin：标尺 0 点对齐画布左上角
        api.draw(this._hCanvas, this._hWrap, { vertical: false, zoom: z, scroll: cs ? cs.scrollLeft - off : 0 });
        api.draw(this._vCanvas, this._vWrap, { vertical: true, zoom: z, scroll: cs ? cs.scrollTop - off : 0 });
      },
      onCanvasScroll: function () { this.syncRulerScroll(); },
      onCanvasClick: function () {
        if (this.model.mode === 'preview') return;
        window.DynDesignerOps.select(this.model, null);
      },
      // ===== 表格批量列配置视图（TableColumnConfigView）=====
      colAdd: function () {
        var vs = this.model.viewState;
        vs.columns.push({ prop: 'field' + (vs.columns.length + 1), label: '新列', width: 120, align: 'left', show: true, slotName: '' });
      },
      colRemove: function (idx) {
        var vs = this.model.viewState;
        if (vs.columns.length <= 1) { this.$message.warning('至少保留一列'); return; }
        vs.columns.splice(idx, 1);
      },
      colMove: function (idx, dir) {
        var cols = this.model.viewState.columns;
        var t = idx + dir;
        if (t < 0 || t >= cols.length) return;
        var tmp = cols[idx]; cols[idx] = cols[t]; cols[t] = tmp;
      },
      viewCancel: function () {
        this.model.viewState.open = false;   // 丢弃副本，不写回节点
      },
      // ===== 标签页配置视图（TabConfigView）=====
      tabAdd: function () {
        var vs = this.model.viewState;
        vs.items.push({ component: 'DynElContainer', modelname: '', options: { comoptions: {}, labeloptions: { label: '新标签页', show: true }, itemoptions: { style: {}, class: '' } }, childrenctrls: [] });
      },
      tabRemove: function (idx) {
        var vs = this.model.viewState;
        if (vs.items.length <= 1) { this.$message.warning('至少保留一个标签页'); return; }
        vs.items.splice(idx, 1);
      },
      tabMove: function (idx, dir) {
        var items = this.model.viewState.items;
        var t = idx + dir;
        if (t < 0 || t >= items.length) return;
        var tmp = items[idx]; items[idx] = items[t]; items[t] = tmp;
      },
      // ===== 折叠项配置视图（CollapseConfigView）=====
      collapseAdd: function () {
        var vs = this.model.viewState;
        vs.items.push({ component: 'DynElCollapseItem', options: { comoptions: { label: '折叠项' }, labeloptions: { show: false } }, childrenctrls: [] });
      },
      collapseRemove: function (idx) {
        var vs = this.model.viewState;
        if (vs.items.length <= 1) { this.$message.warning('至少保留一个折叠项'); return; }
        vs.items.splice(idx, 1);
      },
      collapseMove: function (idx, dir) {
        var items = this.model.viewState.items;
        var t = idx + dir;
        if (t < 0 || t >= items.length) return;
        var tmp = items[idx]; items[idx] = items[t]; items[t] = tmp;
      },
      // ===== 步骤条配置视图（StepsConfigView）=====
      stepsAdd: function () {
        var vs = this.model.viewState;
        vs.items.push({ component: 'DynElStep', options: { comoptions: { title: '新步骤', description: '', status: '', icon: '' } }, childrenctrls: [] });
      },
      stepsRemove: function (idx) {
        var vs = this.model.viewState;
        if (vs.items.length <= 1) { this.$message.warning('至少保留一个步骤'); return; }
        vs.items.splice(idx, 1);
      },
      stepsMove: function (idx, dir) {
        var items = this.model.viewState.items;
        var t = idx + dir;
        if (t < 0 || t >= items.length) return;
        var tmp = items[idx]; items[idx] = items[t]; items[t] = tmp;
      },
      viewConfirm: function () {
        var vs = this.model.viewState;
        var node = vs.node;
        if (!node) { vs.open = false; return; }
        window.DynDesignerOps.saveSnapshot(this.model);
        if (vs.name === 'TabConfigView') {
          // 校验标签页名称非空
          var labels = vs.items.map(function (it) { return String(((it.options || {}).labeloptions || {}).label || '').trim(); });
          if (labels.some(function (x) { return !x; })) { this.$message.warning('存在空的标签页名称'); return; }
          node.childrenctrls = JSON.parse(JSON.stringify(vs.items));
          vs.open = false;
          this.$message.success('标签页配置已更新');
          var m = this.model;
          setTimeout(function () { window.DynDesignerOps.select(m, node); }, 30);
          setTimeout(function () { window.DynDesignerOps.updateOverlay(m); }, 60);
          return;
        }
        if (vs.name === 'CollapseConfigView') {
          var titles = vs.items.map(function (it) { return String(((it.options || {}).comoptions || {}).label || '').trim(); });
          if (titles.some(function (x) { return !x; })) { this.$message.warning('存在空的折叠项标题'); return; }
          node.childrenctrls = JSON.parse(JSON.stringify(vs.items));
          // CollapseItem 对深层 props 变化不重渲染（复用实例显示旧标题），重建 Collapse 子树强制全新渲染
          var pj = this.model.pageJson;
          var pidx = pj.childrenctrls.indexOf(node);
          if (pidx >= 0) {
            pj.childrenctrls[pidx] = JSON.parse(JSON.stringify(pj.childrenctrls[pidx]));
          }
          vs.open = false;
          this.$message.success('折叠项配置已更新');
          var m2 = this.model;
          setTimeout(function () { window.DynDesignerOps.select(m2, m2.pageJson.childrenctrls[pidx >= 0 ? pidx : 0]); }, 30);
          setTimeout(function () { window.DynDesignerOps.updateOverlay(m2); }, 60);
          return;
        }
        if (vs.name === 'StepsConfigView') {
          var stitles = vs.items.map(function (it) { return String(((it.options || {}).comoptions || {}).title || '').trim(); });
          if (stitles.some(function (x) { return !x; })) { this.$message.warning('存在空的步骤标题'); return; }
          node.childrenctrls = JSON.parse(JSON.stringify(vs.items));
          vs.open = false;
          this.$message.success('步骤配置已更新');
          var mS = this.model;
          setTimeout(function () { window.DynDesignerOps.select(mS, node); }, 30);
          setTimeout(function () { window.DynDesignerOps.updateOverlay(mS); }, 60);
          return;
        }
        // TableColumnConfigView：校验 prop 非空、不重复
        var props = vs.columns.map(function (c) { return String(c.prop || '').trim(); });
        if (props.some(function (x) { return !x; })) { this.$message.warning('存在空的字段标识 prop'); return; }
        if (new Set(props).size !== props.length) { this.$message.warning('字段标识 prop 不能重复'); return; }
        // 写回组件节点（options.comoptions.columns）
        var co = window.DynDesignerOps.getPath(node, 'options.comoptions') || {};
        co.columns = JSON.parse(JSON.stringify(vs.columns));
        vs.open = false;
        this.$message.success('列配置已更新');
        var thisModel = this.model;
        setTimeout(function () { window.DynDesignerOps.updateOverlay(thisModel); }, 50);
      },
      // ===== JSON 模式：编辑/格式化/应用整页配置 =====
      refreshJsonMode: function () {
        try {
          this.jsonModeText = JSON.stringify(window.DynDesignerOps.getCleanJson(this.model), null, 2);
          this.jsonModeError = '';
        } catch (e) { this.jsonModeError = '序列化失败：' + e.message; }
      },
      formatJsonMode: function () {
        try {
          this.jsonModeText = JSON.stringify(JSON.parse(this.jsonModeText), null, 2);
          this.jsonModeError = '';
        } catch (e) { this.jsonModeError = 'JSON 语法错误：' + e.message; }
      },
      applyJsonMode: function () {
        var obj;
        try { obj = JSON.parse(this.jsonModeText); }
        catch (e) { this.jsonModeError = 'JSON 语法错误：' + e.message; return; }
        if (!obj || typeof obj !== 'object' || !obj.component) { this.jsonModeError = '必须是包含 component 字段的组件配置对象'; return; }
        window.DynDesignerOps.saveSnapshot(this.model);
        this.model.pageJson = obj;
        this.model.canvasVersion = (this.model.canvasVersion || 0) + 1;
        // 程序化替换顶层引用后重设基线：保留「应用前」快照可撤销，同时避免重复记一条
        if (window.DynDesignerHistory) window.DynDesignerHistory.baseline(this.model);
        window.DynDesignerOps.select(this.model, null);
        this.jsonModeError = '';
        this.$message.success('JSON 已应用到画布，可撤销');
      },
      // ===== 渲染 HTML 查看器 =====
      captureHtml: function () {
        var paper = document.querySelector('[data-designer-canvas]');
        if (!paper) { this.htmlViewerText = '（未找到画布）'; return; }
        var clone = paper.cloneNode(true);
        // 剥离设计器专用标记/浮层/缩放样式，得到接近运行时的静态 HTML
        clone.querySelectorAll('[data-designer-overlay]').forEach(function (n) { n.parentNode && n.parentNode.removeChild(n); });
        clone.querySelectorAll('[data-dyn-uid]').forEach(function (n) { n.removeAttribute('data-dyn-uid'); });
        clone.removeAttribute('data-designer-canvas');
        clone.classList.remove('design-mode');
        clone.style.transform = '';
        clone.style.setProperty('--dyn-zoom', '');
        var html = clone.outerHTML.replace(/></g, '>\n<');
        this.htmlViewerText = html;
      },
      copyHtml: function () {
        var text = this.htmlViewerText || '';
        var self = this;
        var done = function () { self.$message && self.$message.success('已复制到剪贴板'); };
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(text).then(done).catch(function () { fallbackCopy(); });
        } else { fallbackCopy(); }
        function fallbackCopy() {
          var ta = document.createElement('textarea');
          ta.value = text;
          ta.style.position = 'fixed'; ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          try { document.execCommand('copy'); done(); } catch (e) { self.$message && self.$message.warning('复制失败，请手动选择复制'); }
          document.body.removeChild(ta);
        }
      }
    }
  };
  </script>
</main>
