@model dynamic
@{
    var extId = (string)ViewData["ExtId"];
}
<div class="listview-demo-root">
    <div class="listview-demo-header">
        <h3>ListViewApp 卡片网格列表 — 增删改演示</h3>
        <div class="listview-demo-tip">
            CSS Grid 卡片布局 · 自定义 item 模板 · 新增/编辑走 open 片段弹窗 · 删除确认 · 分页
        </div>
    </div>
    <div class="listview-demo-body">
        @await Html.PartialAsync("~/Views/DynBlocks/AppsV2/ListViewApp.cshtml", new ViewDataDictionary(ViewData) {
            ["ExtId"] = extId,
            ["ListSettingId"] = 133,
            ["TableName"] = "SysMenu",
            ["KeyField"] = "Id",
            ["Project"] = "__platform__",
            ["DetailSettingId"] = 51
        })
    </div>
</div>

<style>
    .listview-demo-root { padding: 16px; }
    .listview-demo-header { margin-bottom: 16px; }
    .listview-demo-header h3 { margin: 0 0 4px; font-size: 18px; color: #303133; }
    .listview-demo-tip { font-size: 12px; color: #909399; }
    .listview-demo-body { min-height: 300px; }
</style>
