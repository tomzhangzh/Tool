@{
    Layout = "~/Areas/ElementComponent/Views/_ElementLayout.cshtml";
}

<template>
    <component
        v-if="jc?.component"
        :is="jc.component"
        :jsonconfig="jc"
        :parentmodelinfo="props.parentmodelinfo"
        :node-path="props.nodePath"
    >
    </component>
    <div v-else class="dyn-component-error" style="color:red;padding:4px;">
        组件未配置或不存在: {{ jc?.component ?? "empty" }}
    </div>
</template>

@section setupScripts{
// 数据库jsonconfig.component直接存储Vue真实注册组件名，无需转换
comExtra.targetComponentName = jc?.component;

}
