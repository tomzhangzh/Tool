@{
    Layout = "~/Areas/ElementComponent/Views/_ElementLayout.cshtml";
}

<template>
    <div class="dyn-slot"
         :style="getStyle(jc.options.itemoptions)"
         :class="getClass(jc.options.itemoptions)">
        <!-- 插槽占位：渲染 slots 中指定名称的子组件（默认 default 取 childrenctrls） -->
        <template v-if="jc.slots && jc.slots[slotName] && jc.slots[slotName].length">
            <DynRender v-for="(child, idx) in jc.slots[slotName]" :key="child.component + '_' + idx" :cfg="child" />
        </template>
        <template v-else>
            <DynRender v-for="(child, idx) in safeChildren" :key="child.component + '_' + idx" :cfg="child" />
        </template>
    </div>
</template>

@section setupScripts{
    DVALUE = null;
    // 插槽占位：comoptions.slotName 指定渲染的插槽名，缺省渲染 childrenctrls
    const slotName = computed(() => jc.options?.comoptions?.slotName || 'default');
}
