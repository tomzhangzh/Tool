@{
    Layout = "~/Areas/NutComponent/Views/_NutLayout.cshtml";
}

<template>
    <div class="n-grid-menu" :style="getStyle(props.jsonconfig.options.itemoptions)">
        <div v-for="(item, idx) in menuItems"
             :key="idx"
             class="n-grid-item"
             :class="{ placeholder: item.placeholder }"
             @@click="onItemClick(item)">
            <div class="n-grid-icon" :class="item.iconClass || 'gi-blue'">
                <n-icon :jsonconfig="{ component: 'NIcon', options: { comoptions: { name: item.icon, size: '26px', color: '#fff' } } }"></n-icon>
            </div>
            <span class="n-grid-label">{{ item.label }}</span>
        </div>
    </div>
</template>

@section setupScripts{
    const menuItems = props.jsonconfig.options.comoptions.items || [];
    function onItemClick(item) {
        if (item.path && !item.placeholder) {
            // 路由跳转
        }
    }
}
