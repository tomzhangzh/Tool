@{
    Layout = "~/Areas/NutComponent/Views/_NutLayout.cshtml";
}

<template>
    <div class="lc-container t_container nut-cell-group-wrapper" v-draggable="[props.jsonconfig.childrenctrls, dragOptions]">
        <div v-if="props.jsonconfig.options.comoptions.title" class="nut-cell-group-title">
            {{ props.jsonconfig.options.comoptions.title }}
        </div>
        <n-dynamic-com v-for="(child, idx) in props.jsonconfig.childrenctrls"
                       :key="child.component + '_' + idx"
                       :jsonconfig="child"
                       :parentmodelinfo="props.parentmodelinfo"
                       :node-path="props.nodePath + '.childrenctrls[' + idx + ']'">
        </n-dynamic-com>
    </div>
</template>

@section setupScripts{
    // CellGroup 无需额外逻辑
}
