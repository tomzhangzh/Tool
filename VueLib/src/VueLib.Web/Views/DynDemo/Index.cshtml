@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <title>dyn-lib 动作委托 Demo</title>
    <link rel="stylesheet" href="~/css/element-plus.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/nutui.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/nutui-icons.css" asp-append-version="true" />
    <style>
        body { font-family: 'Segoe UI', 'PingFang SC', Arial, sans-serif; margin: 0; background: #f4f4f5; padding: 20px; }
        .demo-card { background: #fff; border-radius: 8px; padding: 16px 20px; margin-bottom: 16px; box-shadow: 0 1px 4px rgba(0,0,0,.08); }
        .demo-card h3 { margin: 0 0 12px; font-size: 15px; color: #303133; }
        .demo-row { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin: 8px 0; }
        .demo-label { font-size: 13px; color: #909399; min-width: 90px; }
        .model-view { background: #f0f2f5; border-radius: 4px; padding: 6px 10px; font-size: 13px; color: #409eff; font-family: Consolas, monospace; }
        .badge-init { display: inline-block; background: #67c23a; color: #fff; border-radius: 10px; padding: 2px 10px; font-size: 12px; }
        .btn { display:inline-flex; align-items:center; justify-content:center; height:32px; padding:0 16px; background:#409eff; color:#fff;
               border:none; border-radius:4px; font-size:13px; cursor:pointer; transition:background .2s; }
        .btn:hover { background:#66b1ff; }
        input[type="text"], input:not([type]) { height:32px; padding:0 8px; border:1px solid #dcdfe6; border-radius:4px; font-size:13px; }
    </style>
</head>
<body>

    <div id="demo-app" dyn-init='{"count":0,"msg":"初始状态","user":{"name":"","age":0},"items":[{"name":"item0"},{"name":"item1"}]}'>
        <div class="demo-card">
            <h3>① 内置动作 postdata（POST Model → 后端返回 JSON 合并进 Model）</h3>
            <div class="demo-row">
                <span class="demo-label">当前 Model：</span>
                <span class="model-view">count = {{ model.count }} ，msg = "{{ model.msg }}"</span>
            </div>
            <div class="demo-row">
                <button dyn-click-postdata='{"url":"/DynDemo/Submit","message":"提交成功"}' class="btn">postdata 提交（+1）</button>
                <button dyn-click-postdata='{"url":"/DynDemo/Submit","confirm":"确定要提交吗？","message":"已确认提交"}' class="btn">带确认提交</button>
                <button dyn-click-confirm-postdata='{"url":"/DynDemo/Submit","message":"confirm-postdata"}' class="btn">confirm-postdata</button>
                <span style="font-size:12px;color:#909399;">（点击后 count 递增、msg 显示服务端时间）</span>
            </div>
        </div>

        <div class="demo-card">
            <h3>③ 自定义动作（挂 actionHelper 即动作）+ 初始化动作（dyn-init 属性驱动）</h3>
            <div class="demo-row">
                <span class="demo-label">自定义 toast：</span>
                <button dyn-click-toast='{"text":"这是自定义动作，参数来自属性 JSON","type":"success"}' class="btn">toast 自定义动作</button>
                <span style="font-size:12px;color:#909399;">（dyn-click-toast 挂在 dyn.actionHelper.toast 上，自动进入委托）</span>
            </div>
            <div class="demo-row">
                <span class="demo-label">init 动作：</span>
                <span dyn-init-badge='{"text":"初始化完成 ✔"}' class="badge-init" style="opacity:.4">待初始化…</span>
                <span style="font-size:12px;color:#909399;">（actionHelper.badge 挂上即可，初始化完毕 dyn.init 自动扫描 dyn-init-badge 执行，无需任何标记）</span>
            </div>
        </div>

        <div class="demo-card" style="font-size:12px;color:#909399;">
            说明：属性约定 <code>dyn-{event}-{action}='{JSON options}'</code>，事件委托覆盖
            change / click / dblclick / error / focus / select / mouseover；动作统一收 ctx 上下文
            （element / model / options / params / url / targetInfo），由注册表驱动，扩展动作零改委托。
            初始化动作 <code>dyn-init-{action}='{JSON options}'</code>：页面/Vue 初始化完毕立即执行；
            <code>dyn-init-load</code> 请求后端 HTML 填充本容器 + init + 写 data-url + __dynCfg（固定参数/method）。
            reload/updateEl 刷新时参数三层合并：固定参数(__dynCfg.params) → Vue model → 容器内 form 序列化。
        </div>

        <div class="demo-card">
            <h3>⑦ setVueModel 动作（设置 Vue model 值：dyn-init/click/change-setVueModel）</h3>
            <div class="demo-row">
                <span class="demo-label">当前 Model：</span>
                <span class="model-view">user.name = "{{ model.user.name }}" ，user.age = {{ model.user.age }}</span>
            </div>
            <div class="demo-row">
                <span class="demo-label">click 设置：</span>
                <button dyn-click-setVueModel='{"modelName":"user.name","model":"张三","settimeout":0}' class="btn">设置 name=张三</button>
                <button dyn-click-setVueModel='{"modelName":"user.age","model":30}' class="btn">设置 age=30</button>
                <button dyn-click-setVueModel='{"modelName":"user.name","model":"李四","settimeout":1000}' class="btn">延迟 1s 设置 name=李四</button>
            </div>
            <div class="demo-row">
                <span class="demo-label">change 设置：</span>
                <input dyn-change-setVueModel='{"modelName":"user.name"}' placeholder="输入后失焦/回车 → 设置 user.name" style="padding:4px 8px;" />
            </div>
            <div class="demo-row">
                <span class="demo-label">init 设置：</span>
                <span dyn-init-setVueModel='{"modelName":"user.age","model":18,"settimeout":500}' class="badge-init">初始化后 0.5s 设 user.age=18</span>
            </div>
            <div class="demo-row">
                <span class="demo-label">数组下标：</span>
                <span class="model-view">items[0].name = "{{ model.items[0].name }}"</span>
                <button dyn-click-setVueModel='{"modelName":"items[0].name","model":"改过的item0"}' class="btn">设置 items[0].name</button>
            </div>
            <div class="demo-row">
                <span class="demo-label">TargetEl 跨容器：</span>
                <span style="font-size:12px;color:#909399;">下方按钮位于 #demo-app 之外，通过 TargetEl 指向本容器设置 model</span>
            </div>
            <div class="demo-row" style="font-size:12px;color:#909399;">
                说明：<code>dyn-click-setVueModel</code> / <code>dyn-change-setVueModel</code> / <code>dyn-init-setVueModel</code>，
                参数 JSON <code>{"modelName":"user.name","model":"值","settimeout":毫秒}</code>。
                modelName 支持点路径与数组下标（如 "user.name"、"items[0].name"）；
                model 为要设置的值（JSON 字符串自动解析为对象/数组）；
                TargetEl 可选，指定目标 Vue 容器（选择器或元素），缺省用当前元素向上找最近的 VueApp 改其 model；settimeout 可选延迟执行。
            </div>
        </div>
    </div>

    <div class="demo-card">
        <h3>⑦-2 TargetEl 跨容器设置（按钮在 #demo-app 外，通过 TargetEl 指向目标容器）</h3>
        <div class="demo-row">
            <button dyn-click-setVueModel='{"TargetEl":"#demo-app","modelName":"msg","model":"来自外部 TargetEl 设置"}' class="btn">TargetEl 设置 #demo-app 的 msg</button>
            <button dyn-click-setVueModel='{"TargetEl":"#demo-app","modelName":"items[1].name","model":"外部改item1"}' class="btn">TargetEl 设置 items[1].name</button>
            <span style="font-size:12px;color:#909399;">点击后回到上方 ⑦ 卡片查看 msg / items[1].name 变化</span>
        </div>
    </div>

    <div class="demo-card">
        <h3>⑧ 约定式动作（actionHelper 挂方法即动作，无需 registerAction）</h3>
        <div class="demo-row">
            <span class="demo-label">自动绑定：</span>
            <button dyn-click-hello='{"text":"hello 自动绑定"}' class="btn">dyn-click-hello</button>
            <span style="font-size:12px;color:#909399;">hello 挂在 dyn.actionHelper 上，未调用 registerAction，委托自动识别</span>
        </div>
        <div class="demo-row">
            <span class="demo-label">限事件+init：</span>
            <button dyn-click-helloinit='{"text":"helloInit click"}' class="btn">dyn-click-helloInit（仅 click 生效）</button>
            <span dyn-init-helloinit='{"text":"helloInit 初始化执行"}' class="badge-init" style="opacity:.4">待 init…</span>
            <span style="font-size:12px;color:#909399;">helloInit 用 _events=['click'] 限定事件委托，dyn-init-helloinit 初始化照常触发</span>
        </div>
        <div class="demo-row" style="font-size:12px;color:#909399;">
            说明：<code>dyn.actionHelper.xxx = fn</code> 挂上即可被任意 <code>dyn-{event}-xxx</code> 属性触发，
            也可被 <code>dyn-init-xxx</code> 在初始化时自动执行（事件与初始化均由属性名驱动，无需任何标记）；
            <code>fn._events</code> 是可选白名单；运行时新增动作后调用 <code>dyn.rebind()</code> 重新生成委托选择器。
        </div>
    </div>

    <div class="demo-card">
        <h3>② reload 动作（data-dyn-url 容器局部刷新，容器位于 dyn-init 之外）</h3>
        <div class="demo-row">
            <button dyn-click-reload='{"selector":"#reload-host"}' class="btn">reload 刷新容器</button>
            <span style="font-size:12px;color:#909399;">输入框 change 事件也会触发 reload：</span>
            <input dyn-change-reload='{"selector":"#reload-host"}' placeholder="输入后失焦/回车触发 change" style="padding:4px 8px;" />
        </div>
        <div id="reload-host" data-dyn-url="/DynDemo/Partial" data-dyn-load="true"></div>
    </div>

    <div class="demo-card">
        <h3>④ dyn-init-load：div 初始化完毕立即请求后端 HTML 填充（含 init + 写 data-url + 固定参数）</h3>
        <div class="demo-row">
            <span class="demo-label">load div：</span>
            <div id="load-host" dyn-init-load='{"url":"/DynDemo/LoadPart","params":{"fixed":"fix1"}}' style="flex:1"></div>
        </div>
        <div class="demo-row">
            <button dyn-click-reload='{"selector":"#load-host"}' class="btn">reload（读 data-url）</button>
            <button dyn-click-updateel='{"selector":"#load-host","url":"/DynDemo/LoadPart","params":{"via":"updateEl"}}' class="btn">updateEl 更新</button>
            <span style="font-size:12px;color:#909399;">reload/updateEl 时把「固定参数 + 容器内 form(input search)」POST 回去，后端回显收到的参数。</span>
        </div>
    </div>

