    <div class="demo-card">
        <h3>⑥ evalJS 动作（直接执行 JavaScript 代码）</h3>
        <div class="demo-row">
            <span class="demo-label">ElementUI：</span>
            <button dyn-click-evaljs='ElementPlus.ElMessageBox.alert("xxx")' class="btn">警告框</button>
            <button dyn-click-evaljs='ElementPlus.ElMessageBox.confirm("确定删除？")' class="btn">确认框</button>
            <button dyn-click-evaljs='ElementPlus.ElNotification.success({title:"成功",message:"操作成功"})' class="btn">成功通知</button>
        </div>
        <div class="demo-row">
            <span class="demo-label">NutUI：</span>
            <button dyn-click-evaljs='nutui.showToast.success("操作成功")' class="btn">成功消息</button>
            <button dyn-click-evaljs='nutui.showDialog({title:"警告",content:"警告内容",showCancelButton:false})' class="btn">警告框</button>
            <button dyn-click-evaljs='nutui.showDialog({title:"确认",content:"确定删除？",showCancelButton:true})' class="btn">确认框</button>
        </div>
        <div class="demo-row">
            <span class="demo-label">自定义：</span>
            <button dyn-click-evaljs='alert("Hello World")' class="btn">alert</button>
            <button dyn-click-evaljs='console.log("Hello World")' class="btn">console.log</button>
            <button dyn-click-evaljs='document.title = "已修改"' class="btn">修改标题</button>
               @* <button dyn-init-evaljs='alert("Hello World")' class="btn">alert</button> *@
        </div>
        <div class="demo-row">
            <span class="demo-label">异步操作：</span>
            <button dyn-click-evaljs='ElementPlus.ElMessageBox.confirm("确定删除？").then(() => { dyn.showMessage("删除成功", "success"); })' class="btn">确认删除并提示</button>
            <button dyn-click-evaljs='ElementPlus.ElMessageBox.confirm("确定刷新？").then(() => { dyn.reload("#reload-host"); })' class="btn">确认刷新</button>
            <button dyn-click-evaljs="nutui.showDialog({
  title: '基础弹框',
  content: '支持函数调用和组件调用两种方式。',
  onOk: () => console.log('确定'),
  onCancel: () => console.log('取消'),
  beforeClose: (action) => {
    return new Promise((resolve) => {
      setTimeout(() => resolve(action === 'ok'), 1000)
    })
  }
})" class="btn">NutUI 确认删除</button>
        </div>
        <div class="demo-row" style="font-size:12px;color:#909399;">
            说明：属性名 <code>dyn-click-evaljs</code>，属性值是 JavaScript 代码字符串。
            直接执行代码，无需注册动作。支持 Promise 链，可以在异步操作完成后触发别的动作。
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/vue.global.prod.js"></script>
    <script src="~/js/lodash.min.js"></script>
    <script src="~/js/element-plus.full.min.js"></script>
    <script src="~/js/element-plus-icons.min.js"></script>
    <script src="~/js/nutui.umd.min.js"></script>
    <script src="~/js/dyn-lib.js"></script>
    <script>
        // ===== 约定式动作（actionHelper）：挂方法即动作，无需 registerAction / registerInitAction / _init 标记 =====
        // dyn.actionHelper.xxx = function(ctx){...} → 挂上即注册：
        //   1) 任意 dyn-{event}-xxx 属性触发（事件由属性名决定）
        //   2) dyn-init-xxx 属性在初始化（init/initAll/innerHTML 更新）时自动执行，无需任何标记
        // fn._events 是可选白名单（限定事件委托只认这些事件；不设 = 全部事件属性均可）
        (function () {
            // 自定义 toast：挂上即注册（对应 dyn-click-toast / dyn-change-toast）
            window.dyn.actionHelper.toast = function (ctx) {
                var o = ctx.options || {};
                window.dyn.showMessage(o.text || 'toast', o.type || 'success');
                console.log('[dyn-demo] toast ctx =', {
                    action: ctx.action, event: ctx.event, url: ctx.url,
                    model: ctx.model, options: ctx.options
                });
            };

            // 自定义 badge：挂上即可被 dyn-init-badge 在初始化时自动执行（无需 _init 标记）
            window.dyn.actionHelper.badge = function (ctx) {
                var o = ctx.options || {};
                ctx.element.textContent = (o.text || '已初始化');
                ctx.element.style.opacity = '1';
                console.log('[dyn-demo] init badge =', o.text, 'on', ctx.element);
            };

            // 全新动作 hello：挂上即注册
            window.dyn.actionHelper.hello = function (ctx) {
                var o = ctx.options || {};
                window.dyn.showMessage((o.text || 'hello') + '（来自 actionHelper 自动绑定，event=' + ctx.event + '）', 'success');
                console.log('[dyn-demo] actionHelper.hello', ctx.options, 'event=' + ctx.event);
            };
            // helloInit：演示 _events 白名单（事件委托只认 click），但 dyn-init-helloinit 初始化照样触发
            window.dyn.actionHelper.helloInit = function (ctx) {
                var o = ctx.options || {};
                if (ctx.event === 'init') {
                    ctx.element.textContent = (o.text || 'init 执行');
                    ctx.element.style.opacity = '1';
                } else {
                    window.dyn.showMessage((o.text || 'helloInit') + '（click）', 'success');
                }
                console.log('[dyn-demo] actionHelper.helloInit', ctx.options, 'event=' + ctx.event);
            };
            window.dyn.actionHelper.helloInit._events = ['click'];
            // 新增动作后调用 rebind 重新生成委托选择器（此处脚本在 dyn-lib 加载后执行，仍需手动 rebind 一次）
            window.dyn.rebind();
        })();

        // 启动：扫描 dyn-init 应用 + 初始化动作
        window.dyn.initAll();
    </script>
</body>
</html>

