@model DynRouteCustomModel
@{
    Layout = null;
    var project = Model.Project!;
    var webPage = Model.WebPage!;
    var template = Model.Template;
    var schema = Model.Schema ?? new List<DynTemplateParam>();
    var pars = Model.Params ?? new Dictionary<string, object?>();
    var pages = Model.Pages ?? new List<DynPage>();
    var banner = webPage.Title ?? webPage.Name;
    // label 映射
    var labelOf = new Dictionary<string, string>();
    foreach (var p in schema) labelOf[p.Key] = p.Label ?? p.Key;
    // 页面名映射（pagePicker 值 → 页面）
    var pageOf = pages.ToDictionary(x => x.Id, x => x.Name);
}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@(webPage.Title ?? webPage.Name)</title>
    <style>
        body { margin: 0; padding: 16px; background: #f5f7fa; font-family: 'Segoe UI', 'Microsoft YaHei', sans-serif; color: #303133; }
        .page { max-width: 1080px; margin: 0 auto; }
        .hero { background: linear-gradient(135deg, #409eff, #6a9cff); color: #fff; border-radius: 12px; padding: 22px 26px; margin-bottom: 16px; }
        .hero h1 { margin: 0 0 6px; font-size: 22px; }
        .hero p { margin: 0; opacity: .9; font-size: 13px; }
        .section-title { font-size: 14px; font-weight: 600; color: #303133; margin: 14px 0 10px; border-left: 3px solid #409eff; padding-left: 8px; }
        .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 12px; }
        .card { background: #fff; border: 1px solid #ebeef5; border-radius: 8px; padding: 14px 16px; }
        .card .k { font-size: 12px; color: #909399; }
        .card .v { font-size: 15px; font-weight: 600; color: #303133; margin-top: 6px; word-break: break-all; }
        .card .v.sub { font-size: 13px; font-weight: 400; color: #606266; }
        .items { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 10px; margin-top: 8px; }
        .item { background: #f7f9fc; border: 1px solid #ebeef5; border-radius: 8px; padding: 12px; text-align: center; }
        .item .ic { font-size: 24px; }
        .item .ti { font-size: 12px; color: #606266; margin-top: 6px; }
        .jsonbox { background: #1e1e1e; color: #d4d4d4; border-radius: 8px; padding: 14px; font-family: Consolas, monospace; font-size: 12px; white-space: pre-wrap; word-break: break-all; max-height: 340px; overflow: auto; }
    </style>
</head>
<body>
<div class="page">
    <div class="hero">
        <h1>@banner</h1>
        <p>@(webPage.Name) · 模板：@(template?.Name)（@(template?.TemplateType)） · 渲染视图：@(template?.RenderView)</p>
    </div>

    @if (pars.Count > 0)
    {
        <div class="section-title">模板参数</div>
        <div class="grid">
            @foreach (var kv in pars)
            {
                var label = labelOf.TryGetValue(kv.Key, out var lb) && !string.IsNullOrEmpty(lb) ? lb : kv.Key;
                var val = kv.Value;
                var isArray = val is Newtonsoft.Json.Linq.JArray;
                var isObj = val is Newtonsoft.Json.Linq.JObject;
                if (isArray || isObj)
                {
                    var jarr = val as Newtonsoft.Json.Linq.JArray;
                    if (jarr != null && jarr.Count > 0 && jarr[0] is Newtonsoft.Json.Linq.JObject)
                    {
                        <div class="card" style="grid-column: 1 / -1;">
                            <div class="k">@label（@kv.Key）</div>
                            <div class="items">
                                @foreach (var item in jarr)
                                {
                                    var jo = (Newtonsoft.Json.Linq.JObject)item!;
                                    var title = jo["title"]?.ToString() ?? "";
                                    var icon = jo["icon"]?.ToString() ?? "📦";
                                    var route = jo["route"]?.ToString() ?? "#";
                                    var extra = jo.Properties().Where(x => x.Name != "title" && x.Name != "icon" && x.Name != "route")
                                        .Select(x => x.Name + "=" + x.Value).ToArray();
                                    <a class="item" href="/DynRun/Route?projectId=@(project.Id)&route=@(Uri.EscapeDataString(route))" style="text-decoration:none;">
                                        <div class="ic">@icon</div>
                                        <div class="ti">@title</div>
                                        @if (extra.Length > 0) { <div class="ti">@(string.Join("；", extra))</div> }
                                    </a>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="card" style="grid-column: 1 / -1;">
                            <div class="k">@label（@kv.Key）</div>
                            <pre class="jsonbox" style="margin:6px 0 0;">@(Newtonsoft.Json.Linq.JToken.FromObject(val!).ToString(Newtonsoft.Json.Formatting.Indented))</pre>
                        </div>
                    }
                }
                else
                {
                    var text = val?.ToString() ?? "";
                    var isPage = schema.Any(x => x.Key == kv.Key && x.Type == "pagePicker");
                    int pid = 0;
                    if (isPage && int.TryParse(text, out pid) && pageOf.TryGetValue(pid, out var pcode))
                    {
                        <div class="card">
                            <div class="k">@label（@kv.Key）</div>
                            <div class="v">@pcode</div>
                            <div class="v sub">页面 #@pid</div>
                        </div>
                    }
                    else
                    {
                        <div class="card">
                            <div class="k">@label（@kv.Key）</div>
                            <div class="v">@text</div>
                        </div>
                    }
                }
            }
        </div>
    }
    else
    {
        <div class="section-title">模板参数</div>
        <div class="card"><div class="v sub">该模板未定义参数。</div></div>
    }

    <div class="section-title">参数原始 JSON</div>
    <pre class="jsonbox">@(Newtonsoft.Json.JsonConvert.SerializeObject(pars, Newtonsoft.Json.Formatting.Indented))</pre>
</div>
</body>
</html>
