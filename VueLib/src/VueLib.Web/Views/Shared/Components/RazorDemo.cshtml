@* ComponentType: Common *@
@* Description: 纯 Razor View 定义的组件（数据库中不存在，用于演示回退加载） *@
@model VueLib.Web.Models.ComponentViewModel
@{
    Layout = null;
    // 此文件作为组件定义载体，内容通过标记提取，不会直接渲染为页面
}

<!--COMPONENT_TYPE:1-->

<!--TEMPLATE_START-->
<div class="razor-demo">
    <div class="razor-badge">Razor View 组件</div>
    <h3>{{ title }}</h3>
    <p>此组件定义在 <code>.cshtml</code> 文件中，数据库中不存在，通过 Razor 回退机制加载。</p>
    <p>当前时间（服务端渲染时注入）: @DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")</p>
    <p>客户端计数: <strong>{{ count }}</strong></p>
    <button @@click="count++">点我+1</button>
</div>
<!--TEMPLATE_END-->

<!--SCRIPT_START-->
export default {
    name: "RazorDemo",
    props: {
        title: { type: String, default: "来自 Razor View 的组件" }
    },
    data() {
        return { count: 0 };
    }
};
<!--SCRIPT_END-->

<!--STYLE_START-->
.razor-demo {
    padding: 16px;
    background: linear-gradient(135deg, #fff7e6, #ffe7ba);
    border: 1px solid #faad14;
    border-radius: 8px;
    margin: 8px 0;
}
.razor-badge {
    display: inline-block;
    padding: 2px 8px;
    background: #faad14;
    color: #fff;
    border-radius: 10px;
    font-size: 12px;
    margin-bottom: 8px;
}
.razor-demo h3 { margin: 0 0 8px; color: #d46b08; }
.razor-demo code { background: #fff; padding: 2px 6px; border-radius: 3px; }
.razor-demo button {
    margin-top: 8px;
    padding: 6px 16px;
    background: #faad14;
    color: #fff;
    border: none;
    border-radius: 4px;
    cursor: pointer;
}
<!--STYLE_END-->
