@using VueLib.Web.Models
@{
    Layout = null;
    var project = ViewBag.Project as DynProject;
    var pid = project!.Id;
}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>页面管理 - @(project.DisplayName ?? project.Name)</title>
<link rel="stylesheet" href="~/css/element-plus.css">
<style>
    body { margin:0; background:#f0f2f5; font-family:'Segoe UI','Microsoft YaHei',sans-serif; }
    .bar { background:#fff; border-bottom:1px solid #e4e7ed; padding:10px 16px; display:flex; align-items:center; gap:10px; }
    .bar h2 { margin:0; font-size:16px; }
    .wrap { padding:14px; }
    .tip { color:#909399; font-size:12px; line-height:1.6; }
</style>
</head>
<body>
<div id="app">
    <div class="bar">
        <h2>📄 页面管理（路由 → 模板）</h2>
        <span style="color:#909399;font-size:12px;">定义路由，绑定模板并配置模板所需三屏，即完成一个业务流</span>
        <span style="flex:1"></span>
        <el-button type="primary" size="small" @@click="openAdd">＋ 新建页面</el-button>
    </div>
    <div class="wrap">
        <el-table :data="pages" border stripe size="default" v-loading="loading">
            <el-table-column prop="route" label="路由" min-width="140">
                <template #default="s"><span style="font-family:Consolas,monospace;color:#409eff">{{ s.row.route }}</span></template>
            </el-table-column>
            <el-table-column prop="name" label="名称" min-width="120"></el-table-column>
            <el-table-column prop="title" label="标题" min-width="120"></el-table-column>
            <el-table-column label="模板" min-width="140">
                <template #default="s">{{ templateName(s.row.templateId) }}</template>
            </el-table-column>
            <el-table-column label="Filter" width="120">
                <template #default="s">{{ effName(s.row, 'filterPageId') }}</template>
            </el-table-column>
            <el-table-column label="汇总" width="120">
                <template #default="s">{{ effName(s.row, 'summaryPageId') }}</template>
            </el-table-column>
            <el-table-column label="Detail" width="120">
                <template #default="s">{{ effName(s.row, 'detailPageId') }}</template>
            </el-table-column>
            <el-table-column label="主页" width="70" align="center">
                <template #default="s"><el-tag v-if="s.row.isHome" type="success" size="small">Home</el-tag></template>
            </el-table-column>
            <el-table-column label="操作" width="180" fixed="right">
                <template #default="s">
                    <el-button size="small" type="primary" link @@click="preview(s.row)">预览</el-button>
                    <el-button size="small" type="primary" link @@click="openEdit(s.row)">编辑</el-button>
                    <el-button size="small" type="danger" link @@click="del(s.row)">删除</el-button>
                </template>
            </el-table-column>
        </el-table>
    </div>

    <el-dialog v-model="dlg" :title="form.id ? '编辑页面' : '新建页面'" width="680px" :close-on-click-modal="false">
        <el-form :model="form" label-width="110px" size="default">
            <el-row :gutter="16">
                <el-col :span="12"><el-form-item label="页面名称" required><el-input v-model="form.name" placeholder="如：图纸管理"></el-input></el-form-item></el-col>
                <el-col :span="12"><el-form-item label="路由" required>
                    <el-input v-model="form.route" placeholder="/drawings">
                        <template #prepend>/</template>
                    </el-input>
                </el-form-item></el-col>
                <el-col :span="12"><el-form-item label="页面标题"><el-input v-model="form.title" placeholder="显示标题（可空）"></el-input></el-form-item></el-col>
                <el-col :span="12"><el-form-item label="主页">
                    <el-switch v-model="form.isHome"></el-switch>
                </el-form-item></el-col>
                <el-col :span="24"><el-form-item label="使用模板" required>
                    <el-select v-model="form.templateId" style="width:100%" @@change="onTemplateChange">
                        <el-option v-for="t in templates" :key="t.id" :label="t.name + '（' + t.templateType + '）'" :value="t.id"></el-option>
                    </el-select>
                </el-form-item></el-col>
            </el-row>

            <el-divider content-position="left">三屏覆盖（默认用模板的，可单独覆盖）</el-divider>
            <el-row :gutter="16">
                <el-col :span="8"><el-form-item label="Filter 屏">
                    <el-select v-model="form.filterPageId" clearable placeholder="继承模板" style="width:100%">
                        <el-option v-for="p in filterPages" :key="p.id" :label="p.name" :value="p.id"></el-option>
                    </el-select>
                </el-form-item></el-col>
                <el-col :span="8"><el-form-item label="汇总屏">
                    <el-select v-model="form.summaryPageId" clearable placeholder="继承模板" style="width:100%">
                        <el-option v-for="p in summaryPages" :key="p.id" :label="p.name" :value="p.id"></el-option>
                    </el-select>
                </el-form-item></el-col>
                <el-col :span="8"><el-form-item label="Detail 屏">
                    <el-select v-model="form.detailPageId" clearable placeholder="继承模板" style="width:100%">
                        <el-option v-for="p in detailPages" :key="p.id" :label="p.name" :value="p.id"></el-option>
                    </el-select>
                </el-form-item></el-col>
            </el-row>
            <div class="tip">预览地址：/DynRun/Route?projectId=@pid&route={{ 路由 }}</div>
        </el-form>
        <template #footer>
            <el-button @@click="dlg=false">取消</el-button>
            <el-button type="primary" :loading="saving" @@click="save">保存</el-button>
        </template>
    </el-dialog>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/js/vue.global.prod.js"></script>
<script src="~/js/element-plus.full.min.js"></script>
<script src="~/js/element-plus-icons.min.js"></script>
<script>
    window.ElMessage = ElementPlus.ElMessage;
    window.ElMessageBox = ElementPlus.ElMessageBox;
</script>
<script>
const { createApp, ref, reactive, computed, onMounted } = Vue;
const PROJECT_ID = @pid;
createApp({
    setup() {
        const pages = ref([]);
        const templates = ref([]);
        const pagesAll = ref([]);
        const loading = ref(false);
        const saving = ref(false);
        const dlg = ref(false);
        const form = reactive({ id:0, projectId:PROJECT_ID, name:'', route:'', title:'', templateId:null, isHome:false,
            filterPageId:null, summaryPageId:null, detailPageId:null });

        const filterPages = computed(() => pagesAll.value.filter(p => p.pageType === 'Filter'));
        const summaryPages = computed(() => pagesAll.value.filter(p => p.pageType === 'Summary'));
        const detailPages = computed(() => pagesAll.value.filter(p => p.pageType === 'Detail'));

        function templateName(id) { const t = templates.value.find(x=>x.id===id); return t ? t.name : '—'; }
        function pageName(id) { const p = pagesAll.value.find(x=>x.id===id); return p ? p.name : '—'; }
        function effName(row, key) {
            const cfg = row.config ? (()=>{try{return JSON.parse(row.config);}catch{return {};}})() : {};
            const override = cfg[key];
            const t = templates.value.find(x=>x.id===row.templateId);
            const base = t ? t[key] : null;
            const v = override || base;
            return v ? pageName(v) : '—';
        }

        async function load() {
            loading.value = true;
            try {
                const [w, t, pg] = await Promise.all([
                    $.getJSON('/api/dynproject/'+PROJECT_ID+'/webpages'),
                    $.getJSON('/api/dynproject/'+PROJECT_ID+'/templates'),
                    $.getJSON('/api/dynproject/'+PROJECT_ID+'/pages')
                ]);
                pages.value = w.data || [];
                templates.value = t.data || [];
                pagesAll.value = pg.data || [];
            } catch(e) { ElMessage.error('加载失败'); }
            loading.value = false;
        }
        function onTemplateChange() {
            const t = templates.value.find(x=>x.id===form.templateId);
            if (t) { form.filterPageId = null; form.summaryPageId = null; form.detailPageId = null; }
        }
        function openAdd() {
            Object.assign(form, { id:0, name:'', route:'', title:'', templateId:null, isHome:false, filterPageId:null, summaryPageId:null, detailPageId:null });
            dlg.value = true;
        }
        function openEdit(w) {
            Object.assign(form, { id:w.id, name:w.name, route:w.route, title:w.title||'', templateId:w.templateId, isHome:!!w.isHome,
                filterPageId:null, summaryPageId:null, detailPageId:null });
            if (w.config) { try { const c = JSON.parse(w.config); form.filterPageId=c.filterPageId||null; form.summaryPageId=c.summaryPageId||null; form.detailPageId=c.detailPageId||null; } catch {} }
            dlg.value = true;
        }
        function buildConfig() {
            const cfg = {};
            if (form.filterPageId) cfg.filterPageId = form.filterPageId;
            if (form.summaryPageId) cfg.summaryPageId = form.summaryPageId;
            if (form.detailPageId) cfg.detailPageId = form.detailPageId;
            return Object.keys(cfg).length ? JSON.stringify(cfg) : null;
        }
        async function save() {
            if (!form.name || !form.route || !form.templateId) { ElMessage.warning('名称、路由、模板必填'); return; }
            saving.value = true;
            try {
                const r = await $.ajax({ url:'/api/dynproject/webpage/save', method:'POST', contentType:'application/json',
                    data: JSON.stringify({ id:form.id, projectId:PROJECT_ID, name:form.name, route:form.route, title:form.title,
                        templateId:form.templateId, isHome:form.isHome, config:buildConfig() }) });
                if (r.success) { ElMessage.success('已保存'); dlg.value=false; load(); }
                else ElMessage.error(r.message || '保存失败');
            } catch(e) { ElMessage.error('保存失败'); }
            saving.value = false;
        }
        function preview(w) {
            const url = '/DynRun/Route?projectId='+PROJECT_ID+'&route='+encodeURIComponent(w.route);
            if (window.parent && window.parent.dynOpenUrl) window.parent.dynOpenUrl(url, w.title || w.name);
            else window.open(url, '_blank');
        }
        async function del(w) {
            ElMessageBox.confirm('确认删除页面「'+w.name+'」？','提示',{type:'warning'}).then(async ()=>{
                const r = await $.ajax({ url:'/api/dynproject/webpage/'+w.id, method:'DELETE' });
                if (r.success) { ElMessage.success('已删除'); load(); } else ElMessage.error(r.message||'删除失败');
            }).catch(()=>{});
        }
        onMounted(load);
        return { pages, templates, pagesAll, loading, saving, dlg, form, filterPages, summaryPages, detailPages,
            templateName, pageName, effName, openAdd, openEdit, onTemplateChange, save, preview, del };
    }
}).use(ElementPlus).mount('#app');
</script>
</body>
</html>
