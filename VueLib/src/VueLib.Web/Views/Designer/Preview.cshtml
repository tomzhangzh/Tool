@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>手机预览</title>
    <link rel="stylesheet" href="~/css/nutui.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/nutui-icons.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/mobile.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/preview.css" asp-append-version="true" />
