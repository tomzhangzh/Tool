@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>低代码设计器 - VueLib</title>
    <link rel="stylesheet" href="~/css/element-plus.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/nutui.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/nutui-icons.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/mobile.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/designer.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/property-panel.css" asp-append-version="true" />
</head>
<body>
    <div id="designer-app">
        <!-- 顶部工具栏 -->
        <div class="designer-toolbar">
            <div class="toolbar-left">
                <span class="toolbar-title">🎨 低代码设计器</span>
                <el-select v-model="currentPageCode" placeholder="选择页面" size="small" style="width:200px;margin-left:16px;" @@change="loadPage">
                    <el-option v-for="p in pageList" :key="p.pageCode" :label="p.pageName" :value="p.pageCode"></el-option>
                </el-select>
                <el-button size="small" type="primary" @@click="newPage">新建</el-button>
                <el-button size="small" type="success" @@click="savePage" :loading="saving">保存</el-button>
            </div>
            <div class="toolbar-right">
                <el-radio-group v-model="designMode" size="small" style="margin-right:12px;">
                    <el-radio-button label="design">设计</el-radio-button>
                    <el-radio-button label="preview">预览</el-radio-button>
                </el-radio-group>
                <el-switch v-model="showJson" active-text="JSON" inactive-text="" size="small" style="margin:0 12px;"></el-switch>
                <el-button size="small" type="info" @@click="showModelData">查看数据</el-button>
                <el-button size="small" type="warning" @@click="openPreview">新窗口预览</el-button>
            </div>
        </div>

        <!-- 主体三栏 -->
        <div class="designer-body">
            <!-- 左侧组件面板 -->
            <div class="panel panel-left">
                <el-tabs v-model="leftTab" tab-position="top" class="component-tabs">
                    <el-tab-pane label="组件库" name="palette">
                        <div class="palette-inner">
                            <div style="margin-bottom:8px;">
                                <el-select v-model="activeUiLibrary" size="small" style="width:100%;">
                                    <el-option label="全部组件" value="all"></el-option>
                                    <el-option label="NutUI (移动端)" value="nutui"></el-option>
                                    <el-option label="ElementUI (电脑端)" value="elementui"></el-option>
                                    <el-option label="自定义" value="custom"></el-option>
                                </el-select>
                            </div>
                            <el-radio-group v-model="activeCategory" size="small" style="margin-bottom:8px;">
                                <el-radio-button v-for="cat in categories" :key="cat.key" :label="cat.key">{{ cat.label }}</el-radio-button>
                            </el-radio-group>
                            <div class="component-grid" v-draggable="[filteredComponents, paletteDragOptions]">
                                <div v-for="comp in filteredComponents"
                                     :key="comp.componentName"
                                     class="component-item"
                                     :title="comp.description">
                                    <span class="comp-icon">{{ comp.icon }}</span>
                                    <span class="comp-label">{{ comp.displayName || comp.label || comp.componentName }}</span>
                                </div>
                            </div>
                        </div>
                    </el-tab-pane>
                    <el-tab-pane label="组件树" name="tree">
                        <div class="tree-inner">
                            <el-input v-model="treeFilter" placeholder="过滤组件" size="small" clearable style="margin-bottom:8px;"></el-input>
                            <el-tree ref="treeRef"
                                     :data="[configObj]"
                                     :props="{ children: 'childrenctrls', label: 'component' }"
                                     draggable
                                     default-expand-all
                                     :filter-node-method="(value, data) => !value || data.component.includes(value)"
                                     @@node-click="selectFromTree">
                            </el-tree>
                        </div>
                    </el-tab-pane>
                </el-tabs>
            </div>

            <!-- 中间手机模拟器（直接渲染） -->
            <div class="panel panel-center">
                <div class="phone-wrapper">
                    <div class="phone-notch"></div>
                    <div class="phone-screen designer-canvas" :class="{ 'preview-mode': designMode === 'preview' }">
                        <n-dynamic-com :jsonconfig="configObj" :parentmodelinfo="modelObj" node-path="root"></n-dynamic-com>
                    </div>
                    <div class="phone-home-indicator"></div>
                </div>
                <div class="canvas-info">
                    <span>画布: 375 × 667 (iPhone SE)</span>
                    <span v-if="currentPath">选中: {{ currentPath }}</span>
                </div>
            </div>

            <!-- 右侧属性面板 -->
            <div class="panel panel-right">
                <div class="panel-header">属性配置</div>
                <div v-if="!currentCom" class="empty-tip">
                    <el-empty description="在左侧点击组件添加，或在画布中选中组件" :image-size="80"></el-empty>
                </div>
                <div v-else class="property-form">
                    <!-- 组件信息头部 -->
                    <div class="pp-panel-header">
                        <span class="pp-panel-title">
                            <el-tag size="small">{{ currentCom.component }}</el-tag>
                            <span v-if="currentCom.modelname" style="margin-left:6px;font-size:12px;color:#909399;">{{ currentCom.modelname }}</span>
                        </span>
                        <div class="pp-panel-actions">
                            <el-button size="small" text @@click="showJsonEditor" title="编辑JSON">JSON</el-button>
                        </div>
                    </div>

                    <!-- 动态属性面板 -->
                    <dynamic-property-panel
                        v-if="currentPropertyConfig"
                        :property-config="currentPropertyConfig"
                        :component-config="currentCom"
                        :component-name="currentCom.component"
                        @@update="onPropertyUpdate"
                        @@reset="resetCurrentCom">
                    </dynamic-property-panel>

                    <!-- 无属性配置时的回退 -->
                    <div v-else class="pp-fallback">
                        <el-form label-width="90px" size="small">
                            <el-form-item label="绑定字段">
                                <el-input v-model="currentCom.modelname" placeholder="如: user.name" clearable></el-input>
                            </el-form-item>
                            <el-form-item label="标签文字">
                                <el-input v-model="currentCom.options.labeloptions.label" placeholder="标签名称" clearable></el-input>
                            </el-form-item>
                            <el-form-item label="显示标签">
                                <el-switch v-model="currentCom.options.labeloptions.show"></el-switch>
                            </el-form-item>
                            <el-form-item label="必填">
                                <el-switch v-model="currentCom.options.labeloptions.required" @@change="toggleRequired"></el-switch>
                            </el-form-item>
                            <el-form-item label="占位符">
                                <el-input v-model="currentCom.options.comoptions.placeholder" placeholder="placeholder" clearable></el-input>
                            </el-form-item>
                            <el-form-item label="选项值">
                                <el-input v-model="currentCom.options.optionValues" placeholder="逗号分隔，如: 男,女,保密" clearable
                                          v-if="hasOptionField"></el-input>
                                <span v-else class="text-muted">—</span>
                            </el-form-item>
                        </el-form>
                    </div>

                    <el-divider content-position="left">验证器</el-divider>
                    <div class="validator-list">
                        <div v-for="(v, idx) in currentCom.validators" :key="idx" class="validator-item">
                            <el-select v-model="v.type" size="small" style="width:120px;">
                                <el-option label="必填" value="required"></el-option>
                                <el-option label="必须为真" value="requiredTrue"></el-option>
                                <el-option label="最小长度" value="minLength"></el-option>
                                <el-option label="最大长度" value="maxLength"></el-option>
                                <el-option label="最小值" value="min"></el-option>
                                <el-option label="最大值" value="max"></el-option>
                                <el-option label="正则" value="pattern"></el-option>
                                <el-option label="邮箱" value="email"></el-option>
                                <el-option label="手机号" value="phone"></el-option>
                                <el-option label="URL" value="url"></el-option>
                                <el-option label="数字" value="number"></el-option>
                            </el-select>
                            <el-input v-if="needsValue(v.type)" v-model="v.value" size="small" placeholder="值" style="width:80px;margin:0 6px;"></el-input>
                            <el-input v-model="v.message" size="small" placeholder="错误提示" style="flex:1;margin-right:6px;"></el-input>
                            <el-button size="small" type="danger" icon="Delete" @@click="removeValidator(idx)" circle></el-button>
                        </div>
                        <el-button size="small" type="primary" plain icon="Plus" @@click="addValidator">添加验证规则</el-button>
                    </div>

                    <el-divider content-position="left">操作</el-divider>
                    <el-form-item>
                        <el-button size="small" @@click="moveUp" :disabled="!canMoveUp">上移</el-button>
                        <el-button size="small" @@click="moveDown" :disabled="!canMoveDown">下移</el-button>
                        <el-button size="small" type="primary" plain @@click="copyCurrent">复制</el-button>
                        <el-button size="small" type="danger" @@click="deleteCurrent">删除</el-button>
                    </el-form-item>
                </div>
            </div>
        </div>

        <!-- 底部面包屑 -->
        <div class="breadcrumb-bar">
            <span class="breadcrumb-label">路径:</span>
            <template v-for="(item, idx) in breadcrumbList" :key="idx">
                <a href="#" class="breadcrumb-link" @@click.prevent="setCurrentCom(item)">{{ item.component }}<b v-if="item.modelname"> ({{ item.modelname }})</b></a>
                <span v-if="idx < breadcrumbList.length - 1" class="breadcrumb-sep">›</span>
            </template>
            <span v-if="!currentCom" class="breadcrumb-empty">未选中组件</span>
        </div>

        <!-- JSON 编辑器弹窗 -->
        <el-dialog v-model="showJson" title="页面配置 JSON" width="700px" top="5vh">
            <el-input v-model="configJsonText" type="textarea" :rows="24" font-size="12px"
                      placeholder="页面配置 JSON"></el-input>
            <template #footer>
                <el-button @@click="applyJson">应用 JSON</el-button>
                <el-button type="primary" @@click="showJson=false">关闭</el-button>
            </template>
        </el-dialog>

        <!-- 新建页面弹窗 -->
        <el-dialog v-model="showNewPage" title="新建页面" width="400px">
            <el-form label-width="80px">
                <el-form-item label="页面名称">
                    <el-input v-model="newPageForm.pageName"></el-input>
                </el-form-item>
                <el-form-item label="页面编码">
                    <el-input v-model="newPageForm.pageCode" placeholder="英文，如 user-form"></el-input>
                </el-form-item>
            </el-form>
            <template #footer>
                <el-button @@click="showNewPage=false">取消</el-button>
                <el-button type="primary" @@click="confirmNewPage">创建</el-button>
            </template>
        </el-dialog>

        <!-- Model 数据弹窗 -->
        <el-dialog v-model="showModelModal" title="页面数据模型 (Model JSON)" width="600px" top="8vh">
            <el-input v-model="modelJsonText" type="textarea" :rows="20" font-size="12px"
                      readonly placeholder="页面数据模型为空，请先在组件中设置绑定字段名并输入值"></el-input>
            <template #footer>
                <el-button type="primary" @@click="copyModelJson">复制</el-button>
                <el-button @@click="showModelModal=false">关闭</el-button>
            </template>
        </el-dialog>
    </div>

    <script src="~/js/vue.global.prod.js" asp-append-version="true"></script>
    <script src="~/js/lodash.min.js" asp-append-version="true"></script>
    <script src="~/js/element-plus.full.min.js" asp-append-version="true"></script>
    <script src="~/js/element-plus-icons.min.js" asp-append-version="true"></script>
    <script src="~/js/nutui.umd.min.js" asp-append-version="true"></script>
    <script src="~/js/echarts.min.js" asp-append-version="true"></script>
    <script src="~/js/nut-runtime.js" asp-append-version="true"></script>
    <script src="~/js/mobile-setup.js" asp-append-version="true"></script>
    <script src="~/js/property-panel.js" asp-append-version="true"></script>
    <script src="~/js/vue-draggable-plus.umd.min.js" asp-append-version="true"></script>
    <script src="~/js/designer.js" asp-append-version="true"></script>
</body>
</html>
