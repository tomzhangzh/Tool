@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>低代码设计器 - VueLib</title>
    <link rel="stylesheet" href="~/css/element-plus.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/nutui.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/nutui-icons.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/mobile.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/designer.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/property-panel.css" asp-append-version="true" />
</head>
<body>
    <div class="lc-shell">
    @await Html.PartialAsync("_TopToolbar")
    <div class="lc-main">
    @await Html.PartialAsync("_LeftPanel")
    <div id="designer-app">
        <div class="designer-body">
            @await Html.PartialAsync("_CenterCanvas")
        </div>
    </div>
    @await Html.PartialAsync("_RightPanel")
    </div>
    @await Html.PartialAsync("_Dialogs")
    @await Html.PartialAsync("_Breadcrumb")
    </div>

    <script src="~/js/vue.global.prod.js" asp-append-version="true"></script>
    <script src="~/js/lodash.min.js" asp-append-version="true"></script>
    <script src="~/js/element-plus.full.min.js" asp-append-version="true"></script>
    <script src="~/js/element-plus-icons.min.js" asp-append-version="true"></script>
    <script src="~/js/nutui.umd.min.js" asp-append-version="true"></script>
    <script src="~/js/echarts.min.js" asp-append-version="true"></script>
    <script src="~/js/nut-runtime.js" asp-append-version="true"></script>
    <script src="~/js/mobile-setup.js" asp-append-version="true"></script>
    <script src="~/js/property-panel.js" asp-append-version="true"></script>
    <script src="~/lib/sortable/sortable.min.js" asp-append-version="true"></script>
    <script src="~/lib/ruler/ruler.min.js" asp-append-version="true"></script>
    <script src="~/js/vue-draggable-plus.umd.min.js" asp-append-version="true"></script>
    <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
    <script src="~/js/dyn-lib.js" asp-append-version="true"></script>
    <script src="~/js/designer.core.js" asp-append-version="true"></script>
    <script src="~/js/designer.utils.js" asp-append-version="true"></script>
    <script src="~/js/html-code-generator.js" asp-append-version="true"></script>
    <script src="~/js/designer.js" asp-append-version="true"></script>
</body>
</html>
