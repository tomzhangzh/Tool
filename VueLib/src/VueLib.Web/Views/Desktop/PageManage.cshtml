@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>页面管理</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/layui@2.9.16/dist/css/layui.css">
    <style>
        body { padding: 16px; background: #f5f7fa; }
        .toolbar { margin-bottom: 12px; display: flex; gap: 8px; align-items: center; }
    </style>
</head>
<body>
<div class="toolbar">
    <button class="layui-btn layui-btn-sm" onclick="openEdit()">+ 新增页面</button>
    <button class="layui-btn layui-btn-sm layui-btn-primary" onclick="loadData()">刷新</button>
</div>
<table id="pageTable" lay-filter="pageTable"></table>

<script type="text/html" id="barTpl">
    <a class="layui-btn layui-btn-xs" lay-event="design">设计</a>
    <a class="layui-btn layui-btn-xs layui-btn-normal" lay-event="preview">预览</a>
    <a class="layui-btn layui-btn-xs" lay-event="edit">编辑</a>
    <a class="layui-btn layui-btn-xs layui-btn-danger" lay-event="del">删除</a>
</script>

<script src="https://cdn.jsdelivr.net/npm/layui@2.9.16/dist/layui.js"></script>
<script>
let table, layer;
layui.use(['table', 'layer'], function(){
    table = layui.table;
    layer = layui.layer;
    loadData();
});

function loadData() {
    table.render({
        elem: '#pageTable',
        url: '/api/lowcode/pages',
        parseData: function(res){ return { code: res.success ? 0 : 1, msg: '', count: res.data.length, data: res.data }; },
        cols: [[
            { field: 'id', title: 'ID', width: 60 },
            { field: 'pageCode', title: '页面编码', width: 160 },
            { field: 'pageName', title: '页面名称', width: 160 },
            { field: 'platform', title: '平台', width: 90, templet: d => d.platform === 'desktop' ? '<span class="layui-badge layui-bg-blue">电脑端</span>' : '<span class="layui-badge">手机端</span>' },
            { field: 'category', title: '分类', width: 100 },
            { field: 'description', title: '描述' },
            { field: 'isEnabled', title: '状态', width: 80, templet: d => d.isEnabled ? '<span style="color:#5FB878;">启用</span>' : '<span style="color:#FF5722;">禁用</span>' },
            { title: '操作', width: 260, toolbar: '#barTpl' }
        ]],
        page: false
    });
    table.on('tool(pageTable)', function(obj){
        const d = obj.data;
        if (obj.event === 'design') window.open('/designer?code=' + d.pageCode, '_blank');
        if (obj.event === 'preview') window.open('/designer/preview?code=' + d.pageCode, '_blank');
        if (obj.event === 'edit') openEdit(d);
        if (obj.event === 'del') {
            layer.confirm('确定删除页面 [' + d.pageName + ']？', { icon: 3 }, function(idx){
                fetch('/api/lowcode/page/' + d.id, { method: 'DELETE' }).then(() => {
                    layer.close(idx); loadData(); layer.msg('已删除');
                });
            });
        }
    });
}

function openEdit(data) {
    const isEdit = !!data;
    const d = data || { id: 0, pageCode: '', pageName: '', platform: 'mobile', category: '', description: '', isEnabled: true, configJson: '{"component":"NDivContainer","childrenctrls":[],"options":{"itemoptions":{"style":{"padding":"12px"}}}}', defaultModelJson: '{}' };
    const html = `
        <form class="layui-form" style="padding:20px;">
            <div class="layui-form-item"><label class="layui-form-label">页面编码</label><div class="layui-input-block"><input id="f_code" class="layui-input" value="${d.pageCode}" ${isEdit?'disabled':''}></div></div>
            <div class="layui-form-item"><label class="layui-form-label">页面名称</label><div class="layui-input-block"><input id="f_name" class="layui-input" value="${d.pageName}"></div></div>
            <div class="layui-form-item"><label class="layui-form-label">平台</label><div class="layui-input-block">
                <select id="f_platform"><option value="mobile" ${d.platform==='mobile'?'selected':''}>手机端(NutUI)</option><option value="desktop" ${d.platform==='desktop'?'selected':''}>电脑端(ElementUI)</option></select>
            </div></div>
            <div class="layui-form-item"><label class="layui-form-label">分类</label><div class="layui-input-block"><input id="f_category" class="layui-input" value="${d.category || ''}"></div></div>
            <div class="layui-form-item"><label class="layui-form-label">描述</label><div class="layui-input-block"><input id="f_desc" class="layui-input" value="${d.description || ''}"></div></div>
            <div class="layui-form-item"><label class="layui-form-label">启用</label><div class="layui-input-block"><input type="checkbox" id="f_enabled" ${d.isEnabled?'checked':''} lay-skin="switch"></div></div>
        </form>`;
    layer.open({
        type: 1, title: isEdit ? '编辑页面' : '新增页面', area: ['480px', '380px'], content: html,
        btn: ['保存', '取消'],
        yes: function(idx){
            const payload = {
                id: d.id, pageCode: document.getElementById('f_code').value,
                pageName: document.getElementById('f_name').value,
                platform: document.getElementById('f_platform').value,
                category: document.getElementById('f_category').value,
                description: document.getElementById('f_desc').value,
                isEnabled: document.getElementById('f_enabled').checked,
                configJson: d.configJson, defaultModelJson: d.defaultModelJson
            };
            if (!payload.pageCode || !payload.pageName) { layer.msg('编码和名称不能为空'); return; }
            fetch('/api/lowcode/page', {
                method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload)
            }).then(r => r.json()).then(res => {
                if (res.success) { layer.close(idx); loadData(); layer.msg('保存成功'); }
                else layer.msg('保存失败: ' + res.message);
            });
        }
    });
}
</script>
</body>
</html>
